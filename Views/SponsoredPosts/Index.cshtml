@using Bridgo.Extensions
@{
    ViewData["Title"] = Html.T("SponsoredPosts.Title", "Sponsorlu Icerikler").ToString();
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
}

<div id="sponsored-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">
                <i class="bi bi-megaphone text-primary me-2"></i>
                @Html.T("SponsoredPosts.Title", "Sponsorlu Icerikler")
            </h4>
            <p class="text-muted mb-0">@Html.T("SponsoredPosts.Subtitle", "Paylasimlarinizi one cikarin")</p>
        </div>
        <button class="btn btn-primary" data-bind="click: showCreateModal">
            <i class="bi bi-plus-lg me-1"></i> @Html.T("SponsoredPosts.Create", "Yeni Sponsorluk")
        </button>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@Html.T("Common.Loading", "Yukleniyor...")</span>
        </div>
    </div>

    <!-- Empty state -->
    <div data-bind="visible: !isLoading() && items().length === 0" class="text-center py-5">
        <i class="bi bi-megaphone display-1 text-muted"></i>
        <p class="text-muted mt-3">@Html.T("SponsoredPosts.Empty", "Henuz sponsorlu icerik yok")</p>
    </div>

    <!-- Items Table -->
    <div data-bind="visible: !isLoading() && items().length > 0">
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Html.T("SponsoredPosts.Column.Post", "Paylasim")</th>
                            <th>@Html.T("SponsoredPosts.Column.Status", "Durum")</th>
                            <th>@Html.T("SponsoredPosts.Column.Budget", "Butce")</th>
                            <th>@Html.T("SponsoredPosts.Column.Impressions", "Gosterim")</th>
                            <th>@Html.T("SponsoredPosts.Column.Clicks", "Tiklama")</th>
                            <th>@Html.T("SponsoredPosts.Column.Period", "Donem")</th>
                            <th class="text-end">@Html.T("Common.Actions", "Islemler")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: items">
                        <tr>
                            <td>
                                <div class="fw-semibold" data-bind="text: postTitle || postContentPreview"></div>
                                <small class="text-muted" data-bind="text: 'ID: ' + socialPostId"></small>
                            </td>
                            <td>
                                <span class="badge" data-bind="text: statusName, css: statusCssClass"></span>
                            </td>
                            <td>
                                <span data-bind="text: budgetAmount.toFixed(2) + ' ' + currency"></span>
                            </td>
                            <td>
                                <span data-bind="text: currentImpressions + ' / ' + targetImpressions"></span>
                                <div class="progress mt-1" style="height:4px;">
                                    <div class="progress-bar" data-bind="style: { width: (targetImpressions > 0 ? Math.min(100, currentImpressions / targetImpressions * 100) : 0) + '%' }"></div>
                                </div>
                            </td>
                            <td data-bind="text: currentClicks"></td>
                            <td>
                                <small>
                                    <span data-bind="text: startDate ? new Date(startDate).toLocaleDateString('tr-TR') : '-'"></span>
                                    <span> - </span>
                                    <span data-bind="text: endDate ? new Date(endDate).toLocaleDateString('tr-TR') : '-'"></span>
                                </small>
                            </td>
                            <td class="text-end">
                                <!-- ko if: statusId === 1 || statusId === 3 -->
                                <button class="btn btn-sm btn-outline-success" data-bind="click: function() { $parent.activate($data); }" title="@Html.T("SponsoredPosts.Action.Activate", "Aktifle")">
                                    <i class="bi bi-play-fill"></i>
                                </button>
                                <!-- /ko -->
                                <!-- ko if: statusId === 2 -->
                                <button class="btn btn-sm btn-outline-warning" data-bind="click: function() { $parent.pause($data); }" title="@Html.T("SponsoredPosts.Action.Pause", "Duraklat")">
                                    <i class="bi bi-pause-fill"></i>
                                </button>
                                <!-- /ko -->
                                <!-- ko if: statusId === 1 || statusId === 3 -->
                                <button class="btn btn-sm btn-outline-primary" data-bind="click: function() { $parent.showEditModal($data); }" title="@Html.T("Common.Edit", "Duzenle")">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <!-- /ko -->
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Create/Edit Modal -->
    <div class="modal fade" id="sponsoredModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" data-bind="text: editingId() ? '@Html.T("SponsoredPosts.Edit", "Sponsorlu Icerigi Duzenle")' : '@Html.T("SponsoredPosts.Create", "Yeni Sponsorluk")'"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- ko ifnot: editingId -->
                    <div class="mb-3">
                        <label class="form-label">@Html.T("SponsoredPosts.Field.Post", "Paylasim ID")</label>
                        <input type="number" class="form-control" data-bind="value: form.socialPostId" />
                        <small class="form-text text-muted">@Html.T("SponsoredPosts.Field.PostHelp", "Sponsorlamak istediginiz paylasimin ID'si")</small>
                    </div>
                    <!-- /ko -->
                    <div class="mb-3">
                        <label class="form-label">@Html.T("SponsoredPosts.Field.Budget", "Butce")</label>
                        <div class="input-group">
                            <input type="number" step="0.01" class="form-control" data-bind="value: form.budgetAmount" />
                            <select class="form-select" style="max-width:100px;" data-bind="value: form.currency">
                                <option value="USD">USD</option>
                                <option value="EUR">EUR</option>
                                <option value="TRY">TRY</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("SponsoredPosts.Field.TargetImpressions", "Hedef Gosterim")</label>
                        <input type="number" class="form-control" data-bind="value: form.targetImpressions" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("SponsoredPosts.Field.StartDate", "Baslangic Tarihi")</label>
                            <input type="date" class="form-control" data-bind="value: form.startDate" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("SponsoredPosts.Field.EndDate", "Bitis Tarihi")</label>
                            <input type="date" class="form-control" data-bind="value: form.endDate" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Cancel", "Iptal")</button>
                    <button type="button" class="btn btn-primary" data-bind="click: saveSponsored">
                        <i class="bi bi-check-lg me-1"></i> @Html.T("Common.Save", "Kaydet")
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/SponsoredPosts/Index.js" asp-append-version="true"></script>
}
