@{
    ViewData["Title"] = Html.T("Admin.Vendors.Title", "Firma Yonetimi").ToString();
    Layout = "_AdminLayout";
}

<div id="vendors-app">
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h6 class="mb-0">@Html.T("Admin.Vendors.AllVendors", "Tum Firmalar")</h6>
        <div>
            <select class="form-select form-select-sm d-inline-block w-auto me-2" data-bind="value: statusFilter">
                <option value="">@Html.T("Admin.Vendors.AllStatuses", "Tum Durumlar")</option>
                <option value="0">@Html.T("Admin.Vendors.Status.ProfilePending", "Profil Bekliyor")</option>
                <option value="1">@Html.T("Admin.Vendors.Status.VerificationPending", "Dogrulama Bekliyor")</option>
                <option value="2">@Html.T("Common.Active", "Aktif")</option>
                <option value="3">@Html.T("Admin.Vendors.Status.Suspended", "Askida")</option>
                <option value="4">@Html.T("Admin.Vendors.Status.Rejected", "Reddedildi")</option>
            </select>
            <input type="search" class="form-control form-control-sm d-inline-block w-auto"
                   placeholder="@Html.T("Common.Search", "Ara...")" data-bind="value: searchQuery, valueUpdate: 'afterkeydown'">
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Html.T("Admin.Table.CompanyName", "Firma Adi")</th>
                        <th>@Html.T("Admin.Table.Email", "E-posta")</th>
                        <th>@Html.T("Admin.Table.Phone", "Telefon")</th>
                        <th>@Html.T("Admin.Table.Capability", "Yetenek")</th>
                        <th>@Html.T("Admin.Table.UserCount", "Kullanici")</th>
                        <th>@Html.T("Admin.Table.Status", "Durum")</th>
                        <th>@Html.T("Admin.Table.CreatedAt", "Kayit Tarihi")</th>
                        <th>@Html.T("Admin.Table.Actions", "Islemler")</th>
                    </tr>
                </thead>
                <tbody data-bind="foreach: vendors">
                    <tr>
                        <td data-bind="text: companyName"></td>
                        <td data-bind="text: email"></td>
                        <td data-bind="text: phone"></td>
                        <td>
                            <span class="badge bg-info" data-bind="text: capabilityName"></span>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark" data-bind="text: userCount"></span>
                        </td>
                        <td>
                            <span class="badge" data-bind="text: statusText, css: statusClass"></span>
                        </td>
                        <td data-bind="text: createdAt"></td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-primary" title="@Html.T("Common.View", "Goruntule")" data-bind="click: $parent.viewVendor">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button class="btn btn-outline-success" title="@Html.T("Common.Approve", "Onayla")" data-bind="click: $parent.approveVendor, visible: status === 1">
                                    <i class="bi bi-check-lg"></i>
                                </button>
                                <button class="btn btn-outline-warning" title="@Html.T("Admin.Vendors.Suspend", "Askiya Al")" data-bind="click: $parent.suspendVendor, visible: status === 2">
                                    <i class="bi bi-pause"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Loading -->
        <div class="text-center py-4" data-bind="visible: isLoading">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@Html.T("Common.Loading", "Yukleniyor...")</span>
            </div>
        </div>

        <!-- Empty State -->
        <div class="text-center py-5" data-bind="visible: !isLoading() && vendors().length === 0">
            <i class="bi bi-building text-muted fs-1"></i>
            <p class="text-muted mt-2">@Html.T("Admin.Vendors.Empty", "Henuz firma kaydi bulunmuyor")</p>
        </div>
    </div>
</div>
</div>

@section Scripts {
<script src="~/js/Admin/Vendors.js" asp-append-version="true"></script>
}
