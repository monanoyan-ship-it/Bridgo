    </div>
</div>

<!-- Negotiation History Modal -->
<div class="modal fade" id="negotiationModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">
                    <i class="bi bi-arrow-left-right me-2"></i>Pazarlik Gecmisi
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Summary -->
                <div class="card bg-light mb-4" data-bind="with: negotiationSummary">
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-md-3">
                                <div class="fs-4 fw-bold text-primary" data-bind="text: currentRound || 0"></div>
                                <small class="text-muted">Toplam Tur</small>
                            </div>
                            <div class="col-md-3">
                                <div class="fs-4 fw-bold">
                                    <span data-bind="text: originalPrice ? originalPrice.toLocaleString('tr-TR', {minimumFractionDigits: 2}) : '-'"></span>
                                </div>
                                <small class="text-muted">Baslangic Fiyat</small>
                            </div>
                            <div class="col-md-3">
                                <div class="fs-4 fw-bold text-success">
                                    <span data-bind="text: currentPrice ? currentPrice.toLocaleString('tr-TR', {minimumFractionDigits: 2}) : '-'"></span>
                                </div>
                                <small class="text-muted">Guncel Fiyat</small>
                            </div>
                            <div class="col-md-3">
                                <div class="fs-4 fw-bold" data-bind="text: priceChangePercent ? priceChangePercent.toFixed(1) + '%' : '-', css: { 'text-success': priceChangePercent < 0, 'text-danger': priceChangePercent > 0 }"></div>
                                <small class="text-muted">Fiyat Degisimi</small>
                            </div>
                        </div>
                        <!-- Turn indicator -->
                        <div class="mt-3 text-center" data-bind="visible: isNegotiationActive">
                            <div data-bind="visible: isMyTurn" class="alert alert-warning mb-0 py-2">
                                <i class="bi bi-bell-fill me-1"></i>
                                <strong>Sira sizde!</strong> Karsi teklif verin veya kabul/reddedin.
                                <!-- ko if: expiresAt -->
                                <br><small>Kalan sure: <span data-bind="text: $root.formatTimeRemaining(expiresAt)"></span></small>
                                <!-- /ko -->
                            </div>
                            <div data-bind="visible: !isMyTurn" class="alert alert-info mb-0 py-2">
                                <i class="bi bi-hourglass-split me-1"></i>
                                Karsi tarafin yaniti bekleniyor...
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Timeline -->
                <div class="negotiation-timeline" data-bind="with: negotiationHistory">
                    <!-- Original Proposal -->
                    <div class="timeline-item">
                        <div class="timeline-marker bg-primary">
                            <i class="bi bi-file-text"></i>
                        </div>
                        <div class="timeline-content">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <strong class="text-primary">Orijinal Teklif</strong>
                                    <span class="badge bg-secondary ms-2" data-bind="text: sellerCompanyName"></span>
                                </div>
                                <small class="text-muted" data-bind="text: createdAt ? new Date(createdAt).toLocaleString('tr-TR') : ''"></small>
                            </div>
                            <div class="mt-2">
                                <span class="fs-5 fw-bold" data-bind="text: originalUnitPrice ? originalUnitPrice.toLocaleString('tr-TR', {minimumFractionDigits: 2}) : '-'"></span>
                                <small class="text-muted" data-bind="text: currency || 'TRY'"></small>
                                <span class="text-muted mx-2">|</span>
                                <span data-bind="text: originalQuantity"></span> <span data-bind="text: unit || 'adet'"></span>
                                <!-- ko if: originalLeadTimeDays -->
                                <span class="text-muted mx-2">|</span>
                                <span data-bind="text: originalLeadTimeDays"></span> gun teslimat
                                <!-- /ko -->
                            </div>
                        </div>
                    </div>

                    <!-- Negotiation Rounds -->
                    <!-- ko foreach: rounds -->
                    <div class="timeline-item">
                        <div class="timeline-marker" data-bind="css: {
                            'bg-info': status === 1 || status === 2,
                            'bg-success': status === 3,
                            'bg-danger': status === 4,
                            'bg-warning': status === 5 || status === 6
                        }">
                            <i class="bi" data-bind="css: {
                                'bi-chat-dots': status === 1 || status === 2,
                                'bi-check-lg': status === 3,
                                'bi-x-lg': status === 4,
                                'bi-clock': status === 5,
                                'bi-arrow-return-left': status === 6
                            }"></i>
                        </div>
                        <div class="timeline-content">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <strong data-bind="text: 'Tur ' + roundNumber"></strong>
                                    <span class="badge ms-2" data-bind="text: initiatorName, css: {
                                        'bg-primary': isInitiatorBuyer,
                                        'bg-secondary': !isInitiatorBuyer
                                    }"></span>
                                    <span class="badge ms-1" data-bind="text: statusName, css: {
                                        'bg-info': status === 1,
                                        'bg-info': status === 2,
                                        'bg-success': status === 3,
                                        'bg-danger': status === 4,
                                        'bg-warning text-dark': status === 5,
                                        'bg-secondary': status === 6
                                    }"></span>
                                </div>
                                <small class="text-muted" data-bind="text: createdAt ? new Date(createdAt).toLocaleString('tr-TR') : ''"></small>
                            </div>
                            <div class="mt-2">
                                <!-- ko if: unitPrice -->
                                <span class="fs-5 fw-bold" data-bind="text: unitPrice.toLocaleString('tr-TR', {minimumFractionDigits: 2})"></span>
                                <small class="text-muted" data-bind="text: currency || 'TRY'"></small>
                                <!-- /ko -->
                                <!-- ko if: quantity -->
                                <span class="text-muted mx-2">|</span>
                                <span data-bind="text: quantity"></span> <span data-bind="text: unit || 'adet'"></span>
                                <!-- /ko -->
                                <!-- ko if: leadTimeDays -->
                                <span class="text-muted mx-2">|</span>
                                <span data-bind="text: leadTimeDays"></span> gun teslimat
                                <!-- /ko -->
                            </div>
                            <!-- ko if: notes -->
                            <div class="mt-2 small text-muted">
                                <i class="bi bi-chat-left-text me-1"></i>
                                <span data-bind="text: notes"></span>
                            </div>
                            <!-- /ko -->
                            <!-- ko if: rejectionReason -->
                            <div class="mt-2 small text-danger">
                                <i class="bi bi-exclamation-circle me-1"></i>
                                <span data-bind="text: rejectionReason"></span>
                            </div>
                            <!-- /ko -->
                        </div>
                    </div>
                    <!-- /ko -->
                </div>

                <!-- No rounds yet -->
                <div data-bind="visible: !negotiationHistory() || (negotiationHistory().rounds && negotiationHistory().rounds.length === 0)" class="text-center py-4 text-muted">
                    <i class="bi bi-chat-dots fs-1"></i>
                    <p class="mt-2">Henuz pazarlik turu yok.</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                <!-- Actions based on turn -->
                <div data-bind="with: negotiationSummary">
                    <!-- ko if: isNegotiationActive && isMyTurn -->
                    <button type="button" class="btn btn-outline-danger"
                            data-bind="click: function() { $root.rejectNegotiation(); }">
                        <i class="bi bi-x-lg me-1"></i> Reddet
                    </button>
                    <button type="button" class="btn btn-info"
                            data-bind="click: function() { $root.openCounterOfferModal(); }">
                        <i class="bi bi-arrow-repeat me-1"></i> Karsi Teklif
                    </button>
                    <button type="button" class="btn btn-success"
                            data-bind="click: function() { $root.acceptNegotiation(); }">
                        <i class="bi bi-check-lg me-1"></i> Kabul Et
                    </button>
                    <!-- /ko -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Counter Offer Modal -->
<div class="modal fade" id="counterOfferModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
