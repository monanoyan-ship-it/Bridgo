@using Bridgo.Extensions
@{
    ViewData["Title"] = Html.T("ServiceJobs.Title.Customs", "Gumruk Islerim").ToString();
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
}

<div id="my-customs-jobs-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1"><i class="bi bi-building-check text-warning"></i> @Html.T("ServiceJobs.Title.Customs", "Gumruk Islerim")</h4>
            <p class="text-muted mb-0">@Html.T("ServiceJobs.Subtitle.Customs", "Kabul edilen gumruk isleriniz ve beyanname yonetimi")</p>
        </div>
        <button class="btn btn-outline-primary btn-sm" data-bind="click: loadJobs">
            <i class="bi bi-arrow-clockwise"></i> @Html.T("Common.Refresh", "Yenile")
        </button>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link" href="#" data-bind="css: { active: currentTab() === 'active' }, click: function() { currentTab('active'); }">
                <i class="bi bi-play-circle"></i> @Html.T("ServiceJobs.Tab.Active", "Aktif Isler")
                <span class="badge bg-primary ms-1" data-bind="text: activeJobs().length, visible: activeJobs().length > 0"></span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="#" data-bind="css: { active: currentTab() === 'completed' }, click: function() { currentTab('completed'); }">
                <i class="bi bi-check-circle"></i> @Html.T("ServiceJobs.Tab.Completed", "Tamamlananlar")
                <span class="badge bg-success ms-1" data-bind="text: completedJobs().length, visible: completedJobs().length > 0"></span>
            </a>
        </li>
    </ul>

    <!-- Loading -->
    <div data-bind="visible: isLoading()" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">@Html.T("Common.Loading", "Yukleniyor...")</p>
    </div>

    <!-- Active Jobs Tab -->
    <div data-bind="visible: !isLoading() && currentTab() === 'active'">
        <!-- Empty State -->
        <div data-bind="visible: activeJobs().length === 0" class="text-center py-5">
            <i class="bi bi-inbox display-1 text-muted"></i>
            <p class="mt-3 text-muted">@Html.T("ServiceJobs.Empty.Active.Customs", "Aktif gumruk isiniz bulunmuyor")</p>
            <a href="/Services/Customs" class="btn btn-outline-primary">
                <i class="bi bi-search me-1"></i> @Html.T("ServiceJobs.BrowseRequests", "Taleplere Goz At")
            </a>
        </div>

        <!-- Job Cards -->
        <div class="row" data-bind="foreach: activeJobs">
            <div class="col-lg-6 mb-3">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge" data-bind="text: statusName, css: statusCssClass"></span>
                            <span class="badge bg-info ms-1" data-bind="text: customsOperationTypeName, visible: customsOperationTypeName"></span>
                            <span class="fw-bold ms-2" data-bind="text: orderNumber"></span>
                        </div>
                        <small class="text-muted" data-bind="text: $parent.formatDate(createdAt)"></small>
                    </div>
                    <div class="card-body">
                        <div class="row mb-2">
                            <div class="col-6">
                                <small class="text-muted d-block">@Html.T("Common.Buyer", "Alici")</small>
                                <span data-bind="text: buyerName"></span>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block">@Html.T("Common.Seller", "Satici")</small>
                                <span data-bind="text: sellerName"></span>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-6">
                                <small class="text-muted d-block">@Html.T("Common.Destination", "Hedef")</small>
                                <span data-bind="text: (destinationCity || '') + (destinationCountry ? ', ' + destinationCountry : '')"></span>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block">@Html.T("Common.Amount", "Tutar")</small>
                                <span class="fw-bold text-success" data-bind="text: $parent.formatCurrency(netAmount, currency)"></span>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top-0">
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary flex-fill" data-bind="click: function() { $parent.viewDetail($data); }">
                                <i class="bi bi-eye"></i> @Html.T("Common.Detail", "Detay")
                            </button>
                            <button class="btn btn-sm btn-warning flex-fill" data-bind="click: function() { $parent.openDeclarationModal($data); }">
                                <i class="bi bi-file-earmark-text"></i> @Html.T("Customs.Declaration", "Beyanname")
                            </button>
                            <button class="btn btn-sm btn-success" data-bind="click: function() { $parent.completeJob($data); }">
                                <i class="bi bi-check-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Completed Jobs Tab -->
    <div data-bind="visible: !isLoading() && currentTab() === 'completed'">
        <!-- Empty State -->
        <div data-bind="visible: completedJobs().length === 0" class="text-center py-5">
            <i class="bi bi-check-circle display-1 text-muted"></i>
            <p class="mt-3 text-muted">@Html.T("ServiceJobs.Empty.Completed.Customs", "Tamamlanmis gumruk isiniz bulunmuyor")</p>
        </div>

        <!-- Job List -->
        <div class="table-responsive" data-bind="visible: completedJobs().length > 0">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>@Html.T("Common.Order", "Siparis")</th>
                        <th>@Html.T("Customs.OperationType", "Islem Tipi")</th>
                        <th>@Html.T("Common.Buyer", "Alici")</th>
                        <th>@Html.T("Common.Amount", "Tutar")</th>
                        <th>@Html.T("ServiceJobs.Completed", "Tamamlanma")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody data-bind="foreach: completedJobs">
                    <tr>
                        <td><span class="fw-bold" data-bind="text: orderNumber"></span></td>
                        <td><span class="badge bg-info" data-bind="text: customsOperationTypeName || '-'"></span></td>
                        <td data-bind="text: buyerName"></td>
                        <td><span class="text-success" data-bind="text: $parent.formatCurrency(netAmount, currency)"></span></td>
                        <td data-bind="text: $parent.formatDate(taskCompletedAt)"></td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary" data-bind="click: function() { $parent.viewDetail($data); }">
                                <i class="bi bi-eye"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Detail Modal -->
    <div class="modal fade" id="jobDetailModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-building-check text-warning me-2"></i>
                        @Html.T("ServiceJobs.Modal.Detail", "Is Detayi") - <span data-bind="text: selectedJob()?.orderNumber"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" data-bind="with: selectedJob">
                    <!-- Durum -->
                    <div class="alert" data-bind="css: 'alert-' + (status === 3 ? 'success' : 'primary')">
                        <i class="bi" data-bind="css: status === 3 ? 'bi-check-circle' : 'bi-play-circle'"></i>
                        <span data-bind="text: statusName"></span>
                        <span class="badge bg-info ms-2" data-bind="text: customsOperationTypeName, visible: customsOperationTypeName"></span>
                    </div>

                    <!-- Firma Bilgileri -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header py-2"><small class="fw-bold">@Html.T("ServiceJobs.BuyerCompany", "Alici Firma")</small></div>
                                <div class="card-body py-2">
                                    <p class="mb-1" data-bind="text: buyerName"></p>
                                    <small class="text-muted" data-bind="text: buyerEmail"></small><br/>
                                    <small class="text-muted" data-bind="text: buyerPhone"></small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header py-2"><small class="fw-bold">@Html.T("ServiceJobs.SellerCompany", "Satici Firma")</small></div>
                                <div class="card-body py-2">
                                    <p class="mb-1" data-bind="text: sellerName"></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Gumruk Bilgileri -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">@Html.T("ServiceJobs.CargoValue", "Kargo Degeri")</label>
                            <p class="mb-0" data-bind="text: cargoValue ? $parent.formatCurrency(cargoValue, 'USD') : '-'"></p>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">@Html.T("ServiceJobs.Weight", "Agirlik")</label>
                            <p class="mb-0" data-bind="text: weightKg ? weightKg + ' kg' : '-'"></p>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">@Html.T("ServiceJobs.HSCode", "HS Kodu")</label>
                            <p class="mb-0" data-bind="text: hsCode || '-'"></p>
                        </div>
                    </div>

                    <!-- Odeme -->
                    <div class="card bg-light">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4">
                                    <small class="text-muted d-block">@Html.T("ServiceJobs.GrossAmount", "Brut Tutar")</small>
                                    <span class="fw-bold" data-bind="text: $parent.formatCurrency(amount, currency)"></span>
                                </div>
                                <div class="col-md-4">
                                    <small class="text-muted d-block">@Html.T("ServiceJobs.Commission", "Komisyon")</small>
                                    <span class="text-danger" data-bind="text: '-' + $parent.formatCurrency(commissionAmount, currency)"></span>
                                </div>
                                <div class="col-md-4">
                                    <small class="text-muted d-block">@Html.T("ServiceJobs.NetAmount", "Net Tutar")</small>
                                    <span class="fw-bold text-success" data-bind="text: $parent.formatCurrency(netAmount, currency)"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Close", "Kapat")</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Declaration Modal (Evrim Integration) -->
    <div class="modal fade" id="declarationModal" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title">
                        <i class="bi bi-file-earmark-text me-2"></i>
                        @Html.T("Customs.Declarations", "Gumruk Beyannameleri") - <span data-bind="text: selectedJobForDeclaration()?.orderNumber"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Loading -->
                    <div data-bind="visible: isLoadingDeclarations()" class="text-center py-4">
                        <div class="spinner-border text-warning"></div>
                        <p class="mt-2 text-muted">@Html.T("Customs.LoadingDeclarations", "Beyannameler yukleniyor...")</p>
                    </div>

                    <div data-bind="visible: !isLoadingDeclarations()">
                        <!-- Create Declaration Buttons -->
                        <div class="mb-4">
                            <div class="btn-group">
                                <button class="btn btn-outline-primary" data-bind="click: function() { createDeclaration('export'); }, disable: isCreatingDeclaration()">
                                    <i class="bi bi-box-arrow-up-right"></i> @Html.T("Customs.ExportDeclaration", "Ihracat Beyannamesi")
                                </button>
                                <button class="btn btn-outline-info" data-bind="click: function() { createDeclaration('import'); }, disable: isCreatingDeclaration()">
                                    <i class="bi bi-box-arrow-in-down-left"></i> @Html.T("Customs.ImportDeclaration", "Ithalat Beyannamesi")
                                </button>
                                <button class="btn btn-outline-success" data-bind="click: function() { createDeclaration('etgb'); }, disable: isCreatingDeclaration()">
                                    <i class="bi bi-envelope"></i> ETGB
                                </button>
                            </div>
                            <span data-bind="visible: isCreatingDeclaration()" class="ms-2">
                                <span class="spinner-border spinner-border-sm"></span> @Html.T("Common.Creating", "Olusturuluyor...")
                            </span>
                        </div>

                        <!-- Declarations List -->
                        <div data-bind="visible: declarations().length === 0" class="text-center py-4 bg-light rounded">
                            <i class="bi bi-file-earmark display-4 text-muted"></i>
                            <p class="mt-2 text-muted">@Html.T("Customs.NoDeclarations", "Henuz beyanname olusturulmamis")</p>
                        </div>

                        <div class="table-responsive" data-bind="visible: declarations().length > 0">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>@Html.T("Common.Type", "Tip")</th>
                                        <th>@Html.T("Customs.EvrimFileNo", "Evrim Dosya No")</th>
                                        <th>@Html.T("Customs.DeclarationNo", "Beyanname No")</th>
                                        <th>@Html.T("Common.Status", "Durum")</th>
                                        <th>@Html.T("Customs.RegistrationDate", "Tescil Tarihi")</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody data-bind="foreach: declarations">
                                    <tr>
                                        <td>
                                            <i data-bind="css: declarationTypeIcon"></i>
                                            <span data-bind="text: declarationTypeText"></span>
                                        </td>
                                        <td><code data-bind="text: evrimDosyaNo || '-'"></code></td>
                                        <td><span class="fw-bold" data-bind="text: declarationNumber || '-'"></span></td>
                                        <td>
                                            <span class="badge" data-bind="text: statusText, css: statusCssClass"></span>
                                        </td>
                                        <td data-bind="text: $parent.formatDate(registrationDate)"></td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-primary" title="@Html.T("Common.Sync", "Senkronize Et")"
                                                    data-bind="click: function() { $parent.syncDeclaration($data); }, disable: $parent.isSyncing()">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Close", "Kapat")</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Dashboard/MyCustomsJobs.js" asp-append-version="true"></script>
}
