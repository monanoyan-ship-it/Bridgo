@using Bridgo.Extensions
@{
    ViewData["Title"] = Html.T("Module.ProposalManagement", "Teklif Yonetimi").ToString();
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
}

@section Styles {
    <style>
        .stats-card {
            border-left: 4px solid;
            transition: transform 0.2s;
        }
        .stats-card:hover {
            transform: translateY(-2px);
        }
        .stats-card.primary { border-color: var(--bs-primary); }
        .stats-card.warning { border-color: var(--bs-warning); }
        .stats-card.success { border-color: var(--bs-success); }
        .stats-card.danger { border-color: var(--bs-danger); }
        .stats-card.info { border-color: var(--bs-info); }

        .proposal-row {
            transition: background-color 0.2s;
        }
        .proposal-row:hover {
            background-color: rgba(var(--bs-primary-rgb), 0.05);
        }

        .source-badge {
            font-size: 0.7rem;
            padding: 0.2rem 0.5rem;
        }

        .source-image {
            width: 48px;
            height: 48px;
            object-fit: cover;
            border-radius: 4px;
        }

        .source-placeholder {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--bs-light);
            border-radius: 4px;
            color: var(--bs-secondary);
        }
    </style>
}

<div class="container-fluid" data-bind="with: vm">
    <!-- Baslik -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">
                <i class="bi bi-file-earmark-text text-primary me-2"></i>
                @Html.T("Module.ProposalManagement", "Teklif Yonetimi")
            </h4>
            <p class="text-muted mb-0">@Html.T("Proposals.Subtitle", "Verdiginiz tum teklifleri tek yerden yonetin")</p>
        </div>
    </div>

    <!-- Istatistik Kartlari -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="card stats-card primary h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="text-muted mb-1">@Html.T("Proposals.Stats.Total", "Toplam Teklif")</h6>
                            <h3 class="mb-0" data-bind="text: stats().totalProposals">0</h3>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-file-earmark-text fs-1 text-primary opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card stats-card warning h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="text-muted mb-1">@Html.T("Proposals.Stats.Pending", "Bekleyen")</h6>
                            <h3 class="mb-0" data-bind="text: stats().pendingProposals">0</h3>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-hourglass-split fs-1 text-warning opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card stats-card success h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="text-muted mb-1">@Html.T("Proposals.Stats.Accepted", "Kabul Edilen")</h6>
                            <h3 class="mb-0" data-bind="text: stats().acceptedProposals">0</h3>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-check-circle fs-1 text-success opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card stats-card info h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="text-muted mb-1">@Html.T("Proposals.Stats.ThisMonth", "Bu Ay")</h6>
                            <h3 class="mb-0" data-bind="text: stats().thisMonthProposals">0</h3>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-calendar-check fs-1 text-info opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab Navigation -->
    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item">
            <button class="nav-link" data-bind="css: { active: selectedTab() === 'all' }, click: function() { selectTab('all'); }">
                <i class="bi bi-list-ul me-1"></i>
                @Html.T("Proposals.Tab.All", "Tumu")
                <span class="badge bg-secondary ms-1" data-bind="text: stats().totalProposals">0</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bind="css: { active: selectedTab() === 'inquiry' }, click: function() { selectTab('inquiry'); }">
                <i class="bi bi-box me-1"></i>
                @Html.T("Proposals.Tab.Inquiry", "Urun Teklifleri")
                <span class="badge bg-primary ms-1" data-bind="text: stats().inquiryProposals">0</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bind="css: { active: selectedTab() === 'demand' }, click: function() { selectTab('demand'); }">
                <i class="bi bi-megaphone me-1"></i>
                @Html.T("Proposals.Tab.Demand", "Talep Teklifleri")
                <span class="badge bg-info ms-1" data-bind="text: stats().demandProposals">0</span>
            </button>
        </li>
    </ul>

    <!-- Filtre -->
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control"
                               placeholder="@Html.T("Common.Search", "Ara...")"
                               data-bind="value: searchText, valueUpdate: 'afterkeydown'">
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm" data-bind="value: selectedStatus">
                        <option value="">@Html.T("Common.AllStatuses", "Tum Durumlar")</option>
                        <option value="1">@Html.T("Status.Pending", "Beklemede")</option>
                        <option value="2">@Html.T("Status.Viewed", "Goruldu")</option>
                        <option value="3">@Html.T("Status.Accepted", "Kabul Edildi")</option>
                        <option value="4">@Html.T("Status.Rejected", "Reddedildi")</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-sm btn-outline-secondary w-100" data-bind="click: resetFilters">
                        <i class="bi bi-arrow-counterclockwise"></i> @Html.T("Common.Reset", "Sifirla")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Teklif Listesi -->
    <div class="card">
        <div class="card-body p-0">
            <!-- Loading -->
            <div class="text-center py-5" data-bind="visible: isLoading">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">@Html.T("Common.Loading", "Yukleniyor...")</span>
                </div>
            </div>

            <!-- Bos -->
            <div class="text-center py-5" data-bind="visible: !isLoading() && proposals().length === 0">
                <i class="bi bi-inbox fs-1 text-muted"></i>
                <p class="text-muted mt-2">@Html.T("Proposals.Empty", "Henuz teklif vermediniz")</p>
            </div>

            <!-- Liste -->
            <div class="table-responsive" data-bind="visible: !isLoading() && proposals().length > 0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;"></th>
                            <th>@Html.T("Proposals.Source", "Kaynak")</th>
                            <th>@Html.T("Common.Buyer", "Alici")</th>
                            <th class="text-end">@Html.T("Common.Price", "Fiyat")</th>
                            <th class="text-center">@Html.T("Common.Quantity", "Miktar")</th>
                            <th class="text-center">@Html.T("Common.Status", "Durum")</th>
                            <th>@Html.T("Common.Date", "Tarih")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: proposals">
                        <tr class="proposal-row">
                            <!-- Gorsel -->
                            <td class="align-middle">
                                <!-- ko if: sourceImageUrl -->
                                <img data-bind="attr: { src: sourceImageUrl, alt: sourceTitle }" class="source-image">
                                <!-- /ko -->
                                <!-- ko ifnot: sourceImageUrl -->
                                <div class="source-placeholder">
                                    <i class="bi" data-bind="css: sourceType === 'inquiry' ? 'bi-box' : 'bi-megaphone'"></i>
                                </div>
                                <!-- /ko -->
                            </td>
                            <!-- Kaynak -->
                            <td class="align-middle">
                                <div class="d-flex flex-column">
                                    <span class="fw-medium" data-bind="text: sourceTitle"></span>
                                    <small>
                                        <span class="badge source-badge"
                                              data-bind="text: sourceType === 'inquiry' ? 'Urun Istegi' : 'Talep',
                                                         css: sourceType === 'inquiry' ? 'bg-primary' : 'bg-info'"></span>
                                    </small>
                                </div>
                            </td>
                            <!-- Alici -->
                            <td class="align-middle">
                                <span data-bind="text: buyerCompanyName || '-'"></span>
                            </td>
                            <!-- Fiyat -->
                            <td class="align-middle text-end">
                                <!-- ko if: totalPrice -->
                                <span class="fw-bold" data-bind="text: formatMoney(totalPrice, currency)"></span>
                                <!-- /ko -->
                                <!-- ko if: unitPrice && !totalPrice -->
                                <span data-bind="text: formatMoney(unitPrice, currency) + '/birim'"></span>
                                <!-- /ko -->
                                <!-- ko ifnot: totalPrice || unitPrice -->
                                <span class="text-muted">-</span>
                                <!-- /ko -->
                            </td>
                            <!-- Miktar -->
                            <td class="align-middle text-center">
                                <!-- ko if: offeredQuantity -->
                                <span data-bind="text: offeredQuantity + (offeredUnit ? ' ' + offeredUnit : '')"></span>
                                <!-- /ko -->
                                <!-- ko ifnot: offeredQuantity -->
                                <span class="text-muted">-</span>
                                <!-- /ko -->
                            </td>
                            <!-- Durum -->
                            <td class="align-middle text-center">
                                <span class="badge" data-bind="text: statusText, css: getStatusBadgeClass(status)"></span>
                            </td>
                            <!-- Tarih -->
                            <td class="align-middle">
                                <small class="text-muted" data-bind="text: formatDate(createdAt)"></small>
                                <!-- ko if: isReadByBuyer -->
                                <br><small class="text-success"><i class="bi bi-check2-all"></i> Goruldu</small>
                                <!-- /ko -->
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="card-footer bg-white" data-bind="visible: totalPages() > 1">
                <nav>
                    <ul class="pagination pagination-sm justify-content-center mb-0">
                        <li class="page-item" data-bind="css: { disabled: currentPage() === 1 }">
                            <a class="page-link" href="#" data-bind="click: function() { goToPage(currentPage() - 1); }">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        <!-- ko foreach: pageNumbers -->
                        <li class="page-item" data-bind="css: { active: $data === $parent.currentPage() }">
                            <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                        </li>
                        <!-- /ko -->
                        <li class="page-item" data-bind="css: { disabled: currentPage() === totalPages() }">
                            <a class="page-link" href="#" data-bind="click: function() { goToPage(currentPage() + 1); }">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Dashboard/Proposals.js"></script>
}
