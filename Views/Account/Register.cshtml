@{
    ViewData["Title"] = Html.T("Account.Register.Title", "Kayit Ol").ToString();
    Layout = "_Layout";

    var capabilities = ViewBag.Capabilities as List<dynamic> ?? new List<dynamic>();
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div id="register-app">
                <!-- Progress Bar -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="small" data-bind="css: { 'text-primary fw-bold': currentStep() >= 1 }">1. @Html.T("Account.Register.Step.Account", "Hesap")</span>
                        <span class="small" data-bind="css: { 'text-primary fw-bold': currentStep() >= 2 }">2. @Html.T("Account.Register.Step.FindCompany", "Firma Ara")</span>
                        <span class="small" data-bind="css: { 'text-primary fw-bold': currentStep() >= 3, 'text-muted': isJoiningExisting() }">3. @Html.T("Account.Register.Step.Company", "Firma")</span>
                        <span class="small" data-bind="css: { 'text-primary fw-bold': currentStep() >= 4, 'text-muted': isJoiningExisting() }">4. @Html.T("Account.Register.Step.Address", "Adres")</span>
                        <span class="small" data-bind="css: { 'text-primary fw-bold': currentStep() >= 5, 'text-muted': isJoiningExisting() }">5. @Html.T("Account.Register.Step.Usage", "Kullanim")</span>
                        <span class="small" data-bind="css: { 'text-primary fw-bold': currentStep() >= 6, 'text-muted': isJoiningExisting() }">6. @Html.T("Account.Register.Step.Countries", "Ulkeler")</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar" data-bind="style: { width: progressPercent() + '%' }"></div>
                    </div>
                </div>

                <div class="card shadow-sm border-0">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-person-plus me-2"></i>
                            <span data-bind="text: stepTitle"></span>
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <!-- Error Message -->
                        <div data-bind="visible: errorMessage" class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            <span data-bind="text: errorMessage"></span>
                        </div>

                        <!-- ADIM 1: HESAP BILGILERI -->
                        <div data-bind="visible: currentStep() === 1" style="display: block;">
                            <p class="text-muted mb-4">@Html.T("Account.Register.Step1.Description", "Hesap bilgilerinizi girin")</p>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">@Html.T("Account.Fields.FirstName", "Ad") <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" data-bind="value: form.firstName, css: { 'is-invalid': errors.firstName }" placeholder="@Html.T("Account.Fields.FirstName.Placeholder", "Adiniz")" />
                                    <div class="invalid-feedback" data-bind="text: errors.firstName"></div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">@Html.T("Account.Fields.LastName", "Soyad") <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" data-bind="value: form.lastName, css: { 'is-invalid': errors.lastName }" placeholder="@Html.T("Account.Fields.LastName.Placeholder", "Soyadiniz")" />
                                    <div class="invalid-feedback" data-bind="text: errors.lastName"></div>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">@Html.T("Account.Fields.Email", "E-posta") <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                    <input type="email" class="form-control" data-bind="value: form.email, css: { 'is-invalid': errors.email }" placeholder="@Html.T("Account.Fields.Email.Placeholder", "ornek@sirket.com")" />
                                </div>
                                <div class="invalid-feedback d-block" data-bind="text: errors.email, visible: errors.email"></div>
                                <small class="text-muted">@Html.T("Account.Register.EmailHint", "Kurumsal e-posta kullanmaniz tavsiye edilir")</small>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">@Html.T("Account.Fields.Password", "Sifre") <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                        <input type="password" class="form-control" data-bind="value: form.password, css: { 'is-invalid': errors.password }" placeholder="@Html.T("Account.Fields.Password.Placeholder", "En az 6 karakter")" />
                                    </div>
                                    <div class="invalid-feedback d-block" data-bind="text: errors.password, visible: errors.password"></div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">@Html.T("Account.Fields.ConfirmPassword", "Sifre Tekrar") <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                        <input type="password" class="form-control" data-bind="value: form.confirmPassword, css: { 'is-invalid': errors.confirmPassword }" placeholder="@Html.T("Account.Fields.ConfirmPassword.Placeholder", "Sifrenizi tekrar girin")" />
                                    </div>
                                    <div class="invalid-feedback d-block" data-bind="text: errors.confirmPassword, visible: errors.confirmPassword"></div>
                                </div>
                            </div>
                        </div>

                        <!-- ADIM 2: FIRMA ARAMA -->
                        <div data-bind="visible: currentStep() === 2" style="display: none;">
                            <!-- Domain eslesmesi bulundu -->
                            <!-- ko if: domainMatchVendor() -->
                            <div>
                                <div class="text-center py-4">
                                    <i class="bi bi-building-check text-success" style="font-size: 4rem;"></i>
                                    <h4 class="mt-3">@Html.T("Account.Register.DomainMatch.Title", "Firmanizi Bulduk!")</h4>
                                    <p class="text-muted">
                                        @Html.T("Account.Register.DomainMatch.Description", "E-posta adresinize gore asagidaki firmaya kayit olabilirsiniz:")
                                    </p>
                                    <div class="card mx-auto" style="max-width: 400px;">
                                        <div class="card-body" data-bind="with: domainMatchVendor">
                                            <h5 class="card-title mb-1" data-bind="text: companyName"></h5>
                                            <p class="card-text text-muted small" data-bind="text: city || ''"></p>
                                        </div>
                                    </div>
                                    <div class="mt-4">
                                        <button type="button" class="btn btn-success btn-lg me-2" data-bind="click: joinDomainMatchVendor, disable: isLoading">
                                            <span data-bind="visible: !isLoading()">
                                                <i class="bi bi-check-circle me-1"></i> @Html.T("Account.Register.JoinCompany", "Bu Firmaya Katil")
                                            </span>
                                            <span data-bind="visible: isLoading()">
                                                <span class="spinner-border spinner-border-sm"></span>
                                            </span>
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary" data-bind="click: skipDomainMatch">
                                            @Html.T("Account.Register.DifferentCompany", "Baska Firma")
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <!-- /ko -->

                            <!-- Domain eslesmesi yok - Firma arama -->
                            <div data-bind="visible: !domainMatchVendor() && !domainCheckDone()">
                                <div class="text-center py-4">
                                    <div class="spinner-border text-primary" role="status"></div>
                                    <p class="mt-2 text-muted">@Html.T("Account.Register.CheckingDomain", "Firma kontrol ediliyor...")</p>
                                </div>
                            </div>

                            <!-- Manuel firma arama -->
                            <div data-bind="visible: !domainMatchVendor() && domainCheckDone()">
                                <p class="text-muted mb-4">@Html.T("Account.Register.Step2.SearchDescription", "Firmaniz sistemde kayitli mi? Arama yapin veya yeni firma olusturun.")</p>

                                <div class="mb-4">
                                    <label class="form-label">@Html.T("Account.Register.SearchCompany", "Firma Ara")</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                                        <input type="text" class="form-control"
                                               data-bind="value: searchQuery, event: { keyup: searchCompanies }"
                                               placeholder="@Html.T("Account.Register.SearchCompany.Placeholder", "Firma adini yazin...")" />
                                    </div>
                                    <small class="text-muted">@Html.T("Account.Register.SearchCompany.Hint", "En az 2 karakter girin")</small>
                                </div>

                                <!-- Arama sonuclari -->
                                <div data-bind="visible: searchResults().length > 0" class="mb-4">
                                    <h6 class="text-muted mb-2">@Html.T("Account.Register.SearchResults", "Bulunan Firmalar")</h6>
                                    <div class="list-group" data-bind="foreach: searchResults">
                                        <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                                data-bind="click: $parent.selectCompanyToJoin">
                                            <div>
                                                <strong data-bind="text: companyName"></strong>
                                                <br><small class="text-muted" data-bind="text: city || ''"></small>
                                            </div>
                                            <i class="bi bi-chevron-right"></i>
                                        </button>
                                    </div>
                                </div>

                                <!-- Secilen firma -->
                                <!-- ko if: selectedVendorToJoin() -->
                                <div class="mb-4">
                                    <div class="alert alert-info">
                                        <div class="d-flex justify-content-between align-items-center" data-bind="with: selectedVendorToJoin">
                                            <div>
                                                <i class="bi bi-building me-2"></i>
                                                <strong data-bind="text: companyName"></strong>
                                                <span class="text-muted ms-2" data-bind="text: city"></span>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-outline-danger" data-bind="click: $parent.clearSelectedVendor">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">@Html.T("Account.Register.JoinMessage", "Mesaj (Opsiyonel)")</label>
                                        <textarea class="form-control" rows="2" data-bind="value: joinMessage"
                                                  placeholder="@Html.T("Account.Register.JoinMessage.Placeholder", "Firma yoneticisine iletmek istediginiz mesaj...")"></textarea>
                                    </div>
                                </div>
                                <!-- /ko -->

                                <!-- Firma bulunamadi -->
                                <div class="text-center mt-4 pt-4 border-top">
                                    <p class="text-muted">@Html.T("Account.Register.CompanyNotFound", "Firmaniz listede yok mu?")</p>
                                    <button type="button" class="btn btn-outline-primary" data-bind="click: createNewCompany">
                                        <i class="bi bi-plus-circle me-1"></i> @Html.T("Account.Register.CreateNewCompany", "Yeni Firma Olustur")
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- ADIM 3: FIRMA BILGILERI (Yeni firma) -->
                        <div data-bind="visible: currentStep() === 3" style="display: none;">
                            <p class="text-muted mb-4">@Html.T("Account.Register.Step3.Description", "Firma bilgilerinizi girin")</p>
                            <div class="mb-3">
                                <label class="form-label">@Html.T("Company.Fields.CompanyName", "Firma Adi") <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" data-bind="value: form.companyName, css: { 'is-invalid': errors.companyName }" placeholder="@Html.T("Company.Fields.CompanyName.Placeholder", "Sirket Adi Ltd. Sti.")" />
                                <div class="invalid-feedback" data-bind="text: errors.companyName"></div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">@Html.T("Company.Fields.Phone", "Telefon")</label>
                                    <div class="input-group">
                                        <select class="form-select" style="max-width: 140px;" data-bind="value: form.phoneCountryCode, options: phoneCountryCodes, optionsText: 'label', optionsValue: 'value'">
                                        </select>
                                        <input type="tel" class="form-control" data-bind="value: form.phone" placeholder="212 123 4567" />
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">@Html.T("Company.Fields.Website", "Website")</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-globe"></i></span>
                                        <input type="url" class="form-control" data-bind="value: form.website" placeholder="https://www.sirket.com" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ADIM 4: ADRES BILGILERI -->
                        <div data-bind="visible: currentStep() === 4" style="display: none;">
                            <p class="text-muted mb-4">@Html.T("Account.Register.Step4.Description", "Merkez adresinizi girin")</p>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">@Html.T("Address.Fields.Country", "Ulke") <span class="text-danger">*</span></label>
                                    <select class="form-select" data-bind="value: form.countryId, options: addressCountries, optionsText: 'name', optionsValue: 'id', optionsCaption: '@Html.T("Common.Select", "Secin...")', event: { change: onAddressCountryChange }, css: { 'is-invalid': errors.countryId }">
                                    </select>
                                    <div class="invalid-feedback" data-bind="text: errors.countryId"></div>
                                </div>
                                <div class="col-md-6 mb-3" data-bind="visible: addressStates().length > 0">
                                    <label class="form-label">@Html.T("Address.Fields.State", "Eyalet") <span class="text-danger">*</span></label>
                                    <select class="form-select" data-bind="value: form.stateId, options: addressStates, optionsText: 'name', optionsValue: 'id', optionsCaption: '@Html.T("Common.Select", "Secin...")', css: { 'is-invalid': errors.stateId }">
                                    </select>
                                    <div class="invalid-feedback" data-bind="text: errors.stateId"></div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">@Html.T("Address.Fields.City", "Il") <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" data-bind="value: form.city, css: { 'is-invalid': errors.city }" placeholder="@Html.T("Address.Fields.City.Placeholder", "Istanbul")" />
                                    <div class="invalid-feedback" data-bind="text: errors.city"></div>
                                </div>
                                <div class="col-md-8 mb-3">
                                    <label class="form-label">@Html.T("Address.Fields.District", "Ilce") <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" data-bind="value: form.district, css: { 'is-invalid': errors.district }" placeholder="@Html.T("Address.Fields.District.Placeholder", "Kadikoy")" />
                                    <div class="invalid-feedback" data-bind="text: errors.district"></div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-8 mb-3">
                                    <label class="form-label">@Html.T("Address.Fields.AddressLine", "Adres") <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" data-bind="value: form.addressLine, css: { 'is-invalid': errors.addressLine }" placeholder="@Html.T("Address.Fields.AddressLine.Placeholder", "Sokak, Bina No, Kat, Daire")" />
                                    <div class="invalid-feedback" data-bind="text: errors.addressLine"></div>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">@Html.T("Address.Fields.PostalCode", "Posta Kodu")</label>
                                    <input type="text" class="form-control" data-bind="value: form.postalCode" placeholder="34000" maxlength="10" />
                                </div>
                            </div>
                        </div>

                        <!-- ADIM 5: KULLANIM AMACI -->
                        <div data-bind="visible: currentStep() === 5" style="display: none;">
                            <p class="text-muted mb-4">@Html.T("Account.Register.Step5.Description", "Bridgo'i nasil kullanacaksiniz? (Birden fazla secebilirsiniz)")</p>

                            <div class="row">
                                <!-- Alici -->
                                <div class="col-md-6 mb-3">
                                    <div class="card h-100 cursor-pointer" data-bind="click: function() { toggleCapability('buyer') }, css: { 'border-primary bg-primary bg-opacity-10': isCapabilitySelected('buyer') }">
                                        <div class="card-body text-center p-4">
                                            <i class="bi bi-cart text-primary" style="font-size: 2.5rem;"></i>
                                            <h5 class="mt-3 mb-2">@Html.T("Capability.Buyer", "Alici")</h5>
                                            <p class="text-muted small mb-0">@Html.T("Capability.Buyer.Description", "Urun ve hizmet satin almak istiyorum")</p>
                                            <div class="mt-2" data-bind="visible: isCapabilitySelected('buyer')">
                                                <i class="bi bi-check-circle-fill text-primary"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Satici -->
                                <div class="col-md-6 mb-3">
                                    <div class="card h-100 cursor-pointer" data-bind="click: function() { toggleCapability('seller') }, css: { 'border-primary bg-primary bg-opacity-10': isCapabilitySelected('seller') }">
                                        <div class="card-body text-center p-4">
                                            <i class="bi bi-shop text-success" style="font-size: 2.5rem;"></i>
                                            <h5 class="mt-3 mb-2">@Html.T("Capability.Seller", "Satici")</h5>
                                            <p class="text-muted small mb-0">@Html.T("Capability.Seller.Description", "Urun ve hizmet satmak istiyorum")</p>
                                            <div class="mt-2" data-bind="visible: isCapabilitySelected('seller')">
                                                <i class="bi bi-check-circle-fill text-primary"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Hizmet Saglayici -->
                            <div class="card mt-3" data-bind="css: { 'border-primary': hasAnyServiceProvider() }">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0"><i class="bi bi-gear me-2"></i>@Html.T("Capability.ServiceProvider", "Hizmet Saglayici")</h6>
                                </div>
                                <div class="card-body">
                                    <p class="text-muted small mb-3">@Html.T("Capability.ServiceProvider.Question", "Hangi hizmetleri sagliyorsunuz?")</p>
                                    <div class="row">
                                        <!-- Tasimaci -->
                                        <div class="col-md-4 mb-2">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="cap-carrier"
                                                       data-bind="checked: isCapabilitySelected('carrier'), click: function() { toggleCapability('carrier'); return true; }" />
                                                <label class="form-check-label" for="cap-carrier">
                                                    <i class="bi bi-truck text-info me-1"></i> @Html.T("Capability.Carrier", "Tasimaci / Lojistik")
                                                </label>
                                            </div>
                                        </div>
                                        <!-- Sigorta -->
                                        <div class="col-md-4 mb-2">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="cap-insurance"
                                                       data-bind="checked: isCapabilitySelected('insurance'), click: function() { toggleCapability('insurance'); return true; }" />
                                                <label class="form-check-label" for="cap-insurance">
                                                    <i class="bi bi-shield-check text-warning me-1"></i> @Html.T("Capability.Insurance", "Sigorta")
                                                </label>
                                            </div>
                                        </div>
                                        <!-- Gumruk -->
                                        <div class="col-md-4 mb-2">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="cap-customs"
                                                       data-bind="checked: isCapabilitySelected('customs'), click: function() { toggleCapability('customs'); return true; }" />
                                                <label class="form-check-label" for="cap-customs">
                                                    <i class="bi bi-building-check text-secondary me-1"></i> @Html.T("Capability.Customs", "Gumruk Musavirligi")
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <!-- Gozetim -->
                                        <div class="col-md-4 mb-2">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="cap-survey"
                                                       data-bind="checked: isCapabilitySelected('survey'), click: function() { toggleCapability('survey'); return true; }" />
                                                <label class="form-check-label" for="cap-survey">
                                                    <i class="bi bi-search text-primary me-1"></i> @Html.T("Capability.Survey", "Gozetim / Inspeksiyon")
                                                </label>
                                            </div>
                                        </div>
                                        <!-- Yatirimci -->
                                        <div class="col-md-4 mb-2">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="cap-investor"
                                                       data-bind="checked: isCapabilitySelected('investor'), click: function() { toggleCapability('investor'); return true; }" />
                                                <label class="form-check-label" for="cap-investor">
                                                    <i class="bi bi-graph-up-arrow text-success me-1"></i> @Html.T("Capability.Investor", "Yatirimci / Finansor")
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div data-bind="visible: errors.capabilities" class="alert alert-danger mt-3">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                <span data-bind="text: errors.capabilities"></span>
                            </div>
                        </div>

                        <!-- ADIM 6: AKTIF ULKELER -->
                        <div data-bind="visible: currentStep() === 6" style="display: none;">
                            <p class="text-muted mb-3">@Html.T("Account.Register.Step6.Description", "Hangi ulkelerde aktif olacaksiniz?")</p>

                            <!-- Loading -->
                            <div data-bind="visible: isLoadingCountries" class="text-center py-4">
                                <div class="spinner-border text-primary" role="status"></div>
                                <p class="text-muted mt-2">@Html.T("Common.Loading", "Yukleniyor...")</p>
                            </div>

                            <!-- Search & Actions -->
                            <div data-bind="visible: !isLoadingCountries()" class="mb-3">
                                <div class="row align-items-center">
                                    <div class="col-md-6 mb-2 mb-md-0">
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                                            <input type="text" class="form-control"
                                                   placeholder="@Html.T("Account.Register.SearchCountry", "Ulke ara...")"
                                                   data-bind="value: countrySearchQuery, valueUpdate: 'afterkeydown'" />
                                            <button class="btn btn-outline-secondary" type="button"
                                                    data-bind="visible: countrySearchQuery(), click: function() { countrySearchQuery(''); }">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="col-md-6 text-md-end">
                                        <button type="button" class="btn btn-outline-primary btn-sm me-2" data-bind="click: selectAllCountries">
                                            <i class="bi bi-check-all"></i> @Html.T("Common.SelectAll", "Tumunu Sec")
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bind="click: clearAllCountries">
                                            <i class="bi bi-x-lg"></i> @Html.T("Common.Clear", "Temizle")
                                        </button>
                                        <span class="badge bg-primary ms-2" data-bind="text: form.selectedCountries().length + ' secili'"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Countries Grid -->
                            <div class="row" data-bind="visible: !isLoadingCountries(), foreach: filteredCountries" style="max-height: 350px; overflow-y: auto;">
                                <div class="col-md-4 col-6 mb-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               data-bind="attr: { id: 'country-' + code }, checked: $parent.form.selectedCountries, value: code" />
                                        <label class="form-check-label" data-bind="attr: { for: 'country-' + code }">
                                            <span data-bind="text: flagEmoji"></span> <span data-bind="text: name"></span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <!-- No Results -->
                            <div data-bind="visible: !isLoadingCountries() && filteredCountries().length === 0 && countrySearchQuery()" class="text-center py-3 text-muted">
                                <i class="bi bi-search"></i> @Html.T("Common.NoResults", "Sonuc bulunamadi")
                            </div>

                            <div data-bind="visible: errors.countries" class="alert alert-danger mt-3">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                <span data-bind="text: errors.countries"></span>
                            </div>
                        </div>

                        <!-- Navigation Buttons -->
                        <div class="d-flex justify-content-between mt-4 pt-3 border-top" data-bind="visible: !isJoiningExisting() || currentStep() === 1">
                            <button type="button" class="btn btn-outline-secondary" style="display: none;"
                                    data-bind="visible: currentStep() > 1 && currentStep() !== 2, click: prevStep">
                                <i class="bi bi-arrow-left"></i> @Html.T("Common.Back", "Geri")
                            </button>
                            <div data-bind="visible: currentStep() === 1 || currentStep() === 2"></div>

                            <button type="button" class="btn btn-primary" style="display: inline-block;"
                                    data-bind="visible: currentStep() === 1, click: nextStep, disable: isLoading">
                                @Html.T("Common.Continue", "Devam") <i class="bi bi-arrow-right"></i>
                            </button>

                            <button type="button" class="btn btn-primary" style="display: none;"
                                    data-bind="visible: currentStep() >= 3 && currentStep() < 6, click: nextStep, disable: isLoading">
                                @Html.T("Common.Continue", "Devam") <i class="bi bi-arrow-right"></i>
                            </button>

                            <!-- Adim 2'de secilen firmaya katil butonu -->
                            <button type="button" class="btn btn-success" style="display: none;"
                                    data-bind="visible: currentStep() === 2 && selectedVendorToJoin() && !domainMatchVendor(), click: submitJoinRequest, disable: isLoading">
                                <span data-bind="visible: !isLoading()">
                                    <i class="bi bi-check-circle"></i> @Html.T("Account.Register.JoinSelected", "Firmaya Katil")
                                </span>
                                <span data-bind="visible: isLoading()" style="display: none;">
                                    <span class="spinner-border spinner-border-sm"></span>
                                </span>
                            </button>

                            <button type="button" class="btn btn-success" style="display: none;"
                                    data-bind="visible: currentStep() === 6, click: submitForm, disable: isLoading">
                                <span data-bind="visible: !isLoading()">
                                    <i class="bi bi-check-circle"></i> @Html.T("Account.Register.Submit", "Kayit Ol")
                                </span>
                                <span data-bind="visible: isLoading()" style="display: none;">
                                    <span class="spinner-border spinner-border-sm"></span> @Html.T("Common.Saving", "Kaydediliyor...")
                                </span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-3">
                    <span class="text-muted">@Html.T("Account.Register.HasAccount", "Zaten uyemiz misiniz?")</span>
                    <a asp-action="Login" class="ms-2">@Html.T("Account.Login.Title", "Giris Yap")</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var RegisterViewModel = function() {
            var self = this;

            // Current step (1-6)
            self.currentStep = ko.observable(1);
            self.isLoading = ko.observable(false);
            self.errorMessage = ko.observable('');

            // Step 2 - Domain check & company search
            self.domainCheckDone = ko.observable(false);
            self.domainMatchVendor = ko.observable(null);
            self.searchQuery = ko.observable('');
            self.searchResults = ko.observableArray([]);
            self.selectedVendorToJoin = ko.observable(null);
            self.joinMessage = ko.observable('');
            self.isJoiningExisting = ko.observable(false);

            // Phone country codes
            self.phoneCountryCodes = ko.observableArray([
                { value: '+90', label: '🇹🇷 +90' },
                { value: '+1', label: '🇺🇸 +1' },
                { value: '+44', label: '🇬🇧 +44' },
                { value: '+49', label: '🇩🇪 +49' },
                { value: '+33', label: '🇫🇷 +33' },
                { value: '+39', label: '🇮🇹 +39' },
                { value: '+34', label: '🇪🇸 +34' },
                { value: '+31', label: '🇳🇱 +31' },
                { value: '+32', label: '🇧🇪 +32' },
                { value: '+43', label: '🇦🇹 +43' },
                { value: '+41', label: '🇨🇭 +41' },
                { value: '+46', label: '🇸🇪 +46' },
                { value: '+47', label: '🇳🇴 +47' },
                { value: '+45', label: '🇩🇰 +45' },
                { value: '+48', label: '🇵🇱 +48' },
                { value: '+30', label: '🇬🇷 +30' },
                { value: '+7', label: '🇷🇺 +7' },
                { value: '+380', label: '🇺🇦 +380' },
                { value: '+966', label: '🇸🇦 +966' },
                { value: '+971', label: '🇦🇪 +971' },
                { value: '+972', label: '🇮🇱 +972' },
                { value: '+91', label: '🇮🇳 +91' },
                { value: '+86', label: '🇨🇳 +86' },
                { value: '+81', label: '🇯🇵 +81' },
                { value: '+82', label: '🇰🇷 +82' }
            ]);

            // Address geography
            self.addressCountries = ko.observableArray([]);
            self.addressStates = ko.observableArray([]);

            // Form data
            self.form = {
                // Step 1
                firstName: ko.observable(''),
                lastName: ko.observable(''),
                email: ko.observable(''),
                password: ko.observable(''),
                confirmPassword: ko.observable(''),
                // Step 3
                companyName: ko.observable(''),
                phoneCountryCode: ko.observable('+90'),
                phone: ko.observable(''),
                website: ko.observable(''),
                // Step 4
                countryId: ko.observable(null),
                stateId: ko.observable(null),
                city: ko.observable(''),
                district: ko.observable(''),
                addressLine: ko.observable(''),
                postalCode: ko.observable(''),
                // Step 5
                selectedCapabilities: ko.observableArray([]),
                // Step 6
                selectedCountries: ko.observableArray([])
            };

            // Countries
            self.availableCountries = ko.observableArray([]);
            self.isLoadingCountries = ko.observable(false);
            self.countrySearchQuery = ko.observable('');

            // Filtered countries based on search
            self.filteredCountries = ko.computed(function() {
                var query = self.countrySearchQuery().toLowerCase().trim();
                if (!query) return self.availableCountries();

                return self.availableCountries().filter(function(c) {
                    return c.name.toLowerCase().indexOf(query) > -1 ||
                           c.code.toLowerCase().indexOf(query) > -1;
                });
            });

            // Validation errors
            self.errors = {
                firstName: ko.observable(''),
                lastName: ko.observable(''),
                email: ko.observable(''),
                password: ko.observable(''),
                confirmPassword: ko.observable(''),
                companyName: ko.observable(''),
                countryId: ko.observable(''),
                stateId: ko.observable(''),
                city: ko.observable(''),
                district: ko.observable(''),
                addressLine: ko.observable(''),
                capabilities: ko.observable(''),
                countries: ko.observable('')
            };

            // Step title
            self.stepTitle = ko.computed(function() {
                var titles = {
                    1: '@Html.T("Account.Register.StepTitle.Account", "Hesap Bilgileri")',
                    2: '@Html.T("Account.Register.StepTitle.FindCompany", "Firma Arama")',
                    3: '@Html.T("Account.Register.StepTitle.Company", "Firma Bilgileri")',
                    4: '@Html.T("Account.Register.StepTitle.Address", "Adres Bilgileri")',
                    5: '@Html.T("Account.Register.StepTitle.Usage", "Kullanim Amaci")',
                    6: '@Html.T("Account.Register.StepTitle.Countries", "Aktif Ulkeler")'
                };
                return titles[self.currentStep()];
            });

            // Progress percent
            self.progressPercent = ko.computed(function() {
                return (self.currentStep() / 6) * 100;
            });

            // ========== STEP 2 FUNCTIONS ==========

            // Domain eslesmesi kontrolu
            self.checkDomainMatch = function() {
                self.domainCheckDone(false);
                fetch('/Account/CheckDomainMatch?email=' + encodeURIComponent(self.form.email()))
                    .then(function(r) { return r.json(); })
                    .then(function(result) {
                        self.domainCheckDone(true);
                        if (result.found) {
                            self.domainMatchVendor(result.vendor);
                        }
                    })
                    .catch(function() {
                        self.domainCheckDone(true);
                    });
            };

            // Domain eslesmesi ile katil
            self.joinDomainMatchVendor = function() {
                self.selectedVendorToJoin(self.domainMatchVendor());
                self.submitJoinRequest();
            };

            // Domain eslesmesini atla
            self.skipDomainMatch = function() {
                self.domainMatchVendor(null);
            };

            // Firma ara
            var searchTimeout;
            self.searchCompanies = function() {
                clearTimeout(searchTimeout);
                var query = self.searchQuery();
                if (query.length < 2) {
                    self.searchResults([]);
                    return;
                }
                searchTimeout = setTimeout(function() {
                    fetch('/Account/SearchCompanies?query=' + encodeURIComponent(query))
                        .then(function(r) { return r.json(); })
                        .then(function(result) {
                            self.searchResults(result.results || []);
                        });
                }, 300);
            };

            // Firmaya katilmak icin sec
            self.selectCompanyToJoin = function(vendor) {
                self.selectedVendorToJoin(vendor);
                self.searchResults([]);
                self.searchQuery('');
            };

            // Secimi temizle
            self.clearSelectedVendor = function() {
                self.selectedVendorToJoin(null);
            };

            // Yeni firma olustur
            self.createNewCompany = function() {
                self.isJoiningExisting(false);
                self.currentStep(3);
            };

            // Katilma istegi gonder
            self.submitJoinRequest = function() {
                if (!self.selectedVendorToJoin()) return;

                self.isLoading(true);
                self.errorMessage('');

                var data = {
                    firstName: self.form.firstName(),
                    lastName: self.form.lastName(),
                    email: self.form.email(),
                    password: self.form.password(),
                    vendorId: self.selectedVendorToJoin().id,
                    message: self.joinMessage()
                };

                fetch('/Account/RegisterWithJoinRequest', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify(data)
                })
                .then(function(r) { return r.json(); })
                .then(function(result) {
                    if (result.success) {
                        toastr.success(result.message);
                        setTimeout(function() {
                            window.location.href = result.redirectUrl || '/VendorSetup';
                        }, 1500);
                    } else {
                        // Field-spesifik hatalari parse et
                        if (result.errors) {
                            var hasFieldError = false;
                            var fieldMapping = {
                                'FirstName': 'firstName', 'LastName': 'lastName',
                                'Email': 'email', 'Password': 'password',
                                'firstName': 'firstName', 'lastName': 'lastName',
                                'email': 'email', 'password': 'password'
                            };
                            for (var fieldName in result.errors) {
                                if (result.errors.hasOwnProperty(fieldName)) {
                                    var errorKey = fieldMapping[fieldName];
                                    if (errorKey && self.errors[errorKey]) {
                                        self.errors[errorKey](result.errors[fieldName]);
                                        hasFieldError = true;
                                    }
                                }
                            }
                            if (hasFieldError) {
                                self.currentStep(1); // Hesap bilgileri step'ine git
                            }
                            if (!hasFieldError) {
                                self.errorMessage(result.message);
                            }
                        } else {
                            self.errorMessage(result.message);
                        }
                    }
                })
                .catch(function() {
                    self.errorMessage('@Html.T("Common.Error.Generic", "Bir hata olustu")');
                })
                .finally(function() {
                    self.isLoading(false);
                });
            };

            // ========== CAPABILITY & COUNTRY HELPERS ==========

            self.isCapabilitySelected = function(code) {
                return self.form.selectedCapabilities.indexOf(code) > -1;
            };

            self.toggleCapability = function(code) {
                var index = self.form.selectedCapabilities.indexOf(code);
                if (index > -1) {
                    self.form.selectedCapabilities.remove(code);
                } else {
                    self.form.selectedCapabilities.push(code);
                }
                self.errors.capabilities('');
            };

            self.hasAnyServiceProvider = ko.computed(function() {
                var caps = self.form.selectedCapabilities();
                return caps.indexOf('carrier') > -1 || caps.indexOf('insurance') > -1 ||
                       caps.indexOf('customs') > -1 || caps.indexOf('survey') > -1 ||
                       caps.indexOf('investor') > -1;
            });

            // Capability code -> ID mapping
            self.capabilityIdMap = {
                'seller': 2,
                'buyer': 3,
                'carrier': 4,
                'insurance': 5,
                'customs': 6,
                'survey': 7,
                'investor': 8
            };

            // Convert capability codes to IDs
            self.getCapabilityIds = function() {
                return self.form.selectedCapabilities().map(function(code) {
                    return self.capabilityIdMap[code] || 0;
                }).filter(function(id) { return id > 0; });
            };

            // Load countries from API
            self.loadCountries = function() {
                if (self.availableCountries().length > 0) return; // Already loaded

                self.isLoadingCountries(true);
                fetch('/api/localization/countries')
                    .then(function(response) { return response.json(); })
                    .then(function(data) {
                        self.availableCountries(data);
                    })
                    .catch(function(error) {
                        console.error('Countries load error:', error);
                    })
                    .finally(function() {
                        self.isLoadingCountries(false);
                    });
            };

            self.selectAllCountries = function() {
                var allCodes = self.availableCountries().map(function(c) { return c.code; });
                self.form.selectedCountries(allCodes);
                self.errors.countries('');
            };

            self.clearAllCountries = function() {
                self.form.selectedCountries([]);
            };

            // ========== ADDRESS GEOGRAPHY ==========

            // Load address countries from geography API
            self.loadAddressCountries = function() {
                if (self.addressCountries().length > 0) return Promise.resolve();

                return fetch('/api/company/geography/countries')
                    .then(function(response) { return response.json(); })
                    .then(function(data) {
                        self.addressCountries(data);
                        // Default olarak Turkiye secili gelsin (varsa)
                        var turkey = data.find(function(c) { return c.name === 'Türkiye' || c.name === 'Turkey'; });
                        if (turkey) {
                            self.form.countryId(turkey.id);
                            self.loadAddressStates(turkey.id);
                        }
                    })
                    .catch(function(error) {
                        console.error('Address countries load error:', error);
                    });
            };

            // Load states for selected country
            self.loadAddressStates = function(countryId) {
                if (!countryId) {
                    self.addressStates([]);
                    return Promise.resolve();
                }

                return fetch('/api/company/geography/countries/' + countryId + '/states')
                    .then(function(response) { return response.json(); })
                    .then(function(data) {
                        self.addressStates(data);
                    })
                    .catch(function(error) {
                        console.error('Address states load error:', error);
                        self.addressStates([]);
                    });
            };

            // Country change handler
            self.onAddressCountryChange = function() {
                var countryId = self.form.countryId();
                self.form.stateId(null);
                self.loadAddressStates(countryId);
            };

            // ========== VALIDATION ==========

            self.clearErrors = function() {
                for (var key in self.errors) {
                    if (ko.isObservable(self.errors[key])) {
                        self.errors[key]('');
                    }
                }
                self.errorMessage('');
            };

            self.validateStep = function(step) {
                self.clearErrors();
                var isValid = true;
                var errorMessages = [];

                if (step === 1) {
                    if (!self.form.firstName().trim()) {
                        self.errors.firstName('@Html.T("Validation.Required.FirstName", "Ad gereklidir")');
                        errorMessages.push('Ad');
                        isValid = false;
                    }
                    if (!self.form.lastName().trim()) {
                        self.errors.lastName('@Html.T("Validation.Required.LastName", "Soyad gereklidir")');
                        errorMessages.push('Soyad');
                        isValid = false;
                    }
                    if (!self.form.email().trim()) {
                        self.errors.email('@Html.T("Validation.Required.Email", "E-posta gereklidir")');
                        errorMessages.push('E-posta');
                        isValid = false;
                    } else if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(self.form.email())) {
                        self.errors.email('@Html.T("Validation.Invalid.Email", "Gecerli bir e-posta adresi giriniz")');
                        errorMessages.push('Gecerli e-posta');
                        isValid = false;
                    }
                    if (!self.form.password()) {
                        self.errors.password('@Html.T("Validation.Required.Password", "Sifre gereklidir")');
                        errorMessages.push('Sifre');
                        isValid = false;
                    } else if (self.form.password().length < 6) {
                        self.errors.password('@Html.T("Validation.MinLength.Password", "Sifre en az 6 karakter olmalidir")');
                        errorMessages.push('Sifre (min 6 karakter)');
                        isValid = false;
                    }
                    if (self.form.password() !== self.form.confirmPassword()) {
                        self.errors.confirmPassword('@Html.T("Validation.PasswordMismatch", "Sifreler eslesmedi")');
                        errorMessages.push('Sifre tekrari');
                        isValid = false;
                    }
                }
                else if (step === 3) {
                    if (!self.form.companyName().trim()) {
                        self.errors.companyName('@Html.T("Validation.Required.CompanyName", "Firma adi gereklidir")');
                        errorMessages.push('Firma adi');
                        isValid = false;
                    }
                }
                else if (step === 4) {
                    if (!self.form.countryId()) {
                        self.errors.countryId('@Html.T("Validation.Required.Country", "Ulke gereklidir")');
                        errorMessages.push('Ulke');
                        isValid = false;
                    }
                    // State required if states exist for this country
                    if (self.addressStates().length > 0 && !self.form.stateId()) {
                        self.errors.stateId('@Html.T("Validation.Required.State", "Eyalet gereklidir")');
                        errorMessages.push('Eyalet');
                        isValid = false;
                    }
                    if (!self.form.city().trim()) {
                        self.errors.city('@Html.T("Validation.Required.City", "Il gereklidir")');
                        errorMessages.push('Il');
                        isValid = false;
                    }
                    if (!self.form.district().trim()) {
                        self.errors.district('@Html.T("Validation.Required.District", "Ilce gereklidir")');
                        errorMessages.push('Ilce');
                        isValid = false;
                    }
                    if (!self.form.addressLine().trim()) {
                        self.errors.addressLine('@Html.T("Validation.Required.Address", "Adres gereklidir")');
                        errorMessages.push('Adres');
                        isValid = false;
                    }
                }
                else if (step === 5) {
                    if (self.form.selectedCapabilities().length === 0) {
                        self.errors.capabilities('@Html.T("Validation.Required.Capability", "En az bir kullanim amaci secmelisiniz")');
                        errorMessages.push('Kullanim amaci');
                        isValid = false;
                    }
                }
                else if (step === 6) {
                    if (self.form.selectedCountries().length === 0) {
                        self.errors.countries('@Html.T("Validation.Required.Country", "En az bir ulke secmelisiniz")');
                        errorMessages.push('Ulke secimi');
                        isValid = false;
                    }
                }

                // Hata varsa toastr ile goster
                if (!isValid && errorMessages.length > 0) {
                    toastr.warning('Eksik alanlar: ' + errorMessages.join(', '));
                }

                return isValid;
            };

            // ========== NAVIGATION ==========

            self.nextStep = function() {
                if (!self.validateStep(self.currentStep())) return;

                var step = self.currentStep();

                // Adim 1'den 2'ye gecerken e-posta ve domain kontrolu yap
                if (step === 1) {
                    self.isLoading(true);
                    // E-posta kontrolu
                    $.get('/api/account/check-email', { email: self.form.email() })
                        .done(function(result) {
                            if (result.exists) {
                                self.errors.email('Bu e-posta adresi zaten kayitli');
                                toastr.error('Bu e-posta adresi ile zaten bir hesap bulunmaktadir');
                            } else {
                                self.currentStep(2);
                                self.checkDomainMatch();
                            }
                        })
                        .fail(function() {
                            // API hatasi olursa devam et
                            self.currentStep(2);
                            self.checkDomainMatch();
                        })
                        .always(function() {
                            self.isLoading(false);
                        });
                    return;
                }

                // Adim 4'e gecerken adres ulkelerini yukle
                if (step === 3) {
                    self.loadAddressCountries();
                }

                // Adim 6'ya gecerken ulkeleri yukle
                if (step === 5) {
                    self.loadCountries();
                }

                self.currentStep(step + 1);
            };

            self.prevStep = function() {
                var step = self.currentStep();
                if (step > 1) {
                    // Adim 3'ten 2'ye donunce state'i resetle
                    if (step === 3) {
                        self.isJoiningExisting(false);
                    }
                    self.currentStep(step - 1);
                }
            };

            // ========== SUBMIT ==========

            self.submitForm = function() {
                if (!self.validateStep(6)) return;

                self.isLoading(true);
                self.errorMessage('');

                var data = {
                    firstName: self.form.firstName(),
                    lastName: self.form.lastName(),
                    email: self.form.email(),
                    password: self.form.password(),
                    confirmPassword: self.form.confirmPassword(),
                    companyName: self.form.companyName(),
                    phone: self.form.phone() ? (self.form.phoneCountryCode() + ' ' + self.form.phone()) : '',
                    website: self.form.website(),
                    countryId: self.form.countryId(),
                    stateId: self.form.stateId(),
                    city: self.form.city(),
                    district: self.form.district(),
                    addressLine: self.form.addressLine(),
                    postalCode: self.form.postalCode(),
                    selectedCapabilities: self.getCapabilityIds(),
                    selectedCountries: self.form.selectedCountries()
                };

                fetch('/Account/Register', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify(data)
                })
                .then(function(response) {
                    return response.json();
                })
                .then(function(result) {
                    if (result.success) {
                        window.location.href = result.redirectUrl || '/Dashboard';
                    } else {
                        // Field-spesifik hatalari parse et
                        if (result.errors) {
                            var hasFieldError = false;
                            var errorStep = null;

                            // Field mapping - server field adlari -> client error observable'lari
                            var fieldMapping = {
                                'FirstName': { error: 'firstName', step: 1 },
                                'LastName': { error: 'lastName', step: 1 },
                                'Email': { error: 'email', step: 1 },
                                'Password': { error: 'password', step: 1 },
                                'ConfirmPassword': { error: 'confirmPassword', step: 1 },
                                'CompanyName': { error: 'companyName', step: 3 },
                                'CountryId': { error: 'countryId', step: 4 },
                                'StateId': { error: 'stateId', step: 4 },
                                'City': { error: 'city', step: 4 },
                                'District': { error: 'district', step: 4 },
                                'AddressLine': { error: 'addressLine', step: 4 },
                                'SelectedCapabilities': { error: 'capabilities', step: 5 },
                                'SelectedCountries': { error: 'countries', step: 6 },
                                // Lowercase versiyonlari da ekle
                                'firstName': { error: 'firstName', step: 1 },
                                'lastName': { error: 'lastName', step: 1 },
                                'email': { error: 'email', step: 1 },
                                'password': { error: 'password', step: 1 },
                                'confirmPassword': { error: 'confirmPassword', step: 1 },
                                'companyName': { error: 'companyName', step: 3 },
                                'countryId': { error: 'countryId', step: 4 },
                                'stateId': { error: 'stateId', step: 4 },
                                'city': { error: 'city', step: 4 },
                                'district': { error: 'district', step: 4 },
                                'addressLine': { error: 'addressLine', step: 4 },
                                'selectedCapabilities': { error: 'capabilities', step: 5 },
                                'selectedCountries': { error: 'countries', step: 6 }
                            };

                            // Object.entries kullanarak iterate et
                            for (var fieldName in result.errors) {
                                if (result.errors.hasOwnProperty(fieldName)) {
                                    var errorMsg = result.errors[fieldName];
                                    var mapping = fieldMapping[fieldName];
                                    if (mapping && self.errors[mapping.error]) {
                                        self.errors[mapping.error](errorMsg);
                                        hasFieldError = true;
                                        // En erken step'e git
                                        if (errorStep === null || mapping.step < errorStep) {
                                            errorStep = mapping.step;
                                        }
                                    }
                                }
                            }

                            // Hata olan step'e git
                            if (errorStep !== null) {
                                self.currentStep(errorStep);
                            }

                            // Eger field-spesifik hata gosterildiyse, genel mesaji gosterme
                            if (!hasFieldError) {
                                self.errorMessage(result.message || '@Html.T("Common.Error.Registration", "Kayit sirasinda bir hata olustu")');
                            }
                        } else {
                            self.errorMessage(result.message || '@Html.T("Common.Error.Registration", "Kayit sirasinda bir hata olustu")');
                        }
                    }
                })
                .catch(function(error) {
                    self.errorMessage('@Html.T("Common.Error.Generic", "Bir hata olustu. Lutfen tekrar deneyin.")');
                    console.error(error);
                })
                .finally(function() {
                    self.isLoading(false);
                });
            };
        };

        try {
            ko.applyBindings(new RegisterViewModel(), document.getElementById('register-app'));
            console.log('KnockoutJS binding successful');
        } catch (e) {
            console.error('KnockoutJS binding error:', e);
        }
    </script>
    @Html.AntiForgeryToken()
}
