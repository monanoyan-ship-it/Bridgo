@* Buyer Dashboard - Alici (Capability ID: 3) *@

<!-- Stats -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card border-0 shadow-sm bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1 opacity-75">@Html.T("Dashboard.Stats.ActiveOrders", "Aktif Siparisler")</h6>
                        <h2 class="mb-0" data-bind="text: stats().activeOrders || 0"></h2>
                    </div>
                    <i class="bi bi-cart-check" style="font-size: 2.5rem; opacity: 0.5;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-0 shadow-sm bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1 opacity-75">@Html.T("Dashboard.Stats.PendingDeliveries", "Bekleyen Teslimat")</h6>
                        <h2 class="mb-0" data-bind="text: stats().pendingDeliveries || 0"></h2>
                    </div>
                    <i class="bi bi-truck" style="font-size: 2.5rem; opacity: 0.5;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-0 shadow-sm bg-warning text-dark">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1 opacity-75">@Html.T("Dashboard.Stats.ActiveDemands", "Aktif Talepler")</h6>
                        <h2 class="mb-0" data-bind="text: stats().activeDemands || 0"></h2>
                    </div>
                    <i class="bi bi-megaphone" style="font-size: 2.5rem; opacity: 0.5;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-0 shadow-sm bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1 opacity-75">@Html.T("Dashboard.Stats.MonthlySpending", "Aylik Harcama")</h6>
                        <h2 class="mb-0" data-bind="text: formatCurrency(stats().monthlySpending, stats().spendingCurrency)"></h2>
                    </div>
                    <i class="bi bi-wallet2" style="font-size: 2.5rem; opacity: 0.5;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-3">
                <div class="d-flex justify-content-center gap-5">
                    <div>
                        <i class="bi bi-file-earmark-text text-primary" style="font-size: 2rem;"></i>
                        <h3 class="mt-2 mb-1" data-bind="text: stats().pendingProposals || 0"></h3>
                        <small class="text-muted">@Html.T("Dashboard.Stats.PendingProposals", "Bekleyen Teklifler")</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Recent Orders -->
    <div class="col-lg-8 mb-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>@Html.T("Dashboard.MyOrders", "Siparislerim")</h5>
                <a href="/MyOrders" class="btn btn-sm btn-outline-primary">@Html.T("Common.ViewAll", "Tumu")</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Html.T("Dashboard.Table.OrderNo", "Siparis No")</th>
                                <th>@Html.T("Common.Vendor", "Satici")</th>
                                <th>@Html.T("Dashboard.Table.Amount", "Tutar")</th>
                                <th>@Html.T("Admin.Table.Status", "Durum")</th>
                                <th>@Html.T("Dashboard.Table.Date", "Tarih")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: recentOrders">
                            <tr>
                                <td><strong data-bind="text: orderNumber"></strong></td>
                                <td data-bind="text: vendorName"></td>
                                <td data-bind="text: $parent.formatCurrency(totalAmount, currency)"></td>
                                <td><span class="badge" data-bind="text: statusName, css: statusCssClass"></span></td>
                                <td data-bind="text: $parent.formatDate(createdAt)"></td>
                            </tr>
                        </tbody>
                        <!-- ko if: recentOrders().length === 0 -->
                        <tbody>
                            <tr><td colspan="5" class="text-center text-muted py-4">@Html.T("Common.NoData", "Veri bulunamadi")</td></tr>
                        </tbody>
                        <!-- /ko -->
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Demands -->
    <div class="col-lg-4 mb-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0">
                <h5 class="mb-0"><i class="bi bi-megaphone me-2"></i>@Html.T("Dashboard.MyDemands", "Taleplerim")</h5>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush" data-bind="foreach: recentDemands">
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong data-bind="text: title"></strong>
                                <br><small class="text-muted" data-bind="text: categoryName"></small>
                            </div>
                            <span class="badge" data-bind="text: responseCount + ' teklif', css: statusCssClass"></span>
                        </div>
                    </li>
                </ul>
                <!-- ko if: recentDemands().length === 0 -->
                <div class="text-center text-muted py-4">@Html.T("Common.NoData", "Veri bulunamadi")</div>
                <!-- /ko -->
            </div>
        </div>
    </div>
</div>

<!-- Pending Proposals -->
<div class="row">
    <div class="col-12 mb-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i>@Html.T("Dashboard.PendingProposals", "Bekleyen Teklifler")</h5>
                <a href="/Proposals" class="btn btn-sm btn-outline-primary">@Html.T("Common.ViewAll", "Tumu")</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Html.T("Common.Demand", "Talep")</th>
                                <th>@Html.T("Common.Vendor", "Tedarikci")</th>
                                <th>@Html.T("Dashboard.Table.UnitPrice", "Birim Fiyat")</th>
                                <th>@Html.T("Dashboard.Table.TotalPrice", "Toplam")</th>
                                <th>@Html.T("Dashboard.Table.ValidUntil", "Gecerlilik")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: pendingProposals">
                            <tr>
                                <td data-bind="text: demandTitle"></td>
                                <td data-bind="text: vendorName"></td>
                                <td data-bind="text: $parent.formatCurrency(unitPrice, currency)"></td>
                                <td data-bind="text: $parent.formatCurrency(totalPrice, currency)"></td>
                                <td data-bind="text: $parent.formatDate(validUntil)"></td>
                            </tr>
                        </tbody>
                        <!-- ko if: pendingProposals().length === 0 -->
                        <tbody>
                            <tr><td colspan="5" class="text-center text-muted py-4">@Html.T("Common.NoData", "Veri bulunamadi")</td></tr>
                        </tbody>
                        <!-- /ko -->
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
