@using Bridgo.Extensions
@{
    ViewData["Title"] = Html.T("Apps.Logistics", "Lojistik").ToString();
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">
            <i class="bi bi-truck me-2"></i>
            @Html.T("Apps.Logistics", "Lojistik")
        </h4>
        <p class="text-muted mb-0">@Html.T("Apps.LogisticsDesc", "Lojistik ve kargo takip sistemi")</p>
    </div>
    <a href="/Apps" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Geri
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">
        <i class="bi bi-truck text-muted display-1 d-block mb-3"></i>
        <h5>@Html.T("Apps.ComingSoon", "Yakin zamanda")</h5>
        <p class="text-muted">Bu bolum yakin zamanda aktif olacak.</p>
    </div>
</div>
