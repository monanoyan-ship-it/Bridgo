@using Bridgo.Extensions
@{
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
    ViewData["Title"] = Html.T("Cart.Title", "Sepetim").ToString();
}

<div id="cart-app">
    <!-- Baslik -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-cart3 text-primary"></i> @Html.T("Cart.Title", "Sepetim")
        </h2>
        <div>
            <span class="text-muted" data-bind="visible: totalItemCount() > 0">
                <span data-bind="text: totalItemCount"></span> @Html.T("Cart.Items", "urun")
            </span>
        </div>
    </div>

    <!-- Bos sepet -->
    <div data-bind="visible: !loading() && carts().length === 0" style="display: none;">
        <div class="text-center py-5">
            <i class="bi bi-cart-x display-1 text-muted"></i>
            <h4 class="mt-3">@Html.T("Cart.Empty", "Sepetiniz bos")</h4>
            <p class="text-muted">@Html.T("Cart.EmptyHint", "Urun eklemek icin katalogu ziyaret edin")</p>
            <a href="/Catalog" class="btn btn-primary">
                <i class="bi bi-search"></i> @Html.T("Cart.BrowseCatalog", "Katalogu Incele")
            </a>
        </div>
    </div>

    <!-- Yukleniyor -->
    <div data-bind="visible: loading" class="text-center py-5" style="display: none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@Html.T("Common.Loading", "Yukleniyor...")</span>
        </div>
    </div>

    <!-- Sepet Gruplari -->
    <div data-bind="foreach: carts" style="display: none;" class="mb-4">
        <div class="card mb-4 cart-group">
            <!-- Sepet Header: Satici + Depo + Teslimat -->
            <div class="card-header bg-white">
                <div class="row align-items-center">
                    <div class="col-md-4">
                        <div class="d-flex align-items-center">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 40px; height: 40px;">
                                <i class="bi bi-shop"></i>
                            </div>
                            <div>
                                <h6 class="mb-0">
                                    <span data-bind="text: sellerVendorName"></span>
                                    <i class="bi bi-patch-check-fill text-primary" data-bind="visible: sellerIsVerified" title="@Html.T("Cart.VerifiedSeller", "Dogrulanmis Satici")"></i>
                                </h6>
                                <small class="text-muted">
                                    <i class="bi bi-building"></i>
                                    <span data-bind="text: sourceWarehouseName"></span>
                                    <span data-bind="if: sourceWarehouseCity">
                                        (<span data-bind="text: sourceWarehouseCity"></span>)
                                    </span>
                                </small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted">@Html.T("Cart.DeliveryAddress", "Teslimat Adresi")</small>
                        <div>
                            <i class="bi bi-geo-alt text-danger"></i>
                            <span data-bind="text: deliveryAddressTitle"></span>
                        </div>
                    </div>
                    <div class="col-md-4 text-end">
                        <div class="fw-bold text-primary fs-5" data-bind="text: formatCurrency(totalAmount(), currency())"></div>
                        <small class="text-muted"><span data-bind="text: totalItemCount"></span> @Html.T("Cart.Units", "adet")</small>
                    </div>
                </div>
            </div>

            <!-- Sepet Kalemleri -->
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 80px;">@Html.T("Cart.Image", "Gorsel")</th>
                                <th>@Html.T("Cart.Product", "Urun")</th>
                                <th style="width: 150px;" class="text-center">@Html.T("Cart.Quantity", "Miktar")</th>
                                <th style="width: 120px;" class="text-end">@Html.T("Cart.UnitPrice", "Birim Fiyat")</th>
                                <th style="width: 120px;" class="text-end">@Html.T("Cart.Total", "Toplam")</th>
                                <th style="width: 60px;"></th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: items">
                            <tr>
                                <td>
                                    <a data-bind="attr: { href: '/Catalog/' + productSlug }">
                                        <!-- ko if: productImageUrl -->
                                        <img data-bind="attr: { src: productImageUrl, alt: productName }" class="rounded" style="width: 60px; height: 60px; object-fit: cover;" />
                                        <!-- /ko -->
                                        <!-- ko ifnot: productImageUrl -->
                                        <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                            <i class="bi bi-image text-muted"></i>
                                        </div>
                                        <!-- /ko -->
                                    </a>
                                </td>
                                <td>
                                    <a data-bind="attr: { href: '/Catalog/' + productSlug }, text: productName" class="text-decoration-none text-dark fw-medium"></a>
                                    <!-- ko if: productSku -->
                                    <br /><small class="text-muted" data-bind="text: 'SKU: ' + productSku"></small>
                                    <!-- /ko -->
                                    <!-- ko if: note -->
                                    <br /><small class="text-info"><i class="bi bi-sticky"></i> <span data-bind="text: note"></span></small>
                                    <!-- /ko -->
                                    <!-- ko ifnot: inStock -->
                                    <br /><span class="badge bg-warning text-dark">@Html.T("Cart.OutOfStock", "Stok Yok")</span>
                                    <!-- /ko -->
                                </td>
                                <td class="text-center">
                                    <div class="input-group input-group-sm" style="width: 130px; margin: 0 auto;">
                                        <button class="btn btn-outline-secondary" type="button" data-bind="click: $parent.decreaseQuantity">
                                            <i class="bi bi-dash"></i>
                                        </button>
                                        <input type="number" class="form-control text-center" data-bind="value: quantity, attr: { min: minQuantity }, event: { change: function() { $parent.updateQuantity($data); } }" />
                                        <button class="btn btn-outline-secondary" type="button" data-bind="click: $parent.increaseQuantity">
                                            <i class="bi bi-plus"></i>
                                        </button>
                                    </div>
                                    <!-- ko if: minQuantity > 1 -->
                                    <small class="text-muted">Min: <span data-bind="text: minQuantity"></span></small>
                                    <!-- /ko -->
                                </td>
                                <td class="text-end" data-bind="text: formatCurrency(unitPrice(), currency)"></td>
                                <td class="text-end fw-bold" data-bind="text: formatCurrency(totalPrice(), currency)"></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.removeItem" title="@Html.T("Cart.Remove", "Kaldir")">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Sepet Footer: Checkout -->
            <div class="card-footer bg-light">
                <div class="d-flex justify-content-between align-items-center">
                    <button class="btn btn-outline-danger btn-sm" data-bind="click: $root.clearCart">
                        <i class="bi bi-trash"></i> @Html.T("Cart.Clear", "Sepeti Temizle")
                    </button>
                    <div class="d-flex align-items-center gap-3">
                        <div class="text-end">
                            <small class="text-muted">@Html.T("Cart.SubTotal", "Ara Toplam")</small>
                            <div class="fw-bold fs-5 text-primary" data-bind="text: formatCurrency(totalAmount(), currency())"></div>
                        </div>
                        <a class="btn btn-success btn-lg" data-bind="attr: { href: '/Checkout?cartId=' + id }">
                            <i class="bi bi-credit-card"></i> @Html.T("Cart.Checkout", "Odemeye Git")
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Genel Toplam (birden fazla sepet varsa) -->
    <div data-bind="visible: carts().length > 1" style="display: none;">
        <div class="card">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h5 class="mb-0">@Html.T("Cart.GrandTotal", "Genel Toplam")</h5>
                        <small class="text-muted">
                            <span data-bind="text: carts().length"></span> @Html.T("Cart.SeparateShipments", "ayri sevkiyat")
                        </small>
                    </div>
                    <div class="col-md-4 text-end">
                        <div class="fs-3 fw-bold text-primary" data-bind="text: formatCurrency(grandTotal(), 'TRY')"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bilgi Notu -->
    <div data-bind="visible: carts().length > 0" style="display: none;" class="mt-4">
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            <strong>@Html.T("Cart.MultiCartInfo", "Bilgi:"):</strong>
            @Html.T("Cart.MultiCartNote", "Her sepet farkli bir satici/depodan geldiginden ayri sevkiyat olarak gonderilecektir. Tek sevkiyat avantaji icin ayni satici ve depodan urunler secmeye dikkat edin.")
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Cart/Index.js" asp-append-version="true"></script>
}
