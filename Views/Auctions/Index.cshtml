@using Bridgo.Extensions
@{
    ViewData["Title"] = Html.T("Auctions.Title", "Acik Artirmalar").ToString();
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
}

<div id="auctions-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">
                <i class="bi bi-hammer text-primary me-2"></i>
                @Html.T("Auctions.Title", "Acik Artirmalar")
            </h4>
            <p class="text-muted mb-0">@Html.T("Auctions.Subtitle", "Urunleri acik artirmayla alin veya satin")</p>
        </div>
        <button class="btn btn-primary" data-bind="click: openCreateModal">
            <i class="bi bi-plus-lg me-1"></i> @Html.T("Auctions.Create", "Yeni Acik Artirma")
        </button>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link" data-bind="css: { active: activeTab() === 'explore' }, click: function() { setTab('explore'); }" href="#">
                <i class="bi bi-compass"></i> @Html.T("Auctions.Tab.Explore", "Kesfet")
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bind="css: { active: activeTab() === 'myAuctions' }, click: function() { setTab('myAuctions'); }" href="#">
                <i class="bi bi-hammer"></i> @Html.T("Auctions.Tab.MyAuctions", "Acik Artirmalarim")
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bind="css: { active: activeTab() === 'watchlist' }, click: function() { setTab('watchlist'); }" href="#">
                <i class="bi bi-eye"></i> @Html.T("Auctions.Tab.Watchlist", "Izlediklerim")
            </a>
        </li>
    </ul>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body py-2">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <input type="text" class="form-control form-control-sm"
                           placeholder="@Html.T("Auctions.Filter.Search", "Ara...")"
                           data-bind="value: filter.search, event: { keypress: function(d,e) { if(e.keyCode===13) { loadAuctions(); return false; } return true; } }" />
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm" data-bind="value: filter.sortBy">
                        <option value="newest">@Html.T("Auctions.Sort.Newest", "En Yeni")</option>
                        <option value="endingSoon">@Html.T("Auctions.Sort.EndingSoon", "Bitmek Uzere")</option>
                        <option value="priceLow">@Html.T("Auctions.Sort.PriceLow", "Fiyat (Dusuk)")</option>
                        <option value="priceHigh">@Html.T("Auctions.Sort.PriceHigh", "Fiyat (Yuksek)")</option>
                        <option value="mostBids">@Html.T("Auctions.Sort.MostBids", "En Cok Teklif")</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm"
                            data-bind="options: categories, optionsText: 'name', optionsValue: 'id', optionsCaption: '@Html.T("Auctions.Filter.AllCategories", "Tum Kategoriler")', value: filter.categoryId">
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-primary btn-sm w-100" data-bind="click: loadAuctions">
                        <i class="bi bi-search me-1"></i> @Html.T("Common.Filter", "Filtrele")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@Html.T("Common.Loading", "Yukleniyor...")</span>
        </div>
    </div>

    <!-- Auction Cards Grid -->
    <div data-bind="visible: !isLoading()">
        <!-- Empty state -->
        <div data-bind="visible: auctions().length === 0" class="text-center py-5">
            <i class="bi bi-hammer display-1 text-muted"></i>
            <p class="text-muted mt-3">@Html.T("Auctions.Empty", "Henuz acik artirma yok")</p>
        </div>

        <div class="row g-3" data-bind="foreach: auctions">
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 auction-card">
                    <div class="card-body">
                        <!-- Status badge + Watch -->
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge" data-bind="text: auctionStatusName, css: auctionStatusCssClass"></span>
                            <div class="d-flex align-items-center gap-2">
                                <!-- ko if: !isOwnAuction -->
                                <button class="btn btn-sm btn-link p-0" data-bind="click: function() { $parent.toggleWatch($data); }" title="@Html.T("Auctions.Watch", "Izle")">
                                    <!-- ko if: isWatching -->
                                    <i class="bi bi-eye-fill text-primary"></i>
                                    <!-- /ko -->
                                    <!-- ko ifnot: isWatching -->
                                    <i class="bi bi-eye text-muted"></i>
                                    <!-- /ko -->
                                </button>
                                <!-- /ko -->
                                <!-- ko if: isOwnAuction -->
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-link text-muted p-0" data-bs-toggle="dropdown">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <!-- ko if: auctionStatusId === 0 -->
                                        <li><a class="dropdown-item" href="#" data-bind="click: function() { $parent.editAuction($data); }">
                                            <i class="bi bi-pencil me-2"></i>@Html.T("Common.Edit", "Duzenle")
                                        </a></li>
                                        <li><a class="dropdown-item text-success" href="#" data-bind="click: function() { $parent.activateAuction($data); }">
                                            <i class="bi bi-play-circle me-2"></i>@Html.T("Auctions.Activate", "Aktiflestir")
                                        </a></li>
                                        <!-- /ko -->
                                        <!-- ko if: auctionStatusId !== 3 && auctionStatusId !== 5 -->
                                        <li><a class="dropdown-item text-danger" href="#" data-bind="click: function() { $parent.cancelAuction($data); }">
                                            <i class="bi bi-x-circle me-2"></i>@Html.T("Auctions.Cancel", "Iptal Et")
                                        </a></li>
                                        <!-- /ko -->
                                    </ul>
                                </div>
                                <!-- /ko -->
                            </div>
                        </div>

                        <!-- Category -->
                        <!-- ko if: categoryName -->
                        <small class="text-muted d-block mb-1">
                            <i class="bi bi-tag me-1"></i><span data-bind="text: categoryName"></span>
                        </small>
                        <!-- /ko -->

                        <!-- Title -->
                        <h6 class="card-title mb-2">
                            <a href="#" class="text-decoration-none text-dark" data-bind="text: title, click: function() { $parent.openDetail($data); }"></a>
                        </h6>

                        <!-- Vendor -->
                        <small class="text-muted d-block mb-3">
                            <i class="bi bi-building me-1"></i><span data-bind="text: vendorName"></span>
                        </small>

                        <!-- Prices -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted d-block">@Html.T("Auctions.StartingPrice", "Baslangic")</small>
                                    <span class="fw-semibold" data-bind="text: $parent.formatPrice(startingPrice, currency)"></span>
                                </div>
                                <div class="text-end">
                                    <small class="text-muted d-block">@Html.T("Auctions.CurrentBid", "Guncel Teklif")</small>
                                    <span class="fw-bold text-primary" data-bind="text: currentHighestBid > 0 ? $parent.formatPrice(currentHighestBid, currency) : '-'"></span>
                                </div>
                            </div>
                            <!-- ko if: buyNowPrice -->
                            <div class="mt-1">
                                <small class="text-success">
                                    <i class="bi bi-lightning me-1"></i>@Html.T("Auctions.BuyNow", "Hemen Al"):
                                    <span data-bind="text: $parent.formatPrice(buyNowPrice, currency)"></span>
                                </small>
                            </div>
                            <!-- /ko -->
                        </div>

                        <!-- Countdown -->
                        <div class="mb-3">
                            <small class="text-muted d-block mb-1">@Html.T("Auctions.TimeRemaining", "Kalan Sure")</small>
                            <span class="badge bg-dark" data-bind="text: $parent.getCountdown(endAt, auctionStatusId)"></span>
                        </div>

                        <!-- Stats -->
                        <div class="d-flex justify-content-between align-items-center border-top pt-2">
                            <small class="text-muted">
                                <i class="bi bi-hammer me-1"></i><span data-bind="text: bidCount"></span> @Html.T("Auctions.Bids", "teklif")
                            </small>
                            <small class="text-muted">
                                <i class="bi bi-eye me-1"></i><span data-bind="text: viewCount"></span>
                            </small>
                            <!-- ko if: !isOwnAuction && auctionStatusId === 2 -->
                            <button class="btn btn-sm btn-primary" data-bind="click: function() { $parent.openBidModal($data); }">
                                <i class="bi bi-hammer me-1"></i> @Html.T("Auctions.PlaceBid", "Teklif Ver")
                            </button>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pagination -->
        <div data-bind="visible: totalPages() > 1" class="d-flex justify-content-center mt-4">
            <nav>
                <ul class="pagination pagination-sm" data-bind="foreach: pageNumbers">
                    <li class="page-item" data-bind="css: { active: $data === $parent.currentPage() }">
                        <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>

    <!-- ============================================ -->
    <!-- CREATE/EDIT MODAL -->
    <!-- ============================================ -->
    <div class="modal fade" id="auctionFormModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" data-bind="text: editingId() ? '@Html.T("Auctions.Edit.Title", "Acik Artirmayi Duzenle")' : '@Html.T("Auctions.Create.Title", "Yeni Acik Artirma")'"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">@Html.T("Auctions.Form.Title", "Baslik") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: form.title" maxlength="200" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">@Html.T("Auctions.Form.Description", "Aciklama")</label>
                            <textarea class="form-control" rows="3" data-bind="value: form.description" maxlength="4000"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Html.T("Auctions.Form.Category", "Kategori")</label>
                            <select class="form-select"
                                    data-bind="options: categories, optionsText: 'name', optionsValue: 'id', optionsCaption: '@Html.T("Common.Select", "Secin...")', value: form.categoryId">
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Html.T("Auctions.Form.Currency", "Para Birimi")</label>
                            <select class="form-select" data-bind="value: form.currency">
                                <option value="USD">USD</option>
                                <option value="EUR">EUR</option>
                                <option value="TRY">TRY</option>
                                <option value="GBP">GBP</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@Html.T("Auctions.Form.StartingPrice", "Baslangic Fiyati") <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" data-bind="value: form.startingPrice" min="0" step="0.01" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@Html.T("Auctions.Form.ReservePrice", "Minimum Satis Fiyati")</label>
                            <input type="number" class="form-control" data-bind="value: form.reservePrice" min="0" step="0.01" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@Html.T("Auctions.Form.BuyNowPrice", "Hemen Al Fiyati")</label>
                            <input type="number" class="form-control" data-bind="value: form.buyNowPrice" min="0" step="0.01" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@Html.T("Auctions.Form.StartAt", "Baslangic Tarihi") <span class="text-danger">*</span></label>
                            <input type="datetime-local" class="form-control" data-bind="value: form.startAt" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@Html.T("Auctions.Form.EndAt", "Bitis Tarihi") <span class="text-danger">*</span></label>
                            <input type="datetime-local" class="form-control" data-bind="value: form.endAt" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@Html.T("Auctions.Form.AutoExtend", "Oto Uzatma (dk)")</label>
                            <input type="number" class="form-control" data-bind="value: form.autoExtendMinutes" min="0" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Cancel", "Iptal")</button>
                    <button type="button" class="btn btn-primary" data-bind="click: saveAuction, enable: !isSaving()">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>
                        @Html.T("Common.Save", "Kaydet")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================ -->
    <!-- BID MODAL -->
    <!-- ============================================ -->
    <div class="modal fade" id="bidModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Html.T("Auctions.Bid.Title", "Teklif Ver")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="text-center mb-3">
                        <h6 data-bind="text: bidAuction() ? bidAuction().title : ''"></h6>
                        <div class="d-flex justify-content-center gap-4 mt-2">
                            <div>
                                <small class="text-muted d-block">@Html.T("Auctions.StartingPrice", "Baslangic")</small>
                                <span data-bind="text: bidAuction() ? formatPrice(bidAuction().startingPrice, bidAuction().currency) : ''"></span>
                            </div>
                            <div>
                                <small class="text-muted d-block">@Html.T("Auctions.CurrentBid", "Guncel Teklif")</small>
                                <span class="fw-bold text-primary" data-bind="text: bidAuction() ? (bidAuction().currentHighestBid > 0 ? formatPrice(bidAuction().currentHighestBid, bidAuction().currency) : '-') : ''"></span>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Auctions.Bid.Amount", "Teklif Tutari") <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="number" class="form-control" data-bind="value: bidAmount" min="0" step="0.01" />
                            <span class="input-group-text" data-bind="text: bidAuction() ? bidAuction().currency : 'USD'"></span>
                        </div>
                        <small class="text-muted" data-bind="visible: bidAuction()">
                            @Html.T("Auctions.Bid.MinAmount", "Minimum teklif"):
                            <span data-bind="text: bidAuction() ? formatPrice(bidAuction().currentHighestBid > 0 ? bidAuction().currentHighestBid + 0.01 : bidAuction().startingPrice + 0.01, bidAuction().currency) : ''"></span>
                        </small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Auctions.Bid.Message", "Mesaj (Opsiyonel)")</label>
                        <textarea class="form-control" rows="2" data-bind="value: bidMessage" maxlength="500"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Cancel", "Iptal")</button>
                    <button type="button" class="btn btn-primary" data-bind="click: submitBid, enable: !isSaving()">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-hammer me-1" data-bind="visible: !isSaving()"></i>
                        @Html.T("Auctions.PlaceBid", "Teklif Ver")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================ -->
    <!-- DETAIL MODAL -->
    <!-- ============================================ -->
    <div class="modal fade" id="detailModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" data-bind="text: detailAuction() ? detailAuction().title : ''"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" data-bind="with: detailAuction">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <!-- Description -->
                            <!-- ko if: description -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">@Html.T("Auctions.Detail.Description", "Aciklama")</label>
                                <p style="white-space: pre-wrap;" data-bind="text: description"></p>
                            </div>
                            <!-- /ko -->

                            <!-- Product ref -->
                            <!-- ko if: productName -->
                            <div class="alert alert-info py-2">
                                <i class="bi bi-box-seam me-1"></i>
                                @Html.T("Auctions.Detail.Product", "Iliskili Urun"): <strong data-bind="text: productName"></strong>
                            </div>
                            <!-- /ko -->

                            <!-- Bid history -->
                            <h6 class="mt-3 mb-2">
                                <i class="bi bi-clock-history me-1"></i>@Html.T("Auctions.Detail.BidHistory", "Teklif Gecmisi")
                            </h6>
                            <!-- ko if: recentBids && recentBids.length > 0 -->
                            <div class="table-responsive">
                                <table class="table table-sm table-hover">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>@Html.T("Auctions.Detail.Bidder", "Teklif Veren")</th>
                                            <th class="text-end">@Html.T("Auctions.Detail.Amount", "Tutar")</th>
                                            <th>@Html.T("Auctions.Detail.Status", "Durum")</th>
                                            <th>@Html.T("Auctions.Detail.Date", "Tarih")</th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="foreach: recentBids">
                                        <tr>
                                            <td data-bind="text: bidSequence"></td>
                                            <td data-bind="text: buyerVendorName"></td>
                                            <td class="text-end fw-semibold" data-bind="text: $parents[1].formatPrice(bidAmount, $parent.currency)"></td>
                                            <td><span class="badge" data-bind="text: bidStatusName, css: bidStatusCssClass"></span></td>
                                            <td><small data-bind="text: $parents[1].formatDateTime(createdAt)"></small></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <!-- /ko -->
                            <!-- ko if: !recentBids || recentBids.length === 0 -->
                            <p class="text-muted small">@Html.T("Auctions.Detail.NoBids", "Henuz teklif verilmemis")</p>
                            <!-- /ko -->
                        </div>
                        <div class="col-md-4">
                            <!-- Info card -->
                            <div class="card bg-light">
                                <div class="card-body">
                                    <div class="mb-2">
                                        <small class="text-muted d-block">@Html.T("Auctions.Detail.Seller", "Satici")</small>
                                        <span class="fw-semibold" data-bind="text: vendorName"></span>
                                    </div>
                                    <div class="mb-2">
                                        <small class="text-muted d-block">@Html.T("Auctions.Detail.Status", "Durum")</small>
                                        <span class="badge" data-bind="text: auctionStatusName, css: auctionStatusCssClass"></span>
                                    </div>
                                    <!-- ko if: categoryName -->
                                    <div class="mb-2">
                                        <small class="text-muted d-block">@Html.T("Auctions.Detail.Category", "Kategori")</small>
                                        <span data-bind="text: categoryName"></span>
                                    </div>
                                    <!-- /ko -->
                                    <hr />
                                    <div class="mb-2">
                                        <small class="text-muted d-block">@Html.T("Auctions.StartingPrice", "Baslangic")</small>
                                        <span data-bind="text: $parent.formatPrice(startingPrice, currency)"></span>
                                    </div>
                                    <div class="mb-2">
                                        <small class="text-muted d-block">@Html.T("Auctions.CurrentBid", "Guncel Teklif")</small>
                                        <span class="fw-bold text-primary fs-5" data-bind="text: currentHighestBid > 0 ? $parent.formatPrice(currentHighestBid, currency) : '-'"></span>
                                    </div>
                                    <!-- ko if: buyNowPrice -->
                                    <div class="mb-2">
                                        <small class="text-muted d-block">@Html.T("Auctions.BuyNow", "Hemen Al")</small>
                                        <span class="text-success fw-semibold" data-bind="text: $parent.formatPrice(buyNowPrice, currency)"></span>
                                    </div>
                                    <!-- /ko -->
                                    <hr />
                                    <div class="mb-2">
                                        <small class="text-muted d-block">@Html.T("Auctions.Detail.StartDate", "Baslangic")</small>
                                        <span data-bind="text: $parent.formatDateTime(startAt)"></span>
                                    </div>
                                    <div class="mb-2">
                                        <small class="text-muted d-block">@Html.T("Auctions.Detail.EndDate", "Bitis")</small>
                                        <span data-bind="text: $parent.formatDateTime(endAt)"></span>
                                    </div>
                                    <div class="mb-2">
                                        <small class="text-muted d-block">@Html.T("Auctions.TimeRemaining", "Kalan Sure")</small>
                                        <span class="badge bg-dark" data-bind="text: $parent.getCountdown(endAt, auctionStatusId)"></span>
                                    </div>
                                    <hr />
                                    <div class="d-flex justify-content-between">
                                        <small><i class="bi bi-hammer me-1"></i><span data-bind="text: bidCount"></span> @Html.T("Auctions.Bids", "teklif")</small>
                                        <small><i class="bi bi-eye me-1"></i><span data-bind="text: viewCount"></span></small>
                                    </div>
                                    <!-- ko if: !isOwnAuction && auctionStatusId === 2 -->
                                    <button class="btn btn-primary w-100 mt-3" data-bind="click: function() { $parent.openBidModal($data); }">
                                        <i class="bi bi-hammer me-1"></i> @Html.T("Auctions.PlaceBid", "Teklif Ver")
                                    </button>
                                    <!-- /ko -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Auctions/Index.js" asp-append-version="true"></script>
}
