                                <h6 class="mb-2">Tedarikci</h6>
                                <p class="mb-0 fw-bold" data-bind="text: companyName || externalCompanyName"></p>
                            </div>
                            <div class="col-md-3">
                                <h6 class="mb-2">Birim Fiyat</h6>
                                <p class="mb-0">
                                    <span data-bind="text: unitPrice ? unitPrice.toLocaleString('tr-TR', {minimumFractionDigits: 2}) : '-'"></span>
                                    <small data-bind="text: currency || 'TRY'"></small>
                                </p>
                            </div>
                            <div class="col-md-3">
                                <h6 class="mb-2">Toplam</h6>
                                <p class="mb-0 fw-bold text-success">
                                    <span data-bind="text: totalPrice ? totalPrice.toLocaleString('tr-TR', {minimumFractionDigits: 2}) : '-'"></span>
                                    <small data-bind="text: currency || 'TRY'"></small>
                                </p>
                            </div>
                        </div>
