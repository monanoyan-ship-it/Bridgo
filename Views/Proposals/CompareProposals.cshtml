<!-- Create Demand Modal -->
<div class="modal fade" id="createDemandModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-megaphone me-2"></i>Yeni Talep
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="demandForm">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Baslik *</label>
                            <input type="text" class="form-control" data-bind="value: demandForm.title" required maxlength="200" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Kategori</label>
                            <select class="form-select" data-bind="value: demandForm.categoryId, options: categories, optionsText: 'name', optionsValue: 'id', optionsCaption: 'Kategori Sec'"></select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Miktar</label>
                            <input type="number" class="form-control" data-bind="value: demandForm.quantity" min="1" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Birim</label>
                            <select class="form-select" data-bind="options: units, optionsValue: 'id', optionsText: 'name', value: demandForm.unitId, optionsCaption: 'Seciniz...'"></select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Aciklama *</label>
                            <textarea class="form-control" rows="4" data-bind="value: demandForm.description" required></textarea>
