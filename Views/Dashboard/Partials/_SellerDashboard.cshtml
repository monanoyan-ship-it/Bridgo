@* Seller Dashboard - Satici (Capability ID: 2) *@

<!-- Stats -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card border-0 shadow-sm bg-warning text-dark">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1 opacity-75">@Html.T("Dashboard.Stats.PendingOrders", "Bekleyen Siparisler")</h6>
                        <h2 class="mb-0" data-bind="text: stats().pendingOrders || 0"></h2>
                    </div>
                    <i class="bi bi-hourglass-split" style="font-size: 2.5rem; opacity: 0.5;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-0 shadow-sm bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1 opacity-75">@Html.T("Dashboard.Stats.ProcessingOrders", "Islenen Siparisler")</h6>
                        <h2 class="mb-0" data-bind="text: stats().processingOrders || 0"></h2>
                    </div>
                    <i class="bi bi-gear" style="font-size: 2.5rem; opacity: 0.5;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-0 shadow-sm bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1 opacity-75">@Html.T("Dashboard.Stats.MonthlyRevenue", "Aylik Gelir")</h6>
                        <h2 class="mb-0" data-bind="text: formatCurrency(stats().monthlyRevenue, stats().revenueCurrency)"></h2>
                    </div>
                    <i class="bi bi-currency-exchange" style="font-size: 2.5rem; opacity: 0.5;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-0 shadow-sm bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1 opacity-75">@Html.T("Dashboard.Stats.ActiveProducts", "Aktif Urunler")</h6>
                        <h2 class="mb-0" data-bind="text: stats().activeProducts || 0"></h2>
                    </div>
                    <i class="bi bi-box-seam" style="font-size: 2.5rem; opacity: 0.5;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-exclamation-triangle text-danger" style="font-size: 2rem;"></i>
                <h3 class="mt-2 mb-1" data-bind="text: stats().lowStockProducts || 0"></h3>
                <small class="text-muted">@Html.T("Dashboard.Stats.LowStock", "Dusuk Stok")</small>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-envelope text-info" style="font-size: 2rem;"></i>
                <h3 class="mt-2 mb-1" data-bind="text: stats().newInquiries || 0"></h3>
                <small class="text-muted">@Html.T("Dashboard.Stats.NewInquiries", "Yeni Sorular")</small>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-clock-history text-warning" style="font-size: 2rem;"></i>
                <h3 class="mt-2 mb-1" data-bind="text: stats().pendingDemandResponses || 0"></h3>
                <small class="text-muted">@Html.T("Dashboard.Stats.PendingResponses", "Bekleyen Teklifler")</small>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Recent Orders -->
    <div class="col-lg-8 mb-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>@Html.T("Dashboard.RecentOrders", "Son Siparisler")</h5>
                <a href="/Orders" class="btn btn-sm btn-outline-primary">@Html.T("Common.ViewAll", "Tumu")</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Html.T("Dashboard.Table.OrderNo", "Siparis No")</th>
                                <th>@Html.T("Dashboard.Table.Customer", "Musteri")</th>
                                <th>@Html.T("Dashboard.Table.Amount", "Tutar")</th>
                                <th>@Html.T("Admin.Table.Status", "Durum")</th>
                                <th>@Html.T("Dashboard.Table.Date", "Tarih")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: recentOrders">
                            <tr>
                                <td><strong data-bind="text: orderNumber"></strong></td>
                                <td data-bind="text: customerName"></td>
                                <td data-bind="text: $parent.formatCurrency(totalAmount, currency)"></td>
                                <td><span class="badge" data-bind="text: statusName, css: statusCssClass"></span></td>
                                <td data-bind="text: $parent.formatDate(createdAt)"></td>
                            </tr>
                        </tbody>
                        <!-- ko if: recentOrders().length === 0 -->
                        <tbody>
                            <tr><td colspan="5" class="text-center text-muted py-4">@Html.T("Common.NoData", "Veri bulunamadi")</td></tr>
                        </tbody>
                        <!-- /ko -->
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Inquiries -->
    <div class="col-lg-4 mb-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0">
                <h5 class="mb-0"><i class="bi bi-question-circle me-2"></i>@Html.T("Dashboard.RecentInquiries", "Son Sorular")</h5>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush" data-bind="foreach: recentInquiries">
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong data-bind="text: productName"></strong>
                                <br><small class="text-muted" data-bind="text: buyerName"></small>
                            </div>
                            <span class="badge" data-bind="css: isRead ? 'bg-secondary' : 'bg-warning'">
                                <span data-bind="text: quantity"></span> adet
                            </span>
                        </div>
                    </li>
                </ul>
                <!-- ko if: recentInquiries().length === 0 -->
                <div class="text-center text-muted py-4">@Html.T("Common.NoData", "Veri bulunamadi")</div>
                <!-- /ko -->
            </div>
        </div>
    </div>
</div>

<!-- Top Products -->
<div class="row">
    <div class="col-12 mb-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0">
                <h5 class="mb-0"><i class="bi bi-trophy me-2"></i>@Html.T("Dashboard.TopProducts", "En Cok Satan Urunler")</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Html.T("Common.Product", "Urun")</th>
                                <th>@Html.T("Dashboard.Table.SoldQuantity", "Satilan")</th>
                                <th>@Html.T("Dashboard.Table.Revenue", "Gelir")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: topProducts">
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <!-- ko if: imageUrl -->
                                        <img data-bind="attr: { src: imageUrl }" class="rounded me-2" style="width: 40px; height: 40px; object-fit: cover;" />
                                        <!-- /ko -->
                                        <!-- ko ifnot: imageUrl -->
                                        <div class="bg-light rounded me-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            <i class="bi bi-box text-muted"></i>
                                        </div>
                                        <!-- /ko -->
                                        <span data-bind="text: name"></span>
                                    </div>
                                </td>
                                <td data-bind="text: soldQuantity"></td>
                                <td data-bind="text: $parent.formatCurrency(revenue, currency)"></td>
                            </tr>
                        </tbody>
                        <!-- ko if: topProducts().length === 0 -->
                        <tbody>
                            <tr><td colspan="3" class="text-center text-muted py-4">@Html.T("Common.NoData", "Veri bulunamadi")</td></tr>
                        </tbody>
                        <!-- /ko -->
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
