<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bridgo</title>

    <!-- CSS - Yerel Dosyalar (CDN KULLANILMAZ - Offline uyumluluk) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Head", required: false)
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-truck"></i> Bridgo
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house"></i> @Html.T("Nav.Home")
                            </a>
                        </li>
                        <!-- Public Marketplace Links -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Catalog" asp-action="Index">
                                <i class="bi bi-grid-3x3-gap"></i> @Html.T("Nav.Products", "Urunler")
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Suppliers" asp-action="Index">
                                <i class="bi bi-shop"></i> @Html.T("Nav.Suppliers", "Tedarikciler")
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                        <i class="bi bi-shield-lock"></i> @Html.T("Nav.AdminPanel")
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-speedometer2"></i> @Html.T("Nav.Dashboard")
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle"></i> @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">@Html.T("Nav.Profile")</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">
                                                <i class="bi bi-box-arrow-right"></i> @Html.T("Nav.Logout")
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> @Html.T("Nav.Login")
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus"></i> @Html.T("Nav.Register")
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @if (ViewData["FullWidth"] != null && (bool)ViewData["FullWidth"])
    {
        <main role="main">
            @RenderBody()
        </main>
    }
    else
    {
        <div class="container-fluid py-4">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    }

    <footer class="border-top footer text-muted py-3 mt-auto">
        <div class="container">
            <div class="d-flex justify-content-between">
                <span>&copy; 2025 - @Html.T("Common.AppName")</span>
                <span>v1.0.0</span>
            </div>
        </div>
    </footer>

    <!-- Shared Confirm Modal -->
    <div class="modal fade" id="sharedConfirmModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmModalTitle">@Html.T("Common.Confirm")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p id="confirmModalMessage"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Cancel")</button>
                    <button type="button" class="btn" id="confirmModalBtn">
                        <i id="confirmModalIcon"></i> <span id="confirmModalBtnText">@Html.T("Common.Confirm")</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- JavaScript - Yerel Dosyalar -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/knockout/knockout-latest.js"></script>
    <script src="~/lib/toastr/toastr.min.js"></script>
    <script src="~/js/Shared/confirm-modal.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Toastr default settings
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "3000"
        };
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
