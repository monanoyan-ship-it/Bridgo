@using Bridgo.Extensions
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="demands-app" class="container py-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col">
            <h1 class="h2 mb-2">
                <i class="bi bi-megaphone text-primary"></i>
                @Html.T("Demands.Title", "Talepler")
            </h1>
            <p class="text-muted">
                @Html.T("Demands.Subtitle", "B2B alici talepleri. Aradiginiz urunu bulamadiniz mi? Teklif verin!")
            </p>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="@Html.T("Common.Search", "Ara...")"
                               data-bind="value: filter.search, valueUpdate: 'afterkeydown'" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select" data-bind="value: filter.categoryId, options: categories, optionsText: 'name', optionsValue: 'id', optionsCaption: '@Html.T("Common.AllCategories", "Tum Kategoriler")'"></select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" data-bind="value: filter.countryId, options: countries, optionsText: 'name', optionsValue: 'id', optionsCaption: '@Html.T("Common.AllCountries", "Tum Ulkeler")'"></select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary w-100" data-bind="click: resetFilters">
                        <i class="bi bi-x-circle"></i> @Html.T("Common.Reset", "Sifirla")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@Html.T("Common.Loading", "Yukleniyor...")</span>
        </div>
    </div>

    <!-- Results -->
    <div data-bind="visible: !isLoading()">
        <!-- Stats -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="text-muted" data-bind="text: totalCount() + ' talep bulundu'"></span>
            <select class="form-select form-select-sm w-auto" data-bind="value: filter.sortBy">
                <option value="">@Html.T("Common.SortBy", "Sirala"): @Html.T("Common.Newest", "En Yeni")</option>
                <option value="responses">@Html.T("Demands.MostResponses", "En Cok Yanit")</option>
                <option value="views">@Html.T("Demands.MostViews", "En Cok Goruntulenme")</option>
                <option value="expires">@Html.T("Demands.ExpiresSoon", "Yakinda Kapanacak")</option>
            </select>
        </div>

        <!-- Empty State -->
        <div data-bind="visible: demands().length === 0" class="text-center py-5">
            <i class="bi bi-inbox display-1 text-muted"></i>
            <h5 class="mt-3 text-muted">@Html.T("Demands.NoResults", "Talep bulunamadi")</h5>
            <p class="text-muted">@Html.T("Demands.TryDifferentFilters", "Farkli filtreler deneyin")</p>
        </div>

        <!-- Demand Cards -->
        <div class="row g-4" data-bind="foreach: demands">
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm demand-card">
                    <div class="card-body">
                        <!-- Category Badge -->
                        <div class="mb-2" data-bind="visible: categoryName">
                            <span class="badge bg-light text-dark" data-bind="text: categoryName"></span>
                        </div>

                        <!-- Title -->
                        <h5 class="card-title">
                            <a data-bind="attr: { href: '/Demands/' + slug }, text: title" class="text-decoration-none text-dark stretched-link"></a>
                        </h5>

                        <!-- Description -->
                        <p class="card-text text-muted small" data-bind="text: description ? description.substring(0, 120) + '...' : ''"></p>

                        <!-- Details -->
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="badge bg-primary" data-bind="visible: quantity, text: quantity + ' ' + (unit || 'Adet')"></span>
                            <span class="badge bg-secondary" data-bind="visible: countryName">
                                <i class="bi bi-geo-alt"></i> <span data-bind="text: countryName"></span>
                            </span>
                            <span class="badge bg-info" data-bind="visible: hasReferenceProduct">
                                <i class="bi bi-link-45deg"></i> Referans Urun
                            </span>
                        </div>

                        <!-- Budget -->
                        <div data-bind="visible: budgetMin || budgetMax" class="mb-2">
                            <small class="text-success">
                                <i class="bi bi-currency-exchange"></i>
                                <span data-bind="visible: budgetMin, text: budgetMin?.toLocaleString()"></span>
                                <span data-bind="visible: budgetMin && budgetMax"> - </span>
                                <span data-bind="visible: budgetMax, text: budgetMax?.toLocaleString()"></span>
                                <span data-bind="text: budgetCurrency || 'TRY'"></span>
                            </small>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent">
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                <i class="bi bi-building"></i> <span data-bind="text: vendorName || 'Anonim'"></span>
                            </small>
                            <div>
                                <span class="badge bg-light text-dark me-1" title="Goruntulenme">
                                    <i class="bi bi-eye"></i> <span data-bind="text: viewCount"></span>
                                </span>
                                <span class="badge bg-success" title="Teklif">
                                    <i class="bi bi-chat-dots"></i> <span data-bind="text: responseCount"></span>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pagination -->
        <nav class="mt-4" data-bind="visible: totalPages() > 1">
            <ul class="pagination justify-content-center">
                <li class="page-item" data-bind="css: { disabled: currentPage() <= 1 }">
                    <a class="page-link" href="#" data-bind="click: function() { goToPage(currentPage() - 1); }">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                <!-- ko foreach: visiblePages -->
                <li class="page-item" data-bind="css: { active: $data === $parent.currentPage() }">
                    <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                </li>
                <!-- /ko -->
                <li class="page-item" data-bind="css: { disabled: currentPage() >= totalPages() }">
                    <a class="page-link" href="#" data-bind="click: function() { goToPage(currentPage() + 1); }">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>

    <!-- CTA for suppliers -->
    <div class="card bg-primary text-white mt-5">
        <div class="card-body text-center py-4">
            <h4><i class="bi bi-shop"></i> @Html.T("Demands.SupplierCTA.Title", "Tedarikci misiniz?")</h4>
            <p class="mb-3">@Html.T("Demands.SupplierCTA.Text", "Kayit olun, taleplere teklif verin, yeni musteriler kazanin!")</p>
            <a href="/Account/Register" class="btn btn-light btn-lg">
                <i class="bi bi-person-plus"></i> @Html.T("Common.Register", "Kayit Ol")
            </a>
        </div>
    </div>
</div>

@section Styles {
<style>
    .demand-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        transition: all 0.2s ease-in-out;
    }
    .demand-card .stretched-link::after {
        z-index: 1;
    }
    .demand-card .badge {
        position: relative;
        z-index: 2;
    }
</style>
}

@section Scripts {
<script src="~/js/Demands/Index.js"></script>
}
