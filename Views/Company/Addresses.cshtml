@{
    ViewData["Title"] = Html.T("Company.Addresses.Title", "Adresler").ToString();
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
}

<div id="addresses-app">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1"><i class="bi bi-geo-alt me-2"></i>@Html.T("Company.Addresses.Title", "Adresler")</h4>
            <p class="text-muted mb-0">@Html.T("Company.Addresses.Description", "Fatura, sevkiyat ve diger adresleri yonetin")</p>
        </div>
        <button class="btn btn-primary" data-bind="click: openAddModal">
            <i class="bi bi-plus-circle"></i> @Html.T("Company.Addresses.AddNew", "Yeni Adres")
        </button>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>

    <!-- Empty State -->
    <div data-bind="visible: !isLoading() && addresses().length === 0" class="text-center py-5">
        <i class="bi bi-geo-alt text-muted" style="font-size: 3rem;"></i>
        <p class="mt-3 text-muted">@Html.T("Company.Addresses.Empty", "Henuz adres eklenmemis")</p>
        <button class="btn btn-primary" data-bind="click: openAddModal">
            <i class="bi bi-plus-circle"></i> @Html.T("Company.Addresses.AddFirst", "Ilk Adresi Ekle")
        </button>
    </div>

    <!-- Address Table -->
    <div data-bind="visible: !isLoading() && addresses().length > 0" class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Html.T("Address.Fields.Title", "Adres Basligi")</th>
                        <th>@Html.T("Address.Fields.Type", "Tip")</th>
                        <th>@Html.T("Address.Fields.Address", "Adres")</th>
                        <th>@Html.T("Address.Fields.Contact", "Yetkili")</th>
                        <th class="text-end" style="width: 120px;">@Html.T("Common.Actions", "Islemler")</th>
                    </tr>
                </thead>
                <tbody data-bind="foreach: addresses">
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <span data-bind="text: title" class="fw-medium"></span>
                                <span data-bind="visible: isDefault" class="badge bg-primary ms-2">@Html.T("Common.Default", "Varsayilan")</span>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark">
                                <i class="bi me-1" data-bind="class: typeIcon"></i>
                                <span data-bind="text: typeName"></span>
                            </span>
                        </td>
                        <td>
                            <div class="small">
                                <div data-bind="text: fullAddress"></div>
                                <div class="text-muted">
                                    <i class="bi bi-globe2"></i> <span data-bind="text: country"></span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="small">
                                <div data-bind="visible: contactName">
                                    <i class="bi bi-person"></i> <span data-bind="text: contactName"></span>
                                </div>
                                <div data-bind="visible: contactPhone" class="text-muted">
                                    <i class="bi bi-telephone"></i> <span data-bind="text: contactPhone"></span>
                                </div>
                            </div>
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary me-1" data-bind="click: $parent.editAddress" title="@Html.T("Common.Edit", "Duzenle")">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.deleteAddress, visible: !isDefault" title="@Html.T("Common.Delete", "Sil")">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Add/Edit Modal -->
    <div class="modal fade" data-bind="css: { show: showModal }, style: { display: showModal() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form data-bind="submit: saveAddress">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="bi bi-geo-alt"></i>
                            <span data-bind="text: isEditing() ? '@Html.T("Company.Addresses.Edit", "Adres Duzenle")' : '@Html.T("Company.Addresses.AddNew", "Yeni Adres")'"></span>
                        </h5>
                        <button type="button" class="btn-close" data-bind="click: closeModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">@Html.T("Address.Fields.Title", "Adres Basligi") <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" data-bind="value: form().title" required maxlength="100" placeholder="@Html.T("Address.Fields.Title.Placeholder", "Merkez Ofis")" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">@Html.T("Address.Fields.Type", "Adres Tipi")</label>
                                <select class="form-select" data-bind="value: form().type, options: addressTypes, optionsText: 'name', optionsValue: 'id'">
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">@Html.T("Address.Fields.Country", "Ulke") <span class="text-danger">*</span></label>
                                <select class="form-select" data-bind="value: form().countryId, options: countries, optionsText: 'name', optionsValue: 'id', optionsCaption: '@Html.T("Common.Select", "Secin...")', event: { change: onCountryChange }" required>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3" data-bind="visible: states().length > 0">
                                <label class="form-label">@Html.T("Address.Fields.State", "Eyalet") <span class="text-danger" data-bind="visible: states().length > 0">*</span></label>
                                <select class="form-select" data-bind="value: form().stateId, options: states, optionsText: 'name', optionsValue: 'id', optionsCaption: '@Html.T("Common.Select", "Secin...")', attr: { required: states().length > 0 }">
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">@Html.T("Address.Fields.City", "Il") <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" data-bind="value: form().city" required maxlength="100" placeholder="@Html.T("Address.Fields.City.Placeholder", "Istanbul")" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">@Html.T("Address.Fields.District", "Ilce") <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" data-bind="value: form().district" required maxlength="100" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">@Html.T("Address.Fields.PostalCode", "Posta Kodu")</label>
                                <input type="text" class="form-control" data-bind="value: form().postalCode" maxlength="10" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@Html.T("Address.Fields.AddressLine", "Adres") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: form().addressLine" required maxlength="500" placeholder="@Html.T("Address.Fields.AddressLine.Placeholder", "Sokak, Bina No, Kat, Daire")" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">@Html.T("Address.Fields.ContactName", "Yetkili Kisi")</label>
                                <input type="text" class="form-control" data-bind="value: form().contactName" maxlength="200" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">@Html.T("Address.Fields.ContactPhone", "Yetkili Telefon")</label>
                                <input type="text" class="form-control" data-bind="value: form().contactPhone" maxlength="20" />
                            </div>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" data-bind="checked: form().isDefault" id="isDefault">
                            <label class="form-check-label" for="isDefault">@Html.T("Address.Fields.IsDefault", "Varsayilan adres olarak ayarla")</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bind="click: closeModal">@Html.T("Common.Cancel", "Iptal")</button>
                        <button type="submit" class="btn btn-primary" data-bind="disable: isSaving">
                            <span data-bind="visible: !isSaving()"><i class="bi bi-check-circle"></i> @Html.T("Common.Save", "Kaydet")</span>
                            <span data-bind="visible: isSaving()"><span class="spinner-border spinner-border-sm"></span> @Html.T("Common.Saving", "Kaydediliyor...")</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: showModal }, style: { display: showModal() ? 'block' : 'none' }"></div>
</div>

@section Scripts {
    <script src="~/js/Company/Addresses.js" asp-append-version="true"></script>
}
