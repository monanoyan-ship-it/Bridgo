@{
    ViewData["Title"] = "Raporlar";
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
}

<div id="reports-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0">Raporlar</h4>
        <div class="btn-group">
            <button type="button" class="btn btn-outline-primary"
                    data-bind="click: function() { activeTab('seller'); }, css: { 'active': activeTab() === 'seller' }">
                <i class="bi bi-shop me-1"></i> Satici Raporlari
            </button>
            <button type="button" class="btn btn-outline-primary"
                    data-bind="click: function() { activeTab('buyer'); }, css: { 'active': activeTab() === 'buyer' }">
                <i class="bi bi-cart me-1"></i> Alici Raporlari
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-3">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Baslangic Tarihi</label>
                    <input type="date" class="form-control" data-bind="value: filter.fromDate">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Bitis Tarihi</label>
                    <input type="date" class="form-control" data-bind="value: filter.toDate">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Periyot</label>
                    <select class="form-select" data-bind="value: filter.period">
                        <option value="day">Gunluk</option>
                        <option value="week">Haftalik</option>
                        <option value="month">Aylik</option>
                        <option value="year">Yillik</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" data-bind="click: loadReport">
                        <i class="bi bi-bar-chart me-1"></i> Rapor Getir
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div class="text-center py-5" data-bind="visible: isLoading">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Yukleniyor...</span>
        </div>
    </div>

    <!-- Seller Reports -->
    <div data-bind="visible: activeTab() === 'seller' && !isLoading()">
        <!-- Overview Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="bg-success bg-opacity-10 rounded-3 p-3 me-3">
                                <i class="bi bi-cash-stack text-success fs-4"></i>
                            </div>
                            <div>
                                <h4 class="mb-0" data-bind="text: formatCurrency(sellerReport().overview?.totalRevenue || 0)">0</h4>
                                <small class="text-muted">Toplam Gelir</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="bg-primary bg-opacity-10 rounded-3 p-3 me-3">
                                <i class="bi bi-bag text-primary fs-4"></i>
                            </div>
                            <div>
                                <h4 class="mb-0" data-bind="text: sellerReport().overview?.totalOrders || 0">0</h4>
                                <small class="text-muted">Toplam Siparis</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="bg-warning bg-opacity-10 rounded-3 p-3 me-3">
                                <i class="bi bi-clock text-warning fs-4"></i>
                            </div>
                            <div>
                                <h4 class="mb-0" data-bind="text: sellerReport().overview?.pendingOrders || 0">0</h4>
                                <small class="text-muted">Bekleyen Siparis</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="bg-danger bg-opacity-10 rounded-3 p-3 me-3">
                                <i class="bi bi-exclamation-triangle text-danger fs-4"></i>
                            </div>
                            <div>
                                <h4 class="mb-0" data-bind="text: sellerReport().overview?.lowStockProducts || 0">0</h4>
                                <small class="text-muted">Dusuk Stok</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <!-- Sales Chart -->
            <div class="col-md-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white">
                        <h6 class="mb-0">Satis Grafigi</h6>
                    </div>
                    <div class="card-body">
                        <canvas id="salesChart" height="250"></canvas>
                    </div>
                </div>
            </div>

            <!-- Top Products -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white">
                        <h6 class="mb-0">En Cok Satan Urunler</h6>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush" data-bind="foreach: sellerReport().topProducts || []">
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <span data-bind="text: productName"></span>
                                    <small class="text-muted d-block" data-bind="text: sku"></small>
                                </div>
                                <span class="badge bg-primary rounded-pill" data-bind="text: totalQuantity + ' adet'"></span>
                            </li>
                        </ul>
                        <div class="text-center py-3" data-bind="visible: (sellerReport().topProducts || []).length === 0">
                            <small class="text-muted">Henuz veri yok</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top Customers -->
        <div class="row g-3 mt-3">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white">
                        <h6 class="mb-0">En Iyi Musteriler</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Musteri</th>
                                        <th class="text-center">Siparis Sayisi</th>
                                        <th class="text-end">Toplam Harcama</th>
                                        <th class="text-end">Son Siparis</th>
                                    </tr>
                                </thead>
                                <tbody data-bind="foreach: sellerReport().topCustomers || []">
                                    <tr>
                                        <td data-bind="text: vendorName"></td>
                                        <td class="text-center" data-bind="text: orderCount"></td>
                                        <td class="text-end" data-bind="text: formatCurrency(totalSpent)"></td>
                                        <td class="text-end" data-bind="text: formatDate(lastOrderDate)"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="text-center py-3" data-bind="visible: (sellerReport().topCustomers || []).length === 0">
                            <small class="text-muted">Henuz veri yok</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Buyer Reports -->
    <div data-bind="visible: activeTab() === 'buyer' && !isLoading()">
        <!-- Overview Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="bg-danger bg-opacity-10 rounded-3 p-3 me-3">
                                <i class="bi bi-wallet2 text-danger fs-4"></i>
                            </div>
                            <div>
                                <h4 class="mb-0" data-bind="text: formatCurrency(buyerReport().overview?.totalSpent || 0)">0</h4>
                                <small class="text-muted">Toplam Harcama</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="bg-primary bg-opacity-10 rounded-3 p-3 me-3">
                                <i class="bi bi-bag text-primary fs-4"></i>
                            </div>
                            <div>
                                <h4 class="mb-0" data-bind="text: buyerReport().overview?.totalOrders || 0">0</h4>
                                <small class="text-muted">Toplam Siparis</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="bg-info bg-opacity-10 rounded-3 p-3 me-3">
                                <i class="bi bi-megaphone text-info fs-4"></i>
                            </div>
                            <div>
                                <h4 class="mb-0" data-bind="text: buyerReport().overview?.activeDemands || 0">0</h4>
                                <small class="text-muted">Aktif Talep</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="bg-success bg-opacity-10 rounded-3 p-3 me-3">
                                <i class="bi bi-file-earmark-check text-success fs-4"></i>
                            </div>
                            <div>
                                <h4 class="mb-0" data-bind="text: buyerReport().overview?.receivedProposals || 0">0</h4>
                                <small class="text-muted">Gelen Teklif</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <!-- Purchases Chart -->
            <div class="col-md-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white">
                        <h6 class="mb-0">Satin Alma Grafigi</h6>
                    </div>
                    <div class="card-body">
                        <canvas id="purchasesChart" height="250"></canvas>
                    </div>
                </div>
            </div>

            <!-- Top Suppliers -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white">
                        <h6 class="mb-0">En Cok Alisveris Yapilan Tedarikciler</h6>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush" data-bind="foreach: buyerReport().topSuppliers || []">
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span data-bind="text: vendorName"></span>
                                <span class="badge bg-success rounded-pill" data-bind="text: formatCurrency(totalSpent)"></span>
                            </li>
                        </ul>
                        <div class="text-center py-3" data-bind="visible: (buyerReport().topSuppliers || []).length === 0">
                            <small class="text-muted">Henuz veri yok</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top Products -->
        <div class="row g-3 mt-3">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white">
                        <h6 class="mb-0">En Cok Alinan Urunler</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Urun</th>
                                        <th>Tedarikci</th>
                                        <th class="text-center">Miktar</th>
                                        <th class="text-end">Toplam Harcama</th>
                                    </tr>
                                </thead>
                                <tbody data-bind="foreach: buyerReport().topProducts || []">
                                    <tr>
                                        <td data-bind="text: productName"></td>
                                        <td data-bind="text: supplierName"></td>
                                        <td class="text-center" data-bind="text: totalQuantity"></td>
                                        <td class="text-end" data-bind="text: formatCurrency(totalSpent)"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="text-center py-3" data-bind="visible: (buyerReport().topProducts || []).length === 0">
                            <small class="text-muted">Henuz veri yok</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/Dashboard/Reports.js"></script>
}
