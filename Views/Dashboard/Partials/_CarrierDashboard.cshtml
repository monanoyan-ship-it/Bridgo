@* Carrier Dashboard - Tasimaci (Capability ID: 4) *@

<!-- Stats -->
<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <div class="card border-0 shadow-sm bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1 opacity-75">@Html.T("Dashboard.Stats.OpenRequests", "Acik Talepler")</h6>
                        <h2 class="mb-0" data-bind="text: stats().openRequests || 0"></h2>
                    </div>
                    <i class="bi bi-inbox" style="font-size: 2.5rem; opacity: 0.5;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-0 shadow-sm bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1 opacity-75">@Html.T("Dashboard.Stats.ActiveShipments", "Aktif Sevkiyatlar")</h6>
                        <h2 class="mb-0" data-bind="text: stats().activeShipments || 0"></h2>
                    </div>
                    <i class="bi bi-truck" style="font-size: 2.5rem; opacity: 0.5;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-0 shadow-sm bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1 opacity-75">@Html.T("Dashboard.Stats.MonthlyEarnings", "Aylik Kazanc")</h6>
                        <h2 class="mb-0" data-bind="text: formatCurrency(stats().monthlyEarnings, stats().earningsCurrency)"></h2>
                    </div>
                    <i class="bi bi-cash-stack" style="font-size: 2.5rem; opacity: 0.5;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6 mb-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-hourglass-split text-warning" style="font-size: 2rem;"></i>
                <h3 class="mt-2 mb-1" data-bind="text: stats().pendingQuotes || 0"></h3>
                <small class="text-muted">@Html.T("Dashboard.Stats.PendingQuotes", "Bekleyen Teklifler")</small>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-check-circle text-success" style="font-size: 2rem;"></i>
                <h3 class="mt-2 mb-1" data-bind="text: stats().completedThisMonth || 0"></h3>
                <small class="text-muted">@Html.T("Dashboard.Stats.CompletedThisMonth", "Bu Ay Tamamlanan")</small>
            </div>
        </div>
    </div>
</div>

<!-- Recent Requests -->
<div class="row">
    <div class="col-12 mb-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>@Html.T("Dashboard.RecentRequests", "Son Talepler")</h5>
                <a href="/ServiceProvider/Logistics" class="btn btn-sm btn-outline-primary">@Html.T("Common.ViewAll", "Tumu")</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Html.T("Common.Title", "Baslik")</th>
                                <th>@Html.T("Common.Requestor", "Talep Eden")</th>
                                <th>@Html.T("Admin.Table.Status", "Durum")</th>
                                <th>@Html.T("Dashboard.Table.Date", "Tarih")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: recentRequests">
                            <tr>
                                <td data-bind="text: title"></td>
                                <td data-bind="text: requestorName"></td>
                                <td><span class="badge bg-secondary" data-bind="text: statusName"></span></td>
                                <td data-bind="text: $parent.formatDate(createdAt)"></td>
                            </tr>
                        </tbody>
                        <!-- ko if: recentRequests().length === 0 -->
                        <tbody>
                            <tr><td colspan="4" class="text-center text-muted py-4">@Html.T("Common.NoData", "Veri bulunamadi")</td></tr>
                        </tbody>
                        <!-- /ko -->
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
