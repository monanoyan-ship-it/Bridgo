@{
    ViewData["Title"] = "Yatirim Firsatlari";
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
}

<div id="investment-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1"><i class="bi bi-cash-stack text-success"></i> Yatirim Firsatlari</h4>
            <p class="text-muted mb-0">Finansman taleplerini goruntuleyin ve teklif verin</p>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#opportunities"
               data-bind="css: { active: currentTab() === 'opportunities' }, click: function() { currentTab('opportunities'); }">
                <i class="bi bi-collection"></i> Firsatlar
                <span class="badge bg-success ms-1" data-bind="text: opportunities().length, visible: opportunities().length > 0"></span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#myOffers"
               data-bind="css: { active: currentTab() === 'offers' }, click: function() { currentTab('offers'); }">
                <i class="bi bi-send-check"></i> Tekliflerim
                <span class="badge bg-primary ms-1" data-bind="text: myOffers().length, visible: myOffers().length > 0"></span>
            </a>
        </li>
    </ul>

    <!-- Opportunities Tab -->
    <div data-bind="visible: currentTab() === 'opportunities'">
        <!-- Filters -->
        <div class="card mb-3">
            <div class="card-body py-2">
                <div class="row g-2 align-items-center">
                    <div class="col-md-3">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control" placeholder="Ara..." data-bind="textInput: searchTerm" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select form-select-sm" data-bind="value: financingTypeFilter">
                            <option value="">Tum Tipler</option>
                            <option value="1">Fatura Finansmani</option>
                            <option value="2">Siparis Finansmani</option>
                            <option value="3">Proje Finansmani</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-sm btn-outline-secondary w-100" data-bind="click: loadOpportunities">
                            <i class="bi bi-arrow-clockwise"></i> Yenile
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Loading -->
        <div data-bind="visible: isLoading()" class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-2 text-muted">Yukleniyor...</p>
        </div>

        <!-- Empty State -->
        <div data-bind="visible: !isLoading() && filteredOpportunities().length === 0" class="text-center py-5">
            <i class="bi bi-wallet2 display-1 text-muted"></i>
            <p class="mt-3 text-muted">Aktif finansman firsati bulunamadi</p>
        </div>

        <!-- Opportunity Cards -->
        <div class="row" data-bind="foreach: filteredOpportunities">
            <div class="col-lg-6 mb-3">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge" data-bind="text: financingTypeName, css: $parent.getFinancingTypeCss(financingType)"></span>
                            <span class="badge ms-1" data-bind="text: statusName, css: statusCss"></span>
                        </div>
                        <small class="text-muted" data-bind="text: new Date(createdAt).toLocaleDateString('tr-TR')"></small>
                    </div>
                    <div class="card-body">
                        <h6 class="card-title" data-bind="text: title"></h6>
                        <p class="card-text text-muted small" data-bind="text: description, visible: description"></p>

                        <!-- Amount Info -->
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <small class="text-muted d-block">Talep Edilen</small>
                                <strong class="text-primary">
                                    <span data-bind="text: requestedAmount.toLocaleString('tr-TR')"></span>
                                    <span data-bind="text: currency"></span>
                                </strong>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block">Kalan</small>
                                <strong class="text-success">
                                    <span data-bind="text: remainingAmount.toLocaleString('tr-TR')"></span>
                                    <span data-bind="text: currency"></span>
                                </strong>
                            </div>
                        </div>

                        <!-- Progress Bar -->
                        <div class="progress mb-3" style="height: 8px;" data-bind="visible: fundingProgress > 0">
                            <div class="progress-bar bg-success" role="progressbar"
                                 data-bind="style: { width: fundingProgress + '%' }, attr: { 'aria-valuenow': fundingProgress }">
                            </div>
                        </div>

                        <!-- Details -->
                        <div class="row g-2 mb-3">
                            <div class="col-4" data-bind="visible: maxInterestRate">
                                <small class="text-muted d-block">Max Faiz</small>
                                <strong>%<span data-bind="text: maxInterestRate"></span></strong>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">Vade</small>
                                <strong><span data-bind="text: durationDays"></span> gun</strong>
                            </div>
                            <div class="col-4" data-bind="visible: riskScore">
                                <small class="text-muted d-block">Risk Skoru</small>
                                <strong data-bind="text: riskScore, css: $parent.getRiskScoreCss(riskScore)"></strong>
                            </div>
                        </div>

                        <!-- Collateral -->
                        <div data-bind="visible: collateralTypeName" class="mb-2">
                            <small class="text-muted"><i class="bi bi-shield-check"></i> Teminat: <span data-bind="text: collateralTypeName"></span></small>
                        </div>

                        <!-- Deadline -->
                        <div data-bind="visible: offerDeadline" class="text-warning small">
                            <i class="bi bi-clock"></i> Son teklif: <span data-bind="text: new Date(offerDeadline).toLocaleDateString('tr-TR')"></span>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent">
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                <i class="bi bi-building"></i> <span data-bind="text: requesterCompanyName"></span>
                            </small>
                            <div>
                                <!-- ko if: hasMyOffer -->
                                <span class="badge bg-success me-2"><i class="bi bi-check"></i> Teklif verildi</span>
                                <!-- /ko -->
                                <button class="btn btn-sm btn-success" data-bind="click: $parent.openOfferModal, visible: !hasMyOffer">
                                    <i class="bi bi-cash"></i> Teklif Ver
                                </button>
                                <button class="btn btn-sm btn-outline-primary" data-bind="click: $parent.viewDetails">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- My Offers Tab -->
    <div data-bind="visible: currentTab() === 'offers'">
        <!-- Loading -->
        <div data-bind="visible: isLoading()" class="text-center py-5">
            <div class="spinner-border text-primary"></div>
        </div>

        <!-- Empty State -->
        <div data-bind="visible: !isLoading() && myOffers().length === 0" class="text-center py-5">
            <i class="bi bi-send display-1 text-muted"></i>
            <p class="mt-3 text-muted">Henuz teklif vermediniz</p>
        </div>

        <!-- Offers Table -->
        <div class="table-responsive" data-bind="visible: myOffers().length > 0">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Talep</th>
                        <th>Tip</th>
                        <th>Teklif</th>
                        <th>Faiz</th>
                        <th>Geri Odeme</th>
                        <th>Durum</th>
                        <th>Tarih</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody data-bind="foreach: myOffers">
                    <tr>
                        <td>
                            <strong data-bind="text: request.title"></strong>
                            <br /><small class="text-muted" data-bind="text: request.requesterCompanyName"></small>
                        </td>
                        <td>
                            <span class="badge" data-bind="text: request.financingTypeName, css: $parent.getFinancingTypeCss(request.financingType)"></span>
                        </td>
                        <td>
                            <strong data-bind="text: offeredAmount.toLocaleString('tr-TR')"></strong>
                            <span data-bind="text: request.currency"></span>
                        </td>
                        <td>%<span data-bind="text: interestRate"></span></td>
                        <td>
                            <span data-bind="text: totalRepaymentAmount.toLocaleString('tr-TR')"></span>
                            <span data-bind="text: request.currency"></span>
                        </td>
                        <td><span class="badge" data-bind="text: statusName, css: statusCss"></span></td>
                        <td data-bind="text: new Date(createdAt).toLocaleDateString('tr-TR')"></td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.withdrawOffer, visible: status === 1"
                                    title="Geri Cek">
                                <i class="bi bi-x-circle"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Offer Modal -->
    <div class="modal fade" id="offerModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-cash-stack"></i> Yatirim Teklifi</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Request Summary -->
                    <div class="alert alert-light mb-4" data-bind="with: selectedOpportunity">
                        <div class="row">
                            <div class="col-md-6">
                                <strong data-bind="text: title"></strong>
                                <p class="mb-1 text-muted small" data-bind="text: description"></p>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-1">
                                    <span class="text-muted">Talep:</span>
                                    <strong data-bind="text: requestedAmount.toLocaleString('tr-TR')"></strong>
                                    <span data-bind="text: currency"></span>
                                </div>
                                <div class="mb-1">
                                    <span class="text-muted">Kalan:</span>
                                    <strong class="text-success" data-bind="text: remainingAmount.toLocaleString('tr-TR')"></strong>
                                    <span data-bind="text: currency"></span>
                                </div>
                                <div data-bind="visible: maxInterestRate">
                                    <span class="text-muted">Max Faiz:</span>
                                    <strong>%<span data-bind="text: maxInterestRate"></span></strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    <form id="offerForm">
                        <div class="row g-3">
                            <!-- Amount -->
                            <div class="col-md-6">
                                <label class="form-label">Teklif Tutari *</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" data-bind="value: offerForm().offeredAmount" required min="0" step="0.01" />
                                    <span class="input-group-text" data-bind="text: selectedOpportunity() ? selectedOpportunity().currency : 'TRY'"></span>
                                </div>
                            </div>

                            <!-- Interest Rate -->
                            <div class="col-md-6">
                                <label class="form-label">Faiz Orani (Aylik %) *</label>
                                <input type="number" class="form-control" data-bind="value: offerForm().interestRate" required min="0" step="0.1" />
                            </div>

                            <!-- Calculated Repayment -->
                            <div class="col-12">
                                <div class="alert alert-info">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <small class="text-muted">Tahmini Geri Odeme:</small>
                                            <h5 class="mb-0">
                                                <span data-bind="text: calculatedRepayment().toLocaleString('tr-TR')"></span>
                                                <span data-bind="text: selectedOpportunity() ? selectedOpportunity().currency : 'TRY'"></span>
                                            </h5>
                                        </div>
                                        <div class="col-md-6">
                                            <small class="text-muted">Tahmini Faiz Geliri:</small>
                                            <h5 class="mb-0 text-success">
                                                <span data-bind="text: calculatedInterest().toLocaleString('tr-TR')"></span>
                                                <span data-bind="text: selectedOpportunity() ? selectedOpportunity().currency : 'TRY'"></span>
                                            </h5>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Valid Until -->
                            <div class="col-md-6">
                                <label class="form-label">Teklif Gecerliligi</label>
                                <input type="date" class="form-control" data-bind="value: offerForm().validUntil" />
                            </div>

                            <!-- Notes -->
                            <div class="col-12">
                                <label class="form-label">Notlar</label>
                                <textarea class="form-control" rows="2" data-bind="value: offerForm().notes" placeholder="Kosullar, aciklamalar..."></textarea>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-success" data-bind="click: submitOffer, disable: isSubmitting()">
                        <span data-bind="visible: isSubmitting()"><span class="spinner-border spinner-border-sm"></span></span>
                        <span data-bind="visible: !isSubmitting()"><i class="bi bi-cash"></i> Teklif Gonder</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Detail Modal -->
    <div class="modal fade" id="detailModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-info-circle"></i> Talep Detayi</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" data-bind="with: detailData">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <h5 data-bind="text: title"></h5>
                            <p class="text-muted" data-bind="text: description"></p>
                        </div>
                        <div class="col-md-4 text-end">
                            <span class="badge fs-6" data-bind="text: financingTypeName, css: $parent.getFinancingTypeCss(financingType)"></span>
                        </div>
                    </div>

                    <hr />

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="text-muted small">Talep Edilen</label>
                            <h4 class="text-primary" data-bind="text: requestedAmount.toLocaleString('tr-TR') + ' ' + currency"></h4>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small">Finanse Edilen</label>
                            <h4 class="text-success" data-bind="text: fundedAmount.toLocaleString('tr-TR') + ' ' + currency"></h4>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small">Kalan</label>
                            <h4 data-bind="text: remainingAmount.toLocaleString('tr-TR') + ' ' + currency"></h4>
                        </div>
                    </div>

                    <div class="progress my-3" style="height: 12px;">
                        <div class="progress-bar bg-success" role="progressbar"
                             data-bind="style: { width: fundingProgress + '%' }">
                            <span data-bind="text: fundingProgress + '%'"></span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="text-muted small">Max Faiz</label>
                            <div><strong>%<span data-bind="text: maxInterestRate || '-'"></span></strong></div>
                        </div>
                        <div class="col-md-3">
                            <label class="text-muted small">Vade</label>
                            <div><strong><span data-bind="text: durationDays"></span> gun</strong></div>
                        </div>
                        <div class="col-md-3">
                            <label class="text-muted small">Risk Skoru</label>
                            <div><strong data-bind="text: riskScore || '-', css: $parent.getRiskScoreCss(riskScore)"></strong></div>
                        </div>
                        <div class="col-md-3">
                            <label class="text-muted small">Teminat</label>
                            <div><strong data-bind="text: collateralTypeName || 'Yok'"></strong></div>
                        </div>
                    </div>

                    <!-- ko if: collateralDescription -->
                    <div class="mt-3">
                        <label class="text-muted small">Teminat Aciklamasi</label>
                        <p data-bind="text: collateralDescription"></p>
                    </div>
                    <!-- /ko -->

                    <!-- Invoice/Order Details -->
                    <!-- ko if: invoiceNumber -->
                    <div class="alert alert-light mt-3">
                        <h6>Fatura Bilgileri</h6>
                        <div class="row g-2">
                            <div class="col-md-4">
                                <small class="text-muted">Fatura No</small>
                                <div data-bind="text: invoiceNumber"></div>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted">Fatura Tarihi</small>
                                <div data-bind="text: invoiceDate ? new Date(invoiceDate).toLocaleDateString('tr-TR') : '-'"></div>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted">Borclu</small>
                                <div data-bind="text: debtorName || '-'"></div>
                            </div>
                        </div>
                    </div>
                    <!-- /ko -->

                    <!-- Risk Notes -->
                    <!-- ko if: riskNotes -->
                    <div class="alert alert-warning mt-3">
                        <h6><i class="bi bi-exclamation-triangle"></i> Risk Notlari</h6>
                        <p class="mb-0" data-bind="text: riskNotes"></p>
                    </div>
                    <!-- /ko -->

                    <!-- My Offer -->
                    <!-- ko if: myOffer -->
                    <div class="alert alert-success mt-3">
                        <h6><i class="bi bi-check-circle"></i> Teklifiniz</h6>
                        <div class="row g-2">
                            <div class="col-md-4">
                                <small class="text-muted">Tutar</small>
                                <div><strong data-bind="text: myOffer.offeredAmount.toLocaleString('tr-TR') + ' ' + currency"></strong></div>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted">Faiz</small>
                                <div><strong>%<span data-bind="text: myOffer.interestRate"></span></strong></div>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted">Durum</small>
                                <div><span class="badge" data-bind="text: myOffer.statusName, css: myOffer.statusCss"></span></div>
                            </div>
                        </div>
                    </div>
                    <!-- /ko -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                    <!-- ko if: detailData() && !detailData().myOffer -->
                    <button type="button" class="btn btn-success" data-bind="click: openOfferModalFromDetail">
                        <i class="bi bi-cash"></i> Teklif Ver
                    </button>
                    <!-- /ko -->
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Dashboard/InvestmentOpportunities.js" asp-append-version="true"></script>
}
