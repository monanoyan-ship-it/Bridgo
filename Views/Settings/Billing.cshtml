@using Bridgo.Extensions
@{
    ViewData["Title"] = Html.T("Module.Billing", "Fatura ve Banka Bilgileri").ToString();
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
}

<div class="container-fluid" id="billing-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">
                <i class="bi bi-receipt text-primary me-2"></i>
                @Html.T("Module.Billing", "Fatura ve Banka Bilgileri")
            </h4>
            <p class="text-muted mb-0">@Html.T("Billing.Subtitle", "Fatura ve odeme bilgilerinizi yonetin")</p>
        </div>
    </div>

    <!-- Loading -->
    <!-- ko if: isLoading -->
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Yukleniyor...</p>
    </div>
    <!-- /ko -->

    <!-- ko ifnot: isLoading -->
    <div class="row">
        <!-- Fatura Bilgileri -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">
                        <i class="bi bi-file-earmark-text me-2"></i>
                        @Html.T("Billing.InvoiceInfo", "Fatura Bilgileri")
                    </h6>
                </div>
                <div class="card-body">
                    <form data-bind="submit: saveBillingInfo">
                        <div class="mb-3">
                            <label class="form-label">@Html.T("Billing.CompanyName", "Firma Unvani") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: companyName" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@Html.T("Billing.TaxOffice", "Vergi Dairesi") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: taxOffice" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@Html.T("Billing.TaxNumber", "Vergi No / TC Kimlik No") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: taxNumber" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@Html.T("Billing.Address", "Fatura Adresi") <span class="text-danger">*</span></label>
                            <!-- ko if: addresses().length > 0 -->
                            <select class="form-select" data-bind="value: selectedAddressId, options: addresses, optionsText: 'displayText', optionsValue: 'id', optionsCaption: '@Html.T("Billing.SelectAddress", "-- Adreslerimden Sec --")'" required>
                            </select>
                            <!-- ko if: selectedAddressId() -->
                            <div class="border rounded p-2 mt-2 bg-light">
                                <small class="text-muted" data-bind="text: billingAddress"></small>
                            </div>
                            <!-- /ko -->
                            <!-- /ko -->
                            <!-- ko if: addresses().length === 0 -->
                            <div class="alert alert-warning py-2">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                Kayitli adres bulunamadi. <a href="/Company/Addresses" class="alert-link">Adres eklemek icin tiklayin</a>
                            </div>
                            <!-- /ko -->
                        </div>
                        <button type="submit" class="btn btn-primary" data-bind="enable: !isSavingBilling()">
                            <span data-bind="visible: isSavingBilling"><i class="bi bi-hourglass-split me-1"></i></span>
                            <span data-bind="visible: !isSavingBilling()"><i class="bi bi-check-lg me-1"></i></span>
                            @Html.T("Common.Save", "Kaydet")
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Banka Bilgileri -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">
                        <i class="bi bi-bank me-2"></i>
                        @Html.T("Billing.BankInfo", "Banka Bilgileri")
                    </h6>
                    <button class="btn btn-sm btn-outline-primary" data-bind="click: showAddBankModal">
                        <i class="bi bi-plus-lg me-1"></i> Ekle
                    </button>
                </div>
                <div class="card-body p-0">
                    <!-- ko if: bankAccounts().length === 0 -->
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-bank fs-1"></i>
                        <p class="mt-2">Henuz banka hesabi eklenmemis</p>
                    </div>
                    <!-- /ko -->

                    <!-- ko if: bankAccounts().length > 0 -->
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Banka</th>
                                    <th>IBAN</th>
                                    <th class="text-end" style="width: 100px;"></th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: bankAccounts">
                                <tr>
                                    <td>
                                        <div class="fw-medium" data-bind="text: bankName"></div>
                                        <small class="text-muted" data-bind="text: accountHolder"></small>
                                    </td>
                                    <td>
                                        <code class="small" data-bind="text: iban"></code>
                                        <!-- ko if: isDefault -->
                                        <span class="badge bg-success ms-2">Varsayilan</span>
                                        <!-- /ko -->
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary me-1" data-bind="click: $parent.editBankAccount" title="Duzenle">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.deleteBankAccount" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- /ko -->
                </div>
            </div>
        </div>
    </div>

    <!-- Odeme Gecmisi -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="bi bi-clock-history me-2"></i>
                        @Html.T("Billing.PaymentHistory", "Odeme Gecmisi")
                    </h6>
                </div>
                <div class="card-body">
                    <!-- ko if: payments().length === 0 -->
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-credit-card fs-1"></i>
                        <p class="mt-2">Henuz odeme gecmisi bulunmuyor</p>
                    </div>
                    <!-- /ko -->

                    <!-- ko if: payments().length > 0 -->
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Tarih</th>
                                    <th>Aciklama</th>
                                    <th>Tutar</th>
                                    <th>Durum</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: payments">
                                <tr>
                                    <td data-bind="text: date"></td>
                                    <td data-bind="text: description"></td>
                                    <td data-bind="text: amount"></td>
                                    <td>
                                        <span class="badge" data-bind="text: statusText, css: statusClass"></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- /ko -->
                </div>
            </div>
        </div>
    </div>
    <!-- /ko -->

    <!-- Banka Hesabi Ekleme Modal -->
    <div class="modal fade" id="addBankModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-bank me-2"></i>
                        <!-- ko if: editingBankId() -->Banka Hesabi Duzenle<!-- /ko -->
                        <!-- ko ifnot: editingBankId() -->Banka Hesabi Ekle<!-- /ko -->
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" data-bind="with: bankForm">
                    <div class="mb-3">
                        <label class="form-label">Banka Adi <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" data-bind="value: bankName" placeholder="Ornek: Garanti BBVA">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Hesap Sahibi <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" data-bind="value: accountHolder">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">IBAN <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" data-bind="value: iban" placeholder="TR00 0000 0000 0000 0000 0000 00">
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="isDefaultBank" data-bind="checked: isDefault">
                        <label class="form-check-label" for="isDefaultBank">Varsayilan hesap olarak ayarla</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary" data-bind="click: $root.saveBankAccount, enable: !$root.isAddingBank()">
                        <span data-bind="visible: $root.isAddingBank"><i class="bi bi-hourglass-split me-1"></i></span>
                        <span data-bind="visible: !$root.isAddingBank()"><i class="bi bi-check-lg me-1"></i></span>
                        <!-- ko if: $root.editingBankId() -->Guncelle<!-- /ko -->
                        <!-- ko ifnot: $root.editingBankId() -->Kaydet<!-- /ko -->
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Dashboard/Billing.js"></script>
}
