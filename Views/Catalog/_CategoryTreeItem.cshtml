@using Bridgo.DTOs.Catalog
@model CatalogCategoryDto

@{
    var hasChildren = Model.Children?.Any() == true;
    var paddingClass = Model.Level > 0 ? $"ps-{Math.Min(Model.Level + 2, 5)}" : "";
    var collapseId = $"cat-collapse-{Model.Id}";
}

<div class="category-item" data-category-id="@Model.Id" data-category-name="@Model.Name.ToLower()">
    <div class="d-flex align-items-center @paddingClass category-row">
        @if (hasChildren)
        {
            <button class="btn btn-sm btn-link text-muted p-0 me-1 category-toggle"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#@collapseId"
                    aria-expanded="false">
                <i class="bi bi-chevron-right category-chevron"></i>
            </button>
        }
        else
        {
            <span class="me-3"></span>
        }

        <a href="/Catalog/Category/@Model.Slug"
           class="list-group-item list-group-item-action d-flex justify-content-between align-items-center flex-grow-1 py-2 border-0"
           data-category-id="@Model.Id">
            <span class="d-flex align-items-center">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="rounded me-2" style="width: 24px; height: 24px; object-fit: cover;" />
                }
                else if (!string.IsNullOrEmpty(Model.Icon))
                {
                    <i class="bi @Model.Icon me-2 text-primary"></i>
                }
                else
                {
                    <i class="bi bi-folder me-2 text-muted"></i>
                }
                <span class="category-name">@Model.Name</span>
            </span>
            <span class="badge bg-secondary rounded-pill ms-2">@Model.ProductCount</span>
        </a>
    </div>

    @if (hasChildren)
    {
        <div class="collapse" id="@collapseId">
            <div class="category-children">
                @foreach (var child in Model.Children!)
                {
                    @await Html.PartialAsync("_CategoryTreeItem", child)
                }
            </div>
        </div>
    }
</div>
