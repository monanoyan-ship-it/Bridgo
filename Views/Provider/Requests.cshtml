@using Bridgo.Extensions
@{
    ViewData["Title"] = Html.T("Provider.Requests.Title", "Servis Talepleri").ToString();
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
    var serviceType = ViewBag.ServiceType;
}

<div id="provider-requests-app" data-service-type="@serviceType">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">
                <i class="bi bi-clipboard-data text-primary me-2"></i>
                @Html.T("Provider.Requests.Title", "Servis Talepleri")
            </h4>
            <p class="text-muted mb-0">@Html.T("Provider.Requests.Subtitle", "Gelen servis taleplerini inceleyin ve teklif verin.")</p>
        </div>
        <div class="d-flex gap-2">
            <select class="form-select" style="width: auto;" data-bind="value: selectedServiceType">
                <option value="">@Html.T("Provider.Requests.AllServices", "Tum Hizmetler")</option>
                <!-- ko foreach: serviceTypes -->
                <option data-bind="value: id, text: name"></option>
                <!-- /ko -->
            </select>
            <button class="btn btn-outline-primary" data-bind="click: loadRequests">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@Html.T("Common.Loading", "Yukleniyor...")</span>
        </div>
    </div>

    <!-- Empty State -->
    <div data-bind="visible: !isLoading() && requests().length === 0" class="text-center py-5">
        <i class="bi bi-inbox display-1 text-muted"></i>
        <h4 class="mt-3">@Html.T("Provider.Requests.NoRequests", "Henuz talep yok")</h4>
        <p class="text-muted">@Html.T("Provider.Requests.NoRequestsDesc", "Yeni talepler geldiginde burada gorunecek.")</p>
    </div>

    <!-- Requests List -->
    <div data-bind="visible: !isLoading() && requests().length > 0">
        <div class="row g-4" data-bind="foreach: requests">
            <div class="col-lg-6">
                <div class="card h-100" data-bind="css: { 'border-success': hasMyQuote }">
                    <div class="card-header d-flex align-items-center">
                        <i data-bind="attr: { class: 'bi ' + serviceTypeIcon + ' me-2 fs-5' }"></i>
                        <h6 class="mb-0" data-bind="text: serviceTypeName"></h6>
                        <span class="badge ms-2" data-bind="text: statusName, css: $root.getStatusClass(status)"></span>
                        <!-- ko if: hasMyQuote -->
                        <span class="badge bg-success ms-2"><i class="bi bi-check"></i> @Html.T("Provider.Requests.QuoteSubmitted", "Teklif verildi")</span>
                        <!-- /ko -->
                        <small class="ms-auto text-muted" data-bind="text: $root.formatDate(createdAt)"></small>
                    </div>
                    <div class="card-body">
                        <!-- Order Info -->
                        <div class="d-flex justify-content-between mb-3">
                            <div>
                                <small class="text-muted">@Html.T("Provider.Requests.Order", "Siparis")</small>
                                <div class="fw-medium" data-bind="text: orderNumber"></div>
                            </div>
                            <div class="text-end">
                                <small class="text-muted">@Html.T("Provider.Requests.Buyer", "Alici")</small>
                                <div class="fw-medium" data-bind="text: buyerName"></div>
                            </div>
                        </div>

                        <!-- Route -->
                        <div class="bg-light rounded p-3 mb-3">
                            <div class="d-flex align-items-center">
                                <div class="text-center">
                                    <i class="bi bi-geo-alt text-primary"></i>
                                    <div class="small" data-bind="text: originCity || '-'"></div>
                                    <div class="small text-muted" data-bind="text: originCountry || '-'"></div>
                                </div>
                                <div class="flex-fill text-center px-3">
                                    <div class="border-top border-2 border-primary" style="margin-top: 10px;"></div>
                                    <!-- ko if: transportModeName -->
                                    <small class="text-muted" data-bind="text: transportModeName"></small>
                                    <!-- /ko -->
                                </div>
                                <div class="text-center">
                                    <i class="bi bi-geo-alt-fill text-success"></i>
                                    <div class="small" data-bind="text: destinationCity || '-'"></div>
                                    <div class="small text-muted" data-bind="text: destinationCountry || '-'"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Details -->
                        <div class="row g-2 text-center small">
                            <!-- ko if: weightKg -->
                            <div class="col">
                                <div class="text-muted">@Html.T("Provider.Requests.Weight", "Agirlik")</div>
                                <div class="fw-medium" data-bind="text: weightKg + ' kg'"></div>
                            </div>
                            <!-- /ko -->
                            <!-- ko if: cargoValue -->
                            <div class="col">
                                <div class="text-muted">@Html.T("Provider.Requests.Value", "Deger")</div>
                                <div class="fw-medium" data-bind="text: $root.formatCurrency(cargoValue, currency)"></div>
                            </div>
                            <!-- /ko -->
                            <!-- ko if: hsCode -->
                            <div class="col">
                                <div class="text-muted">@Html.T("Provider.Requests.HsCode", "HS Kodu")</div>
                                <div class="fw-medium" data-bind="text: hsCode"></div>
                            </div>
                            <!-- /ko -->
                            <div class="col">
                                <div class="text-muted">@Html.T("Provider.Requests.Quotes", "Teklifler")</div>
                                <div class="fw-medium" data-bind="text: quoteCount"></div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <!-- ko if: hasMyQuote -->
                        <div class="d-flex justify-content-between align-items-center">
                            <span>
                                @Html.T("Provider.Requests.YourQuote", "Teklifiniz"):
                                <strong class="text-primary" data-bind="text: $root.formatCurrency(myQuoteAmount, currency)"></strong>
                            </span>
                            <button class="btn btn-sm btn-outline-primary" data-bind="click: function() { $root.editQuote($data); }">
                                <i class="bi bi-pencil"></i> @Html.T("Common.Edit", "Duzenle")
                            </button>
                        </div>
                        <!-- /ko -->
                        <!-- ko ifnot: hasMyQuote -->
                        <button class="btn btn-primary w-100" data-bind="click: function() { $root.openQuoteModal($data); }">
                            <i class="bi bi-plus-circle me-2"></i>@Html.T("Provider.Requests.SubmitQuote", "Teklif Ver")
                        </button>
                        <!-- /ko -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quote Modal -->
    <div class="modal fade" id="quoteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-cash-coin me-2"></i>
                        <span data-bind="text: isEditing() ? '@Html.T("Provider.Requests.EditQuote", "Teklif Duzenle")' : '@Html.T("Provider.Requests.SubmitQuote", "Teklif Ver")'"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Request Summary -->
                    <div class="bg-light rounded p-3 mb-4" data-bind="with: selectedRequest">
                        <div class="d-flex justify-content-between mb-2">
                            <span data-bind="text: serviceTypeName"></span>
                            <span data-bind="text: orderNumber"></span>
                        </div>
                        <div class="small text-muted">
                            <span data-bind="text: originCity"></span> <i class="bi bi-arrow-right"></i> <span data-bind="text: destinationCity"></span>
                        </div>
                    </div>

                    <!-- Quote Form -->
                    <form data-bind="submit: submitQuote">
                        <div class="mb-3">
                            <label class="form-label">@Html.T("Provider.Requests.QuoteAmount", "Teklif Tutari") *</label>
                            <div class="input-group">
                                <input type="number" class="form-control" step="0.01" required
                                       data-bind="value: quoteForm.quoteAmount">
                                <select class="form-select" style="max-width: 100px;" data-bind="value: quoteForm.currency">
                                    <option value="TRY">TRY</option>
                                    <option value="USD">USD</option>
                                    <option value="EUR">EUR</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Html.T("Provider.Requests.EstimatedDays", "Tahmini Sure (Gun)")</label>
                            <input type="number" class="form-control" min="1"
                                   data-bind="value: quoteForm.estimatedDays">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Html.T("Provider.Requests.ValidUntil", "Teklif Gecerlilik Tarihi")</label>
                            <input type="date" class="form-control"
                                   data-bind="value: quoteForm.validUntil">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Html.T("Provider.Requests.IncludedServices", "Dahil Hizmetler")</label>
                            <textarea class="form-control" rows="2" placeholder="@Html.T("Provider.Requests.IncludedServicesPlaceholder", "Ornegin: Yuklenme, bosaltma, sigorta dahil...")"
                                      data-bind="value: quoteForm.includedServices"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Html.T("Provider.Requests.Notes", "Notlar")</label>
                            <textarea class="form-control" rows="2"
                                      data-bind="value: quoteForm.notes"></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Cancel", "Iptal")</button>
                    <button type="button" class="btn btn-primary" data-bind="click: submitQuote, disable: isSubmitting">
                        <span data-bind="visible: !isSubmitting()">
                            <i class="bi bi-check-circle me-2"></i>
                            <span data-bind="text: isEditing() ? '@Html.T("Common.Save", "Kaydet")' : '@Html.T("Provider.Requests.Submit", "Gonder")'"></span>
                        </span>
                        <span data-bind="visible: isSubmitting">
                            <span class="spinner-border spinner-border-sm me-2"></span>@Html.T("Common.Processing", "Isleniyor...")
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Provider/Requests.js" asp-append-version="true"></script>
}
