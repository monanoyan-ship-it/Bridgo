@using Bridgo.Extensions
@{
    ViewData["Title"] = Html.T("CompareProposals.Title", "Teklif Karsilastirma").ToString();
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
}

<div id="compare-proposals-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">
                <i class="bi bi-arrows-angle-contract text-primary me-2"></i>
                @Html.T("CompareProposals.Title", "Teklif Karsilastirma")
            </h4>
            <p class="text-muted mb-0">@Html.T("CompareProposals.Subtitle", "Gelen teklifleri karsilastirin ve en uygun olanini secin.")</p>
        </div>
        <button type="button" class="btn btn-primary" data-bind="click: openCreateDemandModal">
            <i class="bi bi-plus-lg me-1"></i>
            @Html.T("CompareProposals.NewDemand", "Yeni Talep")
        </button>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="display-6 text-primary" data-bind="text: stats().totalDemandsWithProposals || 0">0</div>
                    <small class="text-muted">Teklifli Talep</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="display-6 text-info" data-bind="text: stats().totalPendingProposals || 0">0</div>
                    <small class="text-muted">Bekleyen Teklif</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="display-6 text-warning" data-bind="text: stats().totalShortlistedProposals || 0">0</div>
                    <small class="text-muted">Kisa Listede</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="display-6 text-success" data-bind="text: stats().totalAcceptedProposals || 0">0</div>
                    <small class="text-muted">Kabul Edildi</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-4" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="demands-tab" data-bs-toggle="tab" data-bs-target="#demands-pane" type="button">
                <i class="bi bi-megaphone me-1"></i>
                Talep Teklifleri
                <span class="badge bg-primary ms-1" data-bind="text: demands().length">0</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="inquiries-tab" data-bs-toggle="tab" data-bs-target="#inquiries-pane" type="button">
                <i class="bi bi-box me-1"></i>
                Urun Istekleri
                <span class="badge bg-info ms-1" data-bind="text: inquiries().length">0</span>
            </button>
        </li>
    </ul>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">@Html.T("Common.Loading", "Yukleniyor...")</p>
    </div>

    <!-- Tab Content -->
    <div class="tab-content" data-bind="visible: !isLoading()">
        <!-- Demands Tab -->
        <div class="tab-pane fade show active" id="demands-pane" role="tabpanel">
            <!-- Empty State -->
            <div data-bind="visible: demands().length === 0" class="text-center py-5">
                <i class="bi bi-inbox display-1 text-muted"></i>
                <h5 class="mt-3">Henuz teklifli talebiniz yok</h5>
                <p class="text-muted">Talep olusturdugunuzda gelen teklifler burada gorunecek.</p>
                <button type="button" class="btn btn-primary" data-bind="click: openCreateDemandModal">
                    <i class="bi bi-plus-lg me-1"></i> Yeni Talep Olustur
                </button>
            </div>

            <!-- Demands List -->
            <div data-bind="foreach: demands">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-1" data-bind="text: title"></h5>
                            <div class="small text-muted">
                                <span data-bind="visible: categoryName">
                                    <i class="bi bi-tag"></i> <span data-bind="text: categoryName"></span>
                                    <span class="mx-2">|</span>
                                </span>
                                <span data-bind="visible: quantity">
                                    <i class="bi bi-boxes"></i> <span data-bind="text: quantity"></span> <span data-bind="text: unit || 'adet'"></span>
                                    <span class="mx-2">|</span>
                                </span>
                                <i class="bi bi-calendar"></i> <span data-bind="text: new Date(createdAt).toLocaleDateString('tr-TR')"></span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge" data-bind="text: statusName, css: {
                                'bg-secondary': status === 0,
                                'bg-warning': status === 1,
                                'bg-success': status === 2,
                                'bg-dark': status === 3,
                                'bg-danger': status === 4 || status === 5
                            }"></span>
                            <span class="badge bg-primary" data-bind="text: proposals.length + ' teklif'"></span>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <!-- Empty proposals -->
                        <div data-bind="visible: proposals.length === 0" class="text-center py-4 text-muted">
                            <i class="bi bi-hourglass-split"></i> Henuz teklif gelmedi
                        </div>

                        <!-- Proposals Table -->
                        <div data-bind="visible: proposals.length > 0" class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 200px;">Tedarikci</th>
                                        <th class="text-end">Birim Fiyat</th>
                                        <th class="text-end">Toplam</th>
                                        <th class="text-center">Teslimat</th>
                                        <th class="text-center">Gecerlilik</th>
                                        <th class="text-center">Puan</th>
                                        <th class="text-center">Durum</th>
                                        <th class="text-end" style="width: 180px;">Islemler</th>
                                    </tr>
                                </thead>
                                <tbody data-bind="foreach: proposals">
                                    <tr data-bind="css: { 'table-success': status === 4, 'table-secondary': status === 5 }">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <!-- ko if: logoUrl -->
                                                <img data-bind="attr: { src: logoUrl }" class="rounded me-2" style="width: 36px; height: 36px; object-fit: cover;">
                                                <!-- /ko -->
                                                <!-- ko ifnot: logoUrl -->
                                                <div class="bg-light rounded d-flex align-items-center justify-content-center me-2" style="width: 36px; height: 36px;">
                                                    <i class="bi bi-building text-muted"></i>
                                                </div>
                                                <!-- /ko -->
                                                <div>
                                                    <div class="fw-medium" data-bind="text: companyName || externalCompanyName || 'Dis Tedarikci'"></div>
                                                    <div class="small">
                                                        <!-- ko if: isVerified -->
                                                        <span class="text-success"><i class="bi bi-patch-check-fill"></i></span>
                                                        <!-- /ko -->
                                                        <!-- ko if: isFavorite -->
                                                        <span class="text-danger"><i class="bi bi-heart-fill"></i></span>
                                                        <!-- /ko -->
                                                        <!-- ko if: isLowestPrice -->
                                                        <span class="badge bg-success-subtle text-success">En Ucuz</span>
                                                        <!-- /ko -->
                                                        <!-- ko if: isFastestDelivery -->
                                                        <span class="badge bg-info-subtle text-info">En Hizli</span>
                                                        <!-- /ko -->
                                                        <!-- ko if: isHighestRated -->
                                                        <span class="badge bg-warning-subtle text-warning">En Iyi Puan</span>
                                                        <!-- /ko -->
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-end">
                                            <span data-bind="visible: unitPrice">
                                                <span class="fw-bold" data-bind="text: unitPrice ? unitPrice.toLocaleString('tr-TR', {minimumFractionDigits: 2}) : '-'"></span>
                                                <small class="text-muted" data-bind="text: currency || 'TRY'"></small>
                                            </span>
                                            <span data-bind="visible: !unitPrice" class="text-muted">-</span>
                                        </td>
                                        <td class="text-end">
                                            <span data-bind="visible: totalPrice">
                                                <span class="fw-bold" data-bind="text: totalPrice ? totalPrice.toLocaleString('tr-TR', {minimumFractionDigits: 2}) : '-'"></span>
                                                <small class="text-muted" data-bind="text: currency || 'TRY'"></small>
                                            </span>
                                            <span data-bind="visible: !totalPrice" class="text-muted">-</span>
                                        </td>
                                        <td class="text-center">
                                            <span data-bind="visible: leadTimeDays">
                                                <span data-bind="text: leadTimeDays"></span> gun
                                            </span>
                                            <span data-bind="visible: !leadTimeDays" class="text-muted">-</span>
                                        </td>
                                        <td class="text-center">
                                            <span data-bind="visible: validUntil">
                                                <span data-bind="text: new Date(validUntil).toLocaleDateString('tr-TR')"></span>
                                            </span>
                                            <span data-bind="visible: !validUntil" class="text-muted">-</span>
                                        </td>
                                        <td class="text-center">
                                            <span data-bind="visible: averageRating > 0">
                                                <i class="bi bi-star-fill text-warning"></i>
                                                <span data-bind="text: averageRating.toFixed(1)"></span>
                                                <small class="text-muted">(<span data-bind="text: reviewCount"></span>)</small>
                                            </span>
                                            <span data-bind="visible: !averageRating || averageRating === 0" class="text-muted">-</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge" data-bind="text: statusName, css: {
                                                'bg-secondary': status === 1,
                                                'bg-info': status === 2,
                                                'bg-warning text-dark': status === 3,
                                                'bg-success': status === 4,
                                                'bg-danger': status === 5
                                            }"></span>
                                        </td>
                                        <td class="text-end">
                                            <!-- Active proposal actions (not negotiating) -->
                                            <div data-bind="visible: status < 4 && status !== 6" class="btn-group btn-group-sm">
                                                <button type="button" class="btn btn-outline-secondary" title="Detay"
                                                        data-bind="click: function() { $root.viewProposal($data); }">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-warning" title="Kisa Liste"
                                                        data-bind="click: function() { $root.shortlistProposal($data); }, visible: status < 3">
                                                    <i class="bi bi-bookmark"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-info" title="Pazarlik Baslat"
                                                        data-bind="click: function() { $root.startNegotiation($data); }">
                                                    <i class="bi bi-arrow-left-right"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-success" title="Kabul Et"
                                                        data-bind="click: function() { $root.acceptProposal($data); }">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-danger" title="Reddet"
                                                        data-bind="click: function() { $root.rejectProposal($data); }">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </div>
                                            <!-- Negotiating - Show negotiation actions -->
                                            <div data-bind="visible: status === 6" class="d-flex align-items-center gap-2">
                                                <span class="badge bg-info">
                                                    <i class="bi bi-arrow-left-right"></i> Pazarlik
                                                </span>
                                                <button type="button" class="btn btn-sm btn-outline-info"
                                                        data-bind="click: function() { $root.openNegotiationModal($data); }">
                                                    <i class="bi bi-chat-dots me-1"></i> Goruntule
                                                </button>
                                            </div>
                                            <!-- Accepted - Show Create Order button -->
                                            <div data-bind="visible: status === 4">
                                                <button type="button" class="btn btn-sm btn-primary"
                                                        data-bind="click: function() { $root.showCreateOrder($data); }">
                                                    <i class="bi bi-cart-plus me-1"></i> Siparis Olustur
                                                </button>
                                            </div>
                                            <div data-bind="visible: status === 5" class="text-danger small">
                                                <i class="bi bi-x-circle-fill"></i> Reddedildi
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Inquiries Tab -->
        <div class="tab-pane fade" id="inquiries-pane" role="tabpanel">
            <!-- Empty State -->
            <div data-bind="visible: inquiries().length === 0" class="text-center py-5">
                <i class="bi bi-box display-1 text-muted"></i>
                <h5 class="mt-3">Henuz urun istegi teklifiniz yok</h5>
                <p class="text-muted">Urun isteklerinize gelen teklifler burada gorunecek.</p>
            </div>

            <!-- Inquiries List -->
            <div data-bind="foreach: inquiries">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <!-- ko if: productImageUrl -->
                            <img data-bind="attr: { src: productImageUrl }" class="rounded me-3" style="width: 48px; height: 48px; object-fit: cover;">
                            <!-- /ko -->
                            <!-- ko ifnot: productImageUrl -->
                            <div class="bg-light rounded d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                                <i class="bi bi-box text-muted"></i>
                            </div>
                            <!-- /ko -->
                            <div>
                                <h5 class="mb-1" data-bind="text: productName"></h5>
                                <div class="small text-muted">
                                    <i class="bi bi-building"></i> <span data-bind="text: sellerCompanyName"></span>
                                    <span class="mx-2">|</span>
                                    <span data-bind="visible: quantity">
                                        <i class="bi bi-boxes"></i> <span data-bind="text: quantity"></span> adet
                                        <span class="mx-2">|</span>
                                    </span>
                                    <i class="bi bi-calendar"></i> <span data-bind="text: new Date(createdAt).toLocaleDateString('tr-TR')"></span>
                                </div>
                            </div>
                        </div>
                        <span class="badge" data-bind="text: statusName, css: {
                            'bg-secondary': status === 1,
                            'bg-info': status === 2,
                            'bg-success': status === 3,
                            'bg-danger': status === 4
                        }"></span>
                    </div>
                    <div class="card-body p-0">
                        <!-- Empty proposals -->
                        <div data-bind="visible: proposals.length === 0" class="text-center py-4 text-muted">
                            <i class="bi bi-hourglass-split"></i> Henuz teklif gelmedi
                        </div>

                        <!-- Proposals -->
                        <div data-bind="visible: proposals.length > 0, foreach: proposals" class="list-group list-group-flush">
                            <div class="list-group-item d-flex justify-content-between align-items-center"
                                 data-bind="css: { 'list-group-item-success': status === 2, 'list-group-item-secondary': status === 3 }">
                                <div class="d-flex align-items-center gap-4">
                                    <div>
                                        <div class="fw-bold">
                                            <span data-bind="text: unitPrice ? unitPrice.toLocaleString('tr-TR', {minimumFractionDigits: 2}) : '-'"></span>
                                            <small class="text-muted" data-bind="text: currency"></small>
                                        </div>
                                        <small class="text-muted">Birim Fiyat</small>
                                    </div>
                                    <div data-bind="visible: offeredQuantity">
                                        <div class="fw-bold" data-bind="text: offeredQuantity"></div>
                                        <small class="text-muted">Miktar</small>
                                    </div>
                                    <div data-bind="visible: leadTimeDays">
                                        <div class="fw-bold"><span data-bind="text: leadTimeDays"></span> gun</div>
                                        <small class="text-muted">Teslimat</small>
                                    </div>
                                    <div data-bind="visible: validUntil">
                                        <div class="fw-bold" data-bind="text: new Date(validUntil).toLocaleDateString('tr-TR')"></div>
                                        <small class="text-muted">Gecerlilik</small>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge" data-bind="text: statusName, css: {
                                        'bg-secondary': status === 1,
                                        'bg-success': status === 2,
                                        'bg-danger': status === 3
                                    }"></span>
                                    <!-- Actions -->
                                    <div data-bind="visible: status === 1" class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-success" title="Kabul Et"
                                                data-bind="click: function() { $root.acceptInquiryProposal($data); }">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-danger" title="Reddet"
                                                data-bind="click: function() { $root.rejectInquiryProposal($data); }">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Proposal Detail Modal -->
<div class="modal fade" id="proposalModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Teklif Detayi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" data-bind="with: selectedProposal">
                <!-- Supplier Info -->
                <div class="d-flex align-items-center mb-4">
                    <!-- ko if: logoUrl -->
                    <img data-bind="attr: { src: logoUrl }" class="rounded me-3" style="width: 64px; height: 64px; object-fit: cover;">
                    <!-- /ko -->
                    <!-- ko ifnot: logoUrl -->
                    <div class="bg-light rounded d-flex align-items-center justify-content-center me-3" style="width: 64px; height: 64px;">
                        <i class="bi bi-building text-muted fs-2"></i>
                    </div>
                    <!-- /ko -->
                    <div>
                        <h5 class="mb-1" data-bind="text: companyName || externalCompanyName || 'Dis Tedarikci'"></h5>
                        <div class="text-muted">
                            <!-- ko if: isVerified -->
                            <span class="badge bg-success me-1"><i class="bi bi-patch-check-fill"></i> Dogrulanmis</span>
                            <!-- /ko -->
                            <!-- ko if: averageRating > 0 -->
                            <span class="me-2"><i class="bi bi-star-fill text-warning"></i> <span data-bind="text: averageRating.toFixed(1)"></span></span>
                            <!-- /ko -->
                            <!-- ko if: isFavorite -->
                            <span class="text-danger"><i class="bi bi-heart-fill"></i> Favorilerde</span>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>

                <!-- External Supplier Info -->
                <div data-bind="visible: externalEmail || externalPhone" class="alert alert-info mb-4">
                    <h6 class="mb-2"><i class="bi bi-person"></i> Dis Tedarikci Iletisim</h6>
                    <div class="row">
                        <div class="col-md-6" data-bind="visible: externalContactName">
                            <small class="text-muted">Yetkili:</small>
                            <div data-bind="text: externalContactName"></div>
                        </div>
                        <div class="col-md-6" data-bind="visible: externalEmail">
                            <small class="text-muted">E-posta:</small>
                            <div><a data-bind="text: externalEmail, attr: { href: 'mailto:' + externalEmail }"></a></div>
                        </div>
                        <div class="col-md-6" data-bind="visible: externalPhone">
                            <small class="text-muted">Telefon:</small>
                            <div data-bind="text: externalPhone"></div>
                        </div>
                    </div>
                </div>

                <!-- Price Details -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="card bg-light border-0">
                            <div class="card-body text-center">
                                <small class="text-muted d-block">Birim Fiyat</small>
                                <div class="fs-4 fw-bold">
                                    <span data-bind="text: unitPrice ? unitPrice.toLocaleString('tr-TR', {minimumFractionDigits: 2}) : '-'"></span>
                                    <small class="text-muted" data-bind="text: currency || 'TRY'"></small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-light border-0">
                            <div class="card-body text-center">
                                <small class="text-muted d-block">Toplam Tutar</small>
                                <div class="fs-4 fw-bold">
                                    <span data-bind="text: totalPrice ? totalPrice.toLocaleString('tr-TR', {minimumFractionDigits: 2}) : '-'"></span>
                                    <small class="text-muted" data-bind="text: currency || 'TRY'"></small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-light border-0">
                            <div class="card-body text-center">
                                <small class="text-muted d-block">Teslimat Suresi</small>
                                <div class="fs-4 fw-bold">
                                    <span data-bind="text: leadTimeDays || '-'"></span>
                                    <small class="text-muted" data-bind="visible: leadTimeDays">gun</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Other Details -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6" data-bind="visible: quantity">
                        <strong>Teklif Edilen Miktar:</strong>
                        <span data-bind="text: quantity"></span> <span data-bind="text: unit || 'adet'"></span>
                    </div>
                    <div class="col-md-6" data-bind="visible: validUntil">
                        <strong>Gecerlilik Tarihi:</strong>
                        <span data-bind="text: new Date(validUntil).toLocaleDateString('tr-TR')"></span>
                    </div>
                </div>

                <!-- Notes -->
                <div data-bind="visible: notes" class="mb-4">
                    <h6><i class="bi bi-chat-left-text"></i> Tedarikci Notu</h6>
                    <p class="bg-light p-3 rounded" data-bind="text: notes"></p>
                </div>

                <!-- Terms -->
                <div data-bind="visible: termsAndConditions" class="mb-4">
                    <h6><i class="bi bi-file-text"></i> Kosullar</h6>
                    <p class="bg-light p-3 rounded" data-bind="text: termsAndConditions"></p>
                </div>

                <!-- Badges -->
                <div class="d-flex gap-2 flex-wrap">
                    <!-- ko if: isLowestPrice -->
                    <span class="badge bg-success"><i class="bi bi-tag-fill"></i> En Dusuk Fiyat</span>
                    <!-- /ko -->
                    <!-- ko if: isFastestDelivery -->
                    <span class="badge bg-info"><i class="bi bi-lightning-fill"></i> En Hizli Teslimat</span>
                    <!-- /ko -->
                    <!-- ko if: isHighestRated -->
                    <span class="badge bg-warning text-dark"><i class="bi bi-star-fill"></i> En Yuksek Puan</span>
                    <!-- /ko -->
                </div>
            </div>
            <div class="modal-footer" data-bind="with: selectedProposal">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                <div data-bind="visible: status < 4" class="d-flex gap-2">
                    <button type="button" class="btn btn-warning" data-bind="click: function() { $root.shortlistProposal($data); $root.proposalModal.hide(); }, visible: status < 3">
                        <i class="bi bi-bookmark me-1"></i> Kisa Listeye Ekle
                    </button>
                    <button type="button" class="btn btn-danger" data-bind="click: function() { $root.rejectProposal($data); $root.proposalModal.hide(); }">
                        <i class="bi bi-x-lg me-1"></i> Reddet
                    </button>
