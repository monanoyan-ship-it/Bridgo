@{
    ViewData["Title"] = Html.T("Account.AccessDenied.Title", "Erisim Reddedildi").ToString();
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow">
            <div class="card-body p-5">
                <i class="bi bi-shield-x text-danger" style="font-size: 4rem;"></i>
                <h2 class="mt-3">@Html.T("Account.AccessDenied.Title", "Erisim Reddedildi")</h2>
                <p class="text-muted">@Html.T("Account.AccessDenied.Message", "Bu sayfaya erisim yetkiniz bulunmamaktadir.")</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-house"></i> @Html.T("Common.BackToHome", "Ana Sayfaya Don")
                </a>
            </div>
        </div>
    </div>
</div>
