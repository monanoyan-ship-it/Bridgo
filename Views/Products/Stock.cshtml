@{
    ViewData["Title"] = Html.T("Products.Stock.Title", "Stok Yonetimi");
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
}

<div id="stock-app">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">@Html.T("Products.Stock.Title", "Stok Yonetimi")</h4>
            <p class="text-muted mb-0">@Html.T("Products.Stock.Subtitle", "Stok durumu ve depo bazli ozet")</p>
        </div>
        <div>
            <a href="/Products" class="btn btn-outline-primary">
                <i class="bi bi-box me-1"></i> @Html.T("Products.Stock.GoToProducts", "Urunlere Git")
            </a>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">@Html.T("Common.Loading", "Yukleniyor...")</p>
    </div>

    <!-- Content -->
    <div data-bind="visible: !isLoading()">
        <!-- Overview Cards -->
        <div class="row mb-4">
            <div class="col-md-2">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="display-6 text-primary" data-bind="text: overview().totalProducts"></div>
                        <div class="text-muted small">@Html.T("Products.Stock.TotalProducts", "Toplam Urun")</div>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="display-6 text-success" data-bind="text: overview().productsInStock"></div>
                        <div class="text-muted small">@Html.T("Products.Stock.InStock", "Stokta")</div>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="display-6 text-danger" data-bind="text: overview().productsOutOfStock"></div>
                        <div class="text-muted small">@Html.T("Products.Stock.OutOfStock", "Tukenmis")</div>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="display-6 text-warning" data-bind="text: overview().lowStockProducts"></div>
                        <div class="text-muted small">@Html.T("Products.Stock.LowStock", "Dusuk Stok")</div>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="display-6 text-info" data-bind="text: overview().totalWarehouses"></div>
                        <div class="text-muted small">@Html.T("Products.Stock.Warehouses", "Depo")</div>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="h5 text-primary mb-0" data-bind="text: formatCurrency(overview().totalStockValue)"></div>
                        <div class="text-muted small">@Html.T("Products.Stock.TotalValue", "Toplam Deger")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Low Stock Products -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">
                            <i class="bi bi-exclamation-triangle text-warning me-2"></i>
                            @Html.T("Products.Stock.LowStockProducts", "Dusuk Stoklu Urunler")
                        </h6>
                        <span class="badge bg-warning" data-bind="text: lowStockProducts().length"></span>
                    </div>
                    <div class="card-body p-0">
                        <!-- ko if: lowStockProducts().length === 0 -->
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-check-circle display-4 text-success"></i>
                            <p class="mt-2">@Html.T("Products.Stock.NoLowStock", "Dusuk stoklu urun yok")</p>
                        </div>
                        <!-- /ko -->

                        <!-- ko if: lowStockProducts().length > 0 -->
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>@Html.T("Products.Fields.Name", "Urun")</th>
                                        <th>@Html.T("Products.Fields.SKU", "SKU")</th>
                                        <th>@Html.T("Products.Fields.Category", "Kategori")</th>
                                        <th class="text-center">@Html.T("Products.Stock.Current", "Mevcut")</th>
                                        <th class="text-center">@Html.T("Products.Stock.MinLevel", "Min")</th>
                                        <th class="text-center">@Html.T("Products.Stock.Difference", "Fark")</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody data-bind="foreach: lowStockProducts">
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <!-- ko if: mainImageUrl -->
                                                <img data-bind="attr: { src: mainImageUrl }" class="rounded me-2" style="width: 40px; height: 40px; object-fit: cover;">
                                                <!-- /ko -->
                                                <!-- ko ifnot: mainImageUrl -->
                                                <div class="bg-light rounded me-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                    <i class="bi bi-image text-muted"></i>
                                                </div>
                                                <!-- /ko -->
                                                <span data-bind="text: name"></span>
                                            </div>
                                        </td>
                                        <td><code data-bind="text: sku || '-'"></code></td>
                                        <td><span class="text-muted" data-bind="text: categoryName || '-'"></span></td>
                                        <td class="text-center">
                                            <span class="badge" data-bind="text: stockQuantity, css: stockQuantity <= 0 ? 'bg-danger' : 'bg-warning'"></span>
                                        </td>
                                        <td class="text-center">
                                            <span data-bind="text: minStockLevel || '-'"></span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-danger" data-bind="text: stockDifference, visible: stockDifference < 0"></span>
                                            <span class="text-muted" data-bind="text: stockDifference, visible: stockDifference >= 0"></span>
                                        </td>
                                        <td>
                                            <a class="btn btn-sm btn-outline-primary" data-bind="attr: { href: '/Products?edit=' + id }">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <!-- /ko -->
                    </div>
                </div>
            </div>

            <!-- Warehouse Summary -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white">
                        <h6 class="mb-0">
                            <i class="bi bi-building text-primary me-2"></i>
                            @Html.T("Products.Stock.ByWarehouse", "Depo Bazli Stok")
                        </h6>
                    </div>
                    <div class="card-body p-0">
                        <!-- ko if: warehouseStocks().length === 0 -->
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-building display-4"></i>
                            <p class="mt-2">@Html.T("Products.Stock.NoWarehouses", "Henuz depo tanimlanmamis")</p>
                            <a href="/Warehouses" class="btn btn-sm btn-primary">
                                <i class="bi bi-plus me-1"></i> @Html.T("Products.Stock.AddWarehouse", "Depo Ekle")
                            </a>
                        </div>
                        <!-- /ko -->

                        <!-- ko if: warehouseStocks().length > 0 -->
                        <div class="list-group list-group-flush" data-bind="foreach: warehouseStocks">
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="fw-medium" data-bind="text: warehouseName">
                                            <!-- ko if: isDefault -->
                                            <span class="badge bg-primary ms-1">@Html.T("Common.Default", "Varsayilan")</span>
                                            <!-- /ko -->
                                        </div>
                                        <small class="text-muted" data-bind="text: warehouseCode"></small>
                                    </div>
                                    <div class="text-end">
                                        <div class="h6 mb-0" data-bind="text: productCount + ' urun'"></div>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <div class="row text-center small">
                                        <div class="col">
                                            <div class="text-muted">@Html.T("Products.Stock.Total", "Toplam")</div>
                                            <div class="fw-medium" data-bind="text: totalQuantity.toFixed(0)"></div>
                                        </div>
                                        <div class="col">
                                            <div class="text-muted">@Html.T("Products.Stock.Reserved", "Rezerve")</div>
                                            <div class="fw-medium text-warning" data-bind="text: totalReserved.toFixed(0)"></div>
                                        </div>
                                        <div class="col">
                                            <div class="text-muted">@Html.T("Products.Stock.Available", "Mevcut")</div>
                                            <div class="fw-medium text-success" data-bind="text: totalAvailable.toFixed(0)"></div>
                                        </div>
                                    </div>
                                    <div class="progress mt-2" style="height: 4px;">
                                        <div class="progress-bar bg-success" data-bind="style: { width: (totalQuantity > 0 ? (totalAvailable / totalQuantity * 100) : 0) + '%' }"></div>
                                        <div class="progress-bar bg-warning" data-bind="style: { width: (totalQuantity > 0 ? (totalReserved / totalQuantity * 100) : 0) + '%' }"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- /ko -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Products/Stock.js"></script>
}
