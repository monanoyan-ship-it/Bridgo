                        <div class="col-md-6">
                            <label class="form-label">Ulke</label>
                            <select class="form-select" data-bind="value: demandForm.countryId, options: countries, optionsText: 'name', optionsValue: 'id', optionsCaption: 'Ulke Sec'"></select>
