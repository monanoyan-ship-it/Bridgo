@{
    var slug = ViewData["Slug"] as string;
    var title = ViewData["Title"] as string ?? "Profil";
    var metaDesc = ViewData["MetaDescription"] as string;
    var ogTitle = ViewData["OgTitle"] as string;
    var ogDesc = ViewData["OgDescription"] as string;
    var ogImage = ViewData["OgImage"] as string;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    @if (!string.IsNullOrEmpty(metaDesc))
    {
        <meta name="description" content="@metaDesc">
    }
    @if (!string.IsNullOrEmpty(ogTitle))
    {
        <meta property="og:title" content="@ogTitle">
        <meta property="og:type" content="website">
    }
    @if (!string.IsNullOrEmpty(ogDesc))
    {
        <meta property="og:description" content="@ogDesc">
    }
    @if (!string.IsNullOrEmpty(ogImage))
    {
        <meta property="og:image" content="@ogImage">
    }
}

<div id="public-profile-app" data-slug="@slug">
    <!-- LOADING -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@Html.T("Common.Loading", "Yukleniyor...")</span>
        </div>
    </div>

    <!-- ERROR -->
    <div data-bind="visible: !isLoading() && error()" class="text-center py-5">
        <i class="bi bi-exclamation-triangle text-warning" style="font-size: 4rem;"></i>
        <h3 class="mt-3">@Html.T("Profile.NotFound", "Profil Bulunamadi")</h3>
        <p class="text-muted" data-bind="text: error"></p>
        <a href="/" class="btn btn-primary mt-3">@Html.T("Common.BackToHome", "Ana Sayfaya Don")</a>
    </div>

    <!-- PROFILE CONTENT -->
    <div data-bind="visible: !isLoading() && !error() && profile()">

        <!-- ==================== HERO SECTION ==================== -->
        <div class="profile-hero position-relative mb-0">
            <!-- Cover Image -->
            <div class="profile-hero-cover" data-bind="style: { backgroundImage: profile().coverImageUrl ? 'url(' + profile().coverImageUrl + ')' : 'none' }">
            </div>
            <!-- Overlay -->
            <div class="profile-hero-overlay">
                <div class="container">
                    <div class="d-flex align-items-end gap-3 pb-3">
                        <!-- Logo -->
                        <!-- ko if: profile().logoUrl -->
                        <img data-bind="attr: { src: profile().logoUrl, alt: profile().displayName }" class="profile-hero-logo">
                        <!-- /ko -->
                        <!-- ko ifnot: profile().logoUrl -->
                        <div class="profile-hero-logo bg-white d-flex align-items-center justify-content-center">
                            <i class="bi bi-building text-primary" style="font-size: 2.5rem;"></i>
                        </div>
                        <!-- /ko -->
                        <div class="text-white flex-grow-1">
                            <h1 class="h2 mb-1 fw-bold text-shadow" data-bind="text: profile().displayName || profile().companyName"></h1>
                            <!-- ko if: profile().tagline -->
                            <p class="mb-2 opacity-90 text-shadow" data-bind="text: profile().tagline"></p>
                            <!-- /ko -->
                            <div class="d-flex flex-wrap gap-2">
                                <span class="badge bg-white text-primary" data-bind="text: profile().capabilityName"></span>
                                <!-- ko if: profile().isVerified -->
                                <span class="badge bg-success"><i class="bi bi-patch-check-fill me-1"></i>@Html.T("Profile.Verified", "Dogrulanmis")</span>
                                <!-- /ko -->
                                <!-- ko if: profile().countryName -->
                                <span class="badge bg-white bg-opacity-25 text-white"><i class="bi bi-geo-alt me-1"></i><span data-bind="text: profile().countryName"></span></span>
                                <!-- /ko -->
                                <!-- ko if: profile().viewCount -->
                                <span class="badge bg-white bg-opacity-25 text-white"><i class="bi bi-eye me-1"></i><span data-bind="text: profile().viewCount"></span></span>
                                <!-- /ko -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ==================== TAB NAVIGATION ==================== -->
        <nav class="profile-nav sticky-top bg-white border-bottom shadow-sm">
            <div class="container">
                <ul class="nav nav-pills profile-nav-pills">
                    <li class="nav-item">
                        <a class="nav-link" href="#home" data-bind="click: function(){ setTab('home') }, css: { active: activeTab() === 'home' }">
                            <i class="bi bi-house me-1"></i>@Html.T("Profile.Tab.Home", "Ana Sayfa")
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#about" data-bind="click: function(){ setTab('about') }, css: { active: activeTab() === 'about' }">
                            <i class="bi bi-info-circle me-1"></i>@Html.T("Profile.Tab.About", "Hakkimizda")
                        </a>
                    </li>
                    <!-- ko if: profile().productCount > 0 -->
                    <li class="nav-item">
                        <a class="nav-link" href="#products" data-bind="click: function(){ setTab('products') }, css: { active: activeTab() === 'products' }">
                            <i class="bi bi-box-seam me-1"></i>@Html.T("Profile.Tab.Products", "Urunler")
                            <span class="badge bg-secondary ms-1" data-bind="text: profile().productCount"></span>
                        </a>
                    </li>
                    <!-- /ko -->
                    <li class="nav-item">
                        <a class="nav-link" href="#services" data-bind="click: function(){ setTab('services') }, css: { active: activeTab() === 'services' }">
                            <i class="bi bi-briefcase me-1"></i>@Html.T("Profile.Tab.Services", "Hizmetler")
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#contact" data-bind="click: function(){ setTab('contact') }, css: { active: activeTab() === 'contact' }">
                            <i class="bi bi-envelope me-1"></i>@Html.T("Profile.Tab.Contact", "Iletisim")
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- ==================== TAB CONTENT ==================== -->
        <div class="container py-4">

            <!-- ========== HOME TAB ========== -->
            <div data-bind="visible: activeTab() === 'home'">
                <!-- Short Description -->
                <!-- ko if: profile().shortDescription || profile().description -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <p class="lead mb-0" data-bind="text: profile().shortDescription || (profile().description ? profile().description.substring(0, 300) + '...' : '')"></p>
                    </div>
                </div>
                <!-- /ko -->

                <!-- Highlights -->
                <!-- ko if: profile().highlightList && profile().highlightList.length > 0 -->
                <div class="row g-3 mb-4">
                    <!-- ko foreach: profile().highlightList -->
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm text-center h-100">
                            <div class="card-body py-4">
                                <i class="text-primary mb-2" style="font-size: 2rem;" data-bind="css: icon || 'bi bi-star'"></i>
                                <h3 class="fw-bold mb-1" data-bind="text: value"></h3>
                                <small class="text-muted" data-bind="text: label"></small>
                            </div>
                        </div>
                    </div>
                    <!-- /ko -->
                </div>
                <!-- /ko -->

                <!-- Featured Products -->
                <!-- ko if: featuredProducts().length > 0 -->
                <h4 class="mb-3"><i class="bi bi-star me-2"></i>@Html.T("Profile.FeaturedProducts", "One Cikan Urunler")</h4>
                <div class="row g-3 mb-4">
                    <!-- ko foreach: featuredProducts -->
                    <div class="col-6 col-md-3">
                        <div class="card profile-product-card h-100 shadow-sm border-0">
                            <!-- ko if: mainImageUrl -->
                            <img data-bind="attr: { src: mainImageUrl, alt: name }" class="card-img-top" style="height: 180px; object-fit: cover;">
                            <!-- /ko -->
                            <!-- ko ifnot: mainImageUrl -->
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 180px;">
                                <i class="bi bi-image text-muted" style="font-size: 2rem;"></i>
                            </div>
                            <!-- /ko -->
                            <div class="card-body p-3">
                                <h6 class="card-title mb-1" data-bind="text: name"></h6>
                                <!-- ko if: price -->
                                <span class="text-primary fw-bold" data-bind="text: price + ' ' + (currency || 'USD')"></span>
                                <!-- /ko -->
                            </div>
                            <a data-bind="attr: { href: '/Catalog/' + slug }" class="stretched-link"></a>
                        </div>
                    </div>
                    <!-- /ko -->
                </div>
                <!-- /ko -->

                <!-- Certifications -->
                <!-- ko if: profile().certifications -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="mb-3"><i class="bi bi-award me-2 text-warning"></i>@Html.T("Profile.Certifications", "Sertifikalar")</h5>
                        <p data-bind="text: profile().certifications"></p>
                    </div>
                </div>
                <!-- /ko -->

                <!-- CTA -->
                <div class="text-center py-3">
                    <button class="btn btn-primary btn-lg px-5" data-bind="click: function(){ setTab('contact') }">
                        <i class="bi bi-chat-dots me-2"></i>@Html.T("Profile.ContactUs", "Iletisime Gecin")
                    </button>
                </div>
            </div>

            <!-- ========== ABOUT TAB ========== -->
            <div data-bind="visible: activeTab() === 'about'">
                <!-- Full Description -->
                <!-- ko if: profile().description -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h4 class="mb-3"><i class="bi bi-info-circle me-2"></i>@Html.T("Profile.About", "Hakkimizda")</h4>
                        <p style="white-space: pre-line;" data-bind="text: profile().description"></p>
                    </div>
                </div>
                <!-- /ko -->

                <!-- Gallery -->
                <!-- ko if: profile().galleryImageList && profile().galleryImageList.length > 0 -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="mb-3"><i class="bi bi-images me-2"></i>@Html.T("Profile.Gallery", "Galeri")</h5>
                        <div class="row g-2">
                            <!-- ko foreach: profile().galleryImageList -->
                            <div class="col-6 col-md-4 col-lg-3">
                                <img data-bind="attr: { src: url, alt: caption || '' }" class="profile-gallery-thumb rounded shadow-sm">
                            </div>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
                <!-- /ko -->

                <!-- Certifications Detail -->
                <!-- ko if: profile().certifications -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="mb-3"><i class="bi bi-award me-2"></i>@Html.T("Profile.Certifications", "Sertifikalar")</h5>
                        <p data-bind="text: profile().certifications"></p>
                    </div>
                </div>
                <!-- /ko -->

                <!-- Service Regions -->
                <!-- ko if: profile().serviceRegions -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="mb-3"><i class="bi bi-globe me-2"></i>@Html.T("Profile.ServiceRegions", "Hizmet Bolgeleri")</h5>
                        <p data-bind="text: profile().serviceRegions"></p>
                    </div>
                </div>
                <!-- /ko -->

                <!-- Categories (for Seller) -->
                <!-- ko if: profile().categories && profile().categories.length > 0 -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="mb-3"><i class="bi bi-tags me-2"></i>@Html.T("Profile.Categories", "Kategoriler")</h5>
                        <div class="d-flex flex-wrap gap-2">
                            <!-- ko foreach: profile().categories -->
                            <span class="badge bg-light text-dark border">
                                <!-- ko if: icon --><i data-bind="css: icon" class="me-1"></i><!-- /ko -->
                                <span data-bind="text: name"></span>
                            </span>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
                <!-- /ko -->
            </div>

            <!-- ========== PRODUCTS TAB ========== -->
            <div data-bind="visible: activeTab() === 'products'">
                <!-- Search -->
                <div class="d-flex gap-2 mb-4">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="@Html.T("Profile.SearchProducts", "Urun ara...")" data-bind="textInput: productSearch">
                    </div>
                </div>

                <!-- Products Loading -->
                <div data-bind="visible: productsLoading" class="text-center py-4">
                    <div class="spinner-border spinner-border-sm text-primary"></div>
                </div>

                <!-- Products Grid -->
                <div data-bind="visible: !productsLoading()">
                    <!-- ko if: products().length > 0 -->
                    <div class="row g-3">
                        <!-- ko foreach: products -->
                        <div class="col-6 col-md-4 col-lg-3">
                            <div class="card profile-product-card h-100 shadow-sm border-0">
                                <!-- ko if: mainImageUrl -->
                                <img data-bind="attr: { src: mainImageUrl, alt: name }" class="card-img-top" style="height: 180px; object-fit: cover;" loading="lazy">
                                <!-- /ko -->
                                <!-- ko ifnot: mainImageUrl -->
                                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 180px;">
                                    <i class="bi bi-image text-muted" style="font-size: 2rem;"></i>
                                </div>
                                <!-- /ko -->
                                <div class="card-body p-3">
                                    <h6 class="card-title mb-1 text-truncate" data-bind="text: name, attr: { title: name }"></h6>
                                    <!-- ko if: shortDescription -->
                                    <p class="text-muted small mb-2" data-bind="text: shortDescription.substring(0, 60)"></p>
                                    <!-- /ko -->
                                    <!-- ko if: price -->
                                    <span class="text-primary fw-bold" data-bind="text: price.toLocaleString() + ' ' + (currency || 'USD')"></span>
                                    <!-- /ko -->
                                </div>
                                <a data-bind="attr: { href: '/Catalog/' + slug }" class="stretched-link"></a>
                            </div>
                        </div>
                        <!-- /ko -->
                    </div>

                    <!-- Pagination -->
                    <!-- ko if: productTotalPages() > 1 -->
                    <nav class="mt-4">
                        <ul class="pagination justify-content-center">
                            <li class="page-item" data-bind="css: { disabled: productPage() <= 1 }">
                                <a class="page-link" href="#" data-bind="click: prevProductPage"><i class="bi bi-chevron-left"></i></a>
                            </li>
                            <!-- ko foreach: productPageNumbers -->
                            <li class="page-item" data-bind="css: { active: $data === $parent.productPage() }">
                                <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToProductPage($data) }"></a>
                            </li>
                            <!-- /ko -->
                            <li class="page-item" data-bind="css: { disabled: productPage() >= productTotalPages() }">
                                <a class="page-link" href="#" data-bind="click: nextProductPage"><i class="bi bi-chevron-right"></i></a>
                            </li>
                        </ul>
                    </nav>
                    <!-- /ko -->
                    <!-- /ko -->

                    <!-- ko if: products().length === 0 && !productsLoading() -->
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-box-seam" style="font-size: 3rem;"></i>
                        <p class="mt-2">@Html.T("Profile.NoProducts", "Henuz urun bulunmuyor.")</p>
                    </div>
                    <!-- /ko -->
                </div>
            </div>

            <!-- ========== SERVICES TAB ========== -->
            <div data-bind="visible: activeTab() === 'services'">
                <!-- Services -->
                <!-- ko if: profile().services -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h4 class="mb-3"><i class="bi bi-briefcase me-2"></i>@Html.T("Profile.Services", "Hizmetler")</h4>
                        <p style="white-space: pre-line;" data-bind="text: profile().services"></p>
                    </div>
                </div>
                <!-- /ko -->

                <!-- Capabilities -->
                <!-- ko if: profile().capabilities -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="mb-3"><i class="bi bi-lightning me-2"></i>@Html.T("Profile.Capabilities", "Yetenekler")</h5>
                        <p data-bind="text: profile().capabilities"></p>
                    </div>
                </div>
                <!-- /ko -->

                <!-- Capability-Specific Cards -->
                <!-- Satici (2) -->
                <!-- ko if: profile().capabilityId === 2 && (profile().productionCapacity || profile().minimumOrderValue || profile().leadTime) -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="mb-3"><i class="bi bi-shop me-2 text-primary"></i>@Html.T("Profile.SellerInfo", "Satici Bilgileri")</h5>
                        <div class="row g-3">
                            <!-- ko if: profile().productionCapacity -->
                            <div class="col-md-4"><div class="p-3 bg-light rounded"><small class="text-muted d-block">@Html.T("Profile.ProductionCapacity", "Uretim Kapasitesi")</small><strong data-bind="text: profile().productionCapacity"></strong></div></div>
                            <!-- /ko -->
                            <!-- ko if: profile().minimumOrderValue -->
                            <div class="col-md-4"><div class="p-3 bg-light rounded"><small class="text-muted d-block">@Html.T("Profile.MinOrder", "Min. Siparis")</small><strong data-bind="text: profile().minimumOrderValue"></strong></div></div>
                            <!-- /ko -->
                            <!-- ko if: profile().leadTime -->
                            <div class="col-md-4"><div class="p-3 bg-light rounded"><small class="text-muted d-block">@Html.T("Profile.LeadTime", "Teslim Suresi")</small><strong data-bind="text: profile().leadTime"></strong></div></div>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
                <!-- /ko -->

                <!-- Alici (3) -->
                <!-- ko if: profile().capabilityId === 3 && (profile().industry || profile().businessType || profile().annualPurchaseVolume) -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="mb-3"><i class="bi bi-cart me-2 text-primary"></i>@Html.T("Profile.BuyerInfo", "Alici Bilgileri")</h5>
                        <div class="row g-3">
                            <!-- ko if: profile().industry -->
                            <div class="col-md-4"><div class="p-3 bg-light rounded"><small class="text-muted d-block">@Html.T("Profile.Industry", "Sektor")</small><strong data-bind="text: profile().industry"></strong></div></div>
                            <!-- /ko -->
                            <!-- ko if: profile().businessType -->
                            <div class="col-md-4"><div class="p-3 bg-light rounded"><small class="text-muted d-block">@Html.T("Profile.BusinessType", "Is Tipi")</small><strong data-bind="text: profile().businessType"></strong></div></div>
                            <!-- /ko -->
                            <!-- ko if: profile().annualPurchaseVolume -->
                            <div class="col-md-4"><div class="p-3 bg-light rounded"><small class="text-muted d-block">@Html.T("Profile.AnnualVolume", "Yillik Hacim")</small><strong><span data-bind="text: profile().annualPurchaseVolume"></span> <span data-bind="text: profile().purchaseVolumeCurrency"></span></strong></div></div>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
                <!-- /ko -->

                <!-- Tasimaci (4) -->
                <!-- ko if: profile().capabilityId === 4 && (profile().fleetInfo || profile().transportModes || profile().routes) -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="mb-3"><i class="bi bi-truck me-2 text-primary"></i>@Html.T("Profile.CarrierInfo", "Lojistik Bilgileri")</h5>
                        <!-- ko if: profile().fleetInfo --><div class="mb-2"><strong>@Html.T("Profile.Fleet", "Filo"):</strong> <span data-bind="text: profile().fleetInfo"></span></div><!-- /ko -->
                        <!-- ko if: profile().transportModes --><div class="mb-2"><strong>@Html.T("Profile.TransportModes", "Tasima Yontemleri"):</strong> <span data-bind="text: profile().transportModes"></span></div><!-- /ko -->
                        <!-- ko if: profile().routes --><div><strong>@Html.T("Profile.Routes", "Rotalar"):</strong> <span data-bind="text: profile().routes"></span></div><!-- /ko -->
                    </div>
                </div>
                <!-- /ko -->

                <!-- Sigorta (5) -->
                <!-- ko if: profile().capabilityId === 5 && (profile().insuranceTypes || profile().coverageTypes || profile().maxCoverageAmount) -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="mb-3"><i class="bi bi-shield-check me-2 text-primary"></i>@Html.T("Profile.InsuranceInfo", "Sigorta Bilgileri")</h5>
                        <!-- ko if: profile().insuranceTypes --><div class="mb-2"><strong>@Html.T("Profile.InsuranceTypes", "Sigorta Turleri"):</strong> <span data-bind="text: profile().insuranceTypes"></span></div><!-- /ko -->
                        <!-- ko if: profile().coverageTypes --><div class="mb-2"><strong>@Html.T("Profile.CoverageTypes", "Teminat Turleri"):</strong> <span data-bind="text: profile().coverageTypes"></span></div><!-- /ko -->
                        <!-- ko if: profile().maxCoverageAmount --><div><strong>@Html.T("Profile.MaxCoverage", "Maks. Teminat"):</strong> <span data-bind="text: profile().maxCoverageAmount"></span> <span data-bind="text: profile().maxCoverageCurrency"></span></div><!-- /ko -->
                    </div>
                </div>
                <!-- /ko -->

                <!-- Gumruk (6) -->
                <!-- ko if: profile().capabilityId === 6 && (profile().customsServices || profile().licenseNumbers || profile().customsOffices) -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="mb-3"><i class="bi bi-passport me-2 text-primary"></i>@Html.T("Profile.CustomsInfo", "Gumruk Bilgileri")</h5>
                        <!-- ko if: profile().customsServices --><div class="mb-2"><strong>@Html.T("Profile.CustomsServices", "Gumruk Hizmetleri"):</strong> <span data-bind="text: profile().customsServices"></span></div><!-- /ko -->
                        <!-- ko if: profile().licenseNumbers --><div class="mb-2"><strong>@Html.T("Profile.LicenseNumbers", "Lisans No"):</strong> <span data-bind="text: profile().licenseNumbers"></span></div><!-- /ko -->
                        <!-- ko if: profile().customsOffices --><div><strong>@Html.T("Profile.CustomsOffices", "Calisilan Gumrukler"):</strong> <span data-bind="text: profile().customsOffices"></span></div><!-- /ko -->
                    </div>
                </div>
                <!-- /ko -->

                <!-- Gozetim (7) -->
                <!-- ko if: profile().capabilityId === 7 && (profile().inspectionTypes || profile().inspectionStandards) -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="mb-3"><i class="bi bi-search me-2 text-primary"></i>@Html.T("Profile.SurveyInfo", "Gozetim Bilgileri")</h5>
                        <!-- ko if: profile().inspectionTypes --><div class="mb-2"><strong>@Html.T("Profile.InspectionTypes", "Gozetim Turleri"):</strong> <span data-bind="text: profile().inspectionTypes"></span></div><!-- /ko -->
                        <!-- ko if: profile().inspectionStandards --><div><strong>@Html.T("Profile.InspectionStandards", "Standartlar"):</strong> <span data-bind="text: profile().inspectionStandards"></span></div><!-- /ko -->
                    </div>
                </div>
                <!-- /ko -->

                <!-- Yatirimci (8) -->
                <!-- ko if: profile().capabilityId === 8 && (profile().investmentTypes || profile().investmentFocus || profile().minInvestmentAmount) -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="mb-3"><i class="bi bi-graph-up-arrow me-2 text-primary"></i>@Html.T("Profile.InvestorInfo", "Yatirimci Bilgileri")</h5>
                        <!-- ko if: profile().investmentTypes --><div class="mb-2"><strong>@Html.T("Profile.InvestmentTypes", "Yatirim Turleri"):</strong> <span data-bind="text: profile().investmentTypes"></span></div><!-- /ko -->
                        <!-- ko if: profile().investmentFocus --><div class="mb-2"><strong>@Html.T("Profile.InvestmentFocus", "Yatirim Odagi"):</strong> <span data-bind="text: profile().investmentFocus"></span></div><!-- /ko -->
                        <!-- ko if: profile().minInvestmentAmount || profile().maxInvestmentAmount -->
                        <div><strong>@Html.T("Profile.InvestmentRange", "Yatirim Araligi"):</strong> <span data-bind="text: profile().minInvestmentAmount"></span> - <span data-bind="text: profile().maxInvestmentAmount"></span> <span data-bind="text: profile().investmentCurrency"></span></div>
                        <!-- /ko -->
                    </div>
                </div>
                <!-- /ko -->

                <!-- No Services fallback -->
                <!-- ko if: !profile().services && !profile().capabilities -->
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-briefcase" style="font-size: 3rem;"></i>
                    <p class="mt-2">@Html.T("Profile.NoServices", "Henuz hizmet bilgisi girilmemis.")</p>
                </div>
                <!-- /ko -->
            </div>

            <!-- ========== CONTACT TAB ========== -->
            <div data-bind="visible: activeTab() === 'contact'">
                <div class="row g-4">
                    <!-- Contact Form -->
                    <div class="col-lg-7">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body p-4">
                                <h4 class="mb-4"><i class="bi bi-chat-dots me-2"></i>@Html.T("Profile.SendMessage", "Mesaj Gonderin")</h4>

                                <!-- Success State -->
                                <div data-bind="visible: contactSent" class="text-center py-4">
                                    <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
                                    <h5 class="mt-3">@Html.T("Profile.Contact.Success", "Mesajiniz basariyla iletildi!")</h5>
                                    <p class="text-muted">@Html.T("Profile.Contact.SuccessDetail", "Firma en kisa surede sizinle iletisime gececek.")</p>
                                    <button class="btn btn-outline-primary mt-2" data-bind="click: resetContactForm">
                                        @Html.T("Profile.Contact.SendAnother", "Baska Mesaj Gonder")
                                    </button>
                                </div>

                                <!-- Form -->
                                <form data-bind="visible: !contactSent(), submit: submitContact">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label">@Html.T("Profile.Contact.Name", "Adiniz") *</label>
                                            <input type="text" class="form-control" data-bind="value: contactForm.senderName" required>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">@Html.T("Profile.Contact.Email", "E-posta") *</label>
                                            <input type="email" class="form-control" data-bind="value: contactForm.senderEmail" required>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">@Html.T("Profile.Contact.Phone", "Telefon")</label>
                                            <input type="tel" class="form-control" data-bind="value: contactForm.senderPhone">
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">@Html.T("Profile.Contact.Subject", "Konu") *</label>
                                            <input type="text" class="form-control" data-bind="value: contactForm.subject" required>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label">@Html.T("Profile.Contact.Message", "Mesajiniz") *</label>
                                            <textarea class="form-control" rows="5" data-bind="value: contactForm.message" required></textarea>
                                        </div>
                                        <div class="col-12">
                                            <button type="submit" class="btn btn-primary" data-bind="enable: !contactSending()">
                                                <span data-bind="visible: !contactSending()"><i class="bi bi-send me-2"></i>@Html.T("Profile.Contact.Send", "Gonder")</span>
                                                <span data-bind="visible: contactSending"><i class="bi bi-hourglass-split me-2"></i>@Html.T("Common.Sending", "Gonderiliyor...")</span>
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Contact Info Sidebar -->
                    <div class="col-lg-5">
                        <!-- Contact Details -->
                        <!-- ko if: profile().showContactInfo -->
                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-body">
                                <h5 class="mb-3"><i class="bi bi-telephone me-2"></i>@Html.T("Profile.ContactInfo", "Iletisim Bilgileri")</h5>
                                <!-- ko if: profile().publicEmail -->
                                <div class="d-flex align-items-center mb-3">
                                    <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3"><i class="bi bi-envelope text-primary"></i></div>
                                    <a data-bind="attr: { href: 'mailto:' + profile().publicEmail }, text: profile().publicEmail"></a>
                                </div>
                                <!-- /ko -->
                                <!-- ko if: profile().publicPhone -->
                                <div class="d-flex align-items-center mb-3">
                                    <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3"><i class="bi bi-phone text-primary"></i></div>
                                    <a data-bind="attr: { href: 'tel:' + profile().publicPhone }, text: profile().publicPhone"></a>
                                </div>
                                <!-- /ko -->
                                <!-- ko if: profile().publicWebsite -->
                                <div class="d-flex align-items-center mb-3">
                                    <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3"><i class="bi bi-globe text-primary"></i></div>
                                    <a data-bind="attr: { href: profile().publicWebsite }, text: profile().publicWebsite" target="_blank" rel="noopener"></a>
                                </div>
                                <!-- /ko -->
                            </div>
                        </div>
                        <!-- /ko -->

                        <!-- Social Links -->
                        <!-- ko if: profile().socialLinkList && profile().socialLinkList.length > 0 -->
                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-body">
                                <h5 class="mb-3"><i class="bi bi-share me-2"></i>@Html.T("Profile.SocialMedia", "Sosyal Medya")</h5>
                                <div class="d-flex flex-wrap gap-3">
                                    <!-- ko foreach: profile().socialLinkList -->
                                    <a data-bind="attr: { href: url }" target="_blank" rel="noopener" class="social-link">
                                        <i data-bind="css: 'bi bi-' + platform"></i>
                                    </a>
                                    <!-- /ko -->
                                </div>
                            </div>
                        </div>
                        <!-- /ko -->

                        <!-- Working Hours -->
                        <!-- ko if: profile().workingHourList && profile().workingHourList.length > 0 -->
                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-body">
                                <h5 class="mb-3"><i class="bi bi-clock me-2"></i>@Html.T("Profile.WorkingHours", "Calisma Saatleri")</h5>
                                <table class="table table-sm table-borderless mb-0 working-hours">
                                    <tbody data-bind="foreach: profile().workingHourList">
                                        <tr>
                                            <td class="fw-medium" data-bind="text: day"></td>
                                            <td class="text-end" data-bind="text: isClosed ? '@Html.T("Profile.Closed", "Kapali")' : hours, css: { 'text-danger': isClosed }"></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!-- /ko -->

                        <!-- Address -->
                        <!-- ko if: profile().countryName || profile().city || profile().address -->
                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-body">
                                <h5 class="mb-3"><i class="bi bi-geo-alt me-2"></i>@Html.T("Profile.Address", "Adres")</h5>
                                <!-- ko if: profile().address --><p class="mb-1" data-bind="text: profile().address"></p><!-- /ko -->
                                <!-- ko if: profile().city --><p class="mb-1" data-bind="text: profile().city"></p><!-- /ko -->
                                <!-- ko if: profile().countryName --><p class="mb-0 fw-medium" data-bind="text: profile().countryName"></p><!-- /ko -->
                            </div>
                        </div>
                        <!-- /ko -->
                    </div>
                </div>
            </div>

        </div><!-- /container -->
    </div><!-- /profile content -->
</div>

@section Scripts {
    <script src="~/js/Public/Profile.js"></script>
}
