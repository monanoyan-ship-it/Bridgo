@using Bridgo.Extensions
@{
    ViewData["Title"] = Html.T("Home.Title");
    ViewData["FullWidth"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/lib/aos/aos.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<!-- HERO SECTION -->
<section class="hero-section py-5">
    <div class="floating-shape shape-1"></div>
    <div class="floating-shape shape-2"></div>
    <div class="floating-shape shape-3"></div>

    <div class="container hero-content py-5">
        <div class="row align-items-center">
            <div class="col-lg-6" data-aos="fade-right">
                <h1 class="hero-title text-white mb-4">
                    @Html.T("Home.Hero.Title.Part1", "B2B Ticaretin")
                    <br />
                    <span class="rotating-text-container">
                        <span class="rotating-text">
                            <span>@Html.T("Home.Hero.Rotating.1", "Alicilari")</span>
                            <span>@Html.T("Home.Hero.Rotating.2", "Saticilari")</span>
                            <span>@Html.T("Home.Hero.Rotating.3", "Partnerleri")</span>
                        </span>
                    </span>
                    @Html.T("Home.Hero.Title.Part2", "Burada!")
                </h1>
                <p class="lead text-white opacity-75 mb-4">
                    @Html.T("Home.Hero.Subtitle", "Binlerce tedarikci, yuz binlerce urun. Guvenilir B2B ticaret icin dogru adres.")
                </p>

                <!-- Glassmorphism Search Box -->
                <div class="glass-search mb-4">
                    <div class="input-group">
                        <input type="text" class="form-control" id="heroSearch"
                               placeholder="@Html.T("Home.Search.Placeholder", "Urun, kategori veya tedarikci ara...")" />
                        <button class="btn btn-primary px-4" onclick="LandingPage.search($('#heroSearch').val())">
                            <i class="bi bi-search me-2"></i>@Html.T("Home.Search.Button", "Ara")
                        </button>
                    </div>
                </div>

                <!-- Quick Tags -->
                <div class="mb-4">
                    <span class="text-white opacity-75 me-2">@Html.T("Home.Search.Popular", "Populer"):</span>
                    <a href="/Catalog?search=makine" class="quick-tag">Makine</a>
                    <a href="/Catalog?search=tekstil" class="quick-tag">Tekstil</a>
                    <a href="/Catalog?search=gida" class="quick-tag">Gida</a>
                    <a href="/Catalog?search=elektronik" class="quick-tag">Elektronik</a>
                </div>

                <!-- Trust Logos (Placeholder) -->
                <div class="trust-logos mt-4 d-none d-md-flex" data-aos="fade-up" data-aos-delay="200">
                    <span class="text-white opacity-50 small me-3">@Html.T("Home.Hero.TrustedBy", "Guvenilen Marka"):</span>
                    <i class="bi bi-building fs-4 text-white opacity-50 me-3"></i>
                    <i class="bi bi-building fs-4 text-white opacity-50 me-3"></i>
                    <i class="bi bi-building fs-4 text-white opacity-50 me-3"></i>
                    <i class="bi bi-building fs-4 text-white opacity-50"></i>
                </div>
            </div>

            <div class="col-lg-6 d-none d-lg-block" data-aos="fade-left" data-aos-delay="100">
                <div class="hero-illustration text-center">
                    <!-- Platform mockup with CSS -->
                    <div class="hero-mockup mx-auto">
                        <div class="bg-white rounded-4 shadow-lg p-4" style="transform: perspective(1000px) rotateY(-5deg) rotateX(5deg);">
                            <div class="bg-light rounded-3 p-3 mb-3">
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <div class="bg-danger rounded-circle" style="width: 12px; height: 12px;"></div>
                                    <div class="bg-warning rounded-circle" style="width: 12px; height: 12px;"></div>
                                    <div class="bg-success rounded-circle" style="width: 12px; height: 12px;"></div>
                                </div>
                                <div class="bg-primary bg-opacity-10 rounded p-3 mb-2"></div>
                                <div class="row g-2">
                                    <div class="col-6"><div class="bg-secondary bg-opacity-25 rounded p-4"></div></div>
                                    <div class="col-6"><div class="bg-secondary bg-opacity-25 rounded p-4"></div></div>
                                    <div class="col-6"><div class="bg-secondary bg-opacity-25 rounded p-4"></div></div>
                                    <div class="col-6"><div class="bg-secondary bg-opacity-25 rounded p-4"></div></div>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <div class="bg-primary rounded-pill px-3 py-2 flex-grow-1"></div>
                                <div class="bg-success bg-opacity-25 rounded-pill px-3 py-2"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- STATS SECTION -->
<section class="stats-section pb-5">
    <div class="container">
        <div class="stats-card" data-aos="fade-up">
            <div class="row">
                <div class="col-6 col-md-3">
                    <div class="stat-item">
                        <div class="stat-icon primary"><i class="bi bi-box-seam"></i></div>
                        <div class="stat-number">
                            <span class="counter-value" data-target="0" id="statProducts">0</span>
                        </div>
                        <div class="stat-label">@Html.T("Home.Stats.Products", "Urun")</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-item">
                        <div class="stat-icon success"><i class="bi bi-shop"></i></div>
                        <div class="stat-number">
                            <span class="counter-value" data-target="0" id="statVendors">0</span>
                        </div>
                        <div class="stat-label">@Html.T("Home.Stats.Vendors", "Tedarikci")</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-item">
                        <div class="stat-icon info"><i class="bi bi-grid-3x3-gap"></i></div>
                        <div class="stat-number">
                            <span class="counter-value" data-target="0" id="statCategories">0</span>
                        </div>
                        <div class="stat-label">@Html.T("Home.Stats.Categories", "Kategori")</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-item">
                        <div class="stat-icon warning"><i class="bi bi-star"></i></div>
                        <div class="stat-number">
                            <span class="counter-value" data-target="0" id="statFeatured">0</span>
                        </div>
                        <div class="stat-label">@Html.T("Home.Stats.Featured", "One Cikan")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CATEGORIES SECTION -->
<section class="categories-section">
    <div class="container">
        <div class="row align-items-end mb-4">
            <div class="col">
                <h2 class="section-title" data-aos="fade-right">
                    <i class="bi bi-grid-3x3-gap text-primary me-2"></i>@Html.T("Home.Categories.Title", "Populer Kategoriler")
                </h2>
                <p class="section-subtitle" data-aos="fade-right" data-aos-delay="100">
                    @Html.T("Home.Categories.Subtitle", "En cok aranan urun kategorilerini kesfedin")
                </p>
            </div>
            <div class="col-auto" data-aos="fade-left">
                <a href="/Catalog" class="btn btn-outline-primary">
                    @Html.T("Home.Categories.ViewAll", "Tumunu Gor") <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-4" id="categoriesGrid">
            <!-- Loaded via JS -->
            <div class="col-12 text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- VALUE PROPOSITION SECTION -->
<section class="value-section">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title" data-aos="fade-up">@Html.T("Home.Value.Title", "Neden Bridgo?")</h2>
            <p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
                @Html.T("Home.Value.Subtitle", "Alicilar ve saticilar icin ozel avantajlar")
            </p>

            <!-- Tabs -->
            <div class="value-tabs mt-4" data-aos="fade-up" data-aos-delay="200">
                <button class="value-tab active" data-target="buyerContent">
                    <i class="bi bi-cart3 me-2"></i>@Html.T("Home.Value.ForBuyers", "Alicilar Icin")
                </button>
                <button class="value-tab" data-target="sellerContent">
                    <i class="bi bi-shop me-2"></i>@Html.T("Home.Value.ForSellers", "Saticilar Icin")
                </button>
            </div>
        </div>

        <!-- Buyer Content -->
        <div class="value-content" id="buyerContent">
            <div class="row g-4">
                <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="0">
                    <div class="value-card">
                        <div class="value-icon blue"><i class="bi bi-search"></i></div>
                        <h5 class="value-title">@Html.T("Home.Value.Buyer.1.Title", "Kolay Urun Arama")</h5>
                        <p class="value-desc">@Html.T("Home.Value.Buyer.1.Desc", "Binlerce urun arasinda ihtiyacinizi hizlica bulun.")</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="100">
                    <div class="value-card">
                        <div class="value-icon green"><i class="bi bi-shield-check"></i></div>
                        <h5 class="value-title">@Html.T("Home.Value.Buyer.2.Title", "Guvenilir Tedarikciler")</h5>
                        <p class="value-desc">@Html.T("Home.Value.Buyer.2.Desc", "Dogrulanmis firmalarla guvenle calisin.")</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="200">
                    <div class="value-card">
                        <div class="value-icon purple"><i class="bi bi-cash-stack"></i></div>
                        <h5 class="value-title">@Html.T("Home.Value.Buyer.3.Title", "Rekabetci Fiyatlar")</h5>
                        <p class="value-desc">@Html.T("Home.Value.Buyer.3.Desc", "Birden fazla teklif alin, en uygununu secin.")</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="300">
                    <div class="value-card">
                        <div class="value-icon orange"><i class="bi bi-truck"></i></div>
                        <h5 class="value-title">@Html.T("Home.Value.Buyer.4.Title", "Entegre Lojistik")</h5>
                        <p class="value-desc">@Html.T("Home.Value.Buyer.4.Desc", "Kargo ve lojistik hizmetleri tek platformda.")</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Seller Content -->
        <div class="value-content d-none" id="sellerContent">
            <div class="row g-4">
                <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="0">
                    <div class="value-card">
                        <div class="value-icon blue"><i class="bi bi-globe"></i></div>
                        <h5 class="value-title">@Html.T("Home.Value.Seller.1.Title", "Genis Musteri Kitlesi")</h5>
                        <p class="value-desc">@Html.T("Home.Value.Seller.1.Desc", "Turkiye genelinde binlerce potansiyel aliciya ulasin.")</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="100">
                    <div class="value-card">
                        <div class="value-icon green"><i class="bi bi-graph-up-arrow"></i></div>
                        <h5 class="value-title">@Html.T("Home.Value.Seller.2.Title", "Satis Arttirma")</h5>
                        <p class="value-desc">@Html.T("Home.Value.Seller.2.Desc", "Urunlerinizi one cikarin, satislarinizi katlatin.")</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="200">
                    <div class="value-card">
                        <div class="value-icon purple"><i class="bi bi-tools"></i></div>
                        <h5 class="value-title">@Html.T("Home.Value.Seller.3.Title", "Kolay Yonetim")</h5>
                        <p class="value-desc">@Html.T("Home.Value.Seller.3.Desc", "Urun, siparis ve musteri yonetimi tek panelden.")</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="300">
                    <div class="value-card">
                        <div class="value-icon orange"><i class="bi bi-bar-chart"></i></div>
                        <h5 class="value-title">@Html.T("Home.Value.Seller.4.Title", "Detayli Raporlar")</h5>
                        <p class="value-desc">@Html.T("Home.Value.Seller.4.Desc", "Satis performansinizi anlik izleyin.")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FEATURED PRODUCTS SECTION -->
<section class="products-section">
    <div class="container">
        <div class="row align-items-end mb-4">
            <div class="col">
                <h2 class="section-title" data-aos="fade-right">
                    <i class="bi bi-star text-warning me-2"></i>@Html.T("Home.Featured.Title", "One Cikan Urunler")
                </h2>
                <p class="section-subtitle" data-aos="fade-right" data-aos-delay="100">
                    @Html.T("Home.Featured.Subtitle", "En populer ve begeni toplayan urunler")
                </p>
            </div>
            <div class="col-auto" data-aos="fade-left">
                <a href="/Catalog?featured=true" class="btn btn-outline-primary">
                    @Html.T("Home.Featured.ViewAll", "Tumunu Gor") <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4" id="featuredProducts">
            <!-- Loaded via JS -->
            <div class="col-12 text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- HOW IT WORKS SECTION -->
<section class="how-it-works-section">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title" data-aos="fade-up">@Html.T("Home.HowItWorks.Title", "Nasil Calisir?")</h2>
            <p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
                @Html.T("Home.HowItWorks.Subtitle", "4 kolay adimda B2B ticarete baslayin")
            </p>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="0">
                <div class="step-card">
                    <div class="step-number bg-primary bg-opacity-10 text-primary">1</div>
                    <h5 class="step-title">@Html.T("Home.HowItWorks.Step1.Title", "Urun Ara")</h5>
                    <p class="step-desc">@Html.T("Home.HowItWorks.Step1.Desc", "Binlerce urun arasinda ihtiyacinizi bulun")</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="100">
                <div class="step-card">
                    <div class="step-number bg-success bg-opacity-10 text-success">2</div>
                    <h5 class="step-title">@Html.T("Home.HowItWorks.Step2.Title", "Teklif Iste")</h5>
                    <p class="step-desc">@Html.T("Home.HowItWorks.Step2.Desc", "Tedarikcilerden fiyat teklifi alin")</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="200">
                <div class="step-card">
                    <div class="step-number bg-info bg-opacity-10 text-info">3</div>
                    <h5 class="step-title">@Html.T("Home.HowItWorks.Step3.Title", "Karsilastir")</h5>
                    <p class="step-desc">@Html.T("Home.HowItWorks.Step3.Desc", "Teklifleri karsilastirin, en uygununu secin")</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="300">
                <div class="step-card">
                    <div class="step-number bg-warning bg-opacity-10 text-warning">4</div>
                    <h5 class="step-title">@Html.T("Home.HowItWorks.Step4.Title", "Siparis Ver")</h5>
                    <p class="step-desc">@Html.T("Home.HowItWorks.Step4.Desc", "Guvenli odeme ile siparisinizi tamamlayin")</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- TESTIMONIALS SECTION -->
<section class="testimonials-section">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title text-white" data-aos="fade-up">@Html.T("Home.Testimonials.Title", "Musterilerimiz Ne Diyor?")</h2>
            <p class="section-subtitle text-white opacity-75" data-aos="fade-up" data-aos-delay="100">
                @Html.T("Home.Testimonials.Subtitle", "Binlerce mutlu musteri deneyimini paylasiyor")
            </p>
        </div>
        <div class="row g-4">
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="0">
                <div class="testimonial-card">
                    <div class="testimonial-stars mb-3">
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                    </div>
                    <p class="testimonial-content">
                        "@Html.T("Home.Testimonials.1.Text", "Bridgo sayesinde tedarikci bulmak cok kolaylasti. Artik tek platformdan tum ihtiyaclarimi karsiliyorum.")"
                    </p>
                    <div class="testimonial-author">
                        <div class="testimonial-avatar">AY</div>
                        <div>
                            <div class="testimonial-name">@Html.T("Home.Testimonials.1.Name", "Ahmet Yilmaz")</div>
                            <div class="testimonial-role">@Html.T("Home.Testimonials.1.Role", "Satin Alma Muduru")</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="testimonial-card">
                    <div class="testimonial-stars mb-3">
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                    </div>
                    <p class="testimonial-content">
                        "@Html.T("Home.Testimonials.2.Text", "Urunlerimizi sergileyen harika bir platform. Yeni musterilere ulasmamiz cok daha kolay oldu.")"
                    </p>
                    <div class="testimonial-author">
                        <div class="testimonial-avatar">FK</div>
                        <div>
                            <div class="testimonial-name">@Html.T("Home.Testimonials.2.Name", "Fatma Kaya")</div>
                            <div class="testimonial-role">@Html.T("Home.Testimonials.2.Role", "Firma Sahibi")</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="testimonial-card">
                    <div class="testimonial-stars mb-3">
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-half"></i>
                    </div>
                    <p class="testimonial-content">
                        "@Html.T("Home.Testimonials.3.Text", "Lojistik entegrasyonu mukemmel. Siparisleri takip etmek ve yonetmek artik cok basit.")"
                    </p>
                    <div class="testimonial-author">
                        <div class="testimonial-avatar">MO</div>
                        <div>
                            <div class="testimonial-name">@Html.T("Home.Testimonials.3.Name", "Mehmet Ozturk")</div>
                            <div class="testimonial-role">@Html.T("Home.Testimonials.3.Role", "Operasyon Muduru")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- NEW PRODUCTS SECTION -->
<section class="products-section bg-light">
    <div class="container">
        <div class="row align-items-end mb-4">
            <div class="col">
                <h2 class="section-title" data-aos="fade-right">
                    <i class="bi bi-clock-history text-info me-2"></i>@Html.T("Home.NewProducts.Title", "Yeni Eklenen Urunler")
                </h2>
                <p class="section-subtitle" data-aos="fade-right" data-aos-delay="100">
                    @Html.T("Home.NewProducts.Subtitle", "Platformumuza yeni eklenen urunleri kesfedin")
                </p>
            </div>
            <div class="col-auto" data-aos="fade-left">
                <a href="/Catalog?sort=newest" class="btn btn-outline-primary">
                    @Html.T("Home.NewProducts.ViewAll", "Tumunu Gor") <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4" id="newProducts">
            <!-- Loaded via JS -->
            <div class="col-12 text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA SECTION -->
@if (User.Identity?.IsAuthenticated != true)
{
    <section class="cta-section text-white text-center">
        <div class="container position-relative" data-aos="zoom-in">
            <h2 class="cta-title">@Html.T("Home.CTA.Title", "Hemen Baslayin!")</h2>
            <p class="cta-subtitle">@Html.T("Home.CTA.Description", "Ucretsiz uye olun, binlerce tedarikci ve urune erisin.")</p>
            <div class="cta-buttons">
                <a asp-controller="Account" asp-action="Register" class="btn btn-white btn-lg">
                    <i class="bi bi-person-plus me-2"></i>@Html.T("Nav.Register", "Uye Ol")
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-white btn-lg">
                    <i class="bi bi-box-arrow-in-right me-2"></i>@Html.T("Nav.Login", "Giris Yap")
                </a>
            </div>
        </div>
    </section>
}

@section Scripts {
<script src="~/lib/aos/aos.js" asp-append-version="true"></script>
<script src="~/js/home.js" asp-append-version="true"></script>
<script>
(function() {
    // Load stats with counter animation
    LandingPage.loadStats(function(data) {
        var products = document.getElementById('statProducts');
        var vendors = document.getElementById('statVendors');
        var categories = document.getElementById('statCategories');
        var featured = document.getElementById('statFeatured');

        if (products) products.setAttribute('data-target', data.totalProducts);
        if (vendors) vendors.setAttribute('data-target', data.totalVendors);
        if (categories) categories.setAttribute('data-target', data.totalCategories);
        if (featured) featured.setAttribute('data-target', data.featuredProducts);

        // Refresh AOS to recognize new elements
        if (typeof AOS !== 'undefined') {
            AOS.refresh();
        }
    });

    // Load featured data
    LandingPage.loadFeaturedData({
        categories: function(cats) {
            var html = '';
            if (cats && cats.length > 0) {
                cats.forEach(function(cat, i) {
                    html += LandingPage.renderCategoryCard(cat, i * 50);
                });
            } else {
                html = '<div class="col-12 text-muted text-center">@Html.T("Home.NoCategories", "Henuz kategori yok")</div>';
            }
            $('#categoriesGrid').html(html);
            if (typeof AOS !== 'undefined') AOS.refresh();
        },
        featured: function(products) {
            var html = '';
            if (products && products.length > 0) {
                products.forEach(function(p, i) {
                    html += LandingPage.renderProductCard(p, i * 50);
                });
            } else {
                html = '<div class="col-12 text-muted text-center">@Html.T("Home.NoFeatured", "Henuz one cikan urun yok")</div>';
            }
            $('#featuredProducts').html(html);
            if (typeof AOS !== 'undefined') AOS.refresh();
        },
        newProducts: function(products) {
            var html = '';
            if (products && products.length > 0) {
                products.forEach(function(p, i) {
                    html += LandingPage.renderProductCard(p, i * 50);
                });
            } else {
                html = '<div class="col-12 text-muted text-center">@Html.T("Home.NoNewProducts", "Henuz urun yok")</div>';
            }
            $('#newProducts').html(html);
            if (typeof AOS !== 'undefined') AOS.refresh();
        }
    });

    // Enter key for search
    $('#heroSearch').keypress(function(e) {
        if (e.which === 13) {
            LandingPage.search($(this).val());
        }
    });
})();
</script>
}
