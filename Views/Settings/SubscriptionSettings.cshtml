@using Bridgo.Extensions
@{
    ViewData["Title"] = Html.T("Module.Subscriptions", "Abonelik Ayarlari").ToString();
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
}

<div class="container-fluid" id="subscriptions-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">
                <i class="bi bi-credit-card-2-front text-primary me-2"></i>
                @Html.T("Module.Subscriptions", "Abonelik Ayarlari")
            </h4>
            <p class="text-muted mb-0">@Html.T("Subscriptions.Subtitle", "Abonelik planlarinizi yonetin")</p>
        </div>
    </div>

    <!-- Loading -->
    <!-- ko if: isLoading -->
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Yukleniyor...</p>
    </div>
    <!-- /ko -->

    <!-- ko ifnot: isLoading -->
    <!-- Mevcut Plan -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-1" data-bind="text: currentPlan().name">Mevcut Plan</h5>
                            <p class="text-muted mb-0">
                                <!-- ko if: currentPlan().isActive -->
                                <span class="badge bg-success me-2">Aktif</span>
                                <!-- /ko -->
                                <!-- ko ifnot: currentPlan().isActive -->
                                <span class="badge bg-secondary me-2">Pasif</span>
                                <!-- /ko -->
                                <span data-bind="text: 'Yenileme: ' + currentPlan().renewalDate"></span>
                            </p>
                        </div>
                        <div>
                            <h3 class="mb-0 text-primary">
                                <span data-bind="text: currentPlan().price"></span>
                                <small class="text-muted fs-6">/ay</small>
                            </h3>
                        </div>
                    </div>

                    <!-- Plan Ozellikleri - Capability'ye Gore Dinamik -->
                    <div class="row mt-4" data-bind="foreach: currentPlanMetrics">
                        <div class="col-md-3 col-6 mb-3">
                            <div class="text-center">
                                <i class="bi fs-4 text-primary mb-1" data-bind="class: icon"></i>
                                <h4 class="mb-0" data-bind="text: value"></h4>
                                <small class="text-muted" data-bind="text: label"></small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Mevcut Planlar -->
    <h5 class="mb-3">Mevcut Planlar</h5>
    <div class="row">
        <!-- ko foreach: plans -->
        <div class="col-md-4 mb-4">
            <div class="card h-100" data-bind="css: { 'border-primary': isCurrentPlan }">
                <!-- ko if: isPopular -->
                <div class="card-header bg-primary text-white text-center py-2">
                    <small>En Populer</small>
                </div>
                <!-- /ko -->
                <div class="card-body">
                    <h5 class="card-title" data-bind="text: name"></h5>
                    <h2 class="mb-3">
                        <span data-bind="text: price"></span>
                        <small class="text-muted fs-6">/ay</small>
                    </h2>
                    <ul class="list-unstyled">
                        <!-- ko foreach: features -->
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success me-2"></i>
                            <span data-bind="text: $data"></span>
                        </li>
                        <!-- /ko -->
                    </ul>
                </div>
                <div class="card-footer bg-transparent">
                    <!-- ko if: isCurrentPlan -->
                    <button class="btn btn-outline-secondary w-100" disabled>Mevcut Plan</button>
                    <!-- /ko -->
                    <!-- ko ifnot: isCurrentPlan -->
                    <button class="btn btn-primary w-100" data-bind="click: $parent.selectPlan">
                        <span data-bind="text: isUpgrade ? 'Yukselt' : 'Sec'"></span>
                    </button>
                    <!-- /ko -->
                </div>
            </div>
        </div>
        <!-- /ko -->
    </div>

    <!-- Fatura Gecmisi -->
    <h5 class="mb-3 mt-4">Fatura Gecmisi</h5>
    <div class="card">
        <div class="card-body">
            <!-- ko if: invoices().length === 0 -->
            <div class="text-center text-muted py-4">
                <i class="bi bi-receipt fs-1"></i>
                <p class="mt-2">Henuz fatura bulunmuyor</p>
            </div>
            <!-- /ko -->

            <!-- ko if: invoices().length > 0 -->
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Fatura No</th>
                            <th>Tarih</th>
                            <th>Tutar</th>
                            <th>Durum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: invoices">
                        <tr>
                            <td data-bind="text: invoiceNumber"></td>
                            <td data-bind="text: date"></td>
                            <td data-bind="text: amount"></td>
                            <td>
                                <span class="badge" data-bind="text: statusText, css: statusClass"></span>
                            </td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" data-bind="attr: { href: downloadUrl }">
                                    <i class="bi bi-download"></i>
                                </a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- Iptal Butonu -->
    <!-- ko if: currentPlan().isActive && !currentPlan().isFree -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-danger">
                <div class="card-body">
                    <h6 class="text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Tehlikeli Bolge</h6>
                    <p class="text-muted mb-3">Aboneligi iptal ettiginizde, donem sonuna kadar erisim devam eder.</p>
                    <button class="btn btn-outline-danger" data-bind="click: cancelSubscription">
                        <i class="bi bi-x-lg me-1"></i>
                        Aboneligi Iptal Et
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- /ko -->
    <!-- /ko -->
</div>

@section Scripts {
    <script src="~/js/Dashboard/SubscriptionSettings.js"></script>
}
