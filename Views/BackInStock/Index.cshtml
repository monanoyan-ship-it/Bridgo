@using Bridgo.Extensions
@{
    ViewData["Title"] = Html.T("BackInStock.Title", "Stok Bildirimleri").ToString();
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
}

<div id="back-in-stock-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">
                <i class="bi bi-bell text-primary me-2"></i>
                @Html.T("BackInStock.Title", "Stok Bildirimleri")
            </h4>
            <p class="text-muted mb-0">@Html.T("BackInStock.Subtitle", "Urunler tekrar stoga girdiginde bildirim alin")</p>
        </div>
        <button class="btn btn-sm btn-outline-primary" data-bind="click: refresh">
            <i class="bi bi-arrow-clockwise me-1"></i> @Html.T("Common.Refresh", "Yenile")
        </button>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>

    <div data-bind="visible: !isLoading()">
        <!-- Subscriptions Table -->
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Html.T("BackInStock.Product", "Urun")</th>
                                <th>@Html.T("BackInStock.Sku", "SKU")</th>
                                <th>@Html.T("BackInStock.Status", "Durum")</th>
                                <th>@Html.T("BackInStock.SubscribedAt", "Abone Tarihi")</th>
                                <th class="text-end">@Html.T("Common.Actions", "Islemler")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: subscriptions">
                            <tr>
                                <td data-bind="text: productName"></td>
                                <td><code data-bind="text: productSku || '-'"></code></td>
                                <td>
                                    <!-- ko if: isNotified -->
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle me-1"></i> @Html.T("BackInStock.Notified", "Bildirildi")
                                    </span>
                                    <!-- /ko -->
                                    <!-- ko ifnot: isNotified -->
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-hourglass-split me-1"></i> @Html.T("BackInStock.Waiting", "Bekleniyor")
                                    </span>
                                    <!-- /ko -->
                                </td>
                                <td data-bind="text: $parent.formatDateTime(createdAt)"></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-danger" data-bind="click: function() { $parent.unsubscribe($data); }">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Empty State -->
                <div data-bind="visible: subscriptions().length === 0" class="text-center py-5">
                    <i class="bi bi-bell-slash text-muted display-4 d-block mb-3"></i>
                    <p class="text-muted">@Html.T("BackInStock.NoSubscriptions", "Henuz stok bildirim aboneliginiz yok.")</p>
                    <p class="text-muted small">@Html.T("BackInStock.HowTo", "Urun detay sayfasindan stok bildirimi icin abone olabilirsiniz.")</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/BackInStock/Index.js"></script>
}
