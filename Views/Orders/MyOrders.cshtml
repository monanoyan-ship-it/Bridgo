    <script src="~/js/Dashboard/MyOrders.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            ko.applyBindings(new MyOrdersViewModel(), document.getElementById('my-orders-app'));
        });
    </script>
