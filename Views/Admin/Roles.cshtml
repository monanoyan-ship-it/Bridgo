@{
    ViewData["Title"] = Html.T("Admin.Roles.Title", "Rol Yonetimi").ToString();
    Layout = "_AdminLayout";
}

<div id="roles-app">
    <div class="row">
        <!-- Capability Filter -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h6 class="mb-0">@Html.T("Admin.Roles.FilterByCapability", "Yetenege Gore Filtrele")</h6>
                </div>
                <div class="list-group list-group-flush">
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                       data-bind="click: function() { selectCapability(null) }, css: { active: !selectedCapabilityId() }">
                        <span>
                            <i class="bi bi-collection me-2"></i> @Html.T("Common.All", "Tumu")
                        </span>
                        <span class="badge bg-primary rounded-pill" data-bind="text: totalRoleCount"></span>
                    </a>
                </div>
                <div class="list-group list-group-flush" data-bind="foreach: capabilities">
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                       data-bind="click: $parent.selectCapability, css: { active: $parent.selectedCapabilityId() === id }">
                        <span>
                            <i data-bind="class: icon" class="me-2"></i>
                            <span data-bind="text: name"></span>
                        </span>
                        <span class="badge bg-primary rounded-pill" data-bind="text: roleCount"></span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Rol Listesi -->
        <div class="col-md-9">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">
                        <span data-bind="text: selectedCapabilityName() || '@Html.T("Common.All", "Tum")'"></span> @Html.T("Admin.Menu.Roles", "Roller")
                    </h6>
                    <button class="btn btn-primary btn-sm" data-bind="click: showAddModal">
                        <i class="bi bi-plus-lg me-1"></i> @Html.T("Admin.Roles.AddNew", "Yeni Rol")
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>@Html.T("Admin.Roles.Role", "Rol")</th>
                                    <th>@Html.T("Admin.Table.Capability", "Yetenek")</th>
                                    <th>@Html.T("Admin.Roles.Default", "Varsayilan")</th>
                                    <th>@Html.T("Admin.Table.UserCount", "Kullanici")</th>
                                    <th>@Html.T("Admin.Table.Status", "Durum")</th>
                                    <th style="width: 150px;">@Html.T("Admin.Table.Actions", "Islemler")</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: filteredRoles">
                                <tr>
                                    <td>
                                        <strong data-bind="text: localizedName || name"></strong>
                                        <!-- ko if: nameResourceKey -->
                                        <br><small class="text-muted"><i class="bi bi-translate me-1"></i><span data-bind="text: nameResourceKey"></span></small>
                                        <!-- /ko -->
                                        <!-- ko if: description -->
                                        <br><small class="text-muted" data-bind="text: description"></small>
                                        <!-- /ko -->
                                    </td>
                                    <td>
                                        <span class="badge bg-info">
                                            <i data-bind="class: capabilityIcon"></i>
                                            <span data-bind="text: capabilityName"></span>
                                        </span>
                                    </td>
                                    <td>
                                        <!-- ko if: isDefault -->
                                        <span class="badge bg-primary"><i class="bi bi-check-circle me-1"></i>@Html.T("Common.Yes", "Evet")</span>
                                        <!-- /ko -->
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark" data-bind="text: userCount"></span>
                                    </td>
                                    <td>
                                        <span class="badge" data-bind="text: isActive ? '@Html.T("Common.Active", "Aktif")' : '@Html.T("Common.Inactive", "Pasif")',
                                          css: isActive ? 'bg-success' : 'bg-secondary'"></span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary" title="@Html.T("Common.Edit", "Duzenle")" data-bind="click: $parent.showEditModal">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-outline-info" title="@Html.T("Admin.Roles.Permissions", "Izinler")" data-bind="click: $parent.showPermissionsModal">
                                                <i class="bi bi-shield-check"></i>
                                            </button>
                                            <button class="btn btn-outline-danger btn-gap" title="@Html.T("Common.Delete", "Sil")"
                                                    data-bind="click: $parent.confirmDeleteRole">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Loading -->
                    <div class="text-center py-4" data-bind="visible: isLoading">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>

                    <!-- Empty State -->
                    <div class="text-center py-5" data-bind="visible: !isLoading() && filteredRoles().length === 0">
                        <i class="bi bi-person-badge text-muted fs-1"></i>
                        <p class="text-muted mt-2">@Html.T("Admin.Roles.Empty", "Bu kriterlere uygun rol bulunamadi")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Add/Edit Modal -->
    <div class="modal fade" id="roleModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" data-bind="text: isEditing() ? '@Html.T("Admin.Roles.Edit", "Rol Duzenle")' : '@Html.T("Admin.Roles.AddNew", "Yeni Rol")'"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form data-bind="submit: saveRole">
                        <div class="mb-3">
                            <label class="form-label">@Html.T("Admin.Table.Name", "Ad") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: formData.name" required>
                            <small class="text-muted">@Html.T("Admin.Roles.NameHint", "Ceviri bulunamazsa gosterilecek fallback isim")</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">
                                <i class="bi bi-translate me-1"></i>@Html.T("Admin.Roles.ResourceKey", "Ceviri Anahtari")
                            </label>
                            <input type="text" class="form-control" data-bind="value: formData.nameResourceKey" placeholder="Role.SalesRepresentative">
                            <small class="text-muted">@Html.T("Admin.Roles.ResourceKeyHint", "Cok dilli isim icin (orn: Role.SalesRepresentative)")</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@Html.T("Admin.Table.Capability", "Yetenek") <span class="text-danger">*</span></label>
                            <select class="form-select" data-bind="value: formData.capabilityId, enable: !isEditing()">
                                <option value="">@Html.T("Common.Select", "Secin...")</option>
                                <!-- ko foreach: capabilities -->
                                <option data-bind="value: id, text: name"></option>
                                <!-- /ko -->
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@Html.T("Admin.Table.Description", "Aciklama")</label>
                            <textarea class="form-control" rows="2" data-bind="value: formData.description"></textarea>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check mb-3">
                                    <input type="checkbox" class="form-check-input" id="roleIsDefault" data-bind="checked: formData.isDefault">
                                    <label class="form-check-label" for="roleIsDefault">
                                        <i class="bi bi-star-fill text-warning me-1"></i>@Html.T("Admin.Roles.IsDefault", "Varsayilan Rol")
                                    </label>
                                    <div><small class="text-muted">@Html.T("Admin.Roles.IsDefaultHint", "Yeni firma kaydinda otomatik atanir")</small></div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mb-3">
                                    <input type="checkbox" class="form-check-input" id="roleIsActive" data-bind="checked: formData.isActive">
                                    <label class="form-check-label" for="roleIsActive">@Html.T("Common.Active", "Aktif")</label>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Cancel", "Iptal")</button>
                    <button type="button" class="btn btn-primary" data-bind="click: saveRole, enable: !isSaving()">
                        <span data-bind="visible: isSaving()" class="spinner-border spinner-border-sm me-1"></span>
                        <span data-bind="text: isEditing() ? '@Html.T("Common.Update", "Guncelle")' : '@Html.T("Common.Save", "Kaydet")'"></span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Permissions Modal -->
    <div class="modal fade" id="permissionsModal" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <span data-bind="text: selectedRole()?.name"></span> - @Html.T("Admin.Roles.ModulePermissions", "Modul Izinleri")
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Tumunu Sec Header -->
                    <div class="row align-items-center mb-3 pb-2 border-bottom bg-light rounded p-2">
                        <div class="col">
                            <strong><i class="bi bi-check-all me-1"></i> @Html.T("Admin.Roles.SelectAll", "Tumunu Sec")</strong>
                            <small class="text-muted ms-2" data-bind="text: '(' + selectedModuleCount() + ' / ' + totalModuleCount() + ' modul secili)'"></small>
                        </div>
                        <div class="col-auto text-center" style="width: 70px;">
                            <div class="form-check d-inline-block">
                                <input type="checkbox" class="form-check-input" id="selectAllView"
                                       data-bind="checked: allViewSelected, click: function() { toggleSelectAllByType('view'); return true; }">
                                <label class="form-check-label small" for="selectAllView">Gor</label>
                            </div>
                        </div>
                        <div class="col-auto text-center" style="width: 70px;">
                            <div class="form-check d-inline-block">
                                <input type="checkbox" class="form-check-input" id="selectAllCreate"
                                       data-bind="checked: allCreateSelected, click: function() { toggleSelectAllByType('create'); return true; }">
                                <label class="form-check-label small" for="selectAllCreate">Ekle</label>
                            </div>
                        </div>
                        <div class="col-auto text-center" style="width: 70px;">
                            <div class="form-check d-inline-block">
                                <input type="checkbox" class="form-check-input" id="selectAllEdit"
                                       data-bind="checked: allEditSelected, click: function() { toggleSelectAllByType('edit'); return true; }">
                                <label class="form-check-label small" for="selectAllEdit">Duzenle</label>
                            </div>
                        </div>
                        <div class="col-auto text-center" style="width: 70px;">
                            <div class="form-check d-inline-block">
                                <input type="checkbox" class="form-check-input" id="selectAllDelete"
                                       data-bind="checked: allDeleteSelected, click: function() { toggleSelectAllByType('delete'); return true; }">
                                <label class="form-check-label small" for="selectAllDelete">Sil</label>
                            </div>
                        </div>
                    </div>

                    <!-- Capability Groups -->
                    <div class="permissions-tree" style="max-height: 450px; overflow-y: auto;">
                        <!-- ko foreach: capabilityGroups -->
                        <div class="capability-group mb-3">
                            <!-- Capability Header -->
                            <div class="capability-header d-flex align-items-center p-2 bg-primary bg-opacity-10 rounded"
                                 style="cursor: pointer;"
                                 data-bind="click: function() { isExpanded(!isExpanded()); }">
                                <i class="bi me-2" data-bind="css: isExpanded() ? 'bi-chevron-down' : 'bi-chevron-right'"></i>
                                <i data-bind="class: capabilityIcon" class="me-2 text-primary"></i>
                                <strong data-bind="text: capabilityName"></strong>
                                <span class="badge bg-primary ms-2" data-bind="text: modules.length + ' modul'"></span>
                            </div>
                            <!-- Capability Modules -->
                            <div class="capability-modules ps-2" data-bind="visible: isExpanded">
                                <div data-bind="template: { name: 'permission-tree-template', data: { modules: modules, level: 0 } }"></div>
                            </div>
                        </div>
                        <!-- /ko -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Close", "Kapat")</button>
                    <button type="button" class="btn btn-primary" data-bind="click: savePermissions, enable: !isSavingPermissions()">
                        <span data-bind="visible: isSavingPermissions()" class="spinner-border spinner-border-sm me-1"></span>
                        @Html.T("Admin.Roles.SavePermissions", "Izinleri Kaydet")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Role Modal -->
    <div class="modal fade" id="deleteRoleModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="bi bi-trash me-2"></i>@Html.T("Admin.Roles.Delete", "Rol Sil")</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div data-bind="visible: deleteRoleData().userCount === 0">
                        <p class="mb-0">
                            <strong data-bind="text: deleteRoleData().name"></strong> @Html.T("Admin.Roles.DeleteConfirm", "rolunu silmek istediginize emin misiniz?")
                        </p>
                    </div>
                    <div data-bind="visible: deleteRoleData().userCount > 0">
                        <div class="alert alert-warning mb-3">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <strong data-bind="text: deleteRoleData().name"></strong> @Html.T("Admin.Roles.HasUsers", "rolunde")
                            <strong data-bind="text: deleteRoleData().userCount"></strong> @Html.T("Admin.Roles.UsersExist", "kullanici bulunuyor.")
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@Html.T("Admin.Roles.TransferTo", "Kullanicilari tasi") <span class="text-danger">*</span></label>
                            <select class="form-select" data-bind="value: targetRoleId, options: availableTargetRoles, optionsText: 'name', optionsValue: 'id', optionsCaption: '@Html.T("Common.Select", "Secin...")'"></select>
                            <small class="text-muted">@Html.T("Admin.Roles.TransferHint", "Kullanicilar secilen role tasinacak")</small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Cancel", "Iptal")</button>
                    <button type="button" class="btn btn-danger" data-bind="click: executeDeleteRole, enable: canDelete">
                        <span data-bind="visible: isDeleting()" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-trash me-1" data-bind="visible: !isDeleting()"></i>
                        @Html.T("Common.Delete", "Sil")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Permission Tree Template -->
    <script type="text/html" id="permission-tree-template">
        <ul class="list-unstyled" data-bind="style: { marginLeft: level > 0 ? '1.5rem' : '0' }">
            <!-- ko foreach: modules -->
            <li class="mb-1">
                <div class="row align-items-center p-2 rounded" data-bind="css: { 'bg-light border-start border-primary border-3': isSection }">
                    <!-- Modul Adi -->
                    <div class="col">
                        <div class="d-flex align-items-center">
                            <i data-bind="class: icon" class="me-2 text-primary"></i>
                            <span data-bind="text: name, css: { 'fw-bold': isSection }"></span>
                            <!-- ko if: isSection && children && children.length > 0 -->
                            <span class="badge bg-secondary ms-2" data-bind="text: children.length + ' modul'"></span>
                            <!-- /ko -->
                        </div>
                    </div>
                    <!-- Izin Checkboxlari -->
                    <div class="col-auto text-center" style="width: 70px;">
                        <input type="checkbox" class="form-check-input"
                               data-bind="checked: canView, click: function(data) { $root.toggleModulePermission(data, 'view'); return true; }">
                    </div>
                    <div class="col-auto text-center" style="width: 70px;">
                        <input type="checkbox" class="form-check-input"
                               data-bind="checked: canCreate, enable: canView, click: function(data) { $root.toggleModulePermission(data, 'create'); return true; }">
                    </div>
                    <div class="col-auto text-center" style="width: 70px;">
                        <input type="checkbox" class="form-check-input"
                               data-bind="checked: canEdit, enable: canView, click: function(data) { $root.toggleModulePermission(data, 'edit'); return true; }">
                    </div>
                    <div class="col-auto text-center" style="width: 70px;">
                        <input type="checkbox" class="form-check-input"
                               data-bind="checked: canDelete, enable: canView, click: function(data) { $root.toggleModulePermission(data, 'delete'); return true; }">
                    </div>
                </div>
                <!-- Alt moduller -->
                <!-- ko if: children && children.length > 0 -->
                <div data-bind="template: { name: 'permission-tree-template', data: { modules: children, level: $parent.level + 1 } }"></div>
                <!-- /ko -->
            </li>
            <!-- /ko -->
        </ul>
    </script>
</div>

@section Scripts {
    <script src="~/js/Admin/Roles.js" asp-append-version="true"></script>
}
