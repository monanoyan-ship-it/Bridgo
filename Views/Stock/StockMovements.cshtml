@using Bridgo.Extensions
@{
    ViewData["Title"] = Html.T("StockMovements.Title", "Stok Hareketleri").ToString();
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
}

<div id="stock-movements-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">
                <i class="bi bi-arrow-left-right text-primary me-2"></i>
                @Html.T("StockMovements.Title", "Stok Hareketleri")
            </h4>
            <p class="text-muted mb-0">@Html.T("StockMovements.Subtitle", "Stok giris, cikis, transfer ve duzeltme islemleri.")</p>
        </div>
        <div class="btn-group">
            <button class="btn btn-success" data-bind="click: showAddStock">
                <i class="bi bi-box-arrow-in-down me-1"></i> Stok Girisi
            </button>
            <button class="btn btn-danger" data-bind="click: showRemoveStock">
                <i class="bi bi-box-arrow-up me-1"></i> Stok Cikisi
            </button>
            <button class="btn btn-primary" data-bind="click: showTransfer">
                <i class="bi bi-arrow-left-right me-1"></i> Transfer
            </button>
            <button class="btn btn-warning" data-bind="click: showAdjustment">
                <i class="bi bi-pencil-square me-1"></i> Duzeltme
            </button>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <div class="fs-4 fw-bold text-primary" data-bind="text: stats().totalProducts || 0">0</div>
                    <small class="text-muted">Toplam Urun</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <div class="fs-4 fw-bold text-warning" data-bind="text: stats().lowStockProducts || 0">0</div>
                    <small class="text-muted">Dusuk Stok</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <div class="fs-4 fw-bold text-danger" data-bind="text: stats().outOfStockProducts || 0">0</div>
                    <small class="text-muted">Stok Yok</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <div class="fs-4 fw-bold text-info" data-bind="text: stats().totalWarehouses || 0">0</div>
                    <small class="text-muted">Depo</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <div class="fs-4 fw-bold text-secondary" data-bind="text: stats().todayMovements || 0">0</div>
                    <small class="text-muted">Bugunki Hareket</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <div class="fs-4 fw-bold text-success" data-bind="text: formatCurrency(stats().totalStockValue || 0)">0</div>
                    <small class="text-muted">Stok Degeri</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Low Stock Alerts -->
    <div class="card border-warning mb-4" data-bind="visible: lowStockAlerts().length > 0">
        <div class="card-header bg-warning-subtle d-flex justify-content-between align-items-center">
            <span><i class="bi bi-exclamation-triangle me-2"></i>Dusuk Stok Alarmlari</span>
            <span class="badge bg-warning text-dark" data-bind="text: lowStockAlerts().length"></span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Urun</th>
                            <th>Depo</th>
                            <th class="text-end">Mevcut</th>
                            <th class="text-end">Minimum</th>
                            <th class="text-end">Eksik</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: lowStockAlerts">
                        <tr>
                            <td>
                                <span data-bind="text: productName"></span>
                                <small class="text-muted" data-bind="visible: productSKU"> (<span data-bind="text: productSKU"></span>)</small>
                            </td>
                            <td data-bind="text: warehouseName"></td>
                            <td class="text-end text-danger fw-bold" data-bind="text: currentQuantity"></td>
                            <td class="text-end" data-bind="text: minStockLevel"></td>
                            <td class="text-end text-warning fw-bold" data-bind="text: deficit"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body py-2">
            <div class="row g-2 align-items-center">
                <div class="col-md-3">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Urun adi veya SKU..."
                               data-bind="value: filter.search, valueUpdate: 'afterkeydown'" />
                    </div>
                </div>
                <div class="col-md-2">
                    <select class="form-select form-select-sm" data-bind="value: filter.warehouseId, options: warehouses, optionsText: 'name', optionsValue: 'id', optionsCaption: 'Tum Depolar'"></select>
                </div>
                <div class="col-md-2">
                    <select class="form-select form-select-sm" data-bind="value: filter.movementType">
                        <option value="">Tum Tipler</option>
                        <option value="1">Giris</option>
                        <option value="2">Cikis</option>
                        <option value="3">Transfer</option>
                        <option value="4">Duzeltme</option>
                        <option value="5">Rezerve</option>
                        <option value="6">Rezerve Iptal</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <input type="date" class="form-control form-control-sm" data-bind="value: filter.fromDate" />
                </div>
                <div class="col-md-2">
                    <input type="date" class="form-control form-control-sm" data-bind="value: filter.toDate" />
                </div>
                <div class="col-md-1 text-end">
                    <button class="btn btn-sm btn-outline-secondary" data-bind="click: resetFilters">
                        <i class="bi bi-x-circle"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">@Html.T("Common.Loading", "Yukleniyor...")</p>
    </div>

    <!-- Movements Table -->
    <div class="card" data-bind="visible: !isLoading()">
        <div class="card-body p-0">
            <div data-bind="visible: movements().length === 0" class="text-center py-5">
                <i class="bi bi-inbox display-1 text-muted"></i>
                <h5 class="mt-3">Stok hareketi bulunamadi</h5>
            </div>

            <div class="table-responsive" data-bind="visible: movements().length > 0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tarih</th>
                            <th>Urun</th>
                            <th>Depo</th>
                            <th class="text-center">Tip</th>
                            <th class="text-end">Miktar</th>
                            <th class="text-end">Onceki</th>
                            <th class="text-end">Sonraki</th>
                            <th>Referans</th>
                            <th>Not</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: movements">
                        <tr>
                            <td>
                                <span data-bind="text: formatDateTime(movementDate)"></span>
                            </td>
                            <td>
                                <span data-bind="text: productName"></span>
                                <small class="text-muted d-block" data-bind="visible: productSKU, text: productSKU"></small>
                            </td>
                            <td>
                                <span data-bind="text: warehouseName"></span>
                                <small class="text-muted d-block" data-bind="visible: targetWarehouseName">
                                    <i class="bi bi-arrow-right"></i> <span data-bind="text: targetWarehouseName"></span>
                                </small>
                            </td>
                            <td class="text-center">
                                <span class="badge" data-bind="text: movementTypeName, css: getMovementTypeBadge(movementType)"></span>
                            </td>
                            <td class="text-end">
                                <span data-bind="text: quantity, css: { 'text-success': quantity > 0, 'text-danger': quantity < 0 }"></span>
                            </td>
                            <td class="text-end text-muted" data-bind="text: previousQuantity"></td>
                            <td class="text-end fw-bold" data-bind="text: newQuantity"></td>
                            <td>
                                <span data-bind="visible: referenceNumber">
                                    <small class="text-muted" data-bind="text: referenceTypeName"></small>:
                                    <span data-bind="text: referenceNumber"></span>
                                </span>
                            </td>
                            <td>
                                <span class="text-muted small" data-bind="text: notes"></span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        <div class="card-footer" data-bind="visible: totalPages() > 1">
            <nav>
                <ul class="pagination pagination-sm justify-content-center mb-0">
                    <li class="page-item" data-bind="css: { disabled: currentPage() === 1 }">
                        <a class="page-link" href="#" data-bind="click: prevPage"><i class="bi bi-chevron-left"></i></a>
                    </li>
                    <!-- ko foreach: pageNumbers -->
                    <li class="page-item" data-bind="css: { active: $data === $parent.currentPage() }">
                        <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                    </li>
                    <!-- /ko -->
                    <li class="page-item" data-bind="css: { disabled: currentPage() === totalPages() }">
                        <a class="page-link" href="#" data-bind="click: nextPage"><i class="bi bi-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>

    <!-- Stock In Modal -->
<div class="modal fade" id="stockInModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="bi bi-box-arrow-in-down me-2"></i>Stok Girisi</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Urun <span class="text-danger">*</span></label>
                    <div class="position-relative">
                        <input type="text" class="form-control" id="stockInProductSearch"
                               placeholder="Urun adi veya SKU yazin..."
                               data-bind="value: form.productSearch, valueUpdate: 'afterkeydown', event: { focus: showProductDropdown, blur: hideProductDropdownDelayed }" autocomplete="off" />
                        <input type="hidden" data-bind="value: form.productId" />
                        <!-- ko if: form.selectedProduct() -->
                        <div class="mt-1">
                            <span class="badge bg-primary">
                                <span data-bind="text: form.selectedProduct().name"></span>
                                <!-- ko if: form.selectedProduct().sku -->
                                <small data-bind="text: ' (' + form.selectedProduct().sku + ')'"></small>
                                <!-- /ko -->
                                <i class="bi bi-x ms-1" style="cursor: pointer;" data-bind="click: clearSelectedProduct"></i>
                            </span>
                        </div>
                        <!-- /ko -->
                        <div class="dropdown-menu w-100" id="stockInProductDropdown" data-bind="visible: showProductResults() && productSearchResults().length > 0, foreach: productSearchResults">
                            <a class="dropdown-item" href="#" data-bind="click: $parent.selectProduct">
                                <span data-bind="text: name"></span>
                                <!-- ko if: sku -->
                                <small class="text-muted" data-bind="text: ' (' + sku + ')'"></small>
                                <!-- /ko -->
                            </a>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Depo <span class="text-danger">*</span></label>
                    <select class="form-select" data-bind="value: form.warehouseId, options: warehouses, optionsText: 'name', optionsValue: 'id', optionsCaption: 'Depo Secin...'"></select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Miktar <span class="text-danger">*</span></label>
                    <input type="number" class="form-control" min="0.01" step="0.01" data-bind="value: form.quantity" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Not</label>
                    <textarea class="form-control" rows="2" data-bind="value: form.notes" placeholder="Stok girisi aciklamasi..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                <button type="button" class="btn btn-success" data-bind="click: saveStockIn, enable: canSave() && !isProcessing()">
                    <span data-bind="visible: isProcessing()" class="spinner-border spinner-border-sm me-1"></span>
                    Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Stock Out Modal -->
<div class="modal fade" id="stockOutModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-box-arrow-up me-2"></i>Stok Cikisi</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Urun <span class="text-danger">*</span></label>
                    <div class="position-relative">
                        <input type="text" class="form-control"
                               placeholder="Urun adi veya SKU yazin..."
                               data-bind="value: form.productSearch, valueUpdate: 'afterkeydown', event: { focus: showProductDropdown, blur: hideProductDropdownDelayed }" autocomplete="off" />
                        <!-- ko if: form.selectedProduct() -->
                        <div class="mt-1">
                            <span class="badge bg-primary">
                                <span data-bind="text: form.selectedProduct().name"></span>
                                <!-- ko if: form.selectedProduct().sku -->
                                <small data-bind="text: ' (' + form.selectedProduct().sku + ')'"></small>
                                <!-- /ko -->
                                <i class="bi bi-x ms-1" style="cursor: pointer;" data-bind="click: clearSelectedProduct"></i>
                            </span>
                        </div>
                        <!-- /ko -->
                        <div class="dropdown-menu w-100 show" data-bind="visible: showProductResults() && productSearchResults().length > 0, foreach: productSearchResults" style="position: absolute; top: 100%; left: 0;">
                            <a class="dropdown-item" href="#" data-bind="click: $parent.selectProduct">
                                <span data-bind="text: name"></span>
                                <!-- ko if: sku -->
                                <small class="text-muted" data-bind="text: ' (' + sku + ')'"></small>
                                <!-- /ko -->
                            </a>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Depo <span class="text-danger">*</span></label>
                    <select class="form-select" data-bind="value: form.warehouseId, options: warehouses, optionsText: 'name', optionsValue: 'id', optionsCaption: 'Depo Secin...'"></select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Miktar <span class="text-danger">*</span></label>
                    <input type="number" class="form-control" min="0.01" step="0.01" data-bind="value: form.quantity" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Not</label>
                    <textarea class="form-control" rows="2" data-bind="value: form.notes" placeholder="Stok cikisi aciklamasi..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                <button type="button" class="btn btn-danger" data-bind="click: saveStockOut, enable: canSave() && !isProcessing()">
                    <span data-bind="visible: isProcessing()" class="spinner-border spinner-border-sm me-1"></span>
                    Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Transfer Modal -->
<div class="modal fade" id="transferModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-arrow-left-right me-2"></i>Stok Transferi</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Urun <span class="text-danger">*</span></label>
                    <div class="position-relative">
                        <input type="text" class="form-control"
                               placeholder="Urun adi veya SKU yazin..."
                               data-bind="value: transferForm.productSearch, valueUpdate: 'afterkeydown', event: { focus: showTransferProductDropdown, blur: hideTransferProductDropdownDelayed }" autocomplete="off" />
                        <!-- ko if: transferForm.selectedProduct() -->
                        <div class="mt-1">
                            <span class="badge bg-primary">
                                <span data-bind="text: transferForm.selectedProduct().name"></span>
                                <!-- ko if: transferForm.selectedProduct().sku -->
                                <small data-bind="text: ' (' + transferForm.selectedProduct().sku + ')'"></small>
                                <!-- /ko -->
                                <i class="bi bi-x ms-1" style="cursor: pointer;" data-bind="click: clearTransferSelectedProduct"></i>
                            </span>
                        </div>
                        <!-- /ko -->
                        <div class="dropdown-menu w-100 show" data-bind="visible: showTransferProductResults() && transferProductSearchResults().length > 0, foreach: transferProductSearchResults" style="position: absolute; top: 100%; left: 0;">
                            <a class="dropdown-item" href="#" data-bind="click: $parent.selectTransferProduct">
                                <span data-bind="text: name"></span>
                                <!-- ko if: sku -->
                                <small class="text-muted" data-bind="text: ' (' + sku + ')'"></small>
                                <!-- /ko -->
                            </a>
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Kaynak Depo <span class="text-danger">*</span></label>
                        <select class="form-select" data-bind="value: transferForm.sourceWarehouseId, options: warehouses, optionsText: 'name', optionsValue: 'id', optionsCaption: 'Secin...'"></select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Hedef Depo <span class="text-danger">*</span></label>
                        <select class="form-select" data-bind="value: transferForm.targetWarehouseId, options: warehouses, optionsText: 'name', optionsValue: 'id', optionsCaption: 'Secin...'"></select>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Miktar <span class="text-danger">*</span></label>
                    <input type="number" class="form-control" min="0.01" step="0.01" data-bind="value: transferForm.quantity" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Not</label>
                    <textarea class="form-control" rows="2" data-bind="value: transferForm.notes" placeholder="Transfer aciklamasi..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                <button type="button" class="btn btn-primary" data-bind="click: saveTransfer, enable: canSaveTransfer() && !isProcessing()">
                    <span data-bind="visible: isProcessing()" class="spinner-border spinner-border-sm me-1"></span>
                    Transfer Et
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Adjustment Modal -->
<div class="modal fade" id="adjustmentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Stok Duzeltme</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Urun <span class="text-danger">*</span></label>
                    <div class="position-relative">
                        <input type="text" class="form-control"
                               placeholder="Urun adi veya SKU yazin..."
                               data-bind="value: adjustForm.productSearch, valueUpdate: 'afterkeydown', event: { focus: showAdjustProductDropdown, blur: hideAdjustProductDropdownDelayed }" autocomplete="off" />
                        <!-- ko if: adjustForm.selectedProduct() -->
                        <div class="mt-1">
                            <span class="badge bg-primary">
                                <span data-bind="text: adjustForm.selectedProduct().name"></span>
                                <!-- ko if: adjustForm.selectedProduct().sku -->
                                <small data-bind="text: ' (' + adjustForm.selectedProduct().sku + ')'"></small>
                                <!-- /ko -->
                                <i class="bi bi-x ms-1" style="cursor: pointer;" data-bind="click: clearAdjustSelectedProduct"></i>
                            </span>
                        </div>
                        <!-- /ko -->
                        <div class="dropdown-menu w-100 show" data-bind="visible: showAdjustProductResults() && adjustProductSearchResults().length > 0, foreach: adjustProductSearchResults" style="position: absolute; top: 100%; left: 0;">
                            <a class="dropdown-item" href="#" data-bind="click: $parent.selectAdjustProduct">
                                <span data-bind="text: name"></span>
                                <!-- ko if: sku -->
                                <small class="text-muted" data-bind="text: ' (' + sku + ')'"></small>
                                <!-- /ko -->
                            </a>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Depo <span class="text-danger">*</span></label>
                    <select class="form-select" data-bind="value: adjustForm.warehouseId, options: warehouses, optionsText: 'name', optionsValue: 'id', optionsCaption: 'Depo Secin...'"></select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Yeni Miktar <span class="text-danger">*</span></label>
                    <input type="number" class="form-control" min="0" step="0.01" data-bind="value: adjustForm.newQuantity" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Duzeltme Nedeni <span class="text-danger">*</span></label>
                    <textarea class="form-control" rows="2" data-bind="value: adjustForm.reason" placeholder="Sayim farki, kayip, vb..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                <button type="button" class="btn btn-warning" data-bind="click: saveAdjustment, enable: canSaveAdjustment() && !isProcessing()">
                    <span data-bind="visible: isProcessing()" class="spinner-border spinner-border-sm me-1"></span>
                    Duzelt
                </button>
            </div>
        </div>
    </div>
</div>

</div> <!-- End of #stock-movements-app -->

@section Scripts {
<script src="~/js/Dashboard/StockMovements.js"></script>
}
