                    <select class="form-select" data-bind="visible: addresses().length > 0, value: selectedAddressId, options: addresses, optionsText: function(a) { return a.title + ' - ' + (a.city || '') + ', ' + (a.countryName || ''); }, optionsValue: 'id', optionsCaption: '-- Adres Secin --'"></select>
