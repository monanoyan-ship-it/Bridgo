                        <div class="col-md-4">
                            <label class="form-label">Max Butce</label>
                            <input type="number" class="form-control" data-bind="value: demandForm.budgetMax" min="0" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Teslim Suresi (gun)</label>
                            <input type="number" class="form-control" data-bind="value: demandForm.desiredLeadTimeDays" min="1" />
                        </div>
