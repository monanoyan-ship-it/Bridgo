@{
    ViewData["Title"] = Html.T("Admin.Users.Title", "Kullanici Yonetimi").ToString();
    Layout = "_AdminLayout";
}

<div id="users-app">
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h6 class="mb-0">@Html.T("Admin.Users.AllUsers", "Tum Kullanicilar")</h6>
        <div class="d-flex gap-2 align-items-center">
            <select class="form-select form-select-sm w-auto" data-bind="value: roleFilter">
                <option value="">@Html.T("Admin.Users.AllRoles", "Tum Roller")</option>
                <option value="Admin">Admin</option>
            </select>
            <input type="search" class="form-control form-control-sm w-auto"
                   placeholder="@Html.T("Common.Search", "Ara...")" data-bind="value: searchQuery, valueUpdate: 'afterkeydown'">
            <button class="btn btn-primary btn-sm" data-bind="click: showAddModal">
                <i class="bi bi-plus-lg me-1"></i>@Html.T("Admin.Users.Add", "Kullanici Ekle")
            </button>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Html.T("Admin.Table.FullName", "Ad Soyad")</th>
                        <th>@Html.T("Admin.Table.Email", "E-posta")</th>
                        <th>@Html.T("Admin.Table.Company", "Firma")</th>
                        <th>@Html.T("Admin.Table.VendorRole", "Firma Rolu")</th>
                        <th>@Html.T("Admin.Table.SystemRole", "Sistem Rolu")</th>
                        <th>@Html.T("Admin.Table.Status", "Durum")</th>
                        <th>@Html.T("Admin.Table.LastLogin", "Son Giris")</th>
                        <th>@Html.T("Admin.Table.Actions", "Islemler")</th>
                    </tr>
                </thead>
                <tbody data-bind="foreach: users">
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="avatar-sm bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                    <span class="text-primary small" data-bind="text: initials"></span>
                                </div>
                                <span data-bind="text: fullName"></span>
                            </div>
                        </td>
                        <td data-bind="text: email"></td>
                        <td data-bind="text: companyName"></td>
                        <td>
                            <span class="badge bg-secondary" data-bind="text: vendorRole"></span>
                        </td>
                        <td>
                            <!-- ko foreach: systemRoles -->
                            <span class="badge bg-info me-1" data-bind="text: $data"></span>
                            <!-- /ko -->
                        </td>
                        <td>
                            <span class="badge" data-bind="text: isActive ? '@Html.T("Common.Active", "Aktif")' : '@Html.T("Common.Inactive", "Pasif")',
                                  css: isActive ? 'bg-success' : 'bg-secondary'"></span>
                        </td>
                        <td data-bind="text: lastLoginAt || '-'"></td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-primary" title="@Html.T("Common.View", "Goruntule")" data-bind="click: $parent.viewUser">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button class="btn btn-outline-warning" title="@Html.T("Admin.Users.Deactivate", "Pasif Yap")" data-bind="click: $parent.toggleUserStatus, visible: isActive">
                                    <i class="bi bi-person-slash"></i>
                                </button>
                                <button class="btn btn-outline-success" title="@Html.T("Admin.Users.Activate", "Aktif Yap")" data-bind="click: $parent.toggleUserStatus, visible: !isActive">
                                    <i class="bi bi-person-check"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Loading -->
        <div class="text-center py-4" data-bind="visible: isLoading">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@Html.T("Common.Loading", "Yukleniyor...")</span>
            </div>
        </div>

        <!-- Empty State -->
        <div class="text-center py-5" data-bind="visible: !isLoading() && users().length === 0">
            <i class="bi bi-people text-muted fs-1"></i>
            <p class="text-muted mt-2">@Html.T("Admin.Users.Empty", "Henuz kullanici kaydi bulunmuyor")</p>
        </div>
    </div>
</div>

<!-- Add User Modal -->
<div class="modal fade" id="userModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Html.T("Admin.Users.Add", "Kullanici Ekle")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form data-bind="submit: saveUser">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Admin.Table.FirstName", "Ad") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: formData.firstName" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Admin.Table.LastName", "Soyad") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: formData.lastName" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Admin.Table.Email", "E-posta") <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" data-bind="value: formData.email" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Admin.Table.Phone", "Telefon")</label>
                        <input type="tel" class="form-control" data-bind="value: formData.phone">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Admin.Table.Password", "Sifre") <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" data-bind="value: formData.password" required minlength="6">
                        <small class="text-muted">@Html.T("Admin.Users.PasswordHint", "En az 6 karakter, buyuk/kucuk harf ve rakam icermeli")</small>
                    </div>
                    <hr>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Admin.Table.Company", "Firma")</label>
                        <select class="form-select" data-bind="value: formData.vendorId, options: vendors, optionsText: 'companyName', optionsValue: 'id', optionsCaption: '@Html.T("Admin.Users.NoCompany", "Firma Yok (Sistem Kullanicisi)")'">
                        </select>
                    </div>
                    <div class="mb-3" data-bind="visible: formData.vendorId()">
                        <label class="form-label">@Html.T("Admin.Table.VendorRole", "Firma Rolu")</label>
                        <select class="form-select" data-bind="value: formData.vendorRole">
                            <option value="Employee">@Html.T("VendorRole.Employee", "Calisan")</option>
                            <option value="Manager">@Html.T("VendorRole.Manager", "Yonetici")</option>
                            <option value="Admin">@Html.T("VendorRole.Admin", "Admin")</option>
                            <option value="Owner">@Html.T("VendorRole.Owner", "Sahip")</option>
                        </select>
                    </div>
                    <div class="form-check mb-3" data-bind="visible: !formData.vendorId()">
                        <input type="checkbox" class="form-check-input" id="isSystemAdmin" data-bind="checked: formData.isSystemAdmin">
                        <label class="form-check-label" for="isSystemAdmin">
                            <i class="bi bi-shield-check me-1"></i>@Html.T("Admin.Users.IsSystemAdmin", "Sistem Yoneticisi")
                        </label>
                    </div>
                    <div class="mb-3" data-bind="visible: formData.isSystemAdmin()">
                        <label class="form-label">@Html.T("Admin.Table.SystemRole", "Sistem Rolu")</label>
                        <select class="form-select" data-bind="value: formData.systemRole">
                            <option value="">@Html.T("Common.Select", "Secin...")</option>
                            <option value="Admin">Admin</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Cancel", "Iptal")</button>
                <button type="button" class="btn btn-primary" data-bind="click: saveUser, enable: !isSaving()">
                    <span data-bind="visible: isSaving()" class="spinner-border spinner-border-sm me-1"></span>
                    @Html.T("Common.Save", "Kaydet")
                </button>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
<script src="~/js/Admin/Users.js" asp-append-version="true"></script>
}
