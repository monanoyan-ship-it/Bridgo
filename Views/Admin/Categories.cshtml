@{
    ViewData["Title"] = Html.T("Admin.Categories.Title", "Urun Kategorileri").ToString();
    Layout = "_AdminLayout";
}

<div id="categories-app">
<!-- Tabs -->
<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="categories-tab" data-bs-toggle="tab" data-bs-target="#categories-pane" type="button" role="tab">
            <i class="bi bi-folder2-open me-1"></i> @Html.T("Admin.Categories.AllCategories", "Kategoriler")
            <span class="badge bg-primary ms-1" data-bind="text: totalCount()"></span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending-pane" type="button" role="tab"
                data-bind="click: loadPendingCategories">
            <i class="bi bi-hourglass-split me-1"></i> @Html.T("Admin.Categories.PendingApproval", "Onay Bekleyenler")
            <span class="badge bg-warning text-dark ms-1" data-bind="text: pendingCategories().length, visible: pendingCategories().length > 0"></span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="trash-tab" data-bs-toggle="tab" data-bs-target="#trash-pane" type="button" role="tab"
                data-bind="click: loadDeletedCategories">
            <i class="bi bi-trash3 me-1"></i> @Html.T("Admin.Categories.Trash", "Cop Kutusu")
            <span class="badge bg-danger ms-1" data-bind="text: deletedCategories().length, visible: deletedCategories().length > 0"></span>
        </button>
    </li>
</ul>

<div class="tab-content">
    <!-- Categories Tab -->
    <div class="tab-pane fade show active" id="categories-pane" role="tabpanel">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0">
                        <i class="bi bi-folder2-open me-2"></i>
                        @Html.T("Admin.Categories.AllCategories", "Tum Kategoriler")
                        <span class="badge bg-primary ms-2" data-bind="text: totalCount() + ' kategori'"></span>
                    </h6>
                    <div>
                        <button class="btn btn-outline-success btn-sm me-2" data-bind="click: seedCategories, enable: !isLoading() && categories().length === 0" title="Ornek kategorileri yukle">
                            <i class="bi bi-database-add me-1"></i> @Html.T("Admin.Categories.Seed", "Ornek Yukle")
                        </button>
                        <button class="btn btn-primary btn-sm" data-bind="click: showAddModal">
                            <i class="bi bi-plus-lg me-1"></i> @Html.T("Admin.Categories.AddNew", "Yeni Kategori")
                        </button>
                    </div>
                </div>

                <!-- Search & Controls -->
                <div class="row g-2 align-items-center">
                    <div class="col-md-6">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control" placeholder="Kategori ara..."
                                   data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
                            <button class="btn btn-outline-secondary" data-bind="click: clearSearch, visible: searchQuery()">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-secondary" data-bind="click: expandAll" title="Tumu Ac">
                                <i class="bi bi-arrows-expand"></i> Tumu Ac
                            </button>
                            <button class="btn btn-outline-secondary" data-bind="click: collapseAll" title="Tumu Kapat">
                                <i class="bi bi-arrows-collapse"></i> Tumu Kapat
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <!-- Category Tree -->
                <div class="p-3" data-bind="visible: !isLoading() && filteredCategories().length > 0">
                    <div class="category-tree" data-bind="template: { name: 'category-template', foreach: filteredCategories }"></div>
                </div>

                <!-- No Search Results -->
                <div class="text-center py-4" data-bind="visible: !isLoading() && searchQuery() && filteredCategories().length === 0">
                    <i class="bi bi-search text-muted fs-1"></i>
                    <p class="text-muted mt-2">"<span data-bind="text: searchQuery"></span>" icin sonuc bulunamadi</p>
                    <button class="btn btn-outline-primary btn-sm" data-bind="click: clearSearch">
                        <i class="bi bi-x-circle"></i> Aramayi Temizle
                    </button>
                </div>

                <!-- Loading -->
                <div class="text-center py-4" data-bind="visible: isLoading">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">@Html.T("Common.Loading", "Yukleniyor...")</span>
                    </div>
                </div>

                <!-- Empty State -->
                <div class="text-center py-5" data-bind="visible: !isLoading() && !searchQuery() && categories().length === 0">
                    <i class="bi bi-folder-x text-muted fs-1"></i>
                    <p class="text-muted mt-2">@Html.T("Admin.Categories.Empty", "Henuz kategori tanimlanmamis")</p>
                    <button class="btn btn-success mt-2" data-bind="click: seedCategories, enable: !isLoading()">
                        <i class="bi bi-database-add me-1"></i> @Html.T("Admin.Categories.Seed", "Ornek Kategorileri Yukle")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Pending Approval Tab -->
    <div class="tab-pane fade" id="pending-pane" role="tabpanel">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h6 class="mb-0">
                    <i class="bi bi-hourglass-split me-2"></i>
                    @Html.T("Admin.Categories.PendingApproval", "Onay Bekleyen Silme Islemleri")
                    <span class="badge bg-warning text-dark ms-2" data-bind="text: pendingCategories().length + ' kategori'"></span>
                </h6>
            </div>

            <div class="card-body p-0">
                <!-- Pending Categories List -->
                <div class="table-responsive" data-bind="visible: !isLoadingPending() && pendingCategories().length > 0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Html.T("Admin.Categories.Name", "Kategori")</th>
                                <th>@Html.T("Admin.Categories.DeletedBy", "Silen")</th>
                                <th class="text-center">@Html.T("Admin.Categories.DeletedAt", "Silinme Tarihi")</th>
                                <th class="text-center">@Html.T("Admin.Categories.MigratedProducts", "Tasinan Urun")</th>
                                <th class="text-end">@Html.T("Common.Actions", "Islemler")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: pendingCategories">
                            <tr>
                                <td>
                                    <span class="me-2" data-bind="visible: icon">
                                        <i data-bind="attr: { 'class': 'bi ' + icon }"></i>
                                    </span>
                                    <span data-bind="visible: !icon">
                                        <i class="bi bi-folder text-muted"></i>
                                    </span>
                                    <span data-bind="text: displayName || name" class="ms-1"></span>
                                </td>
                                <td>
                                    <span data-bind="text: deletedBy || '-'"></span>
                                </td>
                                <td class="text-center">
                                    <small class="text-muted" data-bind="text: deletedAt ? new Date(deletedAt).toLocaleString('tr-TR') : '-'"></small>
                                </td>
                                <td class="text-center">
                                    <!-- ko if: migratedProductCount -->
                                    <span class="badge bg-info" data-bind="text: migratedProductCount + ' urun'"></span>
                                    <small class="text-muted d-block" data-bind="text: '→ ' + (migratedToCategoryName || 'Bilinmiyor')"></small>
                                    <!-- /ko -->
                                    <!-- ko ifnot: migratedProductCount -->
                                    <span class="text-muted">-</span>
                                    <!-- /ko -->
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-info" title="Detay" data-bind="click: function() { $root.showDeletionDetails($data); }">
                                            <i class="bi bi-info-circle"></i>
                                        </button>
                                        <button class="btn btn-outline-success" title="Onayla" data-bind="click: function() { $root.showApproveModal($data); }">
                                            <i class="bi bi-check-lg"></i> Onayla
                                        </button>
                                        <button class="btn btn-outline-danger" title="Reddet" data-bind="click: function() { $root.showRejectModal($data); }">
                                            <i class="bi bi-x-lg"></i> Reddet
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Loading Pending -->
                <div class="text-center py-4" data-bind="visible: isLoadingPending">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">@Html.T("Common.Loading", "Yukleniyor...")</span>
                    </div>
                </div>

                <!-- Empty Pending State -->
                <div class="text-center py-5" data-bind="visible: !isLoadingPending() && pendingCategories().length === 0">
                    <i class="bi bi-check-circle text-success fs-1"></i>
                    <p class="text-muted mt-2">@Html.T("Admin.Categories.NoPending", "Onay bekleyen silme islemi yok")</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Trash Tab -->
    <div class="tab-pane fade" id="trash-pane" role="tabpanel">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">
                        <i class="bi bi-trash3 me-2"></i>
                        @Html.T("Admin.Categories.Trash", "Cop Kutusu") (Onaylanmis Silmeler)
                        <span class="badge bg-danger ms-2" data-bind="text: deletedCategories().length + ' kategori'"></span>
                    </h6>
                    <button class="btn btn-outline-danger btn-sm" data-bind="click: emptyTrash, visible: deletedCategories().length > 0, enable: !isLoadingTrash()">
                        <i class="bi bi-trash3 me-1"></i> @Html.T("Admin.Categories.EmptyTrash", "Cop Kutusunu Bosalt")
                    </button>
                </div>
            </div>

            <div class="card-body p-0">
                <!-- Deleted Categories List -->
                <div class="table-responsive" data-bind="visible: !isLoadingTrash() && deletedCategories().length > 0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Html.T("Admin.Categories.Name", "Kategori")</th>
                                <th>@Html.T("Admin.Categories.DeletedBy", "Silen")</th>
                                <th>@Html.T("Admin.Categories.ReviewedBy", "Onaylayan")</th>
                                <th class="text-center">@Html.T("Admin.Categories.MigratedProducts", "Tasinan Urun")</th>
                                <th class="text-end">@Html.T("Common.Actions", "Islemler")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: deletedCategories">
                            <tr>
                                <td>
                                    <span class="me-2" data-bind="visible: icon">
                                        <i data-bind="attr: { 'class': 'bi ' + icon }"></i>
                                    </span>
                                    <span data-bind="visible: !icon">
                                        <i class="bi bi-folder text-muted"></i>
                                    </span>
                                    <span data-bind="text: displayName || name" class="ms-1"></span>
                                </td>
                                <td>
                                    <span data-bind="text: deletedBy || '-'"></span>
                                    <small class="text-muted d-block" data-bind="text: deletedAt ? new Date(deletedAt).toLocaleString('tr-TR') : ''"></small>
                                </td>
                                <td>
                                    <span data-bind="text: reviewedBy || '-'"></span>
                                    <small class="text-muted d-block" data-bind="text: reviewedAt ? new Date(reviewedAt).toLocaleString('tr-TR') : ''"></small>
                                </td>
                                <td class="text-center">
                                    <!-- ko if: migratedProductCount -->
                                    <span class="badge bg-info" data-bind="text: migratedProductCount + ' urun'"></span>
                                    <small class="text-muted d-block" data-bind="text: '→ ' + (migratedToCategoryName || 'Bilinmiyor')"></small>
                                    <!-- /ko -->
                                    <!-- ko ifnot: migratedProductCount -->
                                    <span class="text-muted">-</span>
                                    <!-- /ko -->
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-info" title="Detay" data-bind="click: function() { $root.showDeletionDetails($data); }">
                                            <i class="bi bi-info-circle"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" title="Kalici Sil" data-bind="click: function() { $root.permanentDeleteCategory($data); }">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Loading Trash -->
                <div class="text-center py-4" data-bind="visible: isLoadingTrash">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">@Html.T("Common.Loading", "Yukleniyor...")</span>
                    </div>
                </div>

                <!-- Empty Trash State -->
                <div class="text-center py-5" data-bind="visible: !isLoadingTrash() && deletedCategories().length === 0">
                    <i class="bi bi-trash3 text-muted fs-1"></i>
                    <p class="text-muted mt-2">@Html.T("Admin.Categories.TrashEmpty", "Cop kutusu bos")</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Category Item Template -->
<script type="text/html" id="category-template">
    <div class="category-item" data-bind="css: { 'search-match': $data._isMatch }">
        <div class="d-flex align-items-center p-2 border rounded mb-1 category-row"
             data-bind="css: { 'bg-light': level === 0, 'border-success': isActive, 'border-secondary border-opacity-25': !isActive, 'bg-warning bg-opacity-10': $data._isMatch }">

            <!-- Expand/Collapse Toggle -->
            <button class="btn btn-sm p-0 me-2 expand-btn" style="width: 24px; height: 24px;"
                    data-bind="visible: children && children.length > 0, click: function(data, event) { $root.toggleExpand(data); event.stopPropagation(); }">
                <i class="bi" data-bind="css: { 'bi-chevron-down': $root.isExpanded($data), 'bi-chevron-right': !$root.isExpanded($data) }"></i>
            </button>
            <span style="width: 24px;" data-bind="visible: !children || children.length === 0"></span>

            <!-- Icon -->
            <span class="me-2 category-icon" data-bind="visible: icon">
                <i data-bind="attr: { 'class': 'bi ' + icon + ' fs-5' }"></i>
            </span>
            <span class="me-2" data-bind="visible: !icon">
                <i class="bi bi-folder text-muted fs-5"></i>
            </span>

            <!-- Name & Info -->
            <div class="flex-grow-1">
                <span class="fw-medium" data-bind="text: displayName || name"></span>
                <small class="text-muted ms-1" data-bind="text: '(' + name + ')', visible: displayName"></small>
                <!-- ko if: children && children.length > 0 -->
                <span class="badge bg-secondary bg-opacity-25 text-dark ms-2" data-bind="text: $root.countDescendants($data) + ' alt kategori'"></span>
                <!-- /ko -->
                <span class="badge bg-info bg-opacity-75 ms-1" data-bind="visible: productCount > 0, text: productCount + ' urun'"></span>
                <!-- ko if: !isActive -->
                <span class="badge bg-secondary ms-1">Pasif</span>
                <!-- /ko -->
            </div>

            <!-- Level Badge -->
            <span class="badge bg-primary bg-opacity-75 me-2" data-bind="visible: level === 0">Ana</span>
            <span class="badge bg-primary bg-opacity-50 me-2" data-bind="visible: level === 1">L2</span>
            <span class="badge bg-primary bg-opacity-25 text-dark me-2" data-bind="visible: level >= 2, text: 'L' + (level + 1)"></span>

            <!-- Actions -->
            <div class="btn-group btn-group-sm">
                <button class="btn btn-outline-primary" title="Alt Kategori Ekle" data-bind="click: function() { $root.showAddChildModal($data); }">
                    <i class="bi bi-plus-circle"></i>
                </button>
                <button class="btn btn-outline-secondary" title="Duzenle" data-bind="click: function() { $root.showEditModal($data); }">
                    <i class="bi bi-pencil"></i>
                </button>
                <button class="btn btn-outline-danger" title="Sil"
                        data-bind="click: function() { $root.deleteCategory($data); },
                                   enable: !children || children.length === 0,
                                   css: { 'disabled': children && children.length > 0 }">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        </div>

        <!-- Children (Recursive) -->
        <!-- ko if: $root.isExpanded($data) && children && children.length > 0 -->
        <div class="children-container ps-4" data-bind="template: { name: 'category-template', foreach: children }"></div>
        <!-- /ko -->
    </div>
</script>

<!-- Add/Edit Modal -->
<div class="modal fade" id="categoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" data-bind="text: isEditing() ? '@Html.T("Admin.Categories.Edit", "Kategori Duzenle")' : '@Html.T("Admin.Categories.AddNew", "Yeni Kategori")'"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form data-bind="submit: saveCategory">
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Admin.Categories.Name", "Teknik Ad") <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" data-bind="value: formData.name" placeholder="electronics" required>
                        <small class="text-muted">Sistem adi (benzersiz, ingilizce, kucuk harf)</small>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Admin.Categories.DisplayName", "Gosterim Adi")</label>
                            <input type="text" class="form-control" data-bind="value: formData.displayName" placeholder="Elektronik">
                            <small class="text-muted">Kullaniciya gosterilecek ad</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Admin.Categories.ResourceKey", "Ceviri Anahtari")</label>
                            <input type="text" class="form-control" data-bind="value: formData.nameResourceKey" placeholder="Category.Electronics">
                            <small class="text-muted">Localization key (opsiyonel)</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Html.T("Admin.Categories.Parent", "Ust Kategori")</label>
                        <select class="form-select" data-bind="options: flatCategories, optionsText: function(item) { return '\u00A0'.repeat(item.level * 4) + (item.displayName || item.name); }, optionsValue: 'id', value: formData.parentId, optionsCaption: '-- Ana Kategori --'"></select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Html.T("Admin.Categories.Description", "Aciklama")</label>
                        <textarea class="form-control" rows="2" data-bind="value: formData.description" placeholder="Kategori aciklamasi"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Admin.Categories.Icon", "Ikon")</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i data-bind="attr: { 'class': 'bi ' + (formData.icon() || 'bi-folder') }"></i>
                                </span>
                                <input type="text" class="form-control" data-bind="value: formData.icon" placeholder="bi-box">
                            </div>
                            <small class="text-muted">Bootstrap Icons: bi-box, bi-laptop, bi-cart, vb.</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Admin.Table.Order", "Siralama")</label>
                            <input type="number" class="form-control" data-bind="value: formData.displayOrder" min="0">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Html.T("Admin.Categories.Slug", "URL Slug")</label>
                        <input type="text" class="form-control" data-bind="value: formData.slug" placeholder="kategori-adi">
                        <small class="text-muted">Bos birakilirsa otomatik olusturulur</small>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="isActive" data-bind="checked: formData.isActive">
                                <label class="form-check-label" for="isActive">@Html.T("Common.Active", "Aktif")</label>
                            </div>
                        </div>
                    </div>

                    <!-- SEO Fields (Collapsed by default) -->
                    <div class="border rounded p-3 bg-light">
                        <a class="text-decoration-none" data-bs-toggle="collapse" href="#seoFields">
                            <i class="bi bi-search me-1"></i> SEO Ayarlari
                            <i class="bi bi-chevron-down float-end"></i>
                        </a>
                        <div class="collapse mt-3" id="seoFields">
                            <div class="mb-3">
                                <label class="form-label">Meta Title</label>
                                <input type="text" class="form-control" data-bind="value: formData.metaTitle" placeholder="SEO baslik">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Meta Description</label>
                                <textarea class="form-control" rows="2" data-bind="value: formData.metaDescription" placeholder="SEO aciklama"></textarea>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Cancel", "Iptal")</button>
                <button type="button" class="btn btn-primary" data-bind="click: saveCategory, enable: !isSaving()">
                    <span data-bind="visible: isSaving()" class="spinner-border spinner-border-sm me-1"></span>
                    <span data-bind="text: isEditing() ? '@Html.T("Common.Update", "Guncelle")' : '@Html.T("Common.Save", "Kaydet")'"></span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Product Migration Modal -->
<div class="modal fade" id="productMigrationModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning bg-opacity-10">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle text-warning me-2"></i>
                    @Html.T("Admin.Categories.ProductMigration", "Urun Tasima")
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning mb-3">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong data-bind="text: deletingCategory() ? deletingCategory().name : ''"></strong> kategorisinde
                    <strong data-bind="text: productMigrationCount"></strong> urun bulunuyor.
                    Silmeden once bu urunleri baska bir kategoriye tasimaniz gerekiyor.
                </div>

                <div class="mb-3">
                    <label class="form-label">@Html.T("Admin.Categories.TargetCategory", "Hedef Kategori") <span class="text-danger">*</span></label>
                    <select class="form-select" data-bind="options: availableTargetCategories, optionsText: function(item) { return '\u00A0'.repeat(item.level * 4) + item.name; }, optionsValue: 'id', value: targetCategoryId, optionsCaption: '-- Kategori Secin --'"></select>
                    <small class="text-muted">Urunler sectiginiz kategoriye tasinacak</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Cancel", "Iptal")</button>
                <button type="button" class="btn btn-danger" data-bind="click: confirmDeleteWithMigration, enable: targetCategoryId()">
                    <i class="bi bi-arrow-right-circle me-1"></i>
                    @Html.T("Admin.Categories.MoveAndDelete", "Tasi ve Sil")
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Deletion Details Modal -->
<div class="modal fade" id="deletionDetailsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info bg-opacity-10">
                <h5 class="modal-title">
                    <i class="bi bi-info-circle text-info me-2"></i>
                    @Html.T("Admin.Categories.DeletionDetails", "Silme Detaylari")
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" data-bind="with: selectedDeletion">
                <table class="table table-borderless mb-0">
                    <tr>
                        <th class="text-muted" style="width: 40%;">Kategori:</th>
                        <td><strong data-bind="text: displayName || name"></strong></td>
                    </tr>
                    <tr>
                        <th class="text-muted">Silen:</th>
                        <td data-bind="text: deletedBy || '-'"></td>
                    </tr>
                    <tr>
                        <th class="text-muted">Silme Tarihi:</th>
                        <td data-bind="text: deletedAt ? new Date(deletedAt).toLocaleString('tr-TR') : '-'"></td>
                    </tr>
                    <!-- ko if: migratedProductCount -->
                    <tr>
                        <th class="text-muted">Tasinan Urun Sayisi:</th>
                        <td><span class="badge bg-info" data-bind="text: migratedProductCount"></span></td>
                    </tr>
                    <tr>
                        <th class="text-muted">Hedef Kategori:</th>
                        <td data-bind="text: migratedToCategoryName || 'Bilinmiyor'"></td>
                    </tr>
                    <!-- /ko -->
                    <!-- ko if: reviewedBy -->
                    <tr class="table-success">
                        <th class="text-muted">Onaylayan:</th>
                        <td data-bind="text: reviewedBy"></td>
                    </tr>
                    <tr class="table-success">
                        <th class="text-muted">Onay Tarihi:</th>
                        <td data-bind="text: reviewedAt ? new Date(reviewedAt).toLocaleString('tr-TR') : '-'"></td>
                    </tr>
                    <!-- ko if: reviewNote -->
                    <tr class="table-success">
                        <th class="text-muted">Onay Notu:</th>
                        <td data-bind="text: reviewNote"></td>
                    </tr>
                    <!-- /ko -->
                    <!-- /ko -->
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Close", "Kapat")</button>
            </div>
        </div>
    </div>
</div>

<!-- Approve Deletion Modal -->
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success bg-opacity-10">
                <h5 class="modal-title">
                    <i class="bi bi-check-circle text-success me-2"></i>
                    @Html.T("Admin.Categories.ApproveDeletion", "Silme Islemini Onayla")
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info mb-3" data-bind="with: selectedDeletion">
                    <strong data-bind="text: displayName || name"></strong> kategorisinin silinmesini onayliyorsunuz.
                    <!-- ko if: migratedProductCount -->
                    <br><small><span data-bind="text: migratedProductCount"></span> urun <strong data-bind="text: migratedToCategoryName"></strong> kategorisine tasinmisti.</small>
                    <!-- /ko -->
                </div>
                <div class="mb-3">
                    <label class="form-label">@Html.T("Admin.Categories.ReviewNote", "Not (Opsiyonel)")</label>
                    <textarea class="form-control" rows="2" data-bind="value: reviewNote" placeholder="Onay notu..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Cancel", "Iptal")</button>
                <button type="button" class="btn btn-success" data-bind="click: confirmApprove">
                    <i class="bi bi-check-lg me-1"></i> @Html.T("Admin.Categories.Approve", "Onayla")
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Reject Deletion Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger bg-opacity-10">
                <h5 class="modal-title">
                    <i class="bi bi-x-circle text-danger me-2"></i>
                    @Html.T("Admin.Categories.RejectDeletion", "Silme Islemini Reddet")
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning mb-3" data-bind="with: selectedDeletion">
                    <strong data-bind="text: displayName || name"></strong> kategorisinin silinmesi reddedilecek ve kategori geri yuklenecek.
                    <!-- ko if: migratedProductCount -->
                    <br><small><span data-bind="text: migratedProductCount"></span> urun bu kategoriye geri tasinacak.</small>
                    <!-- /ko -->
                </div>
                <div class="mb-3">
                    <label class="form-label">@Html.T("Admin.Categories.ReviewNote", "Red Nedeni")</label>
                    <textarea class="form-control" rows="2" data-bind="value: reviewNote" placeholder="Red nedeni..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Cancel", "Iptal")</button>
                <button type="button" class="btn btn-danger" data-bind="click: confirmReject">
                    <i class="bi bi-x-lg me-1"></i> @Html.T("Admin.Categories.Reject", "Reddet")
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .category-row {
        transition: all 0.15s ease;
    }
    .category-row:hover {
        background-color: rgba(var(--bs-primary-rgb), 0.05) !important;
    }
    .expand-btn {
        border: none;
        background: transparent;
        color: var(--bs-secondary);
    }
    .expand-btn:hover {
        color: var(--bs-primary);
    }
    .children-container {
        border-left: 2px solid #dee2e6;
        margin-left: 11px;
    }
    .search-match > .category-row {
        border-left: 3px solid var(--bs-warning) !important;
    }
    .category-icon i {
        color: var(--bs-primary);
    }
</style>
</div>

@section Scripts {
<script src="~/js/Admin/Categories.js" asp-append-version="true"></script>
}
