@{
    ViewData["Title"] = Html.T("Company.Settings.Title", "Ayarlar").ToString();
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
}

<div id="settings-app">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1"><i class="bi bi-sliders me-2"></i>@Html.T("Company.Settings.Title", "Ayarlar")</h4>
            <p class="text-muted mb-0">@Html.T("Company.Settings.Description", "Firma ayarlarini yonetin")</p>
        </div>
    </div>

    <!-- Genel Ayarlar -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-gear me-2"></i>@Html.T("Company.Settings.General.Title", "Genel Ayarlar")</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">@Html.T("Company.Settings.General.Language", "Varsayilan Dil")</label>
                    <select class="form-select">
                        <option value="tr" selected>@Html.T("Common.Language.Turkish", "Turkce")</option>
                        <option value="en">@Html.T("Common.Language.English", "English")</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">@Html.T("Company.Settings.General.Timezone", "Saat Dilimi")</label>
                    <select class="form-select">
                        <option value="Europe/Istanbul" selected>Istanbul (UTC+3)</option>
                        <option value="Europe/London">London (UTC+0)</option>
                        <option value="Europe/Berlin">Berlin (UTC+1)</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Bildirim Ayarlari -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-bell me-2"></i>@Html.T("Company.Settings.Notifications.Title", "Bildirim Ayarlari")</h5>
        </div>
        <div class="card-body">
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="emailNotifications" checked>
                <label class="form-check-label" for="emailNotifications">
                    @Html.T("Company.Settings.Notifications.Email", "E-posta bildirimleri")
                </label>
                <small class="d-block text-muted">@Html.T("Company.Settings.Notifications.Email.Description", "Yeni siparisler ve onemli guncellemeler icin e-posta al")</small>
            </div>
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="smsNotifications">
                <label class="form-check-label" for="smsNotifications">
                    @Html.T("Company.Settings.Notifications.SMS", "SMS bildirimleri")
                </label>
                <small class="d-block text-muted">@Html.T("Company.Settings.Notifications.SMS.Description", "Kritik bildirimler icin SMS al")</small>
            </div>
        </div>
    </div>

    <!-- Tehlikeli Bolge -->
    <div class="card border-danger">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>@Html.T("Company.Settings.Danger.Title", "Tehlikeli Bolge")</h5>
        </div>
        <div class="card-body">
            <p class="text-muted">@Html.T("Company.Settings.Danger.Warning", "Bu islemler geri alinamaz. Dikkatli olun.")</p>
            <button class="btn btn-outline-danger" disabled>
                <i class="bi bi-trash me-1"></i> @Html.T("Company.Settings.Danger.DeleteAccount", "Firma Hesabini Sil")
            </button>
            <small class="d-block text-muted mt-2">@Html.T("Company.Settings.Danger.NotAvailable", "Bu ozellik henuz aktif degil.")</small>
        </div>
    </div>
</div>
