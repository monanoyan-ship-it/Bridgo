@using Bridgo.Extensions
@{
    ViewData["Title"] = Html.T("DownloadableProducts.Title", "Indirilebilir Urunler").ToString();
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
}

<div id="downloadable-products-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">
                <i class="bi bi-download text-primary me-2"></i>
                @Html.T("DownloadableProducts.Title", "Indirilebilir Urunler")
            </h4>
            <p class="text-muted mb-0">@Html.T("DownloadableProducts.Subtitle", "Dijital urunlerinizi yonetin")</p>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>

    <div data-bind="visible: !isLoading()">
        <!-- Products Table -->
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" data-bind="visible: products().length > 0">
                        <thead class="table-light">
                            <tr>
                                <th>@Html.T("DownloadableProducts.ProductName", "Urun Adi")</th>
                                <th>@Html.T("DownloadableProducts.FileName", "Dosya Adi")</th>
                                <th class="text-center">@Html.T("DownloadableProducts.Downloads", "Indirme Sayisi")</th>
                                <th>@Html.T("Common.Status", "Durum")</th>
                                <th class="text-end">@Html.T("Common.Actions", "Islemler")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: products">
                            <tr>
                                <td data-bind="text: name"></td>
                                <td><code data-bind="text: fileName || '-'"></code></td>
                                <td class="text-center" data-bind="text: downloadCount || 0"></td>
                                <td>
                                    <span class="badge bg-success" data-bind="visible: isActive">Aktif</span>
                                    <span class="badge bg-secondary" data-bind="visible: !isActive">Pasif</span>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary" data-bind="click: function() { $parent.editProduct($data); }">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Empty State -->
                <div data-bind="visible: products().length === 0" class="text-center py-5">
                    <i class="bi bi-download text-muted display-4 d-block mb-3"></i>
                    <p class="text-muted">@Html.T("DownloadableProducts.NoProducts", "Henuz indirilebilir urun bulunmuyor.")</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/DownloadableProducts/Index.js"></script>
}
