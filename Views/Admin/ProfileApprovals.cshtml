@{
    ViewData["Title"] = "Profil Onaylari";
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
}

<div id="profile-approvals-app" class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">Profil Onaylari</h4>
            <p class="text-muted mb-0">Yayinlanmak istenen profilleri inceleyin ve onaylayin</p>
        </div>
        <button class="btn btn-outline-primary" data-bind="click: loadProfiles">
            <i class="bi bi-arrow-clockwise"></i> Yenile
        </button>
    </div>

    <!-- Loading State -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Yukleniyor...</span>
        </div>
    </div>

    <!-- Empty State -->
    <div data-bind="visible: !isLoading() && profiles().length === 0" class="text-center py-5">
        <i class="bi bi-check-circle text-success" style="font-size: 4rem;"></i>
        <h5 class="mt-3">Onay Bekleyen Profil Yok</h5>
        <p class="text-muted">Tum profiller incelenmis durumda.</p>
    </div>

    <!-- Profiles Grid -->
    <div data-bind="visible: !isLoading() && profiles().length > 0">
        <div class="row" data-bind="foreach: profiles">
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100">
                    <div class="card-header d-flex align-items-center gap-2">
                        <!-- ko if: logoUrl -->
                        <img data-bind="attr: { src: logoUrl }" class="rounded" style="width: 40px; height: 40px; object-fit: cover;">
                        <!-- /ko -->
                        <!-- ko ifnot: logoUrl -->
                        <div class="bg-secondary rounded d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="bi bi-building text-white"></i>
                        </div>
                        <!-- /ko -->
                        <div class="flex-grow-1 min-width-0">
                            <h6 class="mb-0 text-truncate" data-bind="text: companyName"></h6>
                            <small class="text-muted">
                                <i data-bind="class: capabilityIcon || 'bi bi-circle'"></i>
                                <span data-bind="text: capabilityName"></span>
                            </small>
                        </div>
                    </div>
                    <div class="card-body">
                        <h6 class="card-title" data-bind="text: displayName || 'Isimsiz Profil'"></h6>
                        <p class="card-text text-muted small" data-bind="text: shortDescription || 'Aciklama yok'"></p>
                        <div class="d-flex align-items-center gap-2 text-muted small">
                            <i class="bi bi-link-45deg"></i>
                            <span data-bind="text: slug"></span>
                        </div>
                        <!-- ko if: publicationRequestedAt -->
                        <div class="mt-2 text-muted small">
                            <i class="bi bi-clock"></i>
                            Talep: <span data-bind="text: new Date(publicationRequestedAt).toLocaleDateString('tr-TR')"></span>
                        </div>
                        <!-- /ko -->
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <button class="btn btn-sm btn-outline-primary flex-grow-1" data-bind="click: $parent.showDetails">
                            <i class="bi bi-eye"></i> Detay
                        </button>
                        <button class="btn btn-sm btn-success flex-grow-1" data-bind="click: $parent.approveProfile">
                            <i class="bi bi-check-lg"></i> Onayla
                        </button>
                        <button class="btn btn-sm btn-danger" data-bind="click: $parent.showRejectModal">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Detail Modal -->
    <div class="modal fade" id="detailModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Profil Detayi</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" data-bind="with: selectedProfile">
                    <div class="row">
                        <div class="col-md-8">
                            <h5 data-bind="text: displayName || companyName"></h5>
                            <p class="text-muted" data-bind="text: tagline"></p>

                            <!-- ko if: description -->
                            <div class="mb-3">
                                <strong>Tanitim:</strong>
                                <p data-bind="text: description"></p>
                            </div>
                            <!-- /ko -->

                            <!-- ko if: services -->
                            <div class="mb-3">
                                <strong>Hizmetler:</strong>
                                <p data-bind="text: services"></p>
                            </div>
                            <!-- /ko -->

                            <!-- ko if: certifications -->
                            <div class="mb-3">
                                <strong>Sertifikalar:</strong>
                                <p data-bind="text: certifications"></p>
                            </div>
                            <!-- /ko -->

                            <!-- ko if: serviceRegions -->
                            <div class="mb-3">
                                <strong>Hizmet Bolgeleri:</strong>
                                <p data-bind="text: serviceRegions"></p>
                            </div>
                            <!-- /ko -->
                        </div>
                        <div class="col-md-4">
                            <!-- ko if: coverImageUrl -->
                            <img data-bind="attr: { src: coverImageUrl }" class="img-fluid rounded mb-3">
                            <!-- /ko -->

                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6>Iletisim</h6>
                                    <!-- ko if: publicEmail -->
                                    <div class="small mb-1">
                                        <i class="bi bi-envelope me-2"></i>
                                        <span data-bind="text: publicEmail"></span>
                                    </div>
                                    <!-- /ko -->
                                    <!-- ko if: publicPhone -->
                                    <div class="small mb-1">
                                        <i class="bi bi-phone me-2"></i>
                                        <span data-bind="text: publicPhone"></span>
                                    </div>
                                    <!-- /ko -->
                                    <!-- ko if: publicWebsite -->
                                    <div class="small mb-1">
                                        <i class="bi bi-globe me-2"></i>
                                        <span data-bind="text: publicWebsite"></span>
                                    </div>
                                    <!-- /ko -->

                                    <hr>
                                    <h6>Konum</h6>
                                    <!-- ko if: countryName -->
                                    <div class="small mb-1" data-bind="text: countryName"></div>
                                    <!-- /ko -->
                                    <!-- ko if: city -->
                                    <div class="small mb-1" data-bind="text: city"></div>
                                    <!-- /ko -->
                                    <!-- ko if: address -->
                                    <div class="small" data-bind="text: address"></div>
                                    <!-- /ko -->
                                </div>
                            </div>

                            <div class="mt-3">
                                <small class="text-muted">
                                    <i class="bi bi-eye me-1"></i> <span data-bind="text: viewCount"></span> goruntulenme
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                    <button type="button" class="btn btn-danger" data-bind="click: rejectFromDetail">
                        <i class="bi bi-x-lg"></i> Reddet
                    </button>
                    <button type="button" class="btn btn-success" data-bind="click: approveFromDetail">
                        <i class="bi bi-check-lg"></i> Onayla
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Reject Modal -->
    <div class="modal fade" id="rejectModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Profili Reddet</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Bu profili reddetmek istediginizden emin misiniz?</p>
                    <div class="mb-3">
                        <label class="form-label">Red Sebebi <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="3" data-bind="value: rejectReason" placeholder="Lutfen red sebebini belirtiniz..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-danger" data-bind="click: executeReject, disable: !rejectReason()">
                        <i class="bi bi-x-lg"></i> Reddet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Admin/ProfileApprovals.js"></script>
}
