@{
    ViewData["Title"] = Html.T("VendorSetup.Title", "Firma Kaydi").ToString();
    Layout = "_Layout";
}

<div id="vendor-setup-app" class="container py-4">
    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;"></div>
        <p class="mt-3 text-muted">@Html.T("VendorSetup.Loading", "Bilgileriniz kontrol ediliyor...")</p>
    </div>

    <!-- Error Message -->
    <div data-bind="visible: errorMessage" class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i>
        <span data-bind="text: errorMessage"></span>
        <button type="button" class="btn-close" data-bind="click: function() { errorMessage(''); }"></button>
    </div>

    <!-- Main Content -->
    <div data-bind="visible: !isLoading()">
        <!-- Header -->
        <div class="text-center mb-4">
            <i class="bi bi-building text-primary" style="font-size: 4rem;"></i>
            <h2 class="mt-3">@Html.T("VendorSetup.Title", "Firma Kaydi")</h2>
            <p class="text-muted">@Html.T("VendorSetup.Subtitle", "Bridgo'i kullanmak icin firmanizi kaydedin veya mevcut firmaya katilin")</p>
        </div>

        <!-- Pending Request Section -->
        <div data-bind="visible: hasPendingRequest" class="row justify-content-center mb-4">
            <div class="col-md-8">
                <div class="card border-warning shadow">
                    <div class="card-body text-center">
                        <i class="bi bi-clock-history text-warning" style="font-size: 3rem;"></i>
                        <h4 class="mt-3">@Html.T("VendorSetup.PendingRequest.Title", "Katilma Isteginiz Beklemede")</h4>
                        <p class="text-muted" data-bind="text: '@Html.T("VendorSetup.PendingRequest.Message", "Firmaya katilma isteginiz onay bekliyor:")' + ' ' + (pendingRequest()?.vendorName || '')"></p>
                        <div class="mt-3">
                            <button class="btn btn-outline-danger" data-bind="click: cancelPendingRequest">
                                <i class="bi bi-x-circle"></i> @Html.T("VendorSetup.PendingRequest.Cancel", "Istegi Iptal Et")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Domain Match Section -->
        <div data-bind="visible: hasDomainMatch() && !hasPendingRequest()" class="row justify-content-center mb-4">
            <div class="col-md-8">
                <div class="card border-info shadow">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-building-check text-info me-3" style="font-size: 2.5rem;"></i>
                            <div>
                                <h5 class="mb-1">@Html.T("VendorSetup.DomainMatch.Title", "Firmaniz Bulundu!")</h5>
                                <p class="text-muted mb-0">@Html.T("VendorSetup.DomainMatch.Subtitle", "E-posta adresinize gore eslesen firma")</p>
                            </div>
                        </div>
                        <div class="bg-light rounded p-3 mb-3" data-bind="with: matchedVendor">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h5 class="mb-1" data-bind="text: companyName"></h5>
                                    <small class="text-muted">
                                        <span data-bind="text: city || '@Html.T("Common.LocationNotSpecified", "Konum belirtilmemis")'"></span>
                                        <span data-bind="visible: isVerified" class="badge bg-success ms-2">
                                            <i class="bi bi-patch-check"></i> @Html.T("Common.Verified", "Dogrulanmis")
                                        </span>
                                    </small>
                                </div>
                                <button class="btn btn-info" data-bind="click: $parent.joinMatchedVendor">
                                    <i class="bi bi-person-plus"></i> @Html.T("Common.Join", "Katil")
                                </button>
                            </div>
                        </div>
                        <p class="small text-muted mb-0">
                            <i class="bi bi-info-circle"></i>
                            @Html.T("VendorSetup.DomainMatch.Hint", "Bu sizin firmaniz degilse asagidan arama yapabilir veya yeni firma olusturabilirsiniz.")
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Tabs -->
        <div data-bind="visible: !hasPendingRequest()">
            <ul class="nav nav-pills nav-fill mb-4 justify-content-center" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bind="css: { active: activeTab() === 'search' }, click: function() { activeTab('search'); }">
                        <i class="bi bi-search"></i> @Html.T("VendorSetup.Tab.Search", "Firma Ara")
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bind="css: { active: activeTab() === 'create' }, click: function() { activeTab('create'); }">
                        <i class="bi bi-plus-circle"></i> @Html.T("VendorSetup.Tab.Create", "Yeni Firma Olustur")
                    </button>
                </li>
            </ul>

            <!-- Search Tab -->
            <div data-bind="visible: activeTab() === 'search'">
                <div class="row justify-content-center">
                    <div class="col-md-8">
                        <div class="card shadow">
                            <div class="card-body">
                                <h5 class="card-title"><i class="bi bi-search"></i> @Html.T("VendorSetup.Search.Title", "Firma Ara")</h5>
                                <p class="text-muted small">@Html.T("VendorSetup.Search.Description", "Calistiginiz firmay arayip katilma istegi gonderin")</p>

                                <div class="input-group mb-3">
                                    <span class="input-group-text"><i class="bi bi-building"></i></span>
                                    <input type="text" class="form-control form-control-lg" placeholder="@Html.T("VendorSetup.Search.Placeholder", "Firma adi yazin...")"
                                           data-bind="value: searchTerm, valueUpdate: 'afterkeydown', event: { keyup: onSearchKeyUp }" />
                                    <button class="btn btn-primary" data-bind="click: searchVendors, disable: isSearching">
                                        <span data-bind="visible: !isSearching()"><i class="bi bi-search"></i></span>
                                        <span data-bind="visible: isSearching()" class="spinner-border spinner-border-sm"></span>
                                    </button>
                                </div>

                                <!-- Search Results -->
                                <div data-bind="visible: searchResults().length > 0">
                                    <h6 class="text-muted mb-2">@Html.T("VendorSetup.Search.Results", "Sonuclar") (<span data-bind="text: searchResults().length"></span>)</h6>
                                    <div class="list-group">
                                        <!-- ko foreach: searchResults -->
                                        <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                            <div>
                                                <h6 class="mb-1" data-bind="text: companyName"></h6>
                                                <small class="text-muted">
                                                    <span data-bind="text: city || '@Html.T("Common.LocationNotSpecified", "Konum belirtilmemis")'"></span>
                                                    <span data-bind="visible: isVerified" class="badge bg-success ms-2">
                                                        <i class="bi bi-patch-check"></i>
                                                    </span>
                                                </small>
                                            </div>
                                            <button class="btn btn-outline-primary btn-sm" data-bind="click: $parent.selectVendorToJoin">
                                                <i class="bi bi-person-plus"></i> @Html.T("Common.Join", "Katil")
                                            </button>
                                        </div>
                                        <!-- /ko -->
                                    </div>
                                </div>

                                <!-- No Results -->
                                <div data-bind="visible: searchResults().length === 0 && searchTerm().length >= 2 && !isSearching()" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                                    <p class="mt-2">@Html.T("VendorSetup.Search.NoResults", "Sonuc bulunamadi")</p>
                                    <button class="btn btn-outline-primary" data-bind="click: function() { activeTab('create'); }">
                                        <i class="bi bi-plus-circle"></i> @Html.T("VendorSetup.Tab.Create", "Yeni Firma Olustur")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Create Tab -->
            <div data-bind="visible: activeTab() === 'create'">
                <div class="row justify-content-center">
                    <div class="col-md-10">
                        <div class="card shadow">
                            <div class="card-body">
                                <h5 class="card-title"><i class="bi bi-building-add"></i> @Html.T("VendorSetup.Create.Title", "Yeni Firma Olustur")</h5>
                                <p class="text-muted small">@Html.T("VendorSetup.Create.Description", "Firmanizi sisteme kaydedin. Siz firma sahibi (Owner) olarak atanacaksiniz.")</p>

                                <form data-bind="submit: createVendor">
                                    <!-- Firma Bilgileri -->
                                    <h6 class="border-bottom pb-2 mb-3"><i class="bi bi-briefcase"></i> @Html.T("VendorSetup.Create.CompanyInfo", "Firma Bilgileri")</h6>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">@Html.T("Company.Fields.CompanyName", "Firma Adi") <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" data-bind="value: newVendor().companyName" required maxlength="200" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">@Html.T("Admin.Table.Email", "E-posta") <span class="text-danger">*</span></label>
                                            <input type="email" class="form-control" data-bind="value: newVendor().email" required />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">@Html.T("Company.Fields.Phone", "Telefon") <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" data-bind="value: newVendor().phone" required maxlength="20" placeholder="0212 123 45 67" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">@Html.T("Address.Fields.Type", "Adres Tipi")</label>
                                            <select class="form-select" data-bind="value: newVendor().addressType, options: addressTypes, optionsText: 'name', optionsValue: 'id'">
                                            </select>
                                        </div>
                                    </div>

                                    <!-- Adres Bilgileri -->
                                    <h6 class="border-bottom pb-2 mb-3 mt-4"><i class="bi bi-geo-alt"></i> @Html.T("VendorSetup.Create.AddressInfo", "Adres Bilgileri")</h6>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">@Html.T("Address.Fields.Title", "Adres Basligi") <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" data-bind="value: newVendor().addressTitle" required maxlength="100" placeholder="@Html.T("Address.Fields.Title.Placeholder", "Merkez Ofis")" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">@Html.T("Address.Fields.Country", "Ulke") <span class="text-danger">*</span></label>
                                            <select class="form-select" data-bind="value: newVendor().countryId, options: countries, optionsText: 'name', optionsValue: 'id', optionsCaption: '@Html.T("Common.Select", "Secin...")', event: { change: onCountryChange }" required>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="row" data-bind="visible: states().length > 0">
                                        <div class="col-md-12 mb-3">
                                            <label class="form-label">@Html.T("Address.Fields.State", "Eyalet") <span class="text-danger">*</span></label>
                                            <select class="form-select" data-bind="value: newVendor().stateId, options: states, optionsText: 'name', optionsValue: 'id', optionsCaption: '@Html.T("Common.Select", "Secin...")'" required>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-4 mb-3">
                                            <label class="form-label">@Html.T("Address.Fields.City", "Il") <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" data-bind="value: newVendor().city" required maxlength="100" placeholder="@Html.T("Address.Fields.City.Placeholder", "Istanbul")" />
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <label class="form-label">@Html.T("Address.Fields.District", "Ilce") <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" data-bind="value: newVendor().district" required maxlength="100" />
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <label class="form-label">@Html.T("Address.Fields.PostalCode", "Posta Kodu")</label>
                                            <input type="text" class="form-control" data-bind="value: newVendor().postalCode" maxlength="10" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12 mb-3">
                                            <label class="form-label">@Html.T("Address.Fields.AddressLine", "Adres") <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" data-bind="value: newVendor().addressLine" required maxlength="500" placeholder="@Html.T("Address.Fields.AddressLine.Placeholder", "Sokak, Bina No, Kat, Daire")" />
                                        </div>
                                    </div>

                                    <div class="d-grid mt-4">
                                        <button type="submit" class="btn btn-primary btn-lg" data-bind="disable: isSaving">
                                            <span data-bind="visible: !isSaving()">
                                                <i class="bi bi-check-circle"></i> @Html.T("VendorSetup.Create.Submit", "Firmayi Kaydet")
                                            </span>
                                            <span data-bind="visible: isSaving()">
                                                <span class="spinner-border spinner-border-sm"></span> @Html.T("Common.Saving", "Kaydediliyor...")
                                            </span>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Join Request Modal -->
    <div class="modal fade" data-bind="css: { show: showJoinModal }, style: { display: showJoinModal() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" data-bind="with: selectedVendorToJoin">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-person-plus"></i> @Html.T("VendorSetup.JoinModal.Title", "Firmaya Katil")</h5>
                    <button type="button" class="btn-close" data-bind="click: $parent.closeJoinModal"></button>
                </div>
                <div class="modal-body">
                    <div class="text-center mb-4">
                        <i class="bi bi-building text-primary" style="font-size: 3rem;"></i>
                        <h5 class="mt-2" data-bind="text: companyName"></h5>
                        <p class="text-muted" data-bind="text: city || '@Html.T("Common.LocationNotSpecified", "Konum belirtilmemis")'"></p>
                    </div>
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        @Html.T("VendorSetup.JoinModal.Info", "Katilma isteginiz firma yetkililerine gonderilecektir. Onaylandiginizda sisteme giris yapabilirsiniz.")
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("VendorSetup.JoinModal.MessageLabel", "Mesaj (Opsiyonel)")</label>
                        <textarea class="form-control" rows="3" data-bind="value: $parent.joinMessage"
                                  placeholder="@Html.T("VendorSetup.JoinModal.MessagePlaceholder", "Kendinizi tanitmak ister misiniz? (orn: Satis departmaninda calisiyorum)")"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: $parent.closeJoinModal">
                        @Html.T("Common.Cancel", "Iptal")
                    </button>
                    <button type="button" class="btn btn-primary" data-bind="click: $parent.submitJoinRequest, disable: $parent.isSaving">
                        <span data-bind="visible: !$parent.isSaving()">
                            <i class="bi bi-send"></i> @Html.T("VendorSetup.JoinModal.Submit", "Istek Gonder")
                        </span>
                        <span data-bind="visible: $parent.isSaving()">
                            <span class="spinner-border spinner-border-sm"></span> @Html.T("Common.Sending", "Gonderiliyor...")
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: showJoinModal }, style: { display: showJoinModal() ? 'block' : 'none' }"></div>
</div>

@section Scripts {
    <script src="~/js/VendorSetup/Index.js" asp-append-version="true"></script>
}
