@using Bridgo.Extensions
@{
    ViewData["Title"] = Html.T("SupplierOffers.Title", "Tekliflerim").ToString();
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
}

<div id="supplier-offers-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">
                <i class="bi bi-send-check text-primary me-2"></i>
                @Html.T("SupplierOffers.Title", "Tekliflerim")
            </h4>
            <p class="text-muted mb-0">@Html.T("SupplierOffers.Subtitle", "Gelen talepleri yonetin, yeni firsatlari kesfedin.")</p>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link" data-bind="css: { active: activeTab() === 'incoming' }, click: function() { setTab('incoming'); }" href="#">
                <i class="bi bi-inbox-fill"></i> @Html.T("SupplierOffers.Tab.Incoming", "Gelen Talepler")
                <span class="badge bg-danger ms-1" data-bind="text: unreadInquiryCount, visible: unreadInquiryCount() > 0"></span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bind="css: { active: activeTab() === 'myoffers' }, click: function() { setTab('myoffers'); }" href="#">
                <i class="bi bi-send-check"></i> Verdigim Teklifler
                <span class="badge bg-warning text-dark ms-1" data-bind="text: activeNegotiationsCount, visible: activeNegotiationsCount() > 0"></span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bind="css: { active: activeTab() === 'potential' }, click: function() { setTab('potential'); }" href="#">
                <i class="bi bi-megaphone"></i> @Html.T("SupplierOffers.Tab.Potential", "Muhtemel Talepler")
                <span class="badge bg-primary ms-1" data-bind="text: potentialDemandsCount"></span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bind="css: { active: activeTab() === 'subscriptions' }, click: function() { setTab('subscriptions'); }" href="#">
                <i class="bi bi-bell"></i> @Html.T("SupplierOffers.Tab.Subscriptions", "Takip Ettigim Kategoriler")
                <span class="badge bg-info ms-1" data-bind="text: subscriptions().length"></span>
            </a>
        </li>
    </ul>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@Html.T("Common.Loading", "Yukleniyor...")</span>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- TAB 1: GELEN TALEPLER (Product Inquiries) -->
    <!-- ========================================== -->
    <div data-bind="visible: !isLoading() && activeTab() === 'incoming'">
        <!-- Filters -->
        <div class="card mb-4">
            <div class="card-body py-2">
                <div class="row g-2 align-items-center">
                    <div class="col-md-4">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control" placeholder="@Html.T("Common.Search", "Ara...")"
                                   data-bind="value: incomingFilter.search, valueUpdate: 'afterkeydown'" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select form-select-sm" data-bind="value: incomingFilter.status">
                            <option value="">@Html.T("Common.AllStatuses", "Tum Durumlar")</option>
                            <option value="0">@Html.T("Inquiry.Status.New", "Yeni")</option>
                            <option value="1">@Html.T("Inquiry.Status.Read", "Okundu")</option>
                            <option value="2">@Html.T("Inquiry.Status.Responded", "Yanit Verildi")</option>
                            <option value="3">@Html.T("Inquiry.Status.Closed", "Kapandi")</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select form-select-sm" data-bind="value: incomingFilter.isRead">
                            <option value="">@Html.T("Common.All", "Tumu")</option>
                            <option value="false">@Html.T("Inquiry.Unread", "Okunmamis")</option>
                            <option value="true">@Html.T("Inquiry.Read", "Okunmus")</option>
                        </select>
                    </div>
                    <div class="col-md-2 text-end">
                        <button class="btn btn-sm btn-outline-secondary" data-bind="click: resetIncomingFilters">
                            <i class="bi bi-x-circle"></i> @Html.T("Common.Reset", "Sifirla")
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Empty State -->
        <div data-bind="visible: incomingInquiries().length === 0" class="text-center py-5">
            <i class="bi bi-inbox display-1 text-muted"></i>
            <h5 class="mt-3 text-muted">@Html.T("SupplierOffers.Incoming.NoInquiries", "Henuz gelen talep yok")</h5>
            <p class="text-muted">@Html.T("SupplierOffers.Incoming.NoInquiriesDesc", "Urunlerinize gelen teklif talepleri burada gorunecek.")</p>
        </div>

        <!-- Inquiries List -->
        <div data-bind="visible: incomingInquiries().length > 0, foreach: incomingInquiries">
            <div class="card mb-3" data-bind="css: { 'border-primary': !isRead }">
                <div class="card-header d-flex justify-content-between align-items-center" data-bind="css: { 'bg-primary bg-opacity-10': !isRead, 'bg-light': isRead }">
                    <div>
                        <!-- ko if: !isRead -->
                        <span class="badge bg-danger me-2">@Html.T("Common.New", "Yeni")</span>
                        <!-- /ko -->
                        <strong data-bind="text: productName"></strong>
                        <small class="text-muted ms-2" data-bind="text: '(' + buyerCompanyName + ')'"></small>
                    </div>
                    <span class="badge" data-bind="css: $parent.getInquiryStatusClass(status), text: $parent.getInquiryStatusText(status)"></span>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <h6 class="text-muted mb-1">@Html.T("Inquiry.RequestedQty", "Talep Edilen Miktar")</h6>
                            <p class="mb-2 fw-bold" data-bind="text: quantity ? quantity + ' ' + (unit || 'Adet') : '-'"></p>
                        </div>
                        <div class="col-md-3">
                            <h6 class="text-muted mb-1">@Html.T("Inquiry.TargetPrice", "Hedef Fiyat")</h6>
                            <p class="mb-2" data-bind="text: targetPrice ? (targetPrice.toLocaleString('tr-TR') + ' ' + (currency || 'TRY')) : '-'"></p>
                        </div>
                        <div class="col-md-3">
                            <h6 class="text-muted mb-1">@Html.T("Inquiry.DeliveryDate", "Teslimat Tarihi")</h6>
                            <p class="mb-2" data-bind="text: targetDeliveryDate ? new Date(targetDeliveryDate).toLocaleDateString('tr-TR') : '-'"></p>
                        </div>
                        <div class="col-md-3 text-end">
                            <button class="btn btn-sm btn-primary" data-bind="click: function() { $parent.viewInquiryDetail($data); }">
                                <i class="bi bi-eye"></i> @Html.T("Common.ViewDetail", "Detay")
                            </button>
                            <!-- ko if: status < 2 -->
                            <button class="btn btn-sm btn-success" data-bind="click: function() { $parent.respondToInquiry($data); }">
                                <i class="bi bi-send"></i> @Html.T("Inquiry.Respond", "Teklif Ver")
                            </button>
                            <!-- /ko -->
                        </div>
                    </div>
                    <!-- ko if: notes -->
                    <div class="mt-2 p-2 bg-light rounded">
                        <small class="text-muted"><i class="bi bi-chat-quote"></i> <span data-bind="text: notes"></span></small>
                    </div>
                    <!-- /ko -->
                </div>
                <div class="card-footer bg-transparent text-muted small">
                    <i class="bi bi-calendar"></i> <span data-bind="text: new Date(createdAt).toLocaleString('tr-TR')"></span>
                    <!-- ko if: responseCount > 0 -->
                    <span class="ms-3"><i class="bi bi-reply-all"></i> <span data-bind="text: responseCount"></span> @Html.T("Inquiry.Responses", "teklif")</span>
                    <!-- /ko -->
                </div>
            </div>
        </div>

        <!-- Pagination -->
        <div data-bind="visible: incomingTotalPages() > 1" class="d-flex justify-content-center mt-4">
            <nav>
                <ul class="pagination pagination-sm">
                    <li class="page-item" data-bind="css: { disabled: incomingPage() <= 1 }">
                        <a class="page-link" href="#" data-bind="click: function() { if(incomingPage() > 1) { incomingPage(incomingPage() - 1); loadIncomingInquiries(); } }">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    <li class="page-item active">
                        <span class="page-link" data-bind="text: incomingPage() + ' / ' + incomingTotalPages()"></span>
                    </li>
                    <li class="page-item" data-bind="css: { disabled: incomingPage() >= incomingTotalPages() }">
                        <a class="page-link" href="#" data-bind="click: function() { if(incomingPage() < incomingTotalPages()) { incomingPage(incomingPage() + 1); loadIncomingInquiries(); } }">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- TAB 2: VERDIGIM TEKLIFLER (My DemandResponses) -->
    <!-- ========================================== -->
    <div data-bind="visible: !isLoading() && activeTab() === 'myoffers'">
        <!-- Filter by negotiation status -->
        <div class="mb-3">
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-sm" data-bind="css: { 'btn-primary': myOffersFilter() === 'all', 'btn-outline-primary': myOffersFilter() !== 'all' }, click: function() { setMyOffersFilter('all'); }">
                    Tumu
                </button>
                <button type="button" class="btn btn-sm" data-bind="css: { 'btn-warning': myOffersFilter() === 'negotiating', 'btn-outline-warning': myOffersFilter() !== 'negotiating' }, click: function() { setMyOffersFilter('negotiating'); }">
                    <i class="bi bi-arrow-left-right"></i> Pazarlik Suruyor
                </button>
                <button type="button" class="btn btn-sm" data-bind="css: { 'btn-info': myOffersFilter() === 'myturn', 'btn-outline-info': myOffersFilter() !== 'myturn' }, click: function() { setMyOffersFilter('myturn'); }">
                    <i class="bi bi-bell"></i> Sira Bende
                </button>
            </div>
        </div>

        <!-- Loading -->
        <div data-bind="visible: isLoadingMyOffers" class="text-center py-4">
            <div class="spinner-border spinner-border-sm text-primary"></div>
        </div>

        <!-- Empty State -->
        <div data-bind="visible: !isLoadingMyOffers() && myOffers().length === 0" class="text-center py-5">
            <i class="bi bi-send display-1 text-muted"></i>
            <h5 class="mt-3 text-muted">Henuz teklif vermediniz</h5>
            <p class="text-muted">Muhtemel Talepler sekmesinden taleplere teklif verin.</p>
            <button class="btn btn-primary" data-bind="click: function() { setTab('potential'); }">
                <i class="bi bi-megaphone"></i> Talepleri Gor
            </button>
        </div>

        <!-- My Offers List -->
        <div data-bind="visible: !isLoadingMyOffers() && myOffers().length > 0, foreach: myOffers">
            <div class="card mb-3" data-bind="css: { 'border-warning': status === 6 && isMyTurn, 'border-info': status === 6 && !isMyTurn }">
                <div class="card-header d-flex justify-content-between align-items-center" data-bind="css: { 'bg-warning bg-opacity-10': status === 6 && isMyTurn, 'bg-info bg-opacity-10': status === 6 && !isMyTurn }">
                    <div>
                        <!-- ko if: status === 6 && isMyTurn -->
                        <span class="badge bg-warning text-dark me-2"><i class="bi bi-bell-fill"></i> Sira Sizde</span>
                        <!-- /ko -->
                        <!-- ko if: status === 6 && !isMyTurn -->
                        <span class="badge bg-info me-2"><i class="bi bi-hourglass-split"></i> Yanit Bekleniyor</span>
                        <!-- /ko -->
                        <strong data-bind="text: demandTitle"></strong>
                        <small class="text-muted ms-2" data-bind="text: '(' + buyerCompanyName + ')'"></small>
                    </div>
                    <span class="badge" data-bind="text: statusName, css: {
                        'bg-secondary': status === 1,
                        'bg-info': status === 2,
                        'bg-warning text-dark': status === 3 || status === 6,
                        'bg-success': status === 4,
                        'bg-danger': status === 5
                    }"></span>
                </div>
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-3">
                            <h6 class="text-muted mb-1">Teklifiniz</h6>
                            <p class="mb-0 fw-bold">
                                <span data-bind="text: unitPrice ? unitPrice.toLocaleString('tr-TR', {minimumFractionDigits: 2}) : '-'"></span>
                                <small class="text-muted" data-bind="text: currency || 'TRY'"></small>
                            </p>
                        </div>
                        <div class="col-md-2">
                            <h6 class="text-muted mb-1">Miktar</h6>
                            <p class="mb-0" data-bind="text: quantity ? quantity + ' ' + (unit || 'adet') : '-'"></p>
                        </div>
                        <div class="col-md-2">
                            <h6 class="text-muted mb-1">Teslimat</h6>
                            <p class="mb-0" data-bind="text: leadTimeDays ? leadTimeDays + ' gun' : '-'"></p>
                        </div>
                        <!-- ko if: status === 6 -->
                        <div class="col-md-2">
                            <h6 class="text-muted mb-1">Pazarlik Turu</h6>
                            <p class="mb-0 fw-bold text-primary" data-bind="text: currentRoundNumber || '-'"></p>
                        </div>
                        <!-- /ko -->
                        <div class="col-md-3 text-end">
                            <!-- ko if: status === 6 -->
                            <button class="btn btn-sm btn-info" data-bind="click: function() { $root.openSellerNegotiationModal($data); }">
                                <i class="bi bi-chat-dots me-1"></i> Pazarlik
                            </button>
                            <!-- /ko -->
                            <!-- ko if: status < 4 && status !== 6 -->
                            <button class="btn btn-sm btn-outline-secondary" data-bind="click: function() { $root.viewMyOfferDetail($data); }">
                                <i class="bi bi-eye"></i> Detay
                            </button>
                            <!-- /ko -->
                            <!-- ko if: status === 4 -->
                            <span class="text-success"><i class="bi bi-check-circle-fill"></i> Kabul Edildi</span>
                            <!-- /ko -->
                            <!-- ko if: status === 5 -->
                            <span class="text-danger"><i class="bi bi-x-circle-fill"></i> Reddedildi</span>
                            <!-- /ko -->
                        </div>
                    </div>
                    <!-- Negotiation warning -->
                    <!-- ko if: status === 6 && isMyTurn && expiresAt -->
                    <div class="alert alert-warning mt-3 mb-0 py-2 d-flex align-items-center">
                        <i class="bi bi-clock me-2"></i>
                        <span>Kalan sure: <strong data-bind="text: $root.formatTimeRemaining(expiresAt)"></strong></span>
                    </div>
                    <!-- /ko -->
                </div>
                <div class="card-footer bg-transparent text-muted small">
                    <i class="bi bi-calendar"></i> <span data-bind="text: new Date(createdAt).toLocaleString('tr-TR')"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- TAB 3: MUHTEMEL TALEPLER (Subscribed Demands) -->
    <!-- ========================================== -->
    <div data-bind="visible: !isLoading() && activeTab() === 'potential'">
        <!-- Info Banner -->
        <div class="alert alert-info d-flex align-items-center mb-4">
            <i class="bi bi-info-circle me-2 fs-5"></i>
            <div>
                <strong>@Html.T("SupplierOffers.Potential.Info", "Muhtemel Talepler")</strong>
                <p class="mb-0 small">@Html.T("SupplierOffers.Potential.InfoDesc", "Takip ettiginiz kategorilerdeki talepler. Teklif gonderdiginizde 'Gelen Talepler' sekmesinde goruntulenir.")</p>
            </div>
        </div>

        <!-- Loading -->
        <div data-bind="visible: isLoadingPotential" class="text-center py-4">
            <div class="spinner-border spinner-border-sm text-primary"></div>
        </div>

        <!-- Empty State -->
        <div data-bind="visible: !isLoadingPotential() && potentialDemands().length === 0" class="text-center py-5">
            <i class="bi bi-megaphone display-1 text-muted"></i>
            <h5 class="mt-3 text-muted">@Html.T("SupplierOffers.Potential.NoDemands", "Muhtemel talep yok")</h5>
            <p class="text-muted">@Html.T("SupplierOffers.Potential.NoDemandsDesc", "Takip ettiginiz kategorilerde aktif talep bulunmuyor.")</p>
            <button class="btn btn-info" data-bind="click: function() { setTab('subscriptions'); }">
                <i class="bi bi-bell-plus"></i> @Html.T("SupplierOffers.Potential.AddCategory", "Kategori Ekle")
            </button>
        </div>

        <!-- Demands List -->
        <div class="table-responsive" data-bind="visible: !isLoadingPotential() && potentialDemands().length > 0">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>@Html.T("Common.Title", "Baslik")</th>
                        <th>@Html.T("Common.Category", "Kategori")</th>
                        <th>@Html.T("Common.Quantity", "Miktar")</th>
                        <th>@Html.T("Common.Location", "Konum")</th>
                        <th>@Html.T("Common.Date", "Tarih")</th>
                        <th class="text-end">@Html.T("Common.Actions", "Islemler")</th>
                    </tr>
                </thead>
                <tbody data-bind="foreach: potentialDemands">
                    <tr>
                        <td>
                            <a data-bind="attr: { href: '/Demands/' + slug }, text: title" class="text-decoration-none fw-semibold" target="_blank"></a>
                            <small class="d-block text-muted text-truncate" style="max-width: 300px;" data-bind="text: description"></small>
                        </td>
                        <td><span class="badge bg-info" data-bind="text: categoryName"></span></td>
                        <td data-bind="text: quantity ? quantity + ' ' + (unit || 'Adet') : '-'"></td>
                        <td data-bind="text: countryName || '-'"></td>
                        <td><small data-bind="text: new Date(publishedAt || createdAt).toLocaleDateString('tr-TR')"></small></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" data-bind="attr: { href: '/Demands/' + slug }" target="_blank">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a class="btn btn-sm btn-success" data-bind="attr: { href: '/Demands/' + slug + '#respond' }" target="_blank">
                                <i class="bi bi-send"></i> @Html.T("SupplierOffers.SendOffer", "Teklif Ver")
                            </a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- TAB 3: TAKIP ETTIGIM KATEGORILER -->
    <!-- ========================================== -->
    <div data-bind="visible: !isLoading() && activeTab() === 'subscriptions'">
        <!-- Add New Subscription -->
        <div class="card mb-4">
            <div class="card-header bg-white">
                <h6 class="mb-0"><i class="bi bi-plus-circle text-success"></i> @Html.T("SupplierOffers.Subscriptions.Add", "Kategori Ekle")</h6>
            </div>
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label">@Html.T("Common.Category", "Kategori")</label>
                        <select class="form-select" data-bind="value: newSubscription.categoryId, options: allCategories, optionsText: 'name', optionsValue: 'id', optionsCaption: '@Html.T("Common.SelectCategory", "Kategori Seciniz")'"></select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Html.T("SupplierOffers.Subscriptions.KeywordFilter", "Anahtar Kelime (Opsiyonel)")</label>
                        <input type="text" class="form-control" placeholder="@Html.T("SupplierOffers.Subscriptions.KeywordPlaceholder", "ornek: organik, ithal")" data-bind="value: newSubscription.keywordFilter" />
                    </div>
                    <div class="col-md-2">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="notifyEmail" data-bind="checked: newSubscription.notifyByEmail" />
                            <label class="form-check-label" for="notifyEmail">
                                <i class="bi bi-envelope"></i> @Html.T("SupplierOffers.Subscriptions.NotifyEmail", "E-posta")
                            </label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="notifyApp" data-bind="checked: newSubscription.notifyInApp" />
                            <label class="form-check-label" for="notifyApp">
                                <i class="bi bi-bell"></i> @Html.T("SupplierOffers.Subscriptions.NotifyApp", "Bildirim")
                            </label>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-success w-100" data-bind="click: addSubscription, disable: !newSubscription.categoryId()">
                            <i class="bi bi-plus"></i> @Html.T("Common.Add", "Ekle")
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Loading -->
        <div data-bind="visible: isLoadingSubscriptions" class="text-center py-4">
            <div class="spinner-border spinner-border-sm text-primary"></div>
        </div>

        <!-- Empty State -->
        <div data-bind="visible: !isLoadingSubscriptions() && subscriptions().length === 0" class="text-center py-5">
            <i class="bi bi-bell-slash display-1 text-muted"></i>
            <h5 class="mt-3 text-muted">@Html.T("SupplierOffers.Subscriptions.NoSubscriptions", "Henuz kategori takip etmiyorsunuz")</h5>
            <p class="text-muted">@Html.T("SupplierOffers.Subscriptions.NoSubscriptionsDesc", "Takip ettiginiz kategorilerdeki taleplerden haberdar olun.")</p>
        </div>

        <!-- Subscriptions List -->
        <div class="card" data-bind="visible: !isLoadingSubscriptions() && subscriptions().length > 0">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0"><i class="bi bi-bell-fill text-info"></i> @Html.T("SupplierOffers.Subscriptions.YourCategories", "Takip Ettiginiz Kategoriler")</h6>
                <span class="badge bg-info" data-bind="text: subscriptions().length + ' kategori'"></span>
            </div>
            <ul class="list-group list-group-flush" data-bind="foreach: subscriptions">
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <i class="bi bi-folder-fill text-info me-2"></i>
                        <strong data-bind="text: categoryName"></strong>
                        <!-- ko if: keywordFilter -->
                        <small class="text-muted ms-2">
                            <i class="bi bi-filter"></i> "<span data-bind="text: keywordFilter"></span>"
                        </small>
                        <!-- /ko -->
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <!-- ko if: demandCount > 0 -->
                        <span class="badge bg-primary" data-bind="text: demandCount + ' talep'"></span>
                        <!-- /ko -->
                        <!-- ko if: demandCount === 0 -->
                        <span class="badge bg-secondary">0 talep</span>
                        <!-- /ko -->
                        <span class="badge bg-light text-dark" data-bind="visible: notifyByEmail"><i class="bi bi-envelope"></i></span>
                        <span class="badge bg-light text-dark" data-bind="visible: notifyInApp"><i class="bi bi-bell"></i></span>
                        <button class="btn btn-sm btn-outline-danger" data-bind="click: function() { $parent.removeSubscription($data); }">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- Inquiry Detail Modal -->
<div class="modal fade" id="inquiryDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Html.T("Inquiry.Detail.Title", "Talep Detayi")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" data-bind="with: selectedInquiry">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <h6 class="text-muted">@Html.T("Common.Product", "Urun")</h6>
                        <p class="fw-bold" data-bind="text: productName"></p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted">@Html.T("Common.Buyer", "Alici")</h6>
                        <p class="fw-bold" data-bind="text: buyerCompanyName"></p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4">
                        <h6 class="text-muted">@Html.T("Inquiry.RequestedQty", "Talep Edilen Miktar")</h6>
                        <p data-bind="text: quantity ? quantity + ' ' + (unit || 'Adet') : '-'"></p>
                    </div>
                    <div class="col-md-4">
                        <h6 class="text-muted">@Html.T("Inquiry.TargetPrice", "Hedef Fiyat")</h6>
                        <p data-bind="text: targetPrice ? (targetPrice.toLocaleString('tr-TR') + ' ' + (currency || 'TRY')) : '-'"></p>
                    </div>
                    <div class="col-md-4">
                        <h6 class="text-muted">@Html.T("Inquiry.DeliveryDate", "Teslimat Tarihi")</h6>
                        <p data-bind="text: targetDeliveryDate ? new Date(targetDeliveryDate).toLocaleDateString('tr-TR') : '-'"></p>
                    </div>
                </div>
                <!-- ko if: notes -->
                <div class="mb-3">
                    <h6 class="text-muted">@Html.T("Common.Notes", "Notlar")</h6>
                    <p class="bg-light p-2 rounded" data-bind="text: notes"></p>
                </div>
                <!-- /ko -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Close", "Kapat")</button>
                <button type="button" class="btn btn-success" data-bind="click: function() { respondToInquiry(selectedInquiry()); }">
                    <i class="bi bi-send"></i> @Html.T("Inquiry.Respond", "Teklif Ver")
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Respond Modal -->
<div class="modal fade" id="respondModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Html.T("Inquiry.Respond.Title", "Teklif Gonder")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3" data-bind="with: respondingInquiry">
                    <div class="alert alert-light">
                        <strong data-bind="text: productName"></strong>
                        <small class="d-block text-muted" data-bind="text: buyerCompanyName"></small>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">@Html.T("Inquiry.Respond.UnitPrice", "Birim Fiyat") *</label>
                    <div class="input-group">
                        <input type="number" step="0.01" class="form-control" data-bind="value: responseForm.unitPrice" />
                        <select class="form-select" style="max-width: 100px;" data-bind="value: responseForm.currency">
                            <option value="TRY">TRY</option>
                            <option value="USD">USD</option>
                            <option value="EUR">EUR</option>
                        </select>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">@Html.T("Inquiry.Respond.Quantity", "Teklif Edilen Miktar") *</label>
                    <div class="input-group">
                        <input type="number" class="form-control" data-bind="value: responseForm.offeredQuantity" />
                        <select class="form-select" style="max-width: 130px;" data-bind="options: units, optionsValue: 'id', optionsText: 'name', value: responseForm.unitId, optionsCaption: 'Birim'"></select>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">@Html.T("Inquiry.Respond.LeadTime", "Teslim Suresi (Gun)")</label>
                    <input type="number" class="form-control" data-bind="value: responseForm.leadTimeDays" />
                </div>
                <div class="mb-3">
                    <label class="form-label">@Html.T("Inquiry.Respond.ValidUntil", "Teklif Gecerlilik")</label>
                    <input type="date" class="form-control" data-bind="value: responseForm.validUntil" />
                </div>
                <div class="mb-3">
                    <label class="form-label">@Html.T("Common.Notes", "Notlar")</label>
                    <textarea class="form-control" rows="3" data-bind="value: responseForm.notes"></textarea>
                </div>
                <div data-bind="visible: responseError" class="alert alert-danger" data-bind="text: responseError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Cancel", "Iptal")</button>
                <button type="button" class="btn btn-success" data-bind="click: submitResponse, disable: isSubmittingResponse">
                    <span data-bind="visible: isSubmittingResponse" class="spinner-border spinner-border-sm me-1"></span>
                    <i class="bi bi-send" data-bind="visible: !isSubmittingResponse()"></i> @Html.T("Inquiry.Respond.Submit", "Teklif Gonder")
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Seller Negotiation Modal -->
<div class="modal fade" id="sellerNegotiationModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">
                    <i class="bi bi-arrow-left-right me-2"></i>Pazarlik Detayi
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Summary -->
                <div class="card bg-light mb-4" data-bind="with: sellerNegotiationSummary">
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-md-3">
                                <div class="fs-4 fw-bold text-primary" data-bind="text: currentRound || 0"></div>
                                <small class="text-muted">Toplam Tur</small>
                            </div>
                            <div class="col-md-3">
                                <div class="fs-4 fw-bold">
                                    <span data-bind="text: originalPrice ? originalPrice.toLocaleString('tr-TR', {minimumFractionDigits: 2}) : '-'"></span>
                                </div>
                                <small class="text-muted">Baslangic Fiyat</small>
                            </div>
                            <div class="col-md-3">
                                <div class="fs-4 fw-bold text-success">
                                    <span data-bind="text: currentPrice ? currentPrice.toLocaleString('tr-TR', {minimumFractionDigits: 2}) : '-'"></span>
                                </div>
                                <small class="text-muted">Guncel Fiyat</small>
                            </div>
                            <div class="col-md-3">
                                <div class="fs-4 fw-bold" data-bind="text: priceChangePercent ? priceChangePercent.toFixed(1) + '%' : '-', css: { 'text-success': priceChangePercent < 0, 'text-danger': priceChangePercent > 0 }"></div>
                                <small class="text-muted">Fiyat Degisimi</small>
                            </div>
                        </div>
                        <!-- Turn indicator -->
                        <div class="mt-3 text-center" data-bind="visible: isNegotiationActive">
                            <div data-bind="visible: isMyTurn" class="alert alert-warning mb-0 py-2">
                                <i class="bi bi-bell-fill me-1"></i>
                                <strong>Sira sizde!</strong> Karsi teklif verin veya kabul/reddedin.
                                <!-- ko if: expiresAt -->
                                <br><small>Kalan sure: <span data-bind="text: $root.formatTimeRemaining(expiresAt)"></span></small>
                                <!-- /ko -->
                            </div>
                            <div data-bind="visible: !isMyTurn" class="alert alert-info mb-0 py-2">
                                <i class="bi bi-hourglass-split me-1"></i>
                                Alicinin yaniti bekleniyor...
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Timeline -->
                <div class="negotiation-timeline" data-bind="with: sellerNegotiationHistory">
                    <!-- Original Proposal -->
                    <div class="timeline-item">
                        <div class="timeline-marker bg-secondary">
                            <i class="bi bi-file-text"></i>
                        </div>
                        <div class="timeline-content">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <strong class="text-secondary">Orijinal Teklifiniz</strong>
                                </div>
                                <small class="text-muted" data-bind="text: createdAt ? new Date(createdAt).toLocaleString('tr-TR') : ''"></small>
                            </div>
                            <div class="mt-2">
                                <span class="fs-5 fw-bold" data-bind="text: originalUnitPrice ? originalUnitPrice.toLocaleString('tr-TR', {minimumFractionDigits: 2}) : '-'"></span>
                                <small class="text-muted" data-bind="text: currency || 'TRY'"></small>
                                <!-- ko if: originalQuantity -->
                                <span class="text-muted mx-2">|</span>
                                <span data-bind="text: originalQuantity"></span> <span data-bind="text: unit || 'adet'"></span>
                                <!-- /ko -->
                            </div>
                        </div>
                    </div>

                    <!-- Negotiation Rounds -->
                    <!-- ko foreach: rounds -->
                    <div class="timeline-item">
                        <div class="timeline-marker" data-bind="css: {
                            'bg-primary': isInitiatorBuyer,
                            'bg-secondary': !isInitiatorBuyer,
                            'bg-success': status === 3,
                            'bg-danger': status === 4
                        }">
                            <i class="bi" data-bind="css: {
                                'bi-chat-dots': status === 1 || status === 2,
                                'bi-check-lg': status === 3,
                                'bi-x-lg': status === 4
                            }"></i>
                        </div>
                        <div class="timeline-content">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <strong data-bind="text: 'Tur ' + roundNumber"></strong>
                                    <span class="badge ms-2" data-bind="text: isInitiatorBuyer ? 'Alici' : 'Siz', css: {
                                        'bg-primary': isInitiatorBuyer,
                                        'bg-secondary': !isInitiatorBuyer
                                    }"></span>
                                    <span class="badge ms-1" data-bind="text: statusName, css: {
                                        'bg-info': status === 1 || status === 2,
                                        'bg-success': status === 3,
                                        'bg-danger': status === 4
                                    }"></span>
                                </div>
                                <small class="text-muted" data-bind="text: createdAt ? new Date(createdAt).toLocaleString('tr-TR') : ''"></small>
                            </div>
                            <div class="mt-2">
                                <!-- ko if: unitPrice -->
                                <span class="fs-5 fw-bold" data-bind="text: unitPrice.toLocaleString('tr-TR', {minimumFractionDigits: 2})"></span>
                                <small class="text-muted" data-bind="text: currency || 'TRY'"></small>
                                <!-- /ko -->
                                <!-- ko if: quantity -->
                                <span class="text-muted mx-2">|</span>
                                <span data-bind="text: quantity"></span> <span data-bind="text: unit || 'adet'"></span>
                                <!-- /ko -->
                            </div>
                            <!-- ko if: notes -->
                            <div class="mt-2 small text-muted">
                                <i class="bi bi-chat-left-text me-1"></i>
                                <span data-bind="text: notes"></span>
                            </div>
                            <!-- /ko -->
                        </div>
                    </div>
                    <!-- /ko -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                <!-- Actions based on turn -->
                <div data-bind="with: sellerNegotiationSummary">
                    <!-- ko if: isNegotiationActive && isMyTurn -->
                    <button type="button" class="btn btn-outline-danger"
                            data-bind="click: function() { $root.rejectSellerNegotiation(); }">
                        <i class="bi bi-x-lg me-1"></i> Reddet
                    </button>
                    <button type="button" class="btn btn-info"
                            data-bind="click: function() { $root.openSellerCounterOfferModal(); }">
                        <i class="bi bi-arrow-repeat me-1"></i> Karsi Teklif
                    </button>
                    <button type="button" class="btn btn-success"
                            data-bind="click: function() { $root.acceptSellerNegotiation(); }">
                        <i class="bi bi-check-lg me-1"></i> Kabul Et
                    </button>
                    <!-- /ko -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Seller Counter Offer Modal -->
<div class="modal fade" id="sellerCounterOfferModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">
                    <i class="bi bi-arrow-repeat me-2"></i>Karsi Teklif Ver
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Current values reference -->
                <div class="alert alert-light mb-4" data-bind="with: sellerNegotiationSummary">
                    <small class="text-muted">Alicinin teklifi:</small>
                    <div class="fs-5 fw-bold">
                        <span data-bind="text: currentPrice ? currentPrice.toLocaleString('tr-TR', {minimumFractionDigits: 2}) : '-'"></span>
                        <small class="text-muted" data-bind="text: currency || 'TRY'"></small>
                    </div>
                </div>

                <form id="sellerCounterOfferForm">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Birim Fiyat *</label>
                            <div class="input-group">
                                <input type="number" class="form-control" step="0.01" min="0"
                                       data-bind="value: sellerCounterOfferForm.unitPrice" required />
                                <select class="form-select" style="max-width: 80px;"
                                        data-bind="value: sellerCounterOfferForm.currency">
                                    <option value="TRY">TRY</option>
                                    <option value="USD">USD</option>
                                    <option value="EUR">EUR</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Toplam Fiyat</label>
                            <div class="input-group">
                                <input type="number" class="form-control" step="0.01" min="0"
                                       data-bind="value: sellerCounterOfferForm.totalPrice" />
                                <span class="input-group-text" data-bind="text: sellerCounterOfferForm.currency"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Miktar</label>
                            <input type="number" class="form-control" min="1"
                                   data-bind="value: sellerCounterOfferForm.quantity" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Teslimat Suresi (gun)</label>
                            <input type="number" class="form-control" min="1"
                                   data-bind="value: sellerCounterOfferForm.leadTimeDays" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Not (Opsiyonel)</label>
                            <textarea class="form-control" rows="2" placeholder="Teklifinizle ilgili aciklama..."
                                      data-bind="value: sellerCounterOfferForm.notes"></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                <button type="button" class="btn btn-info" data-bind="click: submitSellerCounterOffer, enable: !isSubmittingSellerCounter()">
                    <span data-bind="visible: isSubmittingSellerCounter" class="spinner-border spinner-border-sm me-1"></span>
                    <i class="bi bi-send me-1" data-bind="visible: !isSubmittingSellerCounter()"></i>
                    Teklif Gonder
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Seller Negotiation Reject Modal -->
<div class="modal fade" id="sellerNegotiationRejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bi bi-x-circle me-2"></i>Pazarligi Reddet
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Bu pazarligi reddetmek istediginize emin misiniz?</p>
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    Reddettikten sonra bu pazarlik kapanacaktir.
                </div>
                <div class="mb-3">
                    <label class="form-label">Red Nedeni (Opsiyonel)</label>
                    <textarea class="form-control" rows="2" placeholder="Neden reddediyorsunuz..."
                              data-bind="value: sellerNegotiationRejectReason"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                <button type="button" class="btn btn-danger" data-bind="click: confirmSellerRejectNegotiation, enable: !isSubmittingSellerCounter()">
                    <span data-bind="visible: isSubmittingSellerCounter" class="spinner-border spinner-border-sm me-1"></span>
                    Reddet
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Negotiation Timeline Styles */
    .negotiation-timeline {
        position: relative;
        padding-left: 40px;
    }
    .negotiation-timeline::before {
        content: '';
        position: absolute;
        left: 15px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: #dee2e6;
    }
    .timeline-item {
        position: relative;
        padding-bottom: 20px;
    }
    .timeline-item:last-child {
        padding-bottom: 0;
    }
    .timeline-marker {
        position: absolute;
        left: -40px;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 14px;
    }
    .timeline-content {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 12px 16px;
    }
</style>

@section Scripts {
<script src="~/js/Dashboard/SupplierOffers.js"></script>
}
