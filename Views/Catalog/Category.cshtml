@using Bridgo.Extensions
@using Bridgo.DTOs.Catalog
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var categories = ViewBag.Categories as List<CatalogCategoryDto> ?? new List<CatalogCategoryDto>();
    var currentCategory = ViewBag.CurrentCategory as CatalogCategoryDto;
    var breadcrumb = ViewBag.Breadcrumb as List<CategoryBreadcrumbDto> ?? new List<CategoryBreadcrumbDto>();
}

@section Head {
    <link rel="canonical" href="@Url.Action("Category", "Catalog", new { slug = currentCategory?.Slug }, Context.Request.Scheme)" />
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:type" content="website" />
}

<div id="catalog-app" class="container-fluid py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Catalog">@Html.T("Catalog.Title", "Katalog")</a></li>
            @foreach (var crumb in breadcrumb)
            {
                if (crumb.Id == currentCategory?.Id)
                {
                    <li class="breadcrumb-item active" aria-current="page">@crumb.Name</li>
                }
                else
                {
                    <li class="breadcrumb-item"><a href="/Catalog/Category/@crumb.Slug">@crumb.Name</a></li>
                }
            }
        </ol>
    </nav>

    <div class="row">
        <!-- Sidebar: Kategori Agaci -->
        <div class="col-lg-3 col-md-4 d-none d-md-block">
            <div class="card sticky-top" style="top: 80px; max-height: calc(100vh - 100px); overflow-y: auto;">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-grid-3x3-gap"></i>
                        @Html.T("Catalog.Categories", "Kategoriler")
                    </h5>
                </div>
                <div class="card-body p-0" style="max-height: 35vh; overflow-y: auto;">
                    <!-- Tum Urunler -->
                    <a href="/Catalog" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-box-seam me-2"></i>@Html.T("Catalog.AllProducts", "Tum Urunler")</span>
                        <span class="badge bg-primary rounded-pill" data-bind="text: stats().totalProducts"></span>
                    </a>

                    <!-- Kategori Tree -->
                    @foreach (var category in categories)
                    {
                        @await Html.PartialAsync("_CategoryTreeItemActive", new Tuple<CatalogCategoryDto, int?>(category, currentCategory?.Id))
                    }
                </div>

                <!-- Ozellik Filtreleri (Faceted Search) -->
                <div data-bind="visible: facets().length > 0">
                    <div class="card-header bg-light py-2 border-top">
                        <h6 class="mb-0">
                            <i class="bi bi-funnel me-2"></i>
                            @Html.T("Catalog.Filters", "Filtreler")
                        </h6>
                    </div>
                    <div class="card-body p-0">
                        <!-- ko foreach: facets -->
                        <div class="border-bottom">
                            <button class="btn btn-link text-start w-100 py-2 px-3 text-decoration-none collapsed"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bind="attr: { 'data-bs-target': '#facet-' + attributeId, 'aria-controls': 'facet-' + attributeId }">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span>
                                        <!-- ko if: icon -->
                                        <i data-bind="class: 'bi ' + icon + ' me-2'"></i>
                                        <!-- /ko -->
                                        <span data-bind="text: attributeName"></span>
                                    </span>
                                    <i class="bi bi-chevron-down facet-chevron"></i>
                                </div>
                            </button>
                            <div class="collapse" data-bind="attr: { id: 'facet-' + attributeId }">
                                <div class="px-3 pb-2" style="max-height: 180px; overflow-y: auto;">
                                    <!-- ko foreach: values -->
                                    <div class="form-check py-1">
                                        <input class="form-check-input" type="checkbox"
                                               data-bind="attr: { id: 'facet-value-' + valueId },
                                                          checked: $root.selectedAttributeValues,
                                                          checkedValue: valueId" />
                                        <label class="form-check-label d-flex justify-content-between w-100"
                                               data-bind="attr: { for: 'facet-value-' + valueId }">
                                            <span data-bind="text: value"></span>
                                            <span class="badge bg-secondary rounded-pill" data-bind="text: productCount"></span>
                                        </label>
                                    </div>
                                    <!-- /ko -->
                                </div>
                            </div>
                        </div>
                        <!-- /ko -->
                    </div>

                    <!-- Secili Filtre Sayisi -->
                    <div data-bind="visible: selectedAttributeValues().length > 0" class="card-footer bg-light py-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                <span data-bind="text: selectedAttributeValues().length"></span> @Html.T("Catalog.FiltersSelected", "filtre secili")
                            </small>
                            <button class="btn btn-sm btn-outline-secondary" data-bind="click: clearAttributeFilters">
                                <i class="bi bi-x-circle"></i> @Html.T("Common.Clear", "Temizle")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-9 col-md-8">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-1">
                        @if (!string.IsNullOrEmpty(currentCategory?.Icon))
                        {
                            <i class="bi @currentCategory.Icon text-primary"></i>
                        }
                        else
                        {
                            <i class="bi bi-folder text-primary"></i>
                        }
                        @currentCategory?.Name
                    </h1>
                    <p class="text-muted mb-0" data-bind="visible: result().totalCount > 0">
                        <span data-bind="text: result().totalCount"></span> @Html.T("Catalog.ProductsFound", "urun bulundu")
                    </p>
                </div>
                <div class="d-flex gap-2">
                    <!-- Gorunum Toggle -->
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-secondary" data-bind="css: { active: viewMode() === 'grid' }, click: function() { viewMode('grid'); }">
                            <i class="bi bi-grid-3x3-gap"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary" data-bind="css: { active: viewMode() === 'list' }, click: function() { viewMode('list'); }">
                            <i class="bi bi-list-ul"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Filters Bar -->
            <div class="card mb-4">
                <div class="card-body">
                    <div class="row g-3">
                        <!-- Arama -->
                        <div class="col-md-5">
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control"
                                       placeholder="@Html.T("Catalog.SearchPlaceholder", "Urun adi, marka, SKU...")"
                                       data-bind="value: filter.search, valueUpdate: 'afterkeydown'" />
                            </div>
                        </div>

                        <!-- Siralama -->
                        <div class="col-md-3">
                            <select class="form-select" data-bind="value: filter.sortBy">
                                <option value="newest">@Html.T("Catalog.Sort.Newest", "En Yeniler")</option>
                                <option value="price_asc">@Html.T("Catalog.Sort.PriceAsc", "Fiyat: Dusukten Yuksege")</option>
                                <option value="price_desc">@Html.T("Catalog.Sort.PriceDesc", "Fiyat: Yuksekten Dusuge")</option>
                                <option value="name">@Html.T("Catalog.Sort.Name", "Isme Gore")</option>
                                <option value="popular">@Html.T("Catalog.Sort.Popular", "Populer")</option>
                            </select>
                        </div>

                        <!-- Stok Durumu -->
                        <div class="col-md-2">
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" id="inStockFilter" data-bind="checked: filter.inStock">
                                <label class="form-check-label" for="inStockFilter">
                                    @Html.T("Catalog.Filter.InStock", "Stokta Var")
                                </label>
                            </div>
                        </div>

                        <!-- Sifirla -->
                        <div class="col-md-auto">
                            <button class="btn btn-outline-secondary" data-bind="click: resetFilters, visible: hasActiveFilters">
                                <i class="bi bi-x-circle"></i> @Html.T("Common.Reset", "Sifirla")
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Loading -->
            <div data-bind="visible: isLoading" class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">@Html.T("Common.Loading", "Yukleniyor...")</span>
                </div>
            </div>

            <!-- Empty State -->
            <div data-bind="visible: !isLoading() && result().products.length === 0" class="text-center py-5">
                <i class="bi bi-inbox display-1 text-muted"></i>
                <h4 class="mt-3">@Html.T("Catalog.NoProducts", "Urun bulunamadi")</h4>
                <p class="text-muted">@Html.T("Catalog.NoProductsInCategory", "Bu kategoride urun yok.")</p>
                <a href="/Catalog" class="btn btn-outline-primary">
                    <i class="bi bi-arrow-left"></i> @Html.T("Catalog.BackToCatalog", "Kataloga Don")
                </a>
            </div>

            <!-- Grid View -->
            <div data-bind="visible: !isLoading() && viewMode() === 'grid'" class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
                <!-- ko foreach: result().products -->
                <div class="col">
                    <div class="card h-100 product-card">
                        <!-- Gorsel -->
                        <a data-bind="attr: { href: '/Catalog/' + slug }">
                            <div class="ratio ratio-1x1 bg-light">
                                <!-- ko if: mainImageUrl -->
                                <img data-bind="attr: { src: mainImageUrl, alt: name }" class="card-img-top object-fit-cover" loading="lazy">
                                <!-- /ko -->
                                <!-- ko ifnot: mainImageUrl -->
                                <div class="d-flex align-items-center justify-content-center">
                                    <i class="bi bi-image display-4 text-muted"></i>
                                </div>
                                <!-- /ko -->
                            </div>
                        </a>

                        <!-- Badges -->
                        <div class="position-absolute top-0 start-0 p-2">
                            <!-- ko if: isFeatured -->
                            <span class="badge bg-warning text-dark"><i class="bi bi-star-fill"></i></span>
                            <!-- /ko -->
                        </div>

                        <!-- Stok Durumu -->
                        <div class="position-absolute top-0 end-0 p-2">
                            <!-- ko ifnot: inStock -->
                            <span class="badge bg-secondary">@Html.T("Catalog.OutOfStock", "Stokta Yok")</span>
                            <!-- /ko -->
                        </div>

                        <div class="card-body d-flex flex-column">
                            <!-- Urun Adi -->
                            <h6 class="card-title mt-1 mb-2">
                                <a data-bind="attr: { href: '/Catalog/' + slug }, text: name" class="text-decoration-none text-dark stretched-link"></a>
                            </h6>

                            <!-- Kisa Aciklama -->
                            <p class="card-text text-muted small flex-grow-1" data-bind="text: shortDescription ? shortDescription.substring(0, 80) + '...' : ''"></p>

                            <!-- Fiyat -->
                            <div class="mt-auto">
                                <!-- ko if: compareAtPrice && compareAtPrice > price -->
                                <small class="text-muted text-decoration-line-through" data-bind="text: $parent.formatPrice(compareAtPrice, currency)"></small>
                                <!-- /ko -->
                                <div class="fw-bold text-primary" data-bind="text: $parent.formatPrice(price, currency)"></div>
                                <!-- ko if: minBulkPrice && minBulkQuantity -->
                                <small class="text-success">
                                    <i class="bi bi-tags"></i>
                                    <span data-bind="text: minBulkQuantity + '+ adet: ' + $parent.formatPrice(minBulkPrice, currency)"></span>
                                </small>
                                <!-- /ko -->
                            </div>

                            <!-- Satici -->
                            <div class="mt-2 pt-2 border-top">
                                <small class="text-muted">
                                    <i class="bi bi-shop"></i>
                                    <span data-bind="text: vendorName"></span>
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- /ko -->
            </div>

            <!-- List View -->
            <div data-bind="visible: !isLoading() && viewMode() === 'list'" class="d-flex flex-column gap-3">
                <!-- ko foreach: result().products -->
                <div class="card product-card-list">
                    <div class="row g-0">
                        <!-- Gorsel -->
                        <div class="col-md-3">
                            <a data-bind="attr: { href: '/Catalog/' + slug }">
                                <div class="ratio ratio-4x3 bg-light h-100">
                                    <!-- ko if: mainImageUrl -->
                                    <img data-bind="attr: { src: mainImageUrl, alt: name }" class="object-fit-cover rounded-start" loading="lazy">
                                    <!-- /ko -->
                                    <!-- ko ifnot: mainImageUrl -->
                                    <div class="d-flex align-items-center justify-content-center">
                                        <i class="bi bi-image display-4 text-muted"></i>
                                    </div>
                                    <!-- /ko -->
                                </div>
                            </a>
                        </div>

                        <!-- Detay -->
                        <div class="col-md-9">
                            <div class="card-body h-100 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h5 class="card-title mb-1">
                                            <a data-bind="attr: { href: '/Catalog/' + slug }, text: name" class="text-decoration-none text-dark"></a>
                                        </h5>
                                        <small class="text-muted">
                                            <i class="bi bi-shop"></i>
                                            <span data-bind="text: vendorName"></span>
                                        </small>
                                    </div>
                                    <div class="text-end">
                                        <!-- ko if: compareAtPrice && compareAtPrice > price -->
                                        <small class="text-muted text-decoration-line-through d-block" data-bind="text: $parent.formatPrice(compareAtPrice, currency)"></small>
                                        <!-- /ko -->
                                        <span class="fs-5 fw-bold text-primary" data-bind="text: $parent.formatPrice(price, currency)"></span>
                                    </div>
                                </div>

                                <p class="card-text text-muted mt-2 flex-grow-1" data-bind="text: shortDescription"></p>

                                <div class="d-flex justify-content-between align-items-center mt-auto">
                                    <div>
                                        <!-- ko if: inStock -->
                                        <span class="badge bg-success">@Html.T("Catalog.InStock", "Stokta")</span>
                                        <!-- /ko -->
                                        <!-- ko ifnot: inStock -->
                                        <span class="badge bg-secondary">@Html.T("Catalog.OutOfStock", "Stokta Yok")</span>
                                        <!-- /ko -->
                                    </div>
                                    <a data-bind="attr: { href: '/Catalog/' + slug }" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-eye"></i> @Html.T("Common.ViewDetail", "Detay")
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- /ko -->
            </div>

            <!-- Pagination -->
            <nav data-bind="visible: result().totalPages > 1" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item" data-bind="css: { disabled: filter.page() <= 1 }">
                        <a class="page-link" href="#" data-bind="click: prevPage">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    <!-- ko foreach: pageNumbers -->
                    <li class="page-item" data-bind="css: { active: $data === $parent.filter.page() }">
                        <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                    </li>
                    <!-- /ko -->
                    <li class="page-item" data-bind="css: { disabled: filter.page() >= result().totalPages }">
                        <a class="page-link" href="#" data-bind="click: nextPage">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<style>
    .product-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }
    .product-card-list:hover {
        box-shadow: 0 0.25rem 0.5rem rgba(0, 0, 0, 0.1);
    }
    .list-group-item.active {
        background-color: var(--bs-primary);
        border-color: var(--bs-primary);
    }
    /* Facet styles */
    .facet-chevron {
        transition: transform 0.2s ease;
    }
    [data-bs-toggle="collapse"]:not(.collapsed) .facet-chevron {
        transform: rotate(180deg);
    }
    .form-check-label {
        cursor: pointer;
    }
</style>

@section Scripts {
    <script>
        var catalogConfig = {
            initialSearch: '',
            initialCategoryId: null,
            initialSort: 'newest',
            vendorSlug: '',
            categorySlug: '@currentCategory?.Slug'
        };
    </script>
    <script src="~/js/Catalog/Category.js" asp-append-version="true"></script>
}
