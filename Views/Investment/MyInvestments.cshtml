@{
    ViewData["Title"] = "Yatirimlarim";
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
}

<div id="my-investments-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1"><i class="bi bi-wallet2 text-success"></i> Yatirimlarim</h4>
            <p class="text-muted mb-0">Kabul edilen yatirimlarinizi takip edin</p>
        </div>
        <a href="/Investment/Opportunities" class="btn btn-outline-success">
            <i class="bi bi-plus-circle"></i> Yeni Yatirim Yap
        </a>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4" data-bind="with: stats">
        <div class="col-md-3 col-6 mb-3">
            <div class="card border-0 bg-success bg-opacity-10">
                <div class="card-body text-center">
                    <h3 class="mb-0 text-success" data-bind="text: activeCount">0</h3>
                    <small class="text-muted">Aktif Yatirim</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-3">
            <div class="card border-0 bg-primary bg-opacity-10">
                <div class="card-body text-center">
                    <h3 class="mb-0 text-primary">
                        <span data-bind="text: activeTotalAmount().toLocaleString('tr-TR')">0</span>
                        <small class="fs-6">TRY</small>
                    </h3>
                    <small class="text-muted">Toplam Yatirim</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-3">
            <div class="card border-0 bg-info bg-opacity-10">
                <div class="card-body text-center">
                    <h3 class="mb-0 text-info">
                        <span data-bind="text: activeExpectedReturn().toLocaleString('tr-TR')">0</span>
                        <small class="fs-6">TRY</small>
                    </h3>
                    <small class="text-muted">Beklenen Getiri</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-3">
            <div class="card border-0 bg-secondary bg-opacity-10">
                <div class="card-body text-center">
                    <h3 class="mb-0 text-secondary" data-bind="text: completedCount">0</h3>
                    <small class="text-muted">Tamamlanan</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#active"
               data-bind="css: { active: currentTab() === 'active' }, click: function() { currentTab('active'); }">
                <i class="bi bi-clock-history"></i> Aktif Yatirimlar
                <span class="badge bg-success ms-1" data-bind="text: activeInvestments().length, visible: activeInvestments().length > 0"></span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#completed"
               data-bind="css: { active: currentTab() === 'completed' }, click: function() { currentTab('completed'); }">
                <i class="bi bi-check-circle"></i> Tamamlanan
                <span class="badge bg-secondary ms-1" data-bind="text: completedInvestments().length, visible: completedInvestments().length > 0"></span>
            </a>
        </li>
    </ul>

    <!-- Active Investments Tab -->
    <div data-bind="visible: currentTab() === 'active'">
        <!-- Loading -->
        <div data-bind="visible: isLoading()" class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-2 text-muted">Yukleniyor...</p>
        </div>

        <!-- Empty State -->
        <div data-bind="visible: !isLoading() && activeInvestments().length === 0" class="text-center py-5">
            <i class="bi bi-wallet2 display-1 text-muted"></i>
            <p class="mt-3 text-muted">Aktif yatiriminiz bulunmuyor</p>
            <a href="/Investment/Opportunities" class="btn btn-success">
                <i class="bi bi-search"></i> Firsatlari Incele
            </a>
        </div>

        <!-- Investment Cards -->
        <div class="row" data-bind="foreach: activeInvestments">
            <div class="col-lg-6 mb-3">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge" data-bind="text: request.financingTypeName, css: request.financingTypeCss || 'bg-primary'"></span>
                            <span class="badge ms-1" data-bind="text: statusName, css: statusCss"></span>
                        </div>
                        <small class="text-muted" data-bind="text: responseDate ? new Date(responseDate).toLocaleDateString('tr-TR') : ''"></small>
                    </div>
                    <div class="card-body">
                        <h6 class="card-title mb-1" data-bind="text: request.title"></h6>
                        <small class="text-muted d-block mb-3">
                            <i class="bi bi-building"></i> <span data-bind="text: request.requesterCompanyName"></span>
                        </small>

                        <!-- Amount Info -->
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <small class="text-muted d-block">Yatirim Tutari</small>
                                <strong class="text-primary fs-5">
                                    <span data-bind="text: offeredAmount.toLocaleString('tr-TR')"></span>
                                    <small data-bind="text: request.currency"></small>
                                </strong>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block">Toplam Geri Odeme</small>
                                <strong class="text-success fs-5">
                                    <span data-bind="text: totalRepaymentAmount.toLocaleString('tr-TR')"></span>
                                    <small data-bind="text: request.currency"></small>
                                </strong>
                            </div>
                        </div>

                        <!-- Interest & Duration -->
                        <div class="row g-2 mb-3">
                            <div class="col-4">
                                <small class="text-muted d-block">Faiz Orani</small>
                                <strong>%<span data-bind="text: interestRate"></span>/ay</strong>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">Vade</small>
                                <strong><span data-bind="text: request.durationDays"></span> gun</strong>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">Kalan</small>
                                <strong data-bind="css: { 'text-warning': daysRemaining <= 7 && daysRemaining > 0, 'text-danger': daysRemaining === 0 }">
                                    <span data-bind="text: daysRemaining"></span> gun
                                </strong>
                            </div>
                        </div>

                        <!-- Expected Profit -->
                        <div class="alert alert-success py-2 mb-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted">Beklenen Kazanc:</span>
                                <strong class="text-success">
                                    +<span data-bind="text: interestAmount.toLocaleString('tr-TR')"></span>
                                    <span data-bind="text: request.currency"></span>
                                </strong>
                            </div>
                        </div>

                        <!-- Status Indicators -->
                        <div class="border-top pt-3">
                            <div class="d-flex align-items-center mb-2">
                                <!-- ko if: isFundTransferred -->
                                <i class="bi bi-check-circle-fill text-success me-2"></i>
                                <span class="text-success">Transfer Tamamlandi</span>
                                <small class="text-muted ms-2" data-bind="text: fundTransferDate ? '(' + new Date(fundTransferDate).toLocaleDateString('tr-TR') + ')' : ''"></small>
                                <!-- /ko -->
                                <!-- ko ifnot: isFundTransferred -->
                                <i class="bi bi-clock text-warning me-2"></i>
                                <span class="text-warning">Transfer Bekleniyor</span>
                                <!-- /ko -->
                            </div>
                            <div class="d-flex align-items-center">
                                <!-- ko if: isRepaid -->
                                <i class="bi bi-check-circle-fill text-success me-2"></i>
                                <span class="text-success">Geri Odeme Tamamlandi</span>
                                <!-- /ko -->
                                <!-- ko ifnot: isRepaid -->
                                <i class="bi bi-hourglass-split text-info me-2"></i>
                                <span class="text-info">Geri Odeme Bekleniyor</span>
                                <small class="text-muted ms-2" data-bind="text: expectedRepaymentDate ? '(' + new Date(expectedRepaymentDate).toLocaleDateString('tr-TR') + ')' : ''"></small>
                                <!-- /ko -->
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent">
                        <button class="btn btn-sm btn-outline-primary" data-bind="click: $parent.viewDetail">
                            <i class="bi bi-eye"></i> Detay
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Completed Investments Tab -->
    <div data-bind="visible: currentTab() === 'completed'">
        <!-- Loading -->
        <div data-bind="visible: isLoading()" class="text-center py-5">
            <div class="spinner-border text-primary"></div>
        </div>

        <!-- Empty State -->
        <div data-bind="visible: !isLoading() && completedInvestments().length === 0" class="text-center py-5">
            <i class="bi bi-check-circle display-1 text-muted"></i>
            <p class="mt-3 text-muted">Tamamlanan yatiriminiz bulunmuyor</p>
        </div>

        <!-- Completed Investments Table -->
        <div class="table-responsive" data-bind="visible: completedInvestments().length > 0">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Talep</th>
                        <th>Tip</th>
                        <th>Yatirim</th>
                        <th>Geri Odeme</th>
                        <th>Kazanc</th>
                        <th>Odeme Tarihi</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody data-bind="foreach: completedInvestments">
                    <tr>
                        <td>
                            <strong data-bind="text: request.title"></strong>
                            <br /><small class="text-muted" data-bind="text: request.requesterCompanyName"></small>
                        </td>
                        <td>
                            <span class="badge" data-bind="text: request.financingTypeName, css: request.financingTypeCss || 'bg-primary'"></span>
                        </td>
                        <td>
                            <strong data-bind="text: offeredAmount.toLocaleString('tr-TR')"></strong>
                            <span data-bind="text: request.currency"></span>
                        </td>
                        <td>
                            <span data-bind="text: totalRepaymentAmount.toLocaleString('tr-TR')"></span>
                            <span data-bind="text: request.currency"></span>
                        </td>
                        <td class="text-success">
                            +<span data-bind="text: interestAmount.toLocaleString('tr-TR')"></span>
                            <span data-bind="text: request.currency"></span>
                        </td>
                        <td data-bind="text: repaymentDate ? new Date(repaymentDate).toLocaleDateString('tr-TR') : '-'"></td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary" data-bind="click: $parent.viewDetail" title="Detay">
                                <i class="bi bi-eye"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Detail Modal -->
    <div class="modal fade" id="detailModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-info-circle"></i> Yatirim Detayi</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" data-bind="with: selectedInvestment">
                    <!-- Header -->
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h5 class="mb-1" data-bind="text: request.title"></h5>
                            <span class="text-muted" data-bind="text: request.requesterCompanyName"></span>
                        </div>
                        <span class="badge fs-6" data-bind="text: request.financingTypeName, css: request.financingTypeCss || 'bg-primary'"></span>
                    </div>

                    <hr />

                    <!-- Financial Summary -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center py-3">
                                    <small class="text-muted d-block">Yatirim Tutari</small>
                                    <h4 class="mb-0 text-primary">
                                        <span data-bind="text: offeredAmount.toLocaleString('tr-TR')"></span>
                                        <small data-bind="text: request.currency"></small>
                                    </h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center py-3">
                                    <small class="text-muted d-block">Faiz Orani</small>
                                    <h4 class="mb-0">%<span data-bind="text: interestRate"></span>/ay</h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-success bg-opacity-10">
                                <div class="card-body text-center py-3">
                                    <small class="text-muted d-block">Toplam Geri Odeme</small>
                                    <h4 class="mb-0 text-success">
                                        <span data-bind="text: totalRepaymentAmount.toLocaleString('tr-TR')"></span>
                                        <small data-bind="text: request.currency"></small>
                                    </h4>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Timeline -->
                    <h6 class="mb-3"><i class="bi bi-clock-history"></i> Zaman Cizelgesi</h6>
                    <div class="timeline mb-4">
                        <!-- Teklif -->
                        <div class="d-flex mb-3">
                            <div class="me-3">
                                <div class="rounded-circle bg-success d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                    <i class="bi bi-send-check text-white small"></i>
                                </div>
                            </div>
                            <div>
                                <strong>Teklif Verildi</strong>
                                <small class="text-muted d-block" data-bind="text: new Date(createdAt).toLocaleDateString('tr-TR')"></small>
                            </div>
                        </div>

                        <!-- Kabul -->
                        <div class="d-flex mb-3" data-bind="visible: responseDate">
                            <div class="me-3">
                                <div class="rounded-circle bg-success d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                    <i class="bi bi-check-lg text-white small"></i>
                                </div>
                            </div>
                            <div>
                                <strong>Teklif Kabul Edildi</strong>
                                <small class="text-muted d-block" data-bind="text: responseDate ? new Date(responseDate).toLocaleDateString('tr-TR') : ''"></small>
                            </div>
                        </div>

                        <!-- Transfer -->
                        <div class="d-flex mb-3">
                            <div class="me-3">
                                <!-- ko if: isFundTransferred -->
                                <div class="rounded-circle bg-success d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                    <i class="bi bi-arrow-right text-white small"></i>
                                </div>
                                <!-- /ko -->
                                <!-- ko ifnot: isFundTransferred -->
                                <div class="rounded-circle bg-warning d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                    <i class="bi bi-clock text-white small"></i>
                                </div>
                                <!-- /ko -->
                            </div>
                            <div>
                                <strong data-bind="css: { 'text-success': isFundTransferred, 'text-warning': !isFundTransferred }">
                                    <!-- ko if: isFundTransferred -->Transfer Tamamlandi<!-- /ko -->
                                    <!-- ko ifnot: isFundTransferred -->Transfer Bekleniyor<!-- /ko -->
                                </strong>
                                <!-- ko if: isFundTransferred -->
                                <small class="text-muted d-block" data-bind="text: fundTransferDate ? new Date(fundTransferDate).toLocaleDateString('tr-TR') : ''"></small>
                                <!-- ko if: transferReference -->
                                <small class="text-muted">Ref: <span data-bind="text: transferReference"></span></small>
                                <!-- /ko -->
                                <!-- /ko -->
                            </div>
                        </div>

                        <!-- Geri Odeme -->
                        <div class="d-flex">
                            <div class="me-3">
                                <!-- ko if: isRepaid -->
                                <div class="rounded-circle bg-success d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                    <i class="bi bi-check-all text-white small"></i>
                                </div>
                                <!-- /ko -->
                                <!-- ko ifnot: isRepaid -->
                                <div class="rounded-circle bg-secondary bg-opacity-50 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                    <i class="bi bi-hourglass-split text-white small"></i>
                                </div>
                                <!-- /ko -->
                            </div>
                            <div>
                                <strong data-bind="css: { 'text-success': isRepaid, 'text-muted': !isRepaid }">
                                    <!-- ko if: isRepaid -->Geri Odeme Tamamlandi<!-- /ko -->
                                    <!-- ko ifnot: isRepaid -->Geri Odeme Bekleniyor<!-- /ko -->
                                </strong>
                                <!-- ko if: isRepaid -->
                                <small class="text-muted d-block" data-bind="text: repaymentDate ? new Date(repaymentDate).toLocaleDateString('tr-TR') : ''"></small>
                                <!-- ko if: repaymentReference -->
                                <small class="text-muted">Ref: <span data-bind="text: repaymentReference"></span></small>
                                <!-- /ko -->
                                <!-- /ko -->
                                <!-- ko ifnot: isRepaid -->
                                <small class="text-muted d-block">
                                    Beklenen: <span data-bind="text: expectedRepaymentDate ? new Date(expectedRepaymentDate).toLocaleDateString('tr-TR') : '-'"></span>
                                    (<span data-bind="text: daysRemaining"></span> gun kaldi)
                                </small>
                                <!-- /ko -->
                            </div>
                        </div>
                    </div>

                    <!-- Request Details -->
                    <h6 class="mb-3"><i class="bi bi-file-text"></i> Talep Detaylari</h6>
                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <small class="text-muted d-block">Talep Edilen Tutar</small>
                            <strong>
                                <span data-bind="text: request.requestedAmount.toLocaleString('tr-TR')"></span>
                                <span data-bind="text: request.currency"></span>
                            </strong>
                        </div>
                        <div class="col-md-4">
                            <small class="text-muted d-block">Vade</small>
                            <strong><span data-bind="text: request.durationDays"></span> gun</strong>
                        </div>
                        <div class="col-md-4" data-bind="visible: request.riskScore">
                            <small class="text-muted d-block">Risk Skoru</small>
                            <strong data-bind="text: request.riskScore, css: $parent.getRiskScoreCss(request.riskScore)"></strong>
                        </div>
                    </div>

                    <!-- Collateral -->
                    <div data-bind="visible: request.collateralTypeName" class="alert alert-light">
                        <i class="bi bi-shield-check"></i> <strong>Teminat:</strong> <span data-bind="text: request.collateralTypeName"></span>
                    </div>

                    <!-- Notes -->
                    <div data-bind="visible: notes" class="mt-3">
                        <small class="text-muted d-block">Teklif Notlari</small>
                        <p class="mb-0" data-bind="text: notes"></p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Dashboard/MyInvestments.js" asp-append-version="true"></script>
}
