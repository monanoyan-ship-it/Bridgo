@{
    ViewData["Title"] = Html.T("Products.Title", "Urunler").ToString();
    Layout = "~/Views/Dashboard/_DashboardLayout.cshtml";
}

<div id="products-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1"><i class="bi bi-box-seam me-2"></i>@Html.T("Products.Title", "Urunler")</h4>
            <p class="text-muted mb-0">@Html.T("Products.Description", "Urunlerinizi yonetin ve stok takibi yapin")</p>
        </div>
        <button class="btn btn-primary" data-bind="click: openProductModal">
            <i class="bi bi-plus-lg"></i> @Html.T("Products.AddProduct", "Urun Ekle")
        </button>
    </div>

    <!-- Error Message -->
    <div data-bind="visible: errorMessage" class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i>
        <span data-bind="text: errorMessage"></span>
        <button type="button" class="btn-close" data-bind="click: function() { errorMessage(''); }"></button>
    </div>

    <!-- Products List -->
        <!-- Filters -->
        <div class="card mb-4">
            <div class="card-body py-3">
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <input type="text" class="form-control" placeholder="@Html.T("Products.Search.Placeholder", "Urun ara (isim, SKU, barkod)...")"
                               data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
                    </div>
                    <div class="col-md-2">
                        <select class="form-select" data-bind="value: filterCategory">
                            <option value="">@Html.T("Products.Filter.AllCategories", "Tum Kategoriler")</option>
                            <!-- ko foreach: categoriesForSelect -->
                            <option data-bind="value: id, text: displayName"></option>
                            <!-- /ko -->
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select" data-bind="value: filterStatus">
                            <option value="">@Html.T("Products.Filter.AllStatuses", "Tum Durumlar")</option>
                            <!-- ko foreach: productStatuses -->
                            <option data-bind="value: id, text: name"></option>
                            <!-- /ko -->
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select" data-bind="value: filterInStock">
                            <option value="">@Html.T("Products.Filter.AllStock", "Tum Stok")</option>
                            <option value="true">@Html.T("Products.Filter.InStock", "Stokta Var")</option>
                            <option value="false">@Html.T("Products.Filter.OutOfStock", "Stokta Yok")</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-outline-secondary w-100" data-bind="click: resetFilters">
                            <i class="bi bi-x-circle"></i> @Html.T("Common.Reset", "Sifirla")
                        </button>
                    </div>
                    <div class="col-md-1">
                        <button class="btn btn-primary w-100" data-bind="click: loadProducts">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bulk Actions -->
        <div data-bind="visible: selectedProducts().length > 0" class="mb-3">
            <div class="alert alert-info py-2 d-flex align-items-center justify-content-between">
                <span>
                    <strong data-bind="text: selectedProducts().length"></strong> @Html.T("Products.Selected", "urun secildi")
                </span>
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-success" data-bind="click: function() { bulkUpdateStatus(1); }">
                        <i class="bi bi-check-circle"></i> @Html.T("Products.BulkActivate", "Aktif Yap")
                    </button>
                    <button class="btn btn-outline-warning" data-bind="click: function() { bulkUpdateStatus(2); }">
                        <i class="bi bi-pause-circle"></i> @Html.T("Products.BulkDeactivate", "Pasif Yap")
                    </button>
                    <button class="btn btn-outline-danger btn-gap" data-bind="click: bulkDelete">
                        <i class="bi bi-trash"></i> @Html.T("Products.BulkDelete", "Sil")
                    </button>
                </div>
            </div>
        </div>

        <!-- Loading -->
        <div data-bind="visible: isLoading" class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-2 text-muted">@Html.T("Common.Loading", "Yukleniyor...")</p>
        </div>

        <!-- Product List -->
        <div data-bind="visible: !isLoading()">
            <div data-bind="visible: products().length === 0" class="text-center py-5">
                <i class="bi bi-box-seam text-muted" style="font-size: 3rem;"></i>
                <p class="mt-3 text-muted">@Html.T("Products.Empty", "Henuz urun eklenmemis")</p>
                <button class="btn btn-primary" data-bind="click: openProductModal">
                    <i class="bi bi-plus-lg"></i> @Html.T("Products.AddFirstProduct", "Ilk Urunu Ekle")
                </button>
            </div>

            <div class="table-responsive" data-bind="visible: products().length > 0">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 40px;">
                                <input type="checkbox" class="form-check-input"
                                       data-bind="checked: allSelected, click: toggleSelectAll" />
                            </th>
                            <th style="width: 60px;">@Html.T("Products.Table.Image", "Gorsel")</th>
                            <th>@Html.T("Products.Table.Name", "Urun Adi")</th>
                            <th>@Html.T("Products.Table.SKU", "SKU")</th>
                            <th>@Html.T("Products.Table.Category", "Kategori")</th>
                            <th class="text-end">@Html.T("Products.Table.Price", "Fiyat")</th>
                            <th class="text-center">@Html.T("Products.Table.Stock", "Stok")</th>
                            <th>@Html.T("Products.Table.Status", "Durum")</th>
                            <th style="width: 120px;"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: products">
                        <tr>
                            <td>
                                <input type="checkbox" class="form-check-input"
                                       data-bind="checked: $parent.selectedProducts, checkedValue: id" />
                            </td>
                            <td>
                                <!-- ko if: mainImageUrl -->
                                <img data-bind="attr: { src: mainImageUrl, alt: name }" class="rounded" style="width: 50px; height: 50px; object-fit: cover;" />
                                <!-- /ko -->
                                <!-- ko ifnot: mainImageUrl -->
                                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                    <i class="bi bi-image text-muted"></i>
                                </div>
                                <!-- /ko -->
                            </td>
                            <td>
                                <div class="fw-medium" data-bind="text: name"></div>
                                <small class="text-muted" data-bind="visible: barcode, text: barcode"></small>
                            </td>
                            <td>
                                <code data-bind="text: sku || '-'"></code>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark" data-bind="text: categoryName || '@Html.T("Products.NoCategory", "Kategorisiz")'"></span>
                            </td>
                            <td class="text-end">
                                <span data-bind="text: priceFormatted" class="fw-medium"></span>
                            </td>
                            <td class="text-center">
                                <span data-bind="text: stockQuantity, css: stockBadgeClass" class="badge"></span>
                            </td>
                            <td>
                                <span class="badge" data-bind="text: statusText, css: statusBadgeClass"></span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary" title="@Html.T("Common.Edit", "Duzenle")"
                                            data-bind="click: function() { $parent.editProduct($data); }">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-secondary" title="@Html.T("Products.ManageImages", "Gorseller")"
                                            data-bind="click: function() { $parent.openImageModal($data); }">
                                        <i class="bi bi-images"></i>
                                    </button>
                                    <button class="btn btn-outline-info" title="@Html.T("Products.ManageStock", "Stok Yonetimi")"
                                            data-bind="click: function() { $parent.openStockModal($data); }">
                                        <i class="bi bi-box-seam"></i>
                                    </button>
                                    <button class="btn btn-outline-danger btn-gap" title="@Html.T("Common.Delete", "Sil")"
                                            data-bind="click: function() { $parent.deleteProduct($data); }">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    <!-- Product Modal -->
    <div class="modal fade" data-bind="css: { show: showProductModal }, style: { display: showProductModal() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <form data-bind="submit: saveProduct">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="bi bi-box-seam"></i>
                            <span data-bind="text: editingProductId() ? '@Html.T("Products.EditProduct", "Urunu Duzenle")' : '@Html.T("Products.AddProduct", "Urun Ekle")'"></span>
                        </h5>
                        <button type="button" class="btn-close" data-bind="click: closeProductModal"></button>
                    </div>
                    <div class="modal-body">
                        <ul class="nav nav-tabs mb-3" role="tablist">
                            <li class="nav-item">
                                <button type="button" class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-general">
                                    @Html.T("Products.Tab.General", "Genel")
                                </button>
                            </li>
                            <li class="nav-item">
                                <button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-pricing">
                                    @Html.T("Products.Tab.Pricing", "Fiyat")
                                </button>
                            </li>
                            <li class="nav-item">
                                <button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-price-tiers" data-bind="visible: editingProductId()">
                                    @Html.T("Products.Tab.PriceTiers", "Fiyat Esikleri")
                                </button>
                            </li>
                            <li class="nav-item">
                                <button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-stock">
                                    @Html.T("Products.Tab.Stock", "Stok")
                                </button>
                            </li>
                            <li class="nav-item">
                                <button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-physical">
                                    @Html.T("Products.Tab.Physical", "Fiziksel")
                                </button>
                            </li>
                            <li class="nav-item">
                                <button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-seo">
                                    @Html.T("Products.Tab.SEO", "SEO")
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content">
                            <!-- General Tab -->
                            <div class="tab-pane fade show active" id="tab-general">
                                <div class="row">
                                    <div class="col-md-8">
                                        <div class="mb-3">
                                            <label class="form-label">@Html.T("Products.Field.Name", "Urun Adi") <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" data-bind="value: productForm().name" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">@Html.T("Products.Field.ShortDescription", "Kisa Aciklama")</label>
                                            <input type="text" class="form-control" data-bind="value: productForm().shortDescription" maxlength="500" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">@Html.T("Products.Field.Description", "Detayli Aciklama")</label>
                                            <textarea class="form-control" rows="4" data-bind="value: productForm().description"></textarea>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">@Html.T("Products.Field.SKU", "Stok Kodu (SKU)")</label>
                                            <input type="text" class="form-control" data-bind="value: productForm().sku" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">@Html.T("Products.Field.Barcode", "Barkod")</label>
                                            <input type="text" class="form-control" data-bind="value: productForm().barcode" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">@Html.T("Products.Field.Category", "Kategori")</label>
                                            <select class="form-select" data-bind="value: productForm().categoryId">
                                                <option value="">@Html.T("Products.SelectCategory", "Kategori Secin")</option>
                                                <!-- ko foreach: categoriesForSelect -->
                                                <option data-bind="value: id, text: displayName"></option>
                                                <!-- /ko -->
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">@Html.T("Products.Field.Tags", "Etiketler")</label>
                                            <input type="text" class="form-control" data-bind="value: productForm().tags" placeholder="@Html.T("Products.Tags.Placeholder", "Virgul ile ayirin")" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">@Html.T("Products.Field.Status", "Durum")</label>
                                            <select class="form-select" data-bind="value: productForm().status, options: productStatuses, optionsValue: 'id', optionsText: 'name'"></select>
                                        </div>
                                        <div class="form-check mb-3">
                                            <input type="checkbox" class="form-check-input" data-bind="checked: productForm().isFeatured" id="isFeatured" />
                                            <label class="form-check-label" for="isFeatured">@Html.T("Products.Field.IsFeatured", "One Cikan Urun")</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Pricing Tab -->
                            <div class="tab-pane fade" id="tab-pricing">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">@Html.T("Products.Field.Price", "Satis Fiyati") <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <input type="number" step="0.01" min="0" class="form-control" data-bind="value: productForm().price" required />
                                                <select class="form-select" style="max-width: 100px;" data-bind="value: productForm().currency">
                                                    <option value="TRY">TRY</option>
                                                    <option value="USD">USD</option>
                                                    <option value="EUR">EUR</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">@Html.T("Products.Field.CompareAtPrice", "Karsilastirma Fiyati")</label>
                                            <input type="number" step="0.01" min="0" class="form-control" data-bind="value: productForm().compareAtPrice" />
                                            <small class="text-muted">@Html.T("Products.CompareAtPrice.Help", "Indirimli fiyat gosterimi icin")</small>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">@Html.T("Products.Field.CostPrice", "Maliyet Fiyati")</label>
                                            <input type="number" step="0.01" min="0" class="form-control" data-bind="value: productForm().costPrice" />
                                            <small class="text-muted">@Html.T("Products.CostPrice.Help", "Kar hesaplama icin")</small>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Price Tiers Tab (Miktar bazli fiyatlandirma) -->
                            <div class="tab-pane fade" id="tab-price-tiers">
                                <div class="alert alert-info mb-3">
                                    <i class="bi bi-info-circle"></i>
                                    @Html.T("Products.PriceTiers.Help", "Miktar bazli fiyatlandirma esikleri tanimlayin. Ornek: 100 adet = 25$, 1000 adet = 24$, 5000+ = 23$")
                                </div>

                                <!-- Add Tier Form -->
                                <div class="card mb-3">
                                    <div class="card-body py-2">
                                        <div class="row align-items-end g-2">
                                            <div class="col-md-2">
                                                <label class="form-label small">@Html.T("Products.PriceTiers.MinQty", "Min Adet")</label>
                                                <input type="number" class="form-control form-control-sm" min="1" data-bind="value: newPriceTier().minQuantity" />
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label small">@Html.T("Products.PriceTiers.MaxQty", "Max Adet")</label>
                                                <input type="number" class="form-control form-control-sm" data-bind="value: newPriceTier().maxQuantity" placeholder="@Html.T("Products.PriceTiers.Unlimited", "Sinirsiz")" />
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label small">@Html.T("Products.PriceTiers.UnitPrice", "Birim Fiyat")</label>
                                                <input type="number" step="0.01" min="0" class="form-control form-control-sm" data-bind="value: newPriceTier().price" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label small">@Html.T("Products.PriceTiers.Description", "Aciklama")</label>
                                                <input type="text" class="form-control form-control-sm" data-bind="value: newPriceTier().description" placeholder="@Html.T("Products.PriceTiers.DescPlaceholder", "Toptan, Distribut\u00f6r vb.")" />
                                            </div>
                                            <div class="col-md-3">
                                                <div class="btn-group w-100">
                                                    <button type="button" class="btn btn-sm w-100"
                                                            data-bind="click: savePriceTier, disable: isSavingTier,
                                                                       css: editingTierId() ? 'btn-primary' : 'btn-success'">
                                                        <i class="bi" data-bind="css: editingTierId() ? 'bi-check-lg' : 'bi-plus-lg'"></i>
                                                        <span data-bind="text: editingTierId() ? '@Html.T("Common.Update", "Guncelle")' : '@Html.T("Products.PriceTiers.Add", "Esik Ekle")'"></span>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                                            data-bind="visible: editingTierId(), click: cancelEditTier" title="@Html.T("Common.Cancel", "Iptal")">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Tier List -->
                                <div data-bind="visible: priceTiers().length === 0" class="text-center py-4">
                                    <i class="bi bi-tag text-muted" style="font-size: 2rem;"></i>
                                    <p class="mt-2 text-muted">@Html.T("Products.PriceTiers.Empty", "Henuz fiyat esigi tanimlanmamis")</p>
                                </div>

                                <div class="table-responsive" data-bind="visible: priceTiers().length > 0">
                                    <table class="table table-sm table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>@Html.T("Products.PriceTiers.MinQty", "Min Adet")</th>
                                                <th>@Html.T("Products.PriceTiers.MaxQty", "Max Adet")</th>
                                                <th class="text-end">@Html.T("Products.PriceTiers.UnitPrice", "Birim Fiyat")</th>
                                                <th>@Html.T("Products.PriceTiers.Description", "Aciklama")</th>
                                                <th style="width: 90px;"></th>
                                            </tr>
                                        </thead>
                                        <tbody data-bind="foreach: priceTiers">
                                            <tr data-bind="css: { 'table-primary': $parent.editingTierId() === id }">
                                                <td data-bind="text: minQuantity + ' adet'"></td>
                                                <td data-bind="text: maxQuantity ? maxQuantity + ' adet' : 've uzeri'"></td>
                                                <td class="text-end fw-medium" data-bind="text: $parent.formatPrice(price)"></td>
                                                <td data-bind="text: description || '-'" class="text-muted"></td>
                                                <td class="text-end">
                                                    <div class="btn-group btn-group-sm">
                                                        <button type="button" class="btn btn-outline-primary"
                                                                data-bind="click: function() { $parent.editTier($data); }, disable: $parent.isSavingTier"
                                                                title="@Html.T("Common.Edit", "Duzenle")">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-outline-danger"
                                                                data-bind="click: function() { $parent.deletePriceTier($data); }, disable: $parent.isSavingTier"
                                                                title="@Html.T("Common.Delete", "Sil")">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Stock Tab -->
                            <div class="tab-pane fade" id="tab-stock">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">@Html.T("Products.Field.StockQuantity", "Stok Miktari")</label>
                                            <input type="number" min="0" class="form-control" data-bind="value: productForm().stockQuantity" />
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">@Html.T("Products.Field.MinStockLevel", "Minimum Stok Seviyesi")</label>
                                            <input type="number" min="0" class="form-control" data-bind="value: productForm().minStockLevel" />
                                            <small class="text-muted">@Html.T("Products.MinStockLevel.Help", "Alarm icin")</small>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3 pt-4">
                                            <div class="form-check mb-2">
                                                <input type="checkbox" class="form-check-input" data-bind="checked: productForm().trackStock" id="trackStock" />
                                                <label class="form-check-label" for="trackStock">@Html.T("Products.Field.TrackStock", "Stok Takibi Yap")</label>
                                            </div>
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" data-bind="checked: productForm().allowBackorder" id="allowBackorder" />
                                                <label class="form-check-label" for="allowBackorder">@Html.T("Products.Field.AllowBackorder", "Onsiparis Izin Ver")</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Physical Tab -->
                            <div class="tab-pane fade" id="tab-physical">
                                <!-- Tek Birim Olculeri -->
                                <div class="card mb-3">
                                    <div class="card-header bg-light py-2">
                                        <h6 class="mb-0"><i class="bi bi-box me-2"></i>@Html.T("Products.Section.UnitDimensions", "Tek Birim Olculeri")</h6>
                                        <small class="text-muted">@Html.T("Products.Section.UnitDimensions.Help", "Urunun paketlenmemis tek biriminin olculeri")</small>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-3">
                                                <div class="mb-3">
                                                    <label class="form-label">@Html.T("Products.Field.Weight", "Agirlik (kg)")</label>
                                                    <input type="number" step="0.001" min="0" class="form-control" data-bind="value: productForm().weight" />
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="mb-3">
                                                    <label class="form-label">@Html.T("Products.Field.Length", "Uzunluk (cm)")</label>
                                                    <input type="number" step="0.1" min="0" class="form-control" data-bind="value: productForm().length" />
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="mb-3">
                                                    <label class="form-label">@Html.T("Products.Field.Width", "Genislik (cm)")</label>
                                                    <input type="number" step="0.1" min="0" class="form-control" data-bind="value: productForm().width" />
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="mb-3">
                                                    <label class="form-label">@Html.T("Products.Field.Height", "Yukseklik (cm)")</label>
                                                    <input type="number" step="0.1" min="0" class="form-control" data-bind="value: productForm().height" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Paketleme Bilgileri -->
                                <div class="card">
                                    <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-0"><i class="bi bi-boxes me-2"></i>@Html.T("Products.Section.Packaging", "Paketleme Bilgileri")</h6>
                                            <small class="text-muted">@Html.T("Products.Section.Packaging.Help", "Urunun farkli paketleme seviyelerini tanimlayin")</small>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-primary" data-bind="click: addPackaging, visible: isEditing()">
                                            <i class="bi bi-plus-lg me-1"></i>@Html.T("Products.AddPackaging", "Paketleme Ekle")
                                        </button>
                                    </div>
                                    <div class="card-body">
                                        <!-- Aciklama -->
                                        <div class="alert alert-info py-2 mb-3" data-bind="visible: productForm().packagings().length === 0">
                                            <i class="bi bi-info-circle me-2"></i>
                                            <strong>@Html.T("Products.Packaging.Info.Title", "Paketleme nedir?")</strong><br/>
                                            <small>@Html.T("Products.Packaging.Info.Text", "Ornegin: 500 adet pul = 1 paket, 10 paket = 1 koli, 20 koli = 1 palet. Farkli paketleme seviyeleri tanimlayarak musterilerinize toplu satis secenekleri sunabilirsiniz.")</small>
                                        </div>

                                        <!-- Paketleme Listesi -->
                                        <div data-bind="foreach: productForm().packagings">
                                            <div class="card mb-2 border-start border-4" data-bind="css: { 'border-info': unitId() === 4 || unitId() === 5 || unitId() === 22, 'border-warning': unitId() === 6, 'border-success': unitId() === 7, 'border-dark': unitId() === 8 }">
                                                <div class="card-body py-2">
                                                    <div class="row align-items-center">
                                                        <!-- Seviye Secimi -->
                                                        <div class="col-md-2">
                                                            <label class="form-label small text-muted mb-1">@Html.T("Products.Packaging.Level", "Seviye")</label>
                                                            <select class="form-select form-select-sm" data-bind="options: $parent.packagingUnits, optionsValue: 'id', optionsText: 'name', value: unitId"></select>
                                                        </div>
                                                        <!-- Adet Bilgisi -->
                                                        <div class="col-md-2">
                                                            <label class="form-label small text-muted mb-1">@Html.T("Products.Packaging.Quantity", "Bu Pakette")</label>
                                                            <div class="input-group input-group-sm">
                                                                <input type="number" min="1" class="form-control" data-bind="value: quantity" />
                                                                <span class="input-group-text">adet</span>
                                                            </div>
                                                        </div>
                                                        <!-- Barkod -->
                                                        <div class="col-md-2">
                                                            <label class="form-label small text-muted mb-1">@Html.T("Products.Packaging.Barcode", "Barkod")</label>
                                                            <input type="text" class="form-control form-control-sm" data-bind="value: barcode" placeholder="Opsiyonel" />
                                                        </div>
                                                        <!-- Agirlik -->
                                                        <div class="col-md-2">
                                                            <label class="form-label small text-muted mb-1">@Html.T("Products.Packaging.Weight", "Brut Agirlik")</label>
                                                            <div class="input-group input-group-sm">
                                                                <input type="number" step="0.01" min="0" class="form-control" data-bind="value: grossWeight" />
                                                                <span class="input-group-text">kg</span>
                                                            </div>
                                                        </div>
                                                        <!-- Boyutlar -->
                                                        <div class="col-md-3">
                                                            <label class="form-label small text-muted mb-1">@Html.T("Products.Packaging.Dimensions", "Boyutlar (cm)")</label>
                                                            <div class="d-flex gap-1">
                                                                <input type="number" step="0.1" min="0" class="form-control form-control-sm" data-bind="value: length" placeholder="U" title="Uzunluk" />
                                                                <input type="number" step="0.1" min="0" class="form-control form-control-sm" data-bind="value: width" placeholder="G" title="Genislik" />
                                                                <input type="number" step="0.1" min="0" class="form-control form-control-sm" data-bind="value: height" placeholder="Y" title="Yukseklik" />
                                                            </div>
                                                        </div>
                                                        <!-- Satis Birimi + Sil Butonu -->
                                                        <div class="col-md-1 text-end">
                                                            <div class="btn-group btn-group-sm">
                                                                <button type="button" class="btn"
                                                                    data-bind="click: $parent.setAsDefault,
                                                                               css: isDefault() ? 'btn-success' : 'btn-outline-secondary',
                                                                               attr: { title: isDefault() ? 'Satis Birimi' : 'Satis Birimi Yap' }">
                                                                    <i class="bi" data-bind="css: isDefault() ? 'bi-check-circle-fill' : 'bi-circle'"></i>
                                                                </button>
                                                                <button type="button" class="btn btn-outline-danger" data-bind="click: $parent.removePackaging" title="Kaldir">
                                                                    <i class="bi bi-trash"></i>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Ozet Bilgi -->
                                        <div class="alert alert-light py-2 mt-2" data-bind="visible: productForm().packagings().length > 0">
                                            <i class="bi bi-diagram-3 me-2"></i>
                                            <strong>@Html.T("Products.Packaging.Summary", "Paketleme Ozeti"):</strong>
                                            <span data-bind="foreach: productForm().packagings">
                                                <span class="badge me-1" data-bind="css: (unitId() === 4 || unitId() === 5 || unitId() === 22) ? 'bg-info' : (unitId() === 6 ? 'bg-warning text-dark' : (unitId() === 7 ? 'bg-success' : 'bg-dark')), text: quantity() + ' adet = 1 ' + ($parent.getPackagingUnitName(unitId()) || 'birim')"></span>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- SEO Tab -->
                            <div class="tab-pane fade" id="tab-seo">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="mb-3">
                                            <label class="form-label">@Html.T("Products.Field.MetaTitle", "Meta Baslik")</label>
                                            <input type="text" class="form-control" data-bind="value: productForm().metaTitle" maxlength="200" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">@Html.T("Products.Field.MetaDescription", "Meta Aciklama")</label>
                                            <textarea class="form-control" rows="3" data-bind="value: productForm().metaDescription" maxlength="500"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bind="click: closeProductModal">@Html.T("Common.Cancel", "Iptal")</button>
                        <button type="submit" class="btn btn-primary" data-bind="disable: isSaving">
                            <span data-bind="visible: !isSaving()"><i class="bi bi-check-lg"></i> @Html.T("Common.Save", "Kaydet")</span>
                            <span data-bind="visible: isSaving()"><span class="spinner-border spinner-border-sm"></span> @Html.T("Common.Saving", "Kaydediliyor...")</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: showProductModal }, style: { display: showProductModal() ? 'block' : 'none' }"></div>

    <!-- Image Modal -->
    <div class="modal fade" data-bind="css: { show: showImageModal }, style: { display: showImageModal() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-images"></i> @Html.T("Products.ManageImages", "Urun Gorselleri")
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: closeImageModal"></button>
                </div>
                <div class="modal-body">
                    <!-- Add Image - Tabs -->
                    <div class="mb-4">
                        <label class="form-label">@Html.T("Products.AddImage", "Gorsel Ekle")</label>
                        <ul class="nav nav-tabs nav-tabs-sm mb-3" role="tablist">
                            <li class="nav-item">
                                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#uploadTab" type="button">
                                    <i class="bi bi-upload me-1"></i> @Html.T("Products.Upload", "Dosya Yukle")
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#urlTab" type="button">
                                    <i class="bi bi-link-45deg me-1"></i> @Html.T("Products.FromUrl", "URL ile")
                                </button>
                            </li>
                        </ul>
                        <div class="tab-content">
                            <!-- Upload Tab -->
                            <div class="tab-pane fade show active" id="uploadTab">
                                <div class="d-flex gap-2">
                                    <input type="file" id="imageFileInput" class="form-control" accept="image/jpeg,image/png,image/gif,image/webp" data-bind="event: { change: onFileSelected }" />
                                    <button type="button" class="btn btn-primary" data-bind="click: uploadImage, disable: !selectedFile() || isUploading()">
                                        <span data-bind="visible: !isUploading()"><i class="bi bi-cloud-upload me-1"></i> @Html.T("Common.Upload", "Yukle")</span>
                                        <span data-bind="visible: isUploading()"><i class="bi bi-hourglass-split me-1"></i> @Html.T("Common.Uploading", "Yukleniyor...")</span>
                                    </button>
                                </div>
                                <small class="text-muted">@Html.T("Products.Upload.Info", "Maks 5MB, JPG/PNG/GIF/WebP")</small>
                            </div>
                            <!-- URL Tab -->
                            <div class="tab-pane fade" id="urlTab">
                                <div class="input-group">
                                    <input type="text" class="form-control" data-bind="value: newImageUrl" placeholder="@Html.T("Products.ImageUrl.Placeholder", "Gorsel URL'si girin...")" />
                                    <button type="button" class="btn btn-primary" data-bind="click: addImage, disable: !newImageUrl() || isSaving()">
                                        <i class="bi bi-plus-lg"></i> @Html.T("Common.Add", "Ekle")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Image List -->
                    <div data-bind="visible: currentProductImages().length === 0" class="text-center py-4">
                        <i class="bi bi-images text-muted" style="font-size: 2rem;"></i>
                        <p class="mt-2 text-muted">@Html.T("Products.NoImages", "Henuz gorsel eklenmemis")</p>
                    </div>

                    <div class="row" data-bind="foreach: currentProductImages">
                        <div class="col-md-4 mb-3">
                            <div class="card h-100">
                                <img data-bind="attr: { src: url, alt: altText || '' }" class="card-img-top" style="height: 150px; object-fit: cover;" />
                                <div class="card-body p-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span data-bind="visible: isMain" class="badge bg-success">
                                            <i class="bi bi-star-fill"></i> @Html.T("Products.MainImage", "Ana")
                                        </span>
                                        <span data-bind="visible: !isMain" class="badge bg-light text-dark">
                                            #<span data-bind="text: displayOrder + 1"></span>
                                        </span>
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-success" title="@Html.T("Products.SetAsMain", "Ana Gorsel Yap")"
                                                    data-bind="visible: !isMain, click: function() { $parent.setMainImage(id); }, disable: $parent.isSaving">
                                                <i class="bi bi-star"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger btn-gap" title="@Html.T("Common.Delete", "Sil")"
                                                    data-bind="click: function() { $parent.deleteImage(id); }, disable: $parent.isSaving">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeImageModal">@Html.T("Common.Close", "Kapat")</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: showImageModal }, style: { display: showImageModal() ? 'block' : 'none' }"></div>

    <!-- Stock Modal -->
    <div class="modal fade" data-bind="css: { show: showStockModal }, style: { display: showStockModal() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-box-seam me-2"></i>@Html.T("Products.StockManagement", "Stok Yonetimi")
                        <small class="text-muted ms-2" data-bind="text: '- ' + (stockProductName() || '')"></small>
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: closeStockModal"></button>
                </div>
                <div class="modal-body">
                    <!-- Loading -->
                    <div data-bind="visible: isLoadingStock" class="text-center py-4">
                        <div class="spinner-border text-primary"></div>
                        <p class="mt-2 text-muted">@Html.T("Common.Loading", "Yukleniyor...")</p>
                    </div>

                    <!-- No Warehouses -->
                    <div data-bind="visible: !isLoadingStock() && warehouses().length === 0" class="text-center py-4">
                        <i class="bi bi-building-x text-muted" style="font-size: 2rem;"></i>
                        <p class="mt-2 text-muted">@Html.T("Products.Stock.NoWarehouses", "Henuz depo tanimlanmamis")</p>
                        <a href="/Warehouses" class="btn btn-primary mt-2">
                            <i class="bi bi-plus-lg"></i> @Html.T("Products.Stock.AddWarehouse", "Depo Ekle")
                        </a>
                    </div>

                    <!-- Stock Table -->
                    <div data-bind="visible: !isLoadingStock() && warehouses().length > 0">
                        <div class="alert alert-info py-2 mb-3">
                            <i class="bi bi-info-circle me-2"></i>
                            @Html.T("Products.Stock.Info", "Her depodaki stok miktarini girin. Kaydet butonuna basmayi unutmayin.")
                        </div>

                        <table class="table table-bordered mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 40%;">@Html.T("Products.Stock.Warehouse", "Depo")</th>
                                    <th style="width: 20%;">@Html.T("Products.Stock.Quantity", "Miktar")</th>
                                    <th style="width: 20%;">@Html.T("Products.Stock.Reserved", "Rezerve")</th>
                                    <th style="width: 20%;">@Html.T("Products.Stock.Available", "Kullanilabilir")</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: warehouseStocks">
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-building me-2 text-muted"></i>
                                            <div>
                                                <span data-bind="text: warehouseName" class="fw-medium"></span>
                                                <small class="text-muted d-block" data-bind="text: warehouseCode"></small>
                                            </div>
                                            <!-- ko if: isDefault -->
                                            <span class="badge bg-primary ms-2">@Html.T("Products.Stock.Default", "Varsayilan")</span>
                                            <!-- /ko -->
                                        </div>
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm" min="0" step="1"
                                               data-bind="value: quantity, valueUpdate: 'afterkeydown'" />
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm" min="0" step="1"
                                               data-bind="value: reservedQuantity, valueUpdate: 'afterkeydown'" />
                                    </td>
                                    <td class="text-center">
                                        <span class="badge" data-bind="text: availableQuantity(), css: availableQuantity() > 0 ? 'bg-success' : 'bg-danger'"></span>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <th>@Html.T("Products.Stock.Total", "Toplam")</th>
                                    <th data-bind="text: totalStockQuantity()"></th>
                                    <th data-bind="text: totalReservedQuantity()"></th>
                                    <th class="text-center">
                                        <span class="badge" data-bind="text: totalAvailableQuantity(), css: totalAvailableQuantity() > 0 ? 'bg-success' : 'bg-danger'"></span>
                                    </th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeStockModal">@Html.T("Common.Cancel", "Iptal")</button>
                    <button type="button" class="btn btn-primary" data-bind="click: saveStock, disable: isSavingStock() || warehouses().length === 0">
                        <span data-bind="visible: isSavingStock"><span class="spinner-border spinner-border-sm me-1"></span></span>
                        <i class="bi bi-check-lg" data-bind="visible: !isSavingStock()"></i>
                        @Html.T("Common.Save", "Kaydet")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: showStockModal }, style: { display: showStockModal() ? 'block' : 'none' }"></div>

    <!-- Category Subscription Suggestion Modal -->
    <div class="modal fade" id="subscriptionModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-bell"></i> @Html.T("Products.Subscription.Title", "Kategori Takibi")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bind="click: closeSubscriptionModal"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="bi bi-megaphone display-4 text-info mb-3"></i>
                    <h5>@Html.T("Products.Subscription.Question", "Bu kategori icin talepleri takip etmek ister misiniz?")</h5>
                    <p class="text-muted mb-0">
                        <span data-bind="text: subscriptionCategoryName" class="fw-bold"></span> @Html.T("Products.Subscription.Description", "kategorisinde yeni bir talep yayinlandiginda bildirim alirsiniz.")
                    </p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-outline-secondary" data-bind="click: closeSubscriptionModal">
                        <i class="bi bi-x"></i> @Html.T("Common.NoThanks", "Hayir, tesekkurler")
                    </button>
                    <button type="button" class="btn btn-info" data-bind="click: subscribeToCategory, disable: isSubscribing">
                        <span data-bind="visible: isSubscribing"><span class="spinner-border spinner-border-sm me-1"></span></span>
                        <i class="bi bi-bell-fill" data-bind="visible: !isSubscribing()"></i>
                        @Html.T("Common.YesSubscribe", "Evet, takip et")
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Products/Index.js" asp-append-version="true"></script>
}
