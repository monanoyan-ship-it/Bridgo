@* Investor Dashboard - Yatirimci (Capability ID: 8) *@

<!-- Stats -->
<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <div class="card border-0 shadow-sm bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1 opacity-75">@Html.T("Dashboard.Stats.Opportunities", "Yatirim Firsatlari")</h6>
                        <h2 class="mb-0" data-bind="text: stats().availableOpportunities || 0"></h2>
                    </div>
                    <i class="bi bi-graph-up-arrow" style="font-size: 2.5rem; opacity: 0.5;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-0 shadow-sm bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1 opacity-75">@Html.T("Dashboard.Stats.ActiveInvestments", "Aktif Yatirimlar")</h6>
                        <h2 class="mb-0" data-bind="text: stats().activeInvestments || 0"></h2>
                    </div>
                    <i class="bi bi-pie-chart" style="font-size: 2.5rem; opacity: 0.5;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-0 shadow-sm bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1 opacity-75">@Html.T("Dashboard.Stats.PortfolioValue", "Portfoy Degeri")</h6>
                        <h2 class="mb-0" data-bind="text: formatCurrency(stats().totalPortfolioValue, stats().currency)"></h2>
                    </div>
                    <i class="bi bi-wallet2" style="font-size: 2.5rem; opacity: 0.5;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6 mb-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-hourglass-split text-warning" style="font-size: 2rem;"></i>
                <h3 class="mt-2 mb-1" data-bind="text: stats().pendingOffers || 0"></h3>
                <small class="text-muted">@Html.T("Dashboard.Stats.PendingOffers", "Bekleyen Teklifler")</small>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <i class="bi bi-currency-exchange text-success" style="font-size: 2rem;"></i>
                <h3 class="mt-2 mb-1" data-bind="text: formatCurrency(stats().expectedMonthlyReturn, stats().currency)"></h3>
                <small class="text-muted">@Html.T("Dashboard.Stats.ExpectedReturn", "Beklenen Aylik Getiri")</small>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Recent Opportunities -->
    <div class="col-lg-6 mb-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-lightning me-2"></i>@Html.T("Dashboard.Opportunities", "Firsatlar")</h5>
                <a href="/Investment/Opportunities" class="btn btn-sm btn-outline-primary">@Html.T("Common.ViewAll", "Tumu")</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Html.T("Common.Title", "Baslik")</th>
                                <th>@Html.T("Dashboard.Table.Amount", "Tutar")</th>
                                <th>@Html.T("Dashboard.Table.InterestRate", "Faiz")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: recentOpportunities">
                            <tr>
                                <td>
                                    <div>
                                        <strong data-bind="text: title"></strong>
                                        <br><small class="text-muted" data-bind="text: vendorName"></small>
                                    </div>
                                </td>
                                <td data-bind="text: $parent.formatCurrency(requestedAmount, currency)"></td>
                                <td>
                                    <span data-bind="text: maxInterestRate"></span>%
                                    <br><small class="text-muted" data-bind="text: durationMonths + ' ay'"></small>
                                </td>
                            </tr>
                        </tbody>
                        <!-- ko if: recentOpportunities().length === 0 -->
                        <tbody>
                            <tr><td colspan="3" class="text-center text-muted py-4">@Html.T("Common.NoData", "Veri bulunamadi")</td></tr>
                        </tbody>
                        <!-- /ko -->
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Investments -->
    <div class="col-lg-6 mb-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-briefcase me-2"></i>@Html.T("Dashboard.ActiveInvestments", "Aktif Yatirimlar")</h5>
                <a href="/Investment/MyInvestments" class="btn btn-sm btn-outline-primary">@Html.T("Common.ViewAll", "Tumu")</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Html.T("Common.Title", "Baslik")</th>
                                <th>@Html.T("Dashboard.Table.InvestedAmount", "Yatirilan")</th>
                                <th>@Html.T("Dashboard.Table.ExpectedReturn", "Beklenen")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: activeInvestments">
                            <tr>
                                <td>
                                    <div>
                                        <strong data-bind="text: title"></strong>
                                        <br><small class="text-muted" data-bind="text: vendorName"></small>
                                    </div>
                                </td>
                                <td data-bind="text: $parent.formatCurrency(investedAmount, currency)"></td>
                                <td>
                                    <span class="text-success" data-bind="text: '+' + $parent.formatCurrency(expectedReturn, currency)"></span>
                                    <br><small class="text-muted" data-bind="text: $parent.formatDate(maturityDate)"></small>
                                </td>
                            </tr>
                        </tbody>
                        <!-- ko if: activeInvestments().length === 0 -->
                        <tbody>
                            <tr><td colspan="3" class="text-center text-muted py-4">@Html.T("Common.NoData", "Veri bulunamadi")</td></tr>
                        </tbody>
                        <!-- /ko -->
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
